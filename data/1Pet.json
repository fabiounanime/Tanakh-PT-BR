{"book":{"id":"1Pet","name":"1 Pedro","testament":"NT","source":"SBLGNT","chapters":5,"verses":105},"chapters":{"1":[{"n":1,"text":"Πέτρος ἀπόστολος Ἰησοῦ Χριστοῦ ἐκλεκτοῖς παρεπιδήμοις διασπορᾶς Πόντου, Γαλατίας, Καππαδοκίας, Ἀσίας, καὶ Βιθυνίας,","tokens":[{"text":"Πέτρος"},{"text":"ἀπόστολος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"ἐκλεκτοῖς"},{"text":"παρεπιδήμοις"},{"text":"διασπορᾶς"},{"text":"Πόντου"},{"text":"Γαλατίας"},{"text":"Καππαδοκίας"},{"text":"Ἀσίας"},{"text":"καὶ"},{"text":"Βιθυνίας"}],"notes":[],"lang":"grc"},{"n":2,"text":"κατὰ πρόγνωσιν θεοῦ πατρός, ἐν ἁγιασμῷ πνεύματος, εἰς ὑπακοὴν καὶ ῥαντισμὸν αἵματος Ἰησοῦ Χριστοῦ· χάρις ὑμῖν καὶ εἰρήνη πληθυνθείη.","tokens":[{"text":"κατὰ"},{"text":"πρόγνωσιν"},{"text":"θεοῦ"},{"text":"πατρός"},{"text":"ἐν"},{"text":"ἁγιασμῷ"},{"text":"πνεύματος"},{"text":"εἰς"},{"text":"ὑπακοὴν"},{"text":"καὶ"},{"text":"ῥαντισμὸν"},{"text":"αἵματος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"πληθυνθείη"}],"notes":[],"lang":"grc"},{"n":3,"text":"Εὐλογητὸς ὁ θεὸς καὶ πατὴρ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, ὁ κατὰ τὸ πολὺ αὐτοῦ ἔλεος ἀναγεννήσας ἡμᾶς εἰς ἐλπίδα ζῶσαν διʼ ἀναστάσεως Ἰησοῦ Χριστοῦ ἐκ νεκρῶν,","tokens":[{"text":"Εὐλογητὸς"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"καὶ"},{"text":"πατὴρ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"ὁ"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"πολὺ"},{"text":"αὐτοῦ"},{"text":"ἔλεος"},{"text":"ἀναγεννήσας"},{"text":"ἡμᾶς"},{"text":"εἰς"},{"text":"ἐλπίδα"},{"text":"ζῶσαν"},{"text":"διʼ"},{"text":"ἀναστάσεως"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"ἐκ"},{"text":"νεκρῶν"}],"notes":[],"lang":"grc"},{"n":4,"text":"εἰς κληρονομίαν ἄφθαρτον καὶ ἀμίαντον καὶ ἀμάραντον, τετηρημένην ἐν οὐρανοῖς εἰς ὑμᾶς","tokens":[{"text":"εἰς"},{"text":"κληρονομίαν"},{"text":"ἄφθαρτον"},{"text":"καὶ"},{"text":"ἀμίαντον"},{"text":"καὶ"},{"text":"ἀμάραντον"},{"text":"τετηρημένην"},{"text":"ἐν"},{"text":"οὐρανοῖς"},{"text":"εἰς"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":5,"text":"τοὺς ἐν δυνάμει θεοῦ φρουρουμένους διὰ πίστεως εἰς σωτηρίαν ἑτοίμην ἀποκαλυφθῆναι ἐν καιρῷ ἐσχάτῳ.","tokens":[{"text":"τοὺς"},{"text":"ἐν"},{"text":"δυνάμει"},{"text":"θεοῦ"},{"text":"φρουρουμένους"},{"text":"διὰ"},{"text":"πίστεως"},{"text":"εἰς"},{"text":"σωτηρίαν"},{"text":"ἑτοίμην"},{"text":"ἀποκαλυφθῆναι"},{"text":"ἐν"},{"text":"καιρῷ"},{"text":"ἐσχάτῳ"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἐν ᾧ ἀγαλλιᾶσθε, ὀλίγον ἄρτι εἰ ⸀ δέον ⸀ λυπηθέντες ἐν ποικίλοις πειρασμοῖς,","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"ἀγαλλιᾶσθε"},{"text":"ὀλίγον"},{"text":"ἄρτι"},{"text":"εἰ"},{"text":"δέον"},{"text":"λυπηθέντες"},{"text":"ἐν"},{"text":"ποικίλοις"},{"text":"πειρασμοῖς"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἵνα τὸ δοκίμιον ὑμῶν τῆς πίστεως ⸀ πολυτιμότερον χρυσίου τοῦ ἀπολλυμένου διὰ πυρὸς δὲ δοκιμαζομένου εὑρεθῇ εἰς ἔπαινον καὶ ⸂ δόξαν καὶ τιμὴν⸃ ἐν ἀποκαλύψει Ἰησοῦ Χριστοῦ.","tokens":[{"text":"ἵνα"},{"text":"τὸ"},{"text":"δοκίμιον"},{"text":"ὑμῶν"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"πολυτιμότερον"},{"text":"χρυσίου"},{"text":"τοῦ"},{"text":"ἀπολλυμένου"},{"text":"διὰ"},{"text":"πυρὸς"},{"text":"δὲ"},{"text":"δοκιμαζομένου"},{"text":"εὑρεθῇ"},{"text":"εἰς"},{"text":"ἔπαινον"},{"text":"καὶ"},{"text":"δόξαν"},{"text":"καὶ"},{"text":"τιμὴν"},{"text":"ἐν"},{"text":"ἀποκαλύψει"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":8,"text":"ὃν οὐκ ⸀ ἰδόντες ἀγαπᾶτε, εἰς ὃν ἄρτι μὴ ὁρῶντες πιστεύοντες δὲ ⸀ ἀγαλλιᾶσθε χαρᾷ ἀνεκλαλήτῳ καὶ δεδοξασμένῃ,","tokens":[{"text":"ὃν"},{"text":"οὐκ"},{"text":"ἰδόντες"},{"text":"ἀγαπᾶτε"},{"text":"εἰς"},{"text":"ὃν"},{"text":"ἄρτι"},{"text":"μὴ"},{"text":"ὁρῶντες"},{"text":"πιστεύοντες"},{"text":"δὲ"},{"text":"ἀγαλλιᾶσθε"},{"text":"χαρᾷ"},{"text":"ἀνεκλαλήτῳ"},{"text":"καὶ"},{"text":"δεδοξασμένῃ"}],"notes":[],"lang":"grc"},{"n":9,"text":"κομιζόμενοι τὸ τέλος τῆς πίστεως ⸀ ὑμῶν σωτηρίαν ψυχῶν.","tokens":[{"text":"κομιζόμενοι"},{"text":"τὸ"},{"text":"τέλος"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"ὑμῶν"},{"text":"σωτηρίαν"},{"text":"ψυχῶν"}],"notes":[],"lang":"grc"},{"n":10,"text":"Περὶ ἧς σωτηρίας ἐξεζήτησαν καὶ ἐξηραύνησαν προφῆται οἱ περὶ τῆς εἰς ὑμᾶς χάριτος προφητεύσαντες,","tokens":[{"text":"Περὶ"},{"text":"ἧς"},{"text":"σωτηρίας"},{"text":"ἐξεζήτησαν"},{"text":"καὶ"},{"text":"ἐξηραύνησαν"},{"text":"προφῆται"},{"text":"οἱ"},{"text":"περὶ"},{"text":"τῆς"},{"text":"εἰς"},{"text":"ὑμᾶς"},{"text":"χάριτος"},{"text":"προφητεύσαντες"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἐραυνῶντες εἰς τίνα ἢ ποῖον καιρὸν ἐδήλου τὸ ἐν αὐτοῖς πνεῦμα Χριστοῦ προμαρτυρόμενον τὰ εἰς Χριστὸν παθήματα καὶ τὰς μετὰ ταῦτα δόξας·","tokens":[{"text":"ἐραυνῶντες"},{"text":"εἰς"},{"text":"τίνα"},{"text":"ἢ"},{"text":"ποῖον"},{"text":"καιρὸν"},{"text":"ἐδήλου"},{"text":"τὸ"},{"text":"ἐν"},{"text":"αὐτοῖς"},{"text":"πνεῦμα"},{"text":"Χριστοῦ"},{"text":"προμαρτυρόμενον"},{"text":"τὰ"},{"text":"εἰς"},{"text":"Χριστὸν"},{"text":"παθήματα"},{"text":"καὶ"},{"text":"τὰς"},{"text":"μετὰ"},{"text":"ταῦτα"},{"text":"δόξας"}],"notes":[],"lang":"grc"},{"n":12,"text":"οἷς ἀπεκαλύφθη ὅτι οὐχ ἑαυτοῖς ὑμῖν δὲ διηκόνουν αὐτά, ἃ νῦν ἀνηγγέλη ὑμῖν διὰ τῶν εὐαγγελισαμένων ⸀ ὑμᾶς πνεύματι ἁγίῳ ἀποσταλέντι ἀπʼ οὐρανοῦ, εἰς ἃ ἐπιθυμοῦσιν ἄγγελοι παρακύψαι.","tokens":[{"text":"οἷς"},{"text":"ἀπεκαλύφθη"},{"text":"ὅτι"},{"text":"οὐχ"},{"text":"ἑαυτοῖς"},{"text":"ὑμῖν"},{"text":"δὲ"},{"text":"διηκόνουν"},{"text":"αὐτά"},{"text":"ἃ"},{"text":"νῦν"},{"text":"ἀνηγγέλη"},{"text":"ὑμῖν"},{"text":"διὰ"},{"text":"τῶν"},{"text":"εὐαγγελισαμένων"},{"text":"ὑμᾶς"},{"text":"πνεύματι"},{"text":"ἁγίῳ"},{"text":"ἀποσταλέντι"},{"text":"ἀπʼ"},{"text":"οὐρανοῦ"},{"text":"εἰς"},{"text":"ἃ"},{"text":"ἐπιθυμοῦσιν"},{"text":"ἄγγελοι"},{"text":"παρακύψαι"}],"notes":[],"lang":"grc"},{"n":13,"text":"Διὸ ἀναζωσάμενοι τὰς ὀσφύας τῆς διανοίας ὑμῶν, νήφοντες τελείως, ἐλπίσατε ἐπὶ τὴν φερομένην ὑμῖν χάριν ἐν ἀποκαλύψει Ἰησοῦ Χριστοῦ.","tokens":[{"text":"Διὸ"},{"text":"ἀναζωσάμενοι"},{"text":"τὰς"},{"text":"ὀσφύας"},{"text":"τῆς"},{"text":"διανοίας"},{"text":"ὑμῶν"},{"text":"νήφοντες"},{"text":"τελείως"},{"text":"ἐλπίσατε"},{"text":"ἐπὶ"},{"text":"τὴν"},{"text":"φερομένην"},{"text":"ὑμῖν"},{"text":"χάριν"},{"text":"ἐν"},{"text":"ἀποκαλύψει"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":14,"text":"ὡς τέκνα ὑπακοῆς, μὴ συσχηματιζόμενοι ταῖς πρότερον ἐν τῇ ἀγνοίᾳ ὑμῶν ἐπιθυμίαις,","tokens":[{"text":"ὡς"},{"text":"τέκνα"},{"text":"ὑπακοῆς"},{"text":"μὴ"},{"text":"συσχηματιζόμενοι"},{"text":"ταῖς"},{"text":"πρότερον"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀγνοίᾳ"},{"text":"ὑμῶν"},{"text":"ἐπιθυμίαις"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἀλλὰ κατὰ τὸν καλέσαντα ὑμᾶς ἅγιον καὶ αὐτοὶ ἅγιοι ἐν πάσῃ ἀναστροφῇ γενήθητε,","tokens":[{"text":"ἀλλὰ"},{"text":"κατὰ"},{"text":"τὸν"},{"text":"καλέσαντα"},{"text":"ὑμᾶς"},{"text":"ἅγιον"},{"text":"καὶ"},{"text":"αὐτοὶ"},{"text":"ἅγιοι"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"ἀναστροφῇ"},{"text":"γενήθητε"}],"notes":[],"lang":"grc"},{"n":16,"text":"διότι γέγραπται ⸀ ὅτι Ἅγιοι ⸀ ἔσεσθε, ὅτι ἐγὼ ⸀ ἅγιος.","tokens":[{"text":"διότι"},{"text":"γέγραπται"},{"text":"ὅτι"},{"text":"Ἅγιοι"},{"text":"ἔσεσθε"},{"text":"ὅτι"},{"text":"ἐγὼ"},{"text":"ἅγιος"}],"notes":[],"lang":"grc"},{"n":17,"text":"Καὶ εἰ πατέρα ἐπικαλεῖσθε τὸν ἀπροσωπολήμπτως κρίνοντα κατὰ τὸ ἑκάστου ἔργον, ἐν φόβῳ τὸν τῆς παροικίας ὑμῶν χρόνον ἀναστράφητε·","tokens":[{"text":"Καὶ"},{"text":"εἰ"},{"text":"πατέρα"},{"text":"ἐπικαλεῖσθε"},{"text":"τὸν"},{"text":"ἀπροσωπολήμπτως"},{"text":"κρίνοντα"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"ἑκάστου"},{"text":"ἔργον"},{"text":"ἐν"},{"text":"φόβῳ"},{"text":"τὸν"},{"text":"τῆς"},{"text":"παροικίας"},{"text":"ὑμῶν"},{"text":"χρόνον"},{"text":"ἀναστράφητε"}],"notes":[],"lang":"grc"},{"n":18,"text":"εἰδότες ὅτι οὐ φθαρτοῖς, ἀργυρίῳ ἢ χρυσίῳ, ἐλυτρώθητε ἐκ τῆς ματαίας ὑμῶν ἀναστροφῆς πατροπαραδότου,","tokens":[{"text":"εἰδότες"},{"text":"ὅτι"},{"text":"οὐ"},{"text":"φθαρτοῖς"},{"text":"ἀργυρίῳ"},{"text":"ἢ"},{"text":"χρυσίῳ"},{"text":"ἐλυτρώθητε"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"ματαίας"},{"text":"ὑμῶν"},{"text":"ἀναστροφῆς"},{"text":"πατροπαραδότου"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἀλλὰ τιμίῳ αἵματι ὡς ἀμνοῦ ἀμώμου καὶ ἀσπίλου Χριστοῦ,","tokens":[{"text":"ἀλλὰ"},{"text":"τιμίῳ"},{"text":"αἵματι"},{"text":"ὡς"},{"text":"ἀμνοῦ"},{"text":"ἀμώμου"},{"text":"καὶ"},{"text":"ἀσπίλου"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":20,"text":"προεγνωσμένου μὲν πρὸ καταβολῆς κόσμου, φανερωθέντος δὲ ἐπʼ ⸀ ἐσχάτου τῶν χρόνων διʼ ὑμᾶς","tokens":[{"text":"προεγνωσμένου"},{"text":"μὲν"},{"text":"πρὸ"},{"text":"καταβολῆς"},{"text":"κόσμου"},{"text":"φανερωθέντος"},{"text":"δὲ"},{"text":"ἐπʼ"},{"text":"ἐσχάτου"},{"text":"τῶν"},{"text":"χρόνων"},{"text":"διʼ"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":21,"text":"τοὺς διʼ αὐτοῦ ⸀ πιστοὺς εἰς θεὸν τὸν ἐγείραντα αὐτὸν ἐκ νεκρῶν καὶ δόξαν αὐτῷ δόντα, ὥστε τὴν πίστιν ὑμῶν καὶ ἐλπίδα εἶναι εἰς θεόν.","tokens":[{"text":"τοὺς"},{"text":"διʼ"},{"text":"αὐτοῦ"},{"text":"πιστοὺς"},{"text":"εἰς"},{"text":"θεὸν"},{"text":"τὸν"},{"text":"ἐγείραντα"},{"text":"αὐτὸν"},{"text":"ἐκ"},{"text":"νεκρῶν"},{"text":"καὶ"},{"text":"δόξαν"},{"text":"αὐτῷ"},{"text":"δόντα"},{"text":"ὥστε"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"ἐλπίδα"},{"text":"εἶναι"},{"text":"εἰς"},{"text":"θεόν"}],"notes":[],"lang":"grc"},{"n":22,"text":"Τὰς ψυχὰς ὑμῶν ἡγνικότες ἐν τῇ ὑπακοῇ τῆς ⸀ ἀληθείας εἰς φιλαδελφίαν ἀνυπόκριτον ⸀ ἐκ καρδίας ἀλλήλους ἀγαπήσατε ἐκτενῶς,","tokens":[{"text":"Τὰς"},{"text":"ψυχὰς"},{"text":"ὑμῶν"},{"text":"ἡγνικότες"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ὑπακοῇ"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"εἰς"},{"text":"φιλαδελφίαν"},{"text":"ἀνυπόκριτον"},{"text":"ἐκ"},{"text":"καρδίας"},{"text":"ἀλλήλους"},{"text":"ἀγαπήσατε"},{"text":"ἐκτενῶς"}],"notes":[],"lang":"grc"},{"n":23,"text":"ἀναγεγεννημένοι οὐκ ἐκ σπορᾶς φθαρτῆς ἀλλὰ ἀφθάρτου, διὰ λόγου ζῶντος θεοῦ καὶ ⸀ μένοντος·","tokens":[{"text":"ἀναγεγεννημένοι"},{"text":"οὐκ"},{"text":"ἐκ"},{"text":"σπορᾶς"},{"text":"φθαρτῆς"},{"text":"ἀλλὰ"},{"text":"ἀφθάρτου"},{"text":"διὰ"},{"text":"λόγου"},{"text":"ζῶντος"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"μένοντος"}],"notes":[],"lang":"grc"},{"n":24,"text":"διότι πᾶσα σὰρξ ὡς χόρτος, καὶ πᾶσα δόξα ⸀ αὐτῆς ὡς ἄνθος χόρτου· ἐξηράνθη ὁ χόρτος, καὶ τὸ ⸀ ἄνθος ἐξέπεσεν·","tokens":[{"text":"διότι"},{"text":"πᾶσα"},{"text":"σὰρξ"},{"text":"ὡς"},{"text":"χόρτος"},{"text":"καὶ"},{"text":"πᾶσα"},{"text":"δόξα"},{"text":"αὐτῆς"},{"text":"ὡς"},{"text":"ἄνθος"},{"text":"χόρτου"},{"text":"ἐξηράνθη"},{"text":"ὁ"},{"text":"χόρτος"},{"text":"καὶ"},{"text":"τὸ"},{"text":"ἄνθος"},{"text":"ἐξέπεσεν"}],"notes":[],"lang":"grc"},{"n":25,"text":"τὸ δὲ ῥῆμα κυρίου μένει εἰς τὸν αἰῶνα. τοῦτο δέ ἐστιν τὸ ῥῆμα τὸ εὐαγγελισθὲν εἰς ὑμᾶς.","tokens":[{"text":"τὸ"},{"text":"δὲ"},{"text":"ῥῆμα"},{"text":"κυρίου"},{"text":"μένει"},{"text":"εἰς"},{"text":"τὸν"},{"text":"αἰῶνα"},{"text":"τοῦτο"},{"text":"δέ"},{"text":"ἐστιν"},{"text":"τὸ"},{"text":"ῥῆμα"},{"text":"τὸ"},{"text":"εὐαγγελισθὲν"},{"text":"εἰς"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Ἀποθέμενοι οὖν πᾶσαν κακίαν καὶ πάντα δόλον καὶ ⸀ ὑποκρίσεις καὶ φθόνους καὶ πάσας καταλαλιάς,","tokens":[{"text":"Ἀποθέμενοι"},{"text":"οὖν"},{"text":"πᾶσαν"},{"text":"κακίαν"},{"text":"καὶ"},{"text":"πάντα"},{"text":"δόλον"},{"text":"καὶ"},{"text":"ὑποκρίσεις"},{"text":"καὶ"},{"text":"φθόνους"},{"text":"καὶ"},{"text":"πάσας"},{"text":"καταλαλιάς"}],"notes":[],"lang":"grc"},{"n":2,"text":"ὡς ἀρτιγέννητα βρέφη τὸ λογικὸν ἄδολον γάλα ἐπιποθήσατε, ἵνα ἐν αὐτῷ αὐξηθῆτε ⸂ εἰς σωτηρίαν⸃,","tokens":[{"text":"ὡς"},{"text":"ἀρτιγέννητα"},{"text":"βρέφη"},{"text":"τὸ"},{"text":"λογικὸν"},{"text":"ἄδολον"},{"text":"γάλα"},{"text":"ἐπιποθήσατε"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"αὐξηθῆτε"},{"text":"εἰς"},{"text":"σωτηρίαν"}],"notes":[],"lang":"grc"},{"n":3,"text":"⸀ εἰ ἐγεύσασθε ὅτι χρηστὸς ὁ κύριος.","tokens":[{"text":"εἰ"},{"text":"ἐγεύσασθε"},{"text":"ὅτι"},{"text":"χρηστὸς"},{"text":"ὁ"},{"text":"κύριος"}],"notes":[],"lang":"grc"},{"n":4,"text":"Πρὸς ὃν προσερχόμενοι, λίθον ζῶντα, ὑπὸ ἀνθρώπων μὲν ἀποδεδοκιμασμένον παρὰ δὲ θεῷ ἐκλεκτὸν ἔντιμον","tokens":[{"text":"Πρὸς"},{"text":"ὃν"},{"text":"προσερχόμενοι"},{"text":"λίθον"},{"text":"ζῶντα"},{"text":"ὑπὸ"},{"text":"ἀνθρώπων"},{"text":"μὲν"},{"text":"ἀποδεδοκιμασμένον"},{"text":"παρὰ"},{"text":"δὲ"},{"text":"θεῷ"},{"text":"ἐκλεκτὸν"},{"text":"ἔντιμον"}],"notes":[],"lang":"grc"},{"n":5,"text":"καὶ αὐτοὶ ὡς λίθοι ζῶντες οἰκοδομεῖσθε οἶκος πνευματικὸς ⸀ εἰς ἱεράτευμα ἅγιον, ἀνενέγκαι πνευματικὰς θυσίας ⸀ εὐπροσδέκτους θεῷ διὰ Ἰησοῦ Χριστοῦ·","tokens":[{"text":"καὶ"},{"text":"αὐτοὶ"},{"text":"ὡς"},{"text":"λίθοι"},{"text":"ζῶντες"},{"text":"οἰκοδομεῖσθε"},{"text":"οἶκος"},{"text":"πνευματικὸς"},{"text":"εἰς"},{"text":"ἱεράτευμα"},{"text":"ἅγιον"},{"text":"ἀνενέγκαι"},{"text":"πνευματικὰς"},{"text":"θυσίας"},{"text":"εὐπροσδέκτους"},{"text":"θεῷ"},{"text":"διὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":6,"text":"διότι περιέχει ⸀ ἐν γραφῇ· Ἰδοὺ τίθημι ἐν Σιὼν λίθον ⸂ ἀκρογωνιαῖον ἐκλεκτὸν⸃ ἔντιμον, καὶ ὁ πιστεύων ἐπʼ αὐτῷ οὐ μὴ καταισχυνθῇ.","tokens":[{"text":"διότι"},{"text":"περιέχει"},{"text":"ἐν"},{"text":"γραφῇ"},{"text":"Ἰδοὺ"},{"text":"τίθημι"},{"text":"ἐν"},{"text":"Σιὼν"},{"text":"λίθον"},{"text":"ἀκρογωνιαῖον"},{"text":"ἐκλεκτὸν"},{"text":"ἔντιμον"},{"text":"καὶ"},{"text":"ὁ"},{"text":"πιστεύων"},{"text":"ἐπʼ"},{"text":"αὐτῷ"},{"text":"οὐ"},{"text":"μὴ"},{"text":"καταισχυνθῇ"}],"notes":[],"lang":"grc"},{"n":7,"text":"ὑμῖν οὖν ἡ τιμὴ τοῖς πιστεύουσιν·  ⸀ ἀπιστοῦσιν δὲ ⸀ λίθος ὃν ἀπεδοκίμασαν οἱ οἰκοδομοῦντες οὗτος ἐγενήθη εἰς κεφαλὴν γωνίας","tokens":[{"text":"ὑμῖν"},{"text":"οὖν"},{"text":"ἡ"},{"text":"τιμὴ"},{"text":"τοῖς"},{"text":"πιστεύουσιν"},{"text":"ἀπιστοῦσιν"},{"text":"δὲ"},{"text":"λίθος"},{"text":"ὃν"},{"text":"ἀπεδοκίμασαν"},{"text":"οἱ"},{"text":"οἰκοδομοῦντες"},{"text":"οὗτος"},{"text":"ἐγενήθη"},{"text":"εἰς"},{"text":"κεφαλὴν"},{"text":"γωνίας"}],"notes":[],"lang":"grc"},{"n":8,"text":"καὶ λίθος προσκόμματος καὶ πέτρα σκανδάλου· οἳ προσκόπτουσιν τῷ λόγῳ ἀπειθοῦντες· εἰς ὃ καὶ ἐτέθησαν.","tokens":[{"text":"καὶ"},{"text":"λίθος"},{"text":"προσκόμματος"},{"text":"καὶ"},{"text":"πέτρα"},{"text":"σκανδάλου"},{"text":"οἳ"},{"text":"προσκόπτουσιν"},{"text":"τῷ"},{"text":"λόγῳ"},{"text":"ἀπειθοῦντες"},{"text":"εἰς"},{"text":"ὃ"},{"text":"καὶ"},{"text":"ἐτέθησαν"}],"notes":[],"lang":"grc"},{"n":9,"text":"Ὑμεῖς δὲ γένος ἐκλεκτόν, βασίλειον ἱεράτευμα, ἔθνος ἅγιον, λαὸς εἰς περιποίησιν, ὅπως τὰς ἀρετὰς ἐξαγγείλητε τοῦ ἐκ σκότους ὑμᾶς καλέσαντος εἰς τὸ θαυμαστὸν αὐτοῦ φῶς·","tokens":[{"text":"Ὑμεῖς"},{"text":"δὲ"},{"text":"γένος"},{"text":"ἐκλεκτόν"},{"text":"βασίλειον"},{"text":"ἱεράτευμα"},{"text":"ἔθνος"},{"text":"ἅγιον"},{"text":"λαὸς"},{"text":"εἰς"},{"text":"περιποίησιν"},{"text":"ὅπως"},{"text":"τὰς"},{"text":"ἀρετὰς"},{"text":"ἐξαγγείλητε"},{"text":"τοῦ"},{"text":"ἐκ"},{"text":"σκότους"},{"text":"ὑμᾶς"},{"text":"καλέσαντος"},{"text":"εἰς"},{"text":"τὸ"},{"text":"θαυμαστὸν"},{"text":"αὐτοῦ"},{"text":"φῶς"}],"notes":[],"lang":"grc"},{"n":10,"text":"οἵ ποτε οὐ λαὸς νῦν δὲ λαὸς θεοῦ, οἱ οὐκ ἠλεημένοι νῦν δὲ ἐλεηθέντες.","tokens":[{"text":"οἵ"},{"text":"ποτε"},{"text":"οὐ"},{"text":"λαὸς"},{"text":"νῦν"},{"text":"δὲ"},{"text":"λαὸς"},{"text":"θεοῦ"},{"text":"οἱ"},{"text":"οὐκ"},{"text":"ἠλεημένοι"},{"text":"νῦν"},{"text":"δὲ"},{"text":"ἐλεηθέντες"}],"notes":[],"lang":"grc"},{"n":11,"text":"Ἀγαπητοί, παρακαλῶ ὡς παροίκους καὶ παρεπιδήμους ἀπέχεσθαι τῶν σαρκικῶν ἐπιθυμιῶν, αἵτινες στρατεύονται κατὰ τῆς ψυχῆς·","tokens":[{"text":"Ἀγαπητοί"},{"text":"παρακαλῶ"},{"text":"ὡς"},{"text":"παροίκους"},{"text":"καὶ"},{"text":"παρεπιδήμους"},{"text":"ἀπέχεσθαι"},{"text":"τῶν"},{"text":"σαρκικῶν"},{"text":"ἐπιθυμιῶν"},{"text":"αἵτινες"},{"text":"στρατεύονται"},{"text":"κατὰ"},{"text":"τῆς"},{"text":"ψυχῆς"}],"notes":[],"lang":"grc"},{"n":12,"text":"τὴν ἀναστροφὴν ὑμῶν ⸂ ἐν τοῖς ἔθνεσιν ἔχοντες καλήν⸃, ἵνα, ἐν ᾧ καταλαλοῦσιν ὑμῶν ὡς κακοποιῶν, ἐκ τῶν καλῶν ἔργων ⸀ ἐποπτεύοντες δοξάσωσι τὸν θεὸν ἐν ἡμέρᾳ ἐπισκοπῆς.","tokens":[{"text":"τὴν"},{"text":"ἀναστροφὴν"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"ἔθνεσιν"},{"text":"ἔχοντες"},{"text":"καλήν"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"ᾧ"},{"text":"καταλαλοῦσιν"},{"text":"ὑμῶν"},{"text":"ὡς"},{"text":"κακοποιῶν"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"καλῶν"},{"text":"ἔργων"},{"text":"ἐποπτεύοντες"},{"text":"δοξάσωσι"},{"text":"τὸν"},{"text":"θεὸν"},{"text":"ἐν"},{"text":"ἡμέρᾳ"},{"text":"ἐπισκοπῆς"}],"notes":[],"lang":"grc"},{"n":13,"text":"⸀ Ὑποτάγητε πάσῃ ἀνθρωπίνῃ κτίσει διὰ τὸν κύριον· εἴτε βασιλεῖ ὡς ὑπερέχοντι,","tokens":[{"text":"Ὑποτάγητε"},{"text":"πάσῃ"},{"text":"ἀνθρωπίνῃ"},{"text":"κτίσει"},{"text":"διὰ"},{"text":"τὸν"},{"text":"κύριον"},{"text":"εἴτε"},{"text":"βασιλεῖ"},{"text":"ὡς"},{"text":"ὑπερέχοντι"}],"notes":[],"lang":"grc"},{"n":14,"text":"εἴτε ἡγεμόσιν ὡς διʼ αὐτοῦ πεμπομένοις εἰς ἐκδίκησιν κακοποιῶν ἔπαινον δὲ ἀγαθοποιῶν","tokens":[{"text":"εἴτε"},{"text":"ἡγεμόσιν"},{"text":"ὡς"},{"text":"διʼ"},{"text":"αὐτοῦ"},{"text":"πεμπομένοις"},{"text":"εἰς"},{"text":"ἐκδίκησιν"},{"text":"κακοποιῶν"},{"text":"ἔπαινον"},{"text":"δὲ"},{"text":"ἀγαθοποιῶν"}],"notes":[],"lang":"grc"},{"n":15,"text":"( ὅτι οὕτως ἐστὶν τὸ θέλημα τοῦ θεοῦ, ἀγαθοποιοῦντας φιμοῦν τὴν τῶν ἀφρόνων ἀνθρώπων ἀγνωσίαν)·","tokens":[{"text":"ὅτι"},{"text":"οὕτως"},{"text":"ἐστὶν"},{"text":"τὸ"},{"text":"θέλημα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἀγαθοποιοῦντας"},{"text":"φιμοῦν"},{"text":"τὴν"},{"text":"τῶν"},{"text":"ἀφρόνων"},{"text":"ἀνθρώπων"},{"text":"ἀγνωσίαν"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὡς ἐλεύθεροι, καὶ μὴ ὡς ἐπικάλυμμα ἔχοντες τῆς κακίας τὴν ἐλευθερίαν, ἀλλʼ ὡς ⸂ θεοῦ δοῦλοι⸃.","tokens":[{"text":"ὡς"},{"text":"ἐλεύθεροι"},{"text":"καὶ"},{"text":"μὴ"},{"text":"ὡς"},{"text":"ἐπικάλυμμα"},{"text":"ἔχοντες"},{"text":"τῆς"},{"text":"κακίας"},{"text":"τὴν"},{"text":"ἐλευθερίαν"},{"text":"ἀλλʼ"},{"text":"ὡς"},{"text":"θεοῦ"},{"text":"δοῦλοι"}],"notes":[],"lang":"grc"},{"n":17,"text":"πάντας τιμήσατε, τὴν ἀδελφότητα ⸀ ἀγαπᾶτε, τὸν θεὸν φοβεῖσθε, τὸν βασιλέα τιμᾶτε.","tokens":[{"text":"πάντας"},{"text":"τιμήσατε"},{"text":"τὴν"},{"text":"ἀδελφότητα"},{"text":"ἀγαπᾶτε"},{"text":"τὸν"},{"text":"θεὸν"},{"text":"φοβεῖσθε"},{"text":"τὸν"},{"text":"βασιλέα"},{"text":"τιμᾶτε"}],"notes":[],"lang":"grc"},{"n":18,"text":"Οἱ οἰκέται ὑποτασσόμενοι ἐν παντὶ φόβῳ τοῖς δεσπόταις, οὐ μόνον τοῖς ἀγαθοῖς καὶ ἐπιεικέσιν ἀλλὰ καὶ τοῖς σκολιοῖς.","tokens":[{"text":"Οἱ"},{"text":"οἰκέται"},{"text":"ὑποτασσόμενοι"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"φόβῳ"},{"text":"τοῖς"},{"text":"δεσπόταις"},{"text":"οὐ"},{"text":"μόνον"},{"text":"τοῖς"},{"text":"ἀγαθοῖς"},{"text":"καὶ"},{"text":"ἐπιεικέσιν"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"τοῖς"},{"text":"σκολιοῖς"}],"notes":[],"lang":"grc"},{"n":19,"text":"τοῦτο γὰρ χάρις εἰ διὰ συνείδησιν θεοῦ ὑποφέρει τις λύπας πάσχων ἀδίκως·","tokens":[{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"χάρις"},{"text":"εἰ"},{"text":"διὰ"},{"text":"συνείδησιν"},{"text":"θεοῦ"},{"text":"ὑποφέρει"},{"text":"τις"},{"text":"λύπας"},{"text":"πάσχων"},{"text":"ἀδίκως"}],"notes":[],"lang":"grc"},{"n":20,"text":"ποῖον γὰρ κλέος εἰ ἁμαρτάνοντες καὶ κολαφιζόμενοι ὑπομενεῖτε; ἀλλʼ εἰ ἀγαθοποιοῦντες καὶ πάσχοντες ὑπομενεῖτε, τοῦτο χάρις παρὰ θεῷ.","tokens":[{"text":"ποῖον"},{"text":"γὰρ"},{"text":"κλέος"},{"text":"εἰ"},{"text":"ἁμαρτάνοντες"},{"text":"καὶ"},{"text":"κολαφιζόμενοι"},{"text":"ὑπομενεῖτε"},{"text":"ἀλλʼ"},{"text":"εἰ"},{"text":"ἀγαθοποιοῦντες"},{"text":"καὶ"},{"text":"πάσχοντες"},{"text":"ὑπομενεῖτε"},{"text":"τοῦτο"},{"text":"χάρις"},{"text":"παρὰ"},{"text":"θεῷ"}],"notes":[],"lang":"grc"},{"n":21,"text":"εἰς τοῦτο γὰρ ἐκλήθητε, ὅτι καὶ Χριστὸς ἔπαθεν ὑπὲρ ⸀ ὑμῶν, ὑμῖν ὑπολιμπάνων ὑπογραμμὸν ἵνα ἐπακολουθήσητε τοῖς ἴχνεσιν αὐτοῦ·","tokens":[{"text":"εἰς"},{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"ἐκλήθητε"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"Χριστὸς"},{"text":"ἔπαθεν"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"ὑμῖν"},{"text":"ὑπολιμπάνων"},{"text":"ὑπογραμμὸν"},{"text":"ἵνα"},{"text":"ἐπακολουθήσητε"},{"text":"τοῖς"},{"text":"ἴχνεσιν"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":22,"text":"ὃς ἁμαρτίαν οὐκ ἐποίησεν οὐδὲ εὑρέθη δόλος ἐν τῷ στόματι αὐτοῦ·","tokens":[{"text":"ὃς"},{"text":"ἁμαρτίαν"},{"text":"οὐκ"},{"text":"ἐποίησεν"},{"text":"οὐδὲ"},{"text":"εὑρέθη"},{"text":"δόλος"},{"text":"ἐν"},{"text":"τῷ"},{"text":"στόματι"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":23,"text":"ὃς λοιδορούμενος οὐκ ἀντελοιδόρει, πάσχων οὐκ ἠπείλει, παρεδίδου δὲ τῷ κρίνοντι δικαίως·","tokens":[{"text":"ὃς"},{"text":"λοιδορούμενος"},{"text":"οὐκ"},{"text":"ἀντελοιδόρει"},{"text":"πάσχων"},{"text":"οὐκ"},{"text":"ἠπείλει"},{"text":"παρεδίδου"},{"text":"δὲ"},{"text":"τῷ"},{"text":"κρίνοντι"},{"text":"δικαίως"}],"notes":[],"lang":"grc"},{"n":24,"text":"ὃς τὰς ἁμαρτίας ἡμῶν αὐτὸς ἀνήνεγκεν ἐν τῷ σώματι αὐτοῦ ἐπὶ τὸ ξύλον, ἵνα ταῖς ἁμαρτίαις ἀπογενόμενοι τῇ δικαιοσύνῃ ζήσωμεν· οὗ τῷ ⸀ μώλωπι ἰάθητε.","tokens":[{"text":"ὃς"},{"text":"τὰς"},{"text":"ἁμαρτίας"},{"text":"ἡμῶν"},{"text":"αὐτὸς"},{"text":"ἀνήνεγκεν"},{"text":"ἐν"},{"text":"τῷ"},{"text":"σώματι"},{"text":"αὐτοῦ"},{"text":"ἐπὶ"},{"text":"τὸ"},{"text":"ξύλον"},{"text":"ἵνα"},{"text":"ταῖς"},{"text":"ἁμαρτίαις"},{"text":"ἀπογενόμενοι"},{"text":"τῇ"},{"text":"δικαιοσύνῃ"},{"text":"ζήσωμεν"},{"text":"οὗ"},{"text":"τῷ"},{"text":"μώλωπι"},{"text":"ἰάθητε"}],"notes":[],"lang":"grc"},{"n":25,"text":"ἦτε γὰρ ὡς πρόβατα ⸀ πλανώμενοι, ἀλλὰ ἐπεστράφητε νῦν ἐπὶ τὸν ποιμένα καὶ ἐπίσκοπον τῶν ψυχῶν ὑμῶν.","tokens":[{"text":"ἦτε"},{"text":"γὰρ"},{"text":"ὡς"},{"text":"πρόβατα"},{"text":"πλανώμενοι"},{"text":"ἀλλὰ"},{"text":"ἐπεστράφητε"},{"text":"νῦν"},{"text":"ἐπὶ"},{"text":"τὸν"},{"text":"ποιμένα"},{"text":"καὶ"},{"text":"ἐπίσκοπον"},{"text":"τῶν"},{"text":"ψυχῶν"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"⸀ Ὁμοίως γυναῖκες ὑποτασσόμεναι τοῖς ἰδίοις ἀνδράσιν, ἵνα ⸀ καὶ εἴ τινες ἀπειθοῦσιν τῷ λόγῳ διὰ τῆς τῶν γυναικῶν ἀναστροφῆς ἄνευ λόγου κερδηθήσονται","tokens":[{"text":"Ὁμοίως"},{"text":"γυναῖκες"},{"text":"ὑποτασσόμεναι"},{"text":"τοῖς"},{"text":"ἰδίοις"},{"text":"ἀνδράσιν"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"εἴ"},{"text":"τινες"},{"text":"ἀπειθοῦσιν"},{"text":"τῷ"},{"text":"λόγῳ"},{"text":"διὰ"},{"text":"τῆς"},{"text":"τῶν"},{"text":"γυναικῶν"},{"text":"ἀναστροφῆς"},{"text":"ἄνευ"},{"text":"λόγου"},{"text":"κερδηθήσονται"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἐποπτεύσαντες τὴν ἐν φόβῳ ἁγνὴν ἀναστροφὴν ὑμῶν.","tokens":[{"text":"ἐποπτεύσαντες"},{"text":"τὴν"},{"text":"ἐν"},{"text":"φόβῳ"},{"text":"ἁγνὴν"},{"text":"ἀναστροφὴν"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":3,"text":"ὧν ἔστω οὐχ ὁ ἔξωθεν ἐμπλοκῆς τριχῶν καὶ περιθέσεως χρυσίων ἢ ἐνδύσεως ἱματίων κόσμος,","tokens":[{"text":"ὧν"},{"text":"ἔστω"},{"text":"οὐχ"},{"text":"ὁ"},{"text":"ἔξωθεν"},{"text":"ἐμπλοκῆς"},{"text":"τριχῶν"},{"text":"καὶ"},{"text":"περιθέσεως"},{"text":"χρυσίων"},{"text":"ἢ"},{"text":"ἐνδύσεως"},{"text":"ἱματίων"},{"text":"κόσμος"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἀλλʼ ὁ κρυπτὸς τῆς καρδίας ἄνθρωπος ἐν τῷ ἀφθάρτῳ τοῦ ⸂ πραέως καὶ ἡσυχίου⸃ πνεύματος, ὅ ἐστιν ἐνώπιον τοῦ θεοῦ πολυτελές.","tokens":[{"text":"ἀλλʼ"},{"text":"ὁ"},{"text":"κρυπτὸς"},{"text":"τῆς"},{"text":"καρδίας"},{"text":"ἄνθρωπος"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ἀφθάρτῳ"},{"text":"τοῦ"},{"text":"πραέως"},{"text":"καὶ"},{"text":"ἡσυχίου"},{"text":"πνεύματος"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"πολυτελές"}],"notes":[],"lang":"grc"},{"n":5,"text":"οὕτως γάρ ποτε καὶ αἱ ἅγιαι γυναῖκες αἱ ἐλπίζουσαι ⸀ εἰς θεὸν ἐκόσμουν ἑαυτάς, ὑποτασσόμεναι τοῖς ἰδίοις ἀνδράσιν,","tokens":[{"text":"οὕτως"},{"text":"γάρ"},{"text":"ποτε"},{"text":"καὶ"},{"text":"αἱ"},{"text":"ἅγιαι"},{"text":"γυναῖκες"},{"text":"αἱ"},{"text":"ἐλπίζουσαι"},{"text":"εἰς"},{"text":"θεὸν"},{"text":"ἐκόσμουν"},{"text":"ἑαυτάς"},{"text":"ὑποτασσόμεναι"},{"text":"τοῖς"},{"text":"ἰδίοις"},{"text":"ἀνδράσιν"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὡς Σάρρα ⸀ ὑπήκουσεν τῷ Ἀβραάμ, κύριον αὐτὸν καλοῦσα· ἧς ἐγενήθητε τέκνα ἀγαθοποιοῦσαι καὶ μὴ φοβούμεναι μηδεμίαν πτόησιν.","tokens":[{"text":"ὡς"},{"text":"Σάρρα"},{"text":"ὑπήκουσεν"},{"text":"τῷ"},{"text":"Ἀβραάμ"},{"text":"κύριον"},{"text":"αὐτὸν"},{"text":"καλοῦσα"},{"text":"ἧς"},{"text":"ἐγενήθητε"},{"text":"τέκνα"},{"text":"ἀγαθοποιοῦσαι"},{"text":"καὶ"},{"text":"μὴ"},{"text":"φοβούμεναι"},{"text":"μηδεμίαν"},{"text":"πτόησιν"}],"notes":[],"lang":"grc"},{"n":7,"text":"Οἱ ἄνδρες ὁμοίως συνοικοῦντες κατὰ γνῶσιν, ὡς ἀσθενεστέρῳ σκεύει τῷ γυναικείῳ ἀπονέμοντες τιμήν, ὡς καὶ ⸀ συγκληρονόμοις χάριτος ζωῆς, εἰς τὸ μὴ ἐγκόπτεσθαι τὰς προσευχὰς ὑμῶν.","tokens":[{"text":"Οἱ"},{"text":"ἄνδρες"},{"text":"ὁμοίως"},{"text":"συνοικοῦντες"},{"text":"κατὰ"},{"text":"γνῶσιν"},{"text":"ὡς"},{"text":"ἀσθενεστέρῳ"},{"text":"σκεύει"},{"text":"τῷ"},{"text":"γυναικείῳ"},{"text":"ἀπονέμοντες"},{"text":"τιμήν"},{"text":"ὡς"},{"text":"καὶ"},{"text":"συγκληρονόμοις"},{"text":"χάριτος"},{"text":"ζωῆς"},{"text":"εἰς"},{"text":"τὸ"},{"text":"μὴ"},{"text":"ἐγκόπτεσθαι"},{"text":"τὰς"},{"text":"προσευχὰς"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":8,"text":"Τὸ δὲ τέλος πάντες ὁμόφρονες, συμπαθεῖς, φιλάδελφοι, εὔσπλαγχνοι,  ⸀ ταπεινόφρονες,","tokens":[{"text":"Τὸ"},{"text":"δὲ"},{"text":"τέλος"},{"text":"πάντες"},{"text":"ὁμόφρονες"},{"text":"συμπαθεῖς"},{"text":"φιλάδελφοι"},{"text":"εὔσπλαγχνοι"},{"text":"ταπεινόφρονες"}],"notes":[],"lang":"grc"},{"n":9,"text":"μὴ ἀποδιδόντες κακὸν ἀντὶ κακοῦ ἢ λοιδορίαν ἀντὶ λοιδορίας τοὐναντίον δὲ ⸀ εὐλογοῦντες, ὅτι εἰς τοῦτο ἐκλήθητε ἵνα εὐλογίαν κληρονομήσητε.","tokens":[{"text":"μὴ"},{"text":"ἀποδιδόντες"},{"text":"κακὸν"},{"text":"ἀντὶ"},{"text":"κακοῦ"},{"text":"ἢ"},{"text":"λοιδορίαν"},{"text":"ἀντὶ"},{"text":"λοιδορίας"},{"text":"τοὐναντίον"},{"text":"δὲ"},{"text":"εὐλογοῦντες"},{"text":"ὅτι"},{"text":"εἰς"},{"text":"τοῦτο"},{"text":"ἐκλήθητε"},{"text":"ἵνα"},{"text":"εὐλογίαν"},{"text":"κληρονομήσητε"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὁ γὰρ θέλων ζωὴν ἀγαπᾶν καὶ ἰδεῖν ἡμέρας ἀγαθὰς παυσάτω τὴν ⸀ γλῶσσαν ἀπὸ κακοῦ καὶ ⸀ χείλη τοῦ μὴ λαλῆσαι δόλον,","tokens":[{"text":"ὁ"},{"text":"γὰρ"},{"text":"θέλων"},{"text":"ζωὴν"},{"text":"ἀγαπᾶν"},{"text":"καὶ"},{"text":"ἰδεῖν"},{"text":"ἡμέρας"},{"text":"ἀγαθὰς"},{"text":"παυσάτω"},{"text":"τὴν"},{"text":"γλῶσσαν"},{"text":"ἀπὸ"},{"text":"κακοῦ"},{"text":"καὶ"},{"text":"χείλη"},{"text":"τοῦ"},{"text":"μὴ"},{"text":"λαλῆσαι"},{"text":"δόλον"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἐκκλινάτω ⸀ δὲ ἀπὸ κακοῦ καὶ ποιησάτω ἀγαθόν, ζητησάτω εἰρήνην καὶ διωξάτω αὐτήν·","tokens":[{"text":"ἐκκλινάτω"},{"text":"δὲ"},{"text":"ἀπὸ"},{"text":"κακοῦ"},{"text":"καὶ"},{"text":"ποιησάτω"},{"text":"ἀγαθόν"},{"text":"ζητησάτω"},{"text":"εἰρήνην"},{"text":"καὶ"},{"text":"διωξάτω"},{"text":"αὐτήν"}],"notes":[],"lang":"grc"},{"n":12,"text":"ὅτι ὀφθαλμοὶ κυρίου ἐπὶ δικαίους καὶ ὦτα αὐτοῦ εἰς δέησιν αὐτῶν, πρόσωπον δὲ κυρίου ἐπὶ ποιοῦντας κακά.","tokens":[{"text":"ὅτι"},{"text":"ὀφθαλμοὶ"},{"text":"κυρίου"},{"text":"ἐπὶ"},{"text":"δικαίους"},{"text":"καὶ"},{"text":"ὦτα"},{"text":"αὐτοῦ"},{"text":"εἰς"},{"text":"δέησιν"},{"text":"αὐτῶν"},{"text":"πρόσωπον"},{"text":"δὲ"},{"text":"κυρίου"},{"text":"ἐπὶ"},{"text":"ποιοῦντας"},{"text":"κακά"}],"notes":[],"lang":"grc"},{"n":13,"text":"Καὶ τίς ὁ κακώσων ὑμᾶς ἐὰν τοῦ ἀγαθοῦ ⸀ ζηλωταὶ γένησθε;","tokens":[{"text":"Καὶ"},{"text":"τίς"},{"text":"ὁ"},{"text":"κακώσων"},{"text":"ὑμᾶς"},{"text":"ἐὰν"},{"text":"τοῦ"},{"text":"ἀγαθοῦ"},{"text":"ζηλωταὶ"},{"text":"γένησθε"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἀλλʼ εἰ καὶ πάσχοιτε διὰ δικαιοσύνην, μακάριοι. τὸν δὲ φόβον αὐτῶν μὴ φοβηθῆτε μηδὲ ταραχθῆτε,","tokens":[{"text":"ἀλλʼ"},{"text":"εἰ"},{"text":"καὶ"},{"text":"πάσχοιτε"},{"text":"διὰ"},{"text":"δικαιοσύνην"},{"text":"μακάριοι"},{"text":"τὸν"},{"text":"δὲ"},{"text":"φόβον"},{"text":"αὐτῶν"},{"text":"μὴ"},{"text":"φοβηθῆτε"},{"text":"μηδὲ"},{"text":"ταραχθῆτε"}],"notes":[],"lang":"grc"},{"n":15,"text":"κύριον δὲ τὸν ⸀ Χριστὸν ἁγιάσατε ἐν ταῖς καρδίαις ὑμῶν,  ⸀ ἕτοιμοι ἀεὶ πρὸς ἀπολογίαν παντὶ τῷ αἰτοῦντι ὑμᾶς λόγον περὶ τῆς ἐν ὑμῖν ἐλπίδος,","tokens":[{"text":"κύριον"},{"text":"δὲ"},{"text":"τὸν"},{"text":"Χριστὸν"},{"text":"ἁγιάσατε"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"καρδίαις"},{"text":"ὑμῶν"},{"text":"ἕτοιμοι"},{"text":"ἀεὶ"},{"text":"πρὸς"},{"text":"ἀπολογίαν"},{"text":"παντὶ"},{"text":"τῷ"},{"text":"αἰτοῦντι"},{"text":"ὑμᾶς"},{"text":"λόγον"},{"text":"περὶ"},{"text":"τῆς"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἐλπίδος"}],"notes":[],"lang":"grc"},{"n":16,"text":"⸀ ἀλλὰ μετὰ πραΰτητος καὶ φόβου, συνείδησιν ἔχοντες ἀγαθήν, ἵνα ἐν ᾧ ⸀ καταλαλεῖσθε καταισχυνθῶσιν οἱ ἐπηρεάζοντες ὑμῶν τὴν ἀγαθὴν ἐν Χριστῷ ἀναστροφήν.","tokens":[{"text":"ἀλλὰ"},{"text":"μετὰ"},{"text":"πραΰτητος"},{"text":"καὶ"},{"text":"φόβου"},{"text":"συνείδησιν"},{"text":"ἔχοντες"},{"text":"ἀγαθήν"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"ᾧ"},{"text":"καταλαλεῖσθε"},{"text":"καταισχυνθῶσιν"},{"text":"οἱ"},{"text":"ἐπηρεάζοντες"},{"text":"ὑμῶν"},{"text":"τὴν"},{"text":"ἀγαθὴν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"ἀναστροφήν"}],"notes":[],"lang":"grc"},{"n":17,"text":"κρεῖττον γὰρ ἀγαθοποιοῦντας, εἰ θέλοι τὸ θέλημα τοῦ θεοῦ, πάσχειν ἢ κακοποιοῦντας.","tokens":[{"text":"κρεῖττον"},{"text":"γὰρ"},{"text":"ἀγαθοποιοῦντας"},{"text":"εἰ"},{"text":"θέλοι"},{"text":"τὸ"},{"text":"θέλημα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"πάσχειν"},{"text":"ἢ"},{"text":"κακοποιοῦντας"}],"notes":[],"lang":"grc"},{"n":18,"text":"ὅτι καὶ Χριστὸς ἅπαξ περὶ ἁμαρτιῶν ⸀ ἔπαθεν, δίκαιος ὑπὲρ ἀδίκων, ἵνα ⸀ ὑμᾶς προσαγάγῃ τῷ θεῷ, θανατωθεὶς μὲν σαρκὶ ζῳοποιηθεὶς δὲ πνεύματι·","tokens":[{"text":"ὅτι"},{"text":"καὶ"},{"text":"Χριστὸς"},{"text":"ἅπαξ"},{"text":"περὶ"},{"text":"ἁμαρτιῶν"},{"text":"ἔπαθεν"},{"text":"δίκαιος"},{"text":"ὑπὲρ"},{"text":"ἀδίκων"},{"text":"ἵνα"},{"text":"ὑμᾶς"},{"text":"προσαγάγῃ"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"θανατωθεὶς"},{"text":"μὲν"},{"text":"σαρκὶ"},{"text":"ζῳοποιηθεὶς"},{"text":"δὲ"},{"text":"πνεύματι"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἐν ᾧ καὶ τοῖς ἐν φυλακῇ πνεύμασιν πορευθεὶς ἐκήρυξεν,","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"καὶ"},{"text":"τοῖς"},{"text":"ἐν"},{"text":"φυλακῇ"},{"text":"πνεύμασιν"},{"text":"πορευθεὶς"},{"text":"ἐκήρυξεν"}],"notes":[],"lang":"grc"},{"n":20,"text":"ἀπειθήσασίν ποτε ὅτε ἀπεξεδέχετο ἡ τοῦ θεοῦ μακροθυμία ἐν ἡμέραις Νῶε κατασκευαζομένης κιβωτοῦ εἰς ἣν ⸀ ὀλίγοι, τοῦτʼ ἔστιν ὀκτὼ ψυχαί, διεσώθησαν διʼ ὕδατος.","tokens":[{"text":"ἀπειθήσασίν"},{"text":"ποτε"},{"text":"ὅτε"},{"text":"ἀπεξεδέχετο"},{"text":"ἡ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"μακροθυμία"},{"text":"ἐν"},{"text":"ἡμέραις"},{"text":"Νῶε"},{"text":"κατασκευαζομένης"},{"text":"κιβωτοῦ"},{"text":"εἰς"},{"text":"ἣν"},{"text":"ὀλίγοι"},{"text":"τοῦτʼ"},{"text":"ἔστιν"},{"text":"ὀκτὼ"},{"text":"ψυχαί"},{"text":"διεσώθησαν"},{"text":"διʼ"},{"text":"ὕδατος"}],"notes":[],"lang":"grc"},{"n":21,"text":"ὃ ⸂ καὶ ὑμᾶς ἀντίτυπον νῦν⸃ σῴζει βάπτισμα, οὐ σαρκὸς ἀπόθεσις ῥύπου ἀλλὰ συνειδήσεως ἀγαθῆς ἐπερώτημα εἰς θεόν, διʼ ἀναστάσεως Ἰησοῦ Χριστοῦ,","tokens":[{"text":"ὃ"},{"text":"καὶ"},{"text":"ὑμᾶς"},{"text":"ἀντίτυπον"},{"text":"νῦν"},{"text":"σῴζει"},{"text":"βάπτισμα"},{"text":"οὐ"},{"text":"σαρκὸς"},{"text":"ἀπόθεσις"},{"text":"ῥύπου"},{"text":"ἀλλὰ"},{"text":"συνειδήσεως"},{"text":"ἀγαθῆς"},{"text":"ἐπερώτημα"},{"text":"εἰς"},{"text":"θεόν"},{"text":"διʼ"},{"text":"ἀναστάσεως"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":22,"text":"ὅς ἐστιν ἐν ⸀ δεξιᾷ θεοῦ πορευθεὶς εἰς οὐρανὸν ὑποταγέντων αὐτῷ ἀγγέλων καὶ ἐξουσιῶν καὶ δυνάμεων.","tokens":[{"text":"ὅς"},{"text":"ἐστιν"},{"text":"ἐν"},{"text":"δεξιᾷ"},{"text":"θεοῦ"},{"text":"πορευθεὶς"},{"text":"εἰς"},{"text":"οὐρανὸν"},{"text":"ὑποταγέντων"},{"text":"αὐτῷ"},{"text":"ἀγγέλων"},{"text":"καὶ"},{"text":"ἐξουσιῶν"},{"text":"καὶ"},{"text":"δυνάμεων"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"Χριστοῦ οὖν ⸀ παθόντος σαρκὶ καὶ ὑμεῖς τὴν αὐτὴν ἔννοιαν ὁπλίσασθε, ὅτι ὁ ⸀ παθὼν σαρκὶ πέπαυται ⸀ ἁμαρτίας,","tokens":[{"text":"Χριστοῦ"},{"text":"οὖν"},{"text":"παθόντος"},{"text":"σαρκὶ"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"τὴν"},{"text":"αὐτὴν"},{"text":"ἔννοιαν"},{"text":"ὁπλίσασθε"},{"text":"ὅτι"},{"text":"ὁ"},{"text":"παθὼν"},{"text":"σαρκὶ"},{"text":"πέπαυται"},{"text":"ἁμαρτίας"}],"notes":[],"lang":"grc"},{"n":2,"text":"εἰς τὸ μηκέτι ἀνθρώπων ἐπιθυμίαις ἀλλὰ θελήματι θεοῦ τὸν ἐπίλοιπον ἐν σαρκὶ βιῶσαι χρόνον.","tokens":[{"text":"εἰς"},{"text":"τὸ"},{"text":"μηκέτι"},{"text":"ἀνθρώπων"},{"text":"ἐπιθυμίαις"},{"text":"ἀλλὰ"},{"text":"θελήματι"},{"text":"θεοῦ"},{"text":"τὸν"},{"text":"ἐπίλοιπον"},{"text":"ἐν"},{"text":"σαρκὶ"},{"text":"βιῶσαι"},{"text":"χρόνον"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἀρκετὸς ⸀ γὰρ ὁ παρεληλυθὼς ⸀ χρόνος τὸ ⸀ βούλημα τῶν ἐθνῶν ⸀ κατειργάσθαι, πεπορευμένους ἐν ἀσελγείαις, ἐπιθυμίαις, οἰνοφλυγίαις, κώμοις, πότοις, καὶ ἀθεμίτοις εἰδωλολατρίαις.","tokens":[{"text":"ἀρκετὸς"},{"text":"γὰρ"},{"text":"ὁ"},{"text":"παρεληλυθὼς"},{"text":"χρόνος"},{"text":"τὸ"},{"text":"βούλημα"},{"text":"τῶν"},{"text":"ἐθνῶν"},{"text":"κατειργάσθαι"},{"text":"πεπορευμένους"},{"text":"ἐν"},{"text":"ἀσελγείαις"},{"text":"ἐπιθυμίαις"},{"text":"οἰνοφλυγίαις"},{"text":"κώμοις"},{"text":"πότοις"},{"text":"καὶ"},{"text":"ἀθεμίτοις"},{"text":"εἰδωλολατρίαις"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἐν ᾧ ξενίζονται μὴ συντρεχόντων ὑμῶν εἰς τὴν αὐτὴν τῆς ἀσωτίας ἀνάχυσιν, βλασφημοῦντες·","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"ξενίζονται"},{"text":"μὴ"},{"text":"συντρεχόντων"},{"text":"ὑμῶν"},{"text":"εἰς"},{"text":"τὴν"},{"text":"αὐτὴν"},{"text":"τῆς"},{"text":"ἀσωτίας"},{"text":"ἀνάχυσιν"},{"text":"βλασφημοῦντες"}],"notes":[],"lang":"grc"},{"n":5,"text":"οἳ ἀποδώσουσιν λόγον τῷ ἑτοίμως ⸂ ἔχοντι κρῖναι⸃ ζῶντας καὶ νεκρούς·","tokens":[{"text":"οἳ"},{"text":"ἀποδώσουσιν"},{"text":"λόγον"},{"text":"τῷ"},{"text":"ἑτοίμως"},{"text":"ἔχοντι"},{"text":"κρῖναι"},{"text":"ζῶντας"},{"text":"καὶ"},{"text":"νεκρούς"}],"notes":[],"lang":"grc"},{"n":6,"text":"εἰς τοῦτο γὰρ καὶ νεκροῖς εὐηγγελίσθη ἵνα κριθῶσι μὲν κατὰ ἀνθρώπους σαρκὶ ζῶσι δὲ κατὰ θεὸν πνεύματι.","tokens":[{"text":"εἰς"},{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"καὶ"},{"text":"νεκροῖς"},{"text":"εὐηγγελίσθη"},{"text":"ἵνα"},{"text":"κριθῶσι"},{"text":"μὲν"},{"text":"κατὰ"},{"text":"ἀνθρώπους"},{"text":"σαρκὶ"},{"text":"ζῶσι"},{"text":"δὲ"},{"text":"κατὰ"},{"text":"θεὸν"},{"text":"πνεύματι"}],"notes":[],"lang":"grc"},{"n":7,"text":"Πάντων δὲ τὸ τέλος ἤγγικεν. σωφρονήσατε οὖν καὶ νήψατε ⸀ εἰς προσευχάς·","tokens":[{"text":"Πάντων"},{"text":"δὲ"},{"text":"τὸ"},{"text":"τέλος"},{"text":"ἤγγικεν"},{"text":"σωφρονήσατε"},{"text":"οὖν"},{"text":"καὶ"},{"text":"νήψατε"},{"text":"εἰς"},{"text":"προσευχάς"}],"notes":[],"lang":"grc"},{"n":8,"text":"πρὸ ⸀ πάντων τὴν εἰς ἑαυτοὺς ἀγάπην ἐκτενῆ ἔχοντες, ὅτι ἀγάπη ⸀ καλύπτει πλῆθος ἁμαρτιῶν·","tokens":[{"text":"πρὸ"},{"text":"πάντων"},{"text":"τὴν"},{"text":"εἰς"},{"text":"ἑαυτοὺς"},{"text":"ἀγάπην"},{"text":"ἐκτενῆ"},{"text":"ἔχοντες"},{"text":"ὅτι"},{"text":"ἀγάπη"},{"text":"καλύπτει"},{"text":"πλῆθος"},{"text":"ἁμαρτιῶν"}],"notes":[],"lang":"grc"},{"n":9,"text":"φιλόξενοι εἰς ἀλλήλους ἄνευ ⸀ γογγυσμοῦ·","tokens":[{"text":"φιλόξενοι"},{"text":"εἰς"},{"text":"ἀλλήλους"},{"text":"ἄνευ"},{"text":"γογγυσμοῦ"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἕκαστος καθὼς ἔλαβεν χάρισμα, εἰς ἑαυτοὺς αὐτὸ διακονοῦντες ὡς καλοὶ οἰκονόμοι ποικίλης χάριτος θεοῦ·","tokens":[{"text":"ἕκαστος"},{"text":"καθὼς"},{"text":"ἔλαβεν"},{"text":"χάρισμα"},{"text":"εἰς"},{"text":"ἑαυτοὺς"},{"text":"αὐτὸ"},{"text":"διακονοῦντες"},{"text":"ὡς"},{"text":"καλοὶ"},{"text":"οἰκονόμοι"},{"text":"ποικίλης"},{"text":"χάριτος"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":11,"text":"εἴ τις λαλεῖ, ὡς λόγια θεοῦ· εἴ τις διακονεῖ, ὡς ἐξ ἰσχύος ⸀ ἧς χορηγεῖ ὁ θεός· ἵνα ἐν πᾶσιν δοξάζηται ὁ θεὸς διὰ Ἰησοῦ Χριστοῦ, ᾧ ἐστιν ἡ δόξα καὶ τὸ κράτος εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.","tokens":[{"text":"εἴ"},{"text":"τις"},{"text":"λαλεῖ"},{"text":"ὡς"},{"text":"λόγια"},{"text":"θεοῦ"},{"text":"εἴ"},{"text":"τις"},{"text":"διακονεῖ"},{"text":"ὡς"},{"text":"ἐξ"},{"text":"ἰσχύος"},{"text":"ἧς"},{"text":"χορηγεῖ"},{"text":"ὁ"},{"text":"θεός"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"δοξάζηται"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"διὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"ᾧ"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"δόξα"},{"text":"καὶ"},{"text":"τὸ"},{"text":"κράτος"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":12,"text":"Ἀγαπητοί, μὴ ξενίζεσθε τῇ ἐν ὑμῖν πυρώσει πρὸς πειρασμὸν ὑμῖν γινομένῃ ὡς ξένου ὑμῖν συμβαίνοντος,","tokens":[{"text":"Ἀγαπητοί"},{"text":"μὴ"},{"text":"ξενίζεσθε"},{"text":"τῇ"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"πυρώσει"},{"text":"πρὸς"},{"text":"πειρασμὸν"},{"text":"ὑμῖν"},{"text":"γινομένῃ"},{"text":"ὡς"},{"text":"ξένου"},{"text":"ὑμῖν"},{"text":"συμβαίνοντος"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἀλλὰ καθὸ κοινωνεῖτε τοῖς τοῦ Χριστοῦ παθήμασιν χαίρετε, ἵνα καὶ ἐν τῇ ἀποκαλύψει τῆς δόξης αὐτοῦ χαρῆτε ἀγαλλιώμενοι.","tokens":[{"text":"ἀλλὰ"},{"text":"καθὸ"},{"text":"κοινωνεῖτε"},{"text":"τοῖς"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"παθήμασιν"},{"text":"χαίρετε"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀποκαλύψει"},{"text":"τῆς"},{"text":"δόξης"},{"text":"αὐτοῦ"},{"text":"χαρῆτε"},{"text":"ἀγαλλιώμενοι"}],"notes":[],"lang":"grc"},{"n":14,"text":"εἰ ὀνειδίζεσθε ἐν ὀνόματι Χριστοῦ, μακάριοι, ὅτι τὸ τῆς δόξης καὶ τὸ τοῦ θεοῦ πνεῦμα ἐφʼ ὑμᾶς ⸀ ἀναπαύεται.","tokens":[{"text":"εἰ"},{"text":"ὀνειδίζεσθε"},{"text":"ἐν"},{"text":"ὀνόματι"},{"text":"Χριστοῦ"},{"text":"μακάριοι"},{"text":"ὅτι"},{"text":"τὸ"},{"text":"τῆς"},{"text":"δόξης"},{"text":"καὶ"},{"text":"τὸ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"πνεῦμα"},{"text":"ἐφʼ"},{"text":"ὑμᾶς"},{"text":"ἀναπαύεται"}],"notes":[],"lang":"grc"},{"n":15,"text":"μὴ γάρ τις ὑμῶν πασχέτω ὡς φονεὺς ἢ κλέπτης ἢ κακοποιὸς ἢ ὡς ἀλλοτριεπίσκοπος·","tokens":[{"text":"μὴ"},{"text":"γάρ"},{"text":"τις"},{"text":"ὑμῶν"},{"text":"πασχέτω"},{"text":"ὡς"},{"text":"φονεὺς"},{"text":"ἢ"},{"text":"κλέπτης"},{"text":"ἢ"},{"text":"κακοποιὸς"},{"text":"ἢ"},{"text":"ὡς"},{"text":"ἀλλοτριεπίσκοπος"}],"notes":[],"lang":"grc"},{"n":16,"text":"εἰ δὲ ὡς Χριστιανός, μὴ αἰσχυνέσθω, δοξαζέτω δὲ τὸν θεὸν ἐν τῷ ⸀ ὀνόματι τούτῳ.","tokens":[{"text":"εἰ"},{"text":"δὲ"},{"text":"ὡς"},{"text":"Χριστιανός"},{"text":"μὴ"},{"text":"αἰσχυνέσθω"},{"text":"δοξαζέτω"},{"text":"δὲ"},{"text":"τὸν"},{"text":"θεὸν"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ὀνόματι"},{"text":"τούτῳ"}],"notes":[],"lang":"grc"},{"n":17,"text":"ὅτι ὁ καιρὸς τοῦ ἄρξασθαι τὸ κρίμα ἀπὸ τοῦ οἴκου τοῦ θεοῦ· εἰ δὲ πρῶτον ἀφʼ ἡμῶν, τί τὸ τέλος τῶν ἀπειθούντων τῷ τοῦ θεοῦ εὐαγγελίῳ;","tokens":[{"text":"ὅτι"},{"text":"ὁ"},{"text":"καιρὸς"},{"text":"τοῦ"},{"text":"ἄρξασθαι"},{"text":"τὸ"},{"text":"κρίμα"},{"text":"ἀπὸ"},{"text":"τοῦ"},{"text":"οἴκου"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"εἰ"},{"text":"δὲ"},{"text":"πρῶτον"},{"text":"ἀφʼ"},{"text":"ἡμῶν"},{"text":"τί"},{"text":"τὸ"},{"text":"τέλος"},{"text":"τῶν"},{"text":"ἀπειθούντων"},{"text":"τῷ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"εὐαγγελίῳ"}],"notes":[],"lang":"grc"},{"n":18,"text":"καὶ εἰ ὁ δίκαιος μόλις σῴζεται,  ⸀ ὁ ἀσεβὴς καὶ ἁμαρτωλὸς ποῦ φανεῖται;","tokens":[{"text":"καὶ"},{"text":"εἰ"},{"text":"ὁ"},{"text":"δίκαιος"},{"text":"μόλις"},{"text":"σῴζεται"},{"text":"ὁ"},{"text":"ἀσεβὴς"},{"text":"καὶ"},{"text":"ἁμαρτωλὸς"},{"text":"ποῦ"},{"text":"φανεῖται"}],"notes":[],"lang":"grc"},{"n":19,"text":"ὥστε καὶ οἱ πάσχοντες κατὰ τὸ θέλημα τοῦ ⸀ θεοῦ πιστῷ κτίστῃ παρατιθέσθωσαν τὰς ψυχὰς ⸀ αὐτῶν ἐν ἀγαθοποιΐᾳ.","tokens":[{"text":"ὥστε"},{"text":"καὶ"},{"text":"οἱ"},{"text":"πάσχοντες"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"θέλημα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"πιστῷ"},{"text":"κτίστῃ"},{"text":"παρατιθέσθωσαν"},{"text":"τὰς"},{"text":"ψυχὰς"},{"text":"αὐτῶν"},{"text":"ἐν"},{"text":"ἀγαθοποιΐᾳ"}],"notes":[],"lang":"grc"}],"5":[{"n":1,"text":"Πρεσβυτέρους ⸀ οὖν ἐν ὑμῖν παρακαλῶ ὁ συμπρεσβύτερος καὶ μάρτυς τῶν τοῦ Χριστοῦ παθημάτων, ὁ καὶ τῆς μελλούσης ἀποκαλύπτεσθαι δόξης κοινωνός,","tokens":[{"text":"Πρεσβυτέρους"},{"text":"οὖν"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"παρακαλῶ"},{"text":"ὁ"},{"text":"συμπρεσβύτερος"},{"text":"καὶ"},{"text":"μάρτυς"},{"text":"τῶν"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"παθημάτων"},{"text":"ὁ"},{"text":"καὶ"},{"text":"τῆς"},{"text":"μελλούσης"},{"text":"ἀποκαλύπτεσθαι"},{"text":"δόξης"},{"text":"κοινωνός"}],"notes":[],"lang":"grc"},{"n":2,"text":"ποιμάνατε τὸ ἐν ὑμῖν ποίμνιον τοῦ θεοῦ,  ⸀ ἐπισκοποῦντες μὴ ἀναγκαστῶς ἀλλὰ ἑκουσίως ⸂ κατὰ θεόν⸃, μηδὲ αἰσχροκερδῶς ἀλλὰ προθύμως,","tokens":[{"text":"ποιμάνατε"},{"text":"τὸ"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ποίμνιον"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐπισκοποῦντες"},{"text":"μὴ"},{"text":"ἀναγκαστῶς"},{"text":"ἀλλὰ"},{"text":"ἑκουσίως"},{"text":"κατὰ"},{"text":"θεόν"},{"text":"μηδὲ"},{"text":"αἰσχροκερδῶς"},{"text":"ἀλλὰ"},{"text":"προθύμως"}],"notes":[],"lang":"grc"},{"n":3,"text":"μηδʼ ὡς κατακυριεύοντες τῶν κλήρων ἀλλὰ τύποι γινόμενοι τοῦ ποιμνίου·","tokens":[{"text":"μηδʼ"},{"text":"ὡς"},{"text":"κατακυριεύοντες"},{"text":"τῶν"},{"text":"κλήρων"},{"text":"ἀλλὰ"},{"text":"τύποι"},{"text":"γινόμενοι"},{"text":"τοῦ"},{"text":"ποιμνίου"}],"notes":[],"lang":"grc"},{"n":4,"text":"καὶ φανερωθέντος τοῦ ἀρχιποίμενος κομιεῖσθε τὸν ἀμαράντινον τῆς δόξης στέφανον.","tokens":[{"text":"καὶ"},{"text":"φανερωθέντος"},{"text":"τοῦ"},{"text":"ἀρχιποίμενος"},{"text":"κομιεῖσθε"},{"text":"τὸν"},{"text":"ἀμαράντινον"},{"text":"τῆς"},{"text":"δόξης"},{"text":"στέφανον"}],"notes":[],"lang":"grc"},{"n":5,"text":"ὁμοίως, νεώτεροι, ὑποτάγητε πρεσβυτέροις. πάντες δὲ ⸀ ἀλλήλοις τὴν ταπεινοφροσύνην ἐγκομβώσασθε, ὅτι Ὁ θεὸς ὑπερηφάνοις ἀντιτάσσεται ταπεινοῖς δὲ δίδωσιν χάριν.","tokens":[{"text":"ὁμοίως"},{"text":"νεώτεροι"},{"text":"ὑποτάγητε"},{"text":"πρεσβυτέροις"},{"text":"πάντες"},{"text":"δὲ"},{"text":"ἀλλήλοις"},{"text":"τὴν"},{"text":"ταπεινοφροσύνην"},{"text":"ἐγκομβώσασθε"},{"text":"ὅτι"},{"text":"Ὁ"},{"text":"θεὸς"},{"text":"ὑπερηφάνοις"},{"text":"ἀντιτάσσεται"},{"text":"ταπεινοῖς"},{"text":"δὲ"},{"text":"δίδωσιν"},{"text":"χάριν"}],"notes":[],"lang":"grc"},{"n":6,"text":"Ταπεινώθητε οὖν ὑπὸ τὴν κραταιὰν χεῖρα τοῦ θεοῦ, ἵνα ὑμᾶς ὑψώσῃ ἐν καιρῷ,","tokens":[{"text":"Ταπεινώθητε"},{"text":"οὖν"},{"text":"ὑπὸ"},{"text":"τὴν"},{"text":"κραταιὰν"},{"text":"χεῖρα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἵνα"},{"text":"ὑμᾶς"},{"text":"ὑψώσῃ"},{"text":"ἐν"},{"text":"καιρῷ"}],"notes":[],"lang":"grc"},{"n":7,"text":"πᾶσαν τὴν μέριμναν ὑμῶν ἐπιρίψαντες ἐπʼ αὐτόν, ὅτι αὐτῷ μέλει περὶ ὑμῶν.","tokens":[{"text":"πᾶσαν"},{"text":"τὴν"},{"text":"μέριμναν"},{"text":"ὑμῶν"},{"text":"ἐπιρίψαντες"},{"text":"ἐπʼ"},{"text":"αὐτόν"},{"text":"ὅτι"},{"text":"αὐτῷ"},{"text":"μέλει"},{"text":"περὶ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":8,"text":"νήψατε, γρηγορήσατε. ὁ ἀντίδικος ὑμῶν διάβολος ὡς λέων ὠρυόμενος περιπατεῖ ζητῶν ⸀ τινα ⸀ καταπιεῖν·","tokens":[{"text":"νήψατε"},{"text":"γρηγορήσατε"},{"text":"ὁ"},{"text":"ἀντίδικος"},{"text":"ὑμῶν"},{"text":"διάβολος"},{"text":"ὡς"},{"text":"λέων"},{"text":"ὠρυόμενος"},{"text":"περιπατεῖ"},{"text":"ζητῶν"},{"text":"τινα"},{"text":"καταπιεῖν"}],"notes":[],"lang":"grc"},{"n":9,"text":"ᾧ ἀντίστητε στερεοὶ τῇ πίστει, εἰδότες τὰ αὐτὰ τῶν παθημάτων τῇ ἐν ⸀ τῷ κόσμῳ ὑμῶν ἀδελφότητι ἐπιτελεῖσθαι.","tokens":[{"text":"ᾧ"},{"text":"ἀντίστητε"},{"text":"στερεοὶ"},{"text":"τῇ"},{"text":"πίστει"},{"text":"εἰδότες"},{"text":"τὰ"},{"text":"αὐτὰ"},{"text":"τῶν"},{"text":"παθημάτων"},{"text":"τῇ"},{"text":"ἐν"},{"text":"τῷ"},{"text":"κόσμῳ"},{"text":"ὑμῶν"},{"text":"ἀδελφότητι"},{"text":"ἐπιτελεῖσθαι"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὁ δὲ θεὸς πάσης χάριτος, ὁ καλέσας ὑμᾶς εἰς τὴν αἰώνιον αὐτοῦ δόξαν ἐν ⸀ Χριστῷ, ὀλίγον παθόντας αὐτὸς ⸀ καταρτίσει, στηρίξει, σθενώσει,  ⸀ θεμελιώσει.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"θεὸς"},{"text":"πάσης"},{"text":"χάριτος"},{"text":"ὁ"},{"text":"καλέσας"},{"text":"ὑμᾶς"},{"text":"εἰς"},{"text":"τὴν"},{"text":"αἰώνιον"},{"text":"αὐτοῦ"},{"text":"δόξαν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"ὀλίγον"},{"text":"παθόντας"},{"text":"αὐτὸς"},{"text":"καταρτίσει"},{"text":"στηρίξει"},{"text":"σθενώσει"},{"text":"θεμελιώσει"}],"notes":[],"lang":"grc"},{"n":11,"text":"⸀ αὐτῷ τὸ κράτος εἰς τοὺς αἰῶνας ⸂ τῶν αἰώνων⸃· ἀμήν.","tokens":[{"text":"αὐτῷ"},{"text":"τὸ"},{"text":"κράτος"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":12,"text":"Διὰ Σιλουανοῦ ὑμῖν τοῦ πιστοῦ ἀδελφοῦ, ὡς λογίζομαι, διʼ ὀλίγων ἔγραψα, παρακαλῶν καὶ ἐπιμαρτυρῶν ταύτην εἶναι ἀληθῆ χάριν τοῦ θεοῦ· εἰς ἣν ⸀ στῆτε.","tokens":[{"text":"Διὰ"},{"text":"Σιλουανοῦ"},{"text":"ὑμῖν"},{"text":"τοῦ"},{"text":"πιστοῦ"},{"text":"ἀδελφοῦ"},{"text":"ὡς"},{"text":"λογίζομαι"},{"text":"διʼ"},{"text":"ὀλίγων"},{"text":"ἔγραψα"},{"text":"παρακαλῶν"},{"text":"καὶ"},{"text":"ἐπιμαρτυρῶν"},{"text":"ταύτην"},{"text":"εἶναι"},{"text":"ἀληθῆ"},{"text":"χάριν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"εἰς"},{"text":"ἣν"},{"text":"στῆτε"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἀσπάζεται ὑμᾶς ἡ ἐν Βαβυλῶνι συνεκλεκτὴ καὶ Μᾶρκος ὁ υἱός μου.","tokens":[{"text":"ἀσπάζεται"},{"text":"ὑμᾶς"},{"text":"ἡ"},{"text":"ἐν"},{"text":"Βαβυλῶνι"},{"text":"συνεκλεκτὴ"},{"text":"καὶ"},{"text":"Μᾶρκος"},{"text":"ὁ"},{"text":"υἱός"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἀσπάσασθε ἀλλήλους ἐν φιλήματι ἀγάπης. εἰρήνη ὑμῖν πᾶσιν τοῖς ἐν ⸀ Χριστῷ.","tokens":[{"text":"ἀσπάσασθε"},{"text":"ἀλλήλους"},{"text":"ἐν"},{"text":"φιλήματι"},{"text":"ἀγάπης"},{"text":"εἰρήνη"},{"text":"ὑμῖν"},{"text":"πᾶσιν"},{"text":"τοῖς"},{"text":"ἐν"},{"text":"Χριστῷ"}],"notes":[],"lang":"grc"}]}}