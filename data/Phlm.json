{"book":{"id":"Phlm","name":"Filemom","testament":"NT","source":"SBLGNT","chapters":1,"verses":25},"chapters":{"1":[{"n":1,"text":"Παῦλος δέσμιος Χριστοῦ Ἰησοῦ καὶ Τιμόθεος ὁ ἀδελφὸς Φιλήμονι τῷ ἀγαπητῷ καὶ συνεργῷ ἡμῶν","tokens":[{"text":"Παῦλος"},{"text":"δέσμιος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"καὶ"},{"text":"Τιμόθεος"},{"text":"ὁ"},{"text":"ἀδελφὸς"},{"text":"Φιλήμονι"},{"text":"τῷ"},{"text":"ἀγαπητῷ"},{"text":"καὶ"},{"text":"συνεργῷ"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":2,"text":"καὶ Ἀπφίᾳ τῇ ⸀ ἀδελφῇ καὶ Ἀρχίππῳ τῷ συστρατιώτῃ ἡμῶν καὶ τῇ κατʼ οἶκόν σου ἐκκλησίᾳ·","tokens":[{"text":"καὶ"},{"text":"Ἀπφίᾳ"},{"text":"τῇ"},{"text":"ἀδελφῇ"},{"text":"καὶ"},{"text":"Ἀρχίππῳ"},{"text":"τῷ"},{"text":"συστρατιώτῃ"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"τῇ"},{"text":"κατʼ"},{"text":"οἶκόν"},{"text":"σου"},{"text":"ἐκκλησίᾳ"}],"notes":[],"lang":"grc"},{"n":3,"text":"χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ.","tokens":[{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":4,"text":"Εὐχαριστῶ τῷ θεῷ μου πάντοτε μνείαν σου ποιούμενος ἐπὶ τῶν προσευχῶν μου,","tokens":[{"text":"Εὐχαριστῶ"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"μου"},{"text":"πάντοτε"},{"text":"μνείαν"},{"text":"σου"},{"text":"ποιούμενος"},{"text":"ἐπὶ"},{"text":"τῶν"},{"text":"προσευχῶν"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἀκούων σου τὴν ἀγάπην καὶ τὴν πίστιν ἣν ἔχεις ⸀ πρὸς τὸν κύριον Ἰησοῦν καὶ εἰς πάντας τοὺς ἁγίους,","tokens":[{"text":"ἀκούων"},{"text":"σου"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"καὶ"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ἣν"},{"text":"ἔχεις"},{"text":"πρὸς"},{"text":"τὸν"},{"text":"κύριον"},{"text":"Ἰησοῦν"},{"text":"καὶ"},{"text":"εἰς"},{"text":"πάντας"},{"text":"τοὺς"},{"text":"ἁγίους"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὅπως ἡ κοινωνία τῆς πίστεώς σου ἐνεργὴς γένηται ἐν ἐπιγνώσει παντὸς ἀγαθοῦ ⸀ τοῦ ἐν ἡμῖν εἰς ⸀ Χριστόν·","tokens":[{"text":"ὅπως"},{"text":"ἡ"},{"text":"κοινωνία"},{"text":"τῆς"},{"text":"πίστεώς"},{"text":"σου"},{"text":"ἐνεργὴς"},{"text":"γένηται"},{"text":"ἐν"},{"text":"ἐπιγνώσει"},{"text":"παντὸς"},{"text":"ἀγαθοῦ"},{"text":"τοῦ"},{"text":"ἐν"},{"text":"ἡμῖν"},{"text":"εἰς"},{"text":"Χριστόν"}],"notes":[],"lang":"grc"},{"n":7,"text":"⸀ χαρὰν γὰρ ⸂ πολλὴν ἔσχον⸃ καὶ παράκλησιν ἐπὶ τῇ ἀγάπῃ σου, ὅτι τὰ σπλάγχνα τῶν ἁγίων ἀναπέπαυται διὰ σοῦ, ἀδελφέ.","tokens":[{"text":"χαρὰν"},{"text":"γὰρ"},{"text":"πολλὴν"},{"text":"ἔσχον"},{"text":"καὶ"},{"text":"παράκλησιν"},{"text":"ἐπὶ"},{"text":"τῇ"},{"text":"ἀγάπῃ"},{"text":"σου"},{"text":"ὅτι"},{"text":"τὰ"},{"text":"σπλάγχνα"},{"text":"τῶν"},{"text":"ἁγίων"},{"text":"ἀναπέπαυται"},{"text":"διὰ"},{"text":"σοῦ"},{"text":"ἀδελφέ"}],"notes":[],"lang":"grc"},{"n":8,"text":"Διό, πολλὴν ἐν Χριστῷ παρρησίαν ἔχων ἐπιτάσσειν σοι τὸ ἀνῆκον,","tokens":[{"text":"Διό"},{"text":"πολλὴν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"παρρησίαν"},{"text":"ἔχων"},{"text":"ἐπιτάσσειν"},{"text":"σοι"},{"text":"τὸ"},{"text":"ἀνῆκον"}],"notes":[],"lang":"grc"},{"n":9,"text":"διὰ τὴν ἀγάπην μᾶλλον παρακαλῶ, τοιοῦτος ὢν ὡς Παῦλος πρεσβύτης νυνὶ δὲ καὶ δέσμιος ⸂ Χριστοῦ Ἰησοῦ⸃—","tokens":[{"text":"διὰ"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"μᾶλλον"},{"text":"παρακαλῶ"},{"text":"τοιοῦτος"},{"text":"ὢν"},{"text":"ὡς"},{"text":"Παῦλος"},{"text":"πρεσβύτης"},{"text":"νυνὶ"},{"text":"δὲ"},{"text":"καὶ"},{"text":"δέσμιος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":10,"text":"παρακαλῶ σε περὶ τοῦ ἐμοῦ τέκνου, ὃν ἐγέννησα ἐν τοῖς ⸀ δεσμοῖς Ὀνήσιμον,","tokens":[{"text":"παρακαλῶ"},{"text":"σε"},{"text":"περὶ"},{"text":"τοῦ"},{"text":"ἐμοῦ"},{"text":"τέκνου"},{"text":"ὃν"},{"text":"ἐγέννησα"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"δεσμοῖς"},{"text":"Ὀνήσιμον"}],"notes":[],"lang":"grc"},{"n":11,"text":"τόν ποτέ σοι ἄχρηστον νυνὶ ⸀ δὲ σοὶ καὶ ἐμοὶ εὔχρηστον,","tokens":[{"text":"τόν"},{"text":"ποτέ"},{"text":"σοι"},{"text":"ἄχρηστον"},{"text":"νυνὶ"},{"text":"δὲ"},{"text":"σοὶ"},{"text":"καὶ"},{"text":"ἐμοὶ"},{"text":"εὔχρηστον"}],"notes":[],"lang":"grc"},{"n":12,"text":"ὃν ἀνέπεμψά ⸂ σοι αὐτόν, τοῦτʼ ἔστιν τὰ ἐμὰ σπλάγχνα⸃·","tokens":[{"text":"ὃν"},{"text":"ἀνέπεμψά"},{"text":"σοι"},{"text":"αὐτόν"},{"text":"τοῦτʼ"},{"text":"ἔστιν"},{"text":"τὰ"},{"text":"ἐμὰ"},{"text":"σπλάγχνα"}],"notes":[],"lang":"grc"},{"n":13,"text":"ὃν ἐγὼ ἐβουλόμην πρὸς ἐμαυτὸν κατέχειν, ἵνα ὑπὲρ σοῦ ⸂ μοι διακονῇ⸃ ἐν τοῖς δεσμοῖς τοῦ εὐαγγελίου,","tokens":[{"text":"ὃν"},{"text":"ἐγὼ"},{"text":"ἐβουλόμην"},{"text":"πρὸς"},{"text":"ἐμαυτὸν"},{"text":"κατέχειν"},{"text":"ἵνα"},{"text":"ὑπὲρ"},{"text":"σοῦ"},{"text":"μοι"},{"text":"διακονῇ"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"δεσμοῖς"},{"text":"τοῦ"},{"text":"εὐαγγελίου"}],"notes":[],"lang":"grc"},{"n":14,"text":"χωρὶς δὲ τῆς σῆς γνώμης οὐδὲν ἠθέλησα ποιῆσαι, ἵνα μὴ ὡς κατὰ ἀνάγκην τὸ ἀγαθόν σου ᾖ ἀλλὰ κατὰ ἑκούσιον·","tokens":[{"text":"χωρὶς"},{"text":"δὲ"},{"text":"τῆς"},{"text":"σῆς"},{"text":"γνώμης"},{"text":"οὐδὲν"},{"text":"ἠθέλησα"},{"text":"ποιῆσαι"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ὡς"},{"text":"κατὰ"},{"text":"ἀνάγκην"},{"text":"τὸ"},{"text":"ἀγαθόν"},{"text":"σου"},{"text":"ᾖ"},{"text":"ἀλλὰ"},{"text":"κατὰ"},{"text":"ἑκούσιον"}],"notes":[],"lang":"grc"},{"n":15,"text":"τάχα γὰρ διὰ τοῦτο ἐχωρίσθη πρὸς ὥραν ἵνα αἰώνιον αὐτὸν ἀπέχῃς,","tokens":[{"text":"τάχα"},{"text":"γὰρ"},{"text":"διὰ"},{"text":"τοῦτο"},{"text":"ἐχωρίσθη"},{"text":"πρὸς"},{"text":"ὥραν"},{"text":"ἵνα"},{"text":"αἰώνιον"},{"text":"αὐτὸν"},{"text":"ἀπέχῃς"}],"notes":[],"lang":"grc"},{"n":16,"text":"οὐκέτι ὡς δοῦλον ἀλλὰ ὑπὲρ δοῦλον, ἀδελφὸν ἀγαπητόν, μάλιστα ἐμοί, πόσῳ δὲ μᾶλλον σοὶ καὶ ἐν σαρκὶ καὶ ἐν κυρίῳ.","tokens":[{"text":"οὐκέτι"},{"text":"ὡς"},{"text":"δοῦλον"},{"text":"ἀλλὰ"},{"text":"ὑπὲρ"},{"text":"δοῦλον"},{"text":"ἀδελφὸν"},{"text":"ἀγαπητόν"},{"text":"μάλιστα"},{"text":"ἐμοί"},{"text":"πόσῳ"},{"text":"δὲ"},{"text":"μᾶλλον"},{"text":"σοὶ"},{"text":"καὶ"},{"text":"ἐν"},{"text":"σαρκὶ"},{"text":"καὶ"},{"text":"ἐν"},{"text":"κυρίῳ"}],"notes":[],"lang":"grc"},{"n":17,"text":"Εἰ οὖν με ἔχεις κοινωνόν, προσλαβοῦ αὐτὸν ὡς ἐμέ.","tokens":[{"text":"Εἰ"},{"text":"οὖν"},{"text":"με"},{"text":"ἔχεις"},{"text":"κοινωνόν"},{"text":"προσλαβοῦ"},{"text":"αὐτὸν"},{"text":"ὡς"},{"text":"ἐμέ"}],"notes":[],"lang":"grc"},{"n":18,"text":"εἰ δέ τι ἠδίκησέν σε ἢ ὀφείλει, τοῦτο ἐμοὶ ⸀ ἐλλόγα·","tokens":[{"text":"εἰ"},{"text":"δέ"},{"text":"τι"},{"text":"ἠδίκησέν"},{"text":"σε"},{"text":"ἢ"},{"text":"ὀφείλει"},{"text":"τοῦτο"},{"text":"ἐμοὶ"},{"text":"ἐλλόγα"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἐγὼ Παῦλος ἔγραψα τῇ ἐμῇ χειρί, ἐγὼ ἀποτίσω· ἵνα μὴ λέγω σοι ὅτι καὶ σεαυτόν μοι προσοφείλεις.","tokens":[{"text":"ἐγὼ"},{"text":"Παῦλος"},{"text":"ἔγραψα"},{"text":"τῇ"},{"text":"ἐμῇ"},{"text":"χειρί"},{"text":"ἐγὼ"},{"text":"ἀποτίσω"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"λέγω"},{"text":"σοι"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"σεαυτόν"},{"text":"μοι"},{"text":"προσοφείλεις"}],"notes":[],"lang":"grc"},{"n":20,"text":"ναί, ἀδελφέ, ἐγώ σου ὀναίμην ἐν κυρίῳ· ἀνάπαυσόν μου τὰ σπλάγχνα ἐν ⸀ Χριστῷ.","tokens":[{"text":"ναί"},{"text":"ἀδελφέ"},{"text":"ἐγώ"},{"text":"σου"},{"text":"ὀναίμην"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"ἀνάπαυσόν"},{"text":"μου"},{"text":"τὰ"},{"text":"σπλάγχνα"},{"text":"ἐν"},{"text":"Χριστῷ"}],"notes":[],"lang":"grc"},{"n":21,"text":"πεποιθὼς τῇ ὑπακοῇ σου ἔγραψά σοι, εἰδὼς ὅτι καὶ ὑπὲρ ⸀ ἃ λέγω ποιήσεις.","tokens":[{"text":"πεποιθὼς"},{"text":"τῇ"},{"text":"ὑπακοῇ"},{"text":"σου"},{"text":"ἔγραψά"},{"text":"σοι"},{"text":"εἰδὼς"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"ὑπὲρ"},{"text":"ἃ"},{"text":"λέγω"},{"text":"ποιήσεις"}],"notes":[],"lang":"grc"},{"n":22,"text":"ἅμα δὲ καὶ ἑτοίμαζέ μοι ξενίαν, ἐλπίζω γὰρ ὅτι διὰ τῶν προσευχῶν ὑμῶν χαρισθήσομαι ὑμῖν.","tokens":[{"text":"ἅμα"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἑτοίμαζέ"},{"text":"μοι"},{"text":"ξενίαν"},{"text":"ἐλπίζω"},{"text":"γὰρ"},{"text":"ὅτι"},{"text":"διὰ"},{"text":"τῶν"},{"text":"προσευχῶν"},{"text":"ὑμῶν"},{"text":"χαρισθήσομαι"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":23,"text":"⸀ Ἀσπάζεταί σε Ἐπαφρᾶς ὁ συναιχμάλωτός μου ἐν Χριστῷ Ἰησοῦ,","tokens":[{"text":"Ἀσπάζεταί"},{"text":"σε"},{"text":"Ἐπαφρᾶς"},{"text":"ὁ"},{"text":"συναιχμάλωτός"},{"text":"μου"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":24,"text":"Μᾶρκος, Ἀρίσταρχος, Δημᾶς, Λουκᾶς, οἱ συνεργοί μου.","tokens":[{"text":"Μᾶρκος"},{"text":"Ἀρίσταρχος"},{"text":"Δημᾶς"},{"text":"Λουκᾶς"},{"text":"οἱ"},{"text":"συνεργοί"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":25,"text":"Ἡ χάρις τοῦ ⸀ κυρίου Ἰησοῦ Χριστοῦ μετὰ τοῦ πνεύματος ⸀ ὑμῶν.","tokens":[{"text":"Ἡ"},{"text":"χάρις"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"μετὰ"},{"text":"τοῦ"},{"text":"πνεύματος"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}