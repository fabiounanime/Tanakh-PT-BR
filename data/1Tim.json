{"book":{"id":"1Tim","name":"1 Timóteo","testament":"NT","source":"SBLGNT","chapters":6,"verses":113},"chapters":{"1":[{"n":1,"text":"Παῦλος ἀπόστολος ⸂ Χριστοῦ Ἰησοῦ⸃ κατʼ ἐπιταγὴν θεοῦ σωτῆρος ἡμῶν καὶ ⸂ Χριστοῦ Ἰησοῦ⸃ τῆς ἐλπίδος ἡμῶν","tokens":[{"text":"Παῦλος"},{"text":"ἀπόστολος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"κατʼ"},{"text":"ἐπιταγὴν"},{"text":"θεοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τῆς"},{"text":"ἐλπίδος"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":2,"text":"Τιμοθέῳ γνησίῳ τέκνῳ ἐν πίστει· χάρις, ἔλεος, εἰρήνη ἀπὸ θεοῦ ⸀ πατρὸς καὶ Χριστοῦ Ἰησοῦ τοῦ κυρίου ἡμῶν.","tokens":[{"text":"Τιμοθέῳ"},{"text":"γνησίῳ"},{"text":"τέκνῳ"},{"text":"ἐν"},{"text":"πίστει"},{"text":"χάρις"},{"text":"ἔλεος"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":3,"text":"Καθὼς παρεκάλεσά σε προσμεῖναι ἐν Ἐφέσῳ, πορευόμενος εἰς Μακεδονίαν, ἵνα παραγγείλῃς τισὶν μὴ ἑτεροδιδασκαλεῖν","tokens":[{"text":"Καθὼς"},{"text":"παρεκάλεσά"},{"text":"σε"},{"text":"προσμεῖναι"},{"text":"ἐν"},{"text":"Ἐφέσῳ"},{"text":"πορευόμενος"},{"text":"εἰς"},{"text":"Μακεδονίαν"},{"text":"ἵνα"},{"text":"παραγγείλῃς"},{"text":"τισὶν"},{"text":"μὴ"},{"text":"ἑτεροδιδασκαλεῖν"}],"notes":[],"lang":"grc"},{"n":4,"text":"μηδὲ προσέχειν μύθοις καὶ γενεαλογίαις ἀπεράντοις, αἵτινες ⸀ ἐκζητήσεις παρέχουσι μᾶλλον ἢ οἰκονομίαν θεοῦ τὴν ἐν πίστει—","tokens":[{"text":"μηδὲ"},{"text":"προσέχειν"},{"text":"μύθοις"},{"text":"καὶ"},{"text":"γενεαλογίαις"},{"text":"ἀπεράντοις"},{"text":"αἵτινες"},{"text":"ἐκζητήσεις"},{"text":"παρέχουσι"},{"text":"μᾶλλον"},{"text":"ἢ"},{"text":"οἰκονομίαν"},{"text":"θεοῦ"},{"text":"τὴν"},{"text":"ἐν"},{"text":"πίστει"}],"notes":[],"lang":"grc"},{"n":5,"text":"τὸ δὲ τέλος τῆς παραγγελίας ἐστὶν ἀγάπη ἐκ καθαρᾶς καρδίας καὶ συνειδήσεως ἀγαθῆς καὶ πίστεως ἀνυποκρίτου,","tokens":[{"text":"τὸ"},{"text":"δὲ"},{"text":"τέλος"},{"text":"τῆς"},{"text":"παραγγελίας"},{"text":"ἐστὶν"},{"text":"ἀγάπη"},{"text":"ἐκ"},{"text":"καθαρᾶς"},{"text":"καρδίας"},{"text":"καὶ"},{"text":"συνειδήσεως"},{"text":"ἀγαθῆς"},{"text":"καὶ"},{"text":"πίστεως"},{"text":"ἀνυποκρίτου"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὧν τινες ἀστοχήσαντες ἐξετράπησαν εἰς ματαιολογίαν,","tokens":[{"text":"ὧν"},{"text":"τινες"},{"text":"ἀστοχήσαντες"},{"text":"ἐξετράπησαν"},{"text":"εἰς"},{"text":"ματαιολογίαν"}],"notes":[],"lang":"grc"},{"n":7,"text":"θέλοντες εἶναι νομοδιδάσκαλοι, μὴ νοοῦντες μήτε ἃ λέγουσιν μήτε περὶ τίνων διαβεβαιοῦνται.","tokens":[{"text":"θέλοντες"},{"text":"εἶναι"},{"text":"νομοδιδάσκαλοι"},{"text":"μὴ"},{"text":"νοοῦντες"},{"text":"μήτε"},{"text":"ἃ"},{"text":"λέγουσιν"},{"text":"μήτε"},{"text":"περὶ"},{"text":"τίνων"},{"text":"διαβεβαιοῦνται"}],"notes":[],"lang":"grc"},{"n":8,"text":"Οἴδαμεν δὲ ὅτι καλὸς ὁ νόμος ἐάν τις αὐτῷ νομίμως χρῆται,","tokens":[{"text":"Οἴδαμεν"},{"text":"δὲ"},{"text":"ὅτι"},{"text":"καλὸς"},{"text":"ὁ"},{"text":"νόμος"},{"text":"ἐάν"},{"text":"τις"},{"text":"αὐτῷ"},{"text":"νομίμως"},{"text":"χρῆται"}],"notes":[],"lang":"grc"},{"n":9,"text":"εἰδὼς τοῦτο, ὅτι δικαίῳ νόμος οὐ κεῖται, ἀνόμοις δὲ καὶ ἀνυποτάκτοις, ἀσεβέσι καὶ ἁμαρτωλοῖς, ἀνοσίοις καὶ βεβήλοις, πατρολῴαις καὶ μητρολῴαις, ἀνδροφόνοις,","tokens":[{"text":"εἰδὼς"},{"text":"τοῦτο"},{"text":"ὅτι"},{"text":"δικαίῳ"},{"text":"νόμος"},{"text":"οὐ"},{"text":"κεῖται"},{"text":"ἀνόμοις"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἀνυποτάκτοις"},{"text":"ἀσεβέσι"},{"text":"καὶ"},{"text":"ἁμαρτωλοῖς"},{"text":"ἀνοσίοις"},{"text":"καὶ"},{"text":"βεβήλοις"},{"text":"πατρολῴαις"},{"text":"καὶ"},{"text":"μητρολῴαις"},{"text":"ἀνδροφόνοις"}],"notes":[],"lang":"grc"},{"n":10,"text":"πόρνοις, ἀρσενοκοίταις, ἀνδραποδισταῖς, ψεύσταις, ἐπιόρκοις, καὶ εἴ τι ἕτερον τῇ ὑγιαινούσῃ διδασκαλίᾳ ἀντίκειται,","tokens":[{"text":"πόρνοις"},{"text":"ἀρσενοκοίταις"},{"text":"ἀνδραποδισταῖς"},{"text":"ψεύσταις"},{"text":"ἐπιόρκοις"},{"text":"καὶ"},{"text":"εἴ"},{"text":"τι"},{"text":"ἕτερον"},{"text":"τῇ"},{"text":"ὑγιαινούσῃ"},{"text":"διδασκαλίᾳ"},{"text":"ἀντίκειται"}],"notes":[],"lang":"grc"},{"n":11,"text":"κατὰ τὸ εὐαγγέλιον τῆς δόξης τοῦ μακαρίου θεοῦ, ὃ ἐπιστεύθην ἐγώ.","tokens":[{"text":"κατὰ"},{"text":"τὸ"},{"text":"εὐαγγέλιον"},{"text":"τῆς"},{"text":"δόξης"},{"text":"τοῦ"},{"text":"μακαρίου"},{"text":"θεοῦ"},{"text":"ὃ"},{"text":"ἐπιστεύθην"},{"text":"ἐγώ"}],"notes":[],"lang":"grc"},{"n":12,"text":"⸀ Χάριν ἔχω τῷ ἐνδυναμώσαντί με Χριστῷ Ἰησοῦ τῷ κυρίῳ ἡμῶν, ὅτι πιστόν με ἡγήσατο θέμενος εἰς διακονίαν,","tokens":[{"text":"Χάριν"},{"text":"ἔχω"},{"text":"τῷ"},{"text":"ἐνδυναμώσαντί"},{"text":"με"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"τῷ"},{"text":"κυρίῳ"},{"text":"ἡμῶν"},{"text":"ὅτι"},{"text":"πιστόν"},{"text":"με"},{"text":"ἡγήσατο"},{"text":"θέμενος"},{"text":"εἰς"},{"text":"διακονίαν"}],"notes":[],"lang":"grc"},{"n":13,"text":"⸀ τὸ πρότερον ὄντα βλάσφημον καὶ διώκτην καὶ ὑβριστήν· ἀλλὰ ἠλεήθην, ὅτι ἀγνοῶν ἐποίησα ἐν ἀπιστίᾳ,","tokens":[{"text":"τὸ"},{"text":"πρότερον"},{"text":"ὄντα"},{"text":"βλάσφημον"},{"text":"καὶ"},{"text":"διώκτην"},{"text":"καὶ"},{"text":"ὑβριστήν"},{"text":"ἀλλὰ"},{"text":"ἠλεήθην"},{"text":"ὅτι"},{"text":"ἀγνοῶν"},{"text":"ἐποίησα"},{"text":"ἐν"},{"text":"ἀπιστίᾳ"}],"notes":[],"lang":"grc"},{"n":14,"text":"ὑπερεπλεόνασεν δὲ ἡ χάρις τοῦ κυρίου ἡμῶν μετὰ πίστεως καὶ ἀγάπης τῆς ἐν Χριστῷ Ἰησοῦ.","tokens":[{"text":"ὑπερεπλεόνασεν"},{"text":"δὲ"},{"text":"ἡ"},{"text":"χάρις"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"μετὰ"},{"text":"πίστεως"},{"text":"καὶ"},{"text":"ἀγάπης"},{"text":"τῆς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"πιστὸς ὁ λόγος καὶ πάσης ἀποδοχῆς ἄξιος, ὅτι Χριστὸς Ἰησοῦς ἦλθεν εἰς τὸν κόσμον ἁμαρτωλοὺς σῶσαι· ὧν πρῶτός εἰμι ἐγώ,","tokens":[{"text":"πιστὸς"},{"text":"ὁ"},{"text":"λόγος"},{"text":"καὶ"},{"text":"πάσης"},{"text":"ἀποδοχῆς"},{"text":"ἄξιος"},{"text":"ὅτι"},{"text":"Χριστὸς"},{"text":"Ἰησοῦς"},{"text":"ἦλθεν"},{"text":"εἰς"},{"text":"τὸν"},{"text":"κόσμον"},{"text":"ἁμαρτωλοὺς"},{"text":"σῶσαι"},{"text":"ὧν"},{"text":"πρῶτός"},{"text":"εἰμι"},{"text":"ἐγώ"}],"notes":[],"lang":"grc"},{"n":16,"text":"ἀλλὰ διὰ τοῦτο ἠλεήθην, ἵνα ἐν ἐμοὶ πρώτῳ ἐνδείξηται ⸂ Χριστὸς Ἰησοῦς⸃ τὴν ⸀ ἅπασαν μακροθυμίαν, πρὸς ὑποτύπωσιν τῶν μελλόντων πιστεύειν ἐπʼ αὐτῷ εἰς ζωὴν αἰώνιον.","tokens":[{"text":"ἀλλὰ"},{"text":"διὰ"},{"text":"τοῦτο"},{"text":"ἠλεήθην"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"ἐμοὶ"},{"text":"πρώτῳ"},{"text":"ἐνδείξηται"},{"text":"Χριστὸς"},{"text":"Ἰησοῦς"},{"text":"τὴν"},{"text":"ἅπασαν"},{"text":"μακροθυμίαν"},{"text":"πρὸς"},{"text":"ὑποτύπωσιν"},{"text":"τῶν"},{"text":"μελλόντων"},{"text":"πιστεύειν"},{"text":"ἐπʼ"},{"text":"αὐτῷ"},{"text":"εἰς"},{"text":"ζωὴν"},{"text":"αἰώνιον"}],"notes":[],"lang":"grc"},{"n":17,"text":"τῷ δὲ βασιλεῖ τῶν αἰώνων, ἀφθάρτῳ, ἀοράτῳ,  ⸀ μόνῳ θεῷ, τιμὴ καὶ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.","tokens":[{"text":"τῷ"},{"text":"δὲ"},{"text":"βασιλεῖ"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀφθάρτῳ"},{"text":"ἀοράτῳ"},{"text":"μόνῳ"},{"text":"θεῷ"},{"text":"τιμὴ"},{"text":"καὶ"},{"text":"δόξα"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":18,"text":"Ταύτην τὴν παραγγελίαν παρατίθεμαί σοι, τέκνον Τιμόθεε, κατὰ τὰς προαγούσας ἐπὶ σὲ προφητείας, ἵνα ⸀ στρατεύῃ ἐν αὐταῖς τὴν καλὴν στρατείαν,","tokens":[{"text":"Ταύτην"},{"text":"τὴν"},{"text":"παραγγελίαν"},{"text":"παρατίθεμαί"},{"text":"σοι"},{"text":"τέκνον"},{"text":"Τιμόθεε"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"προαγούσας"},{"text":"ἐπὶ"},{"text":"σὲ"},{"text":"προφητείας"},{"text":"ἵνα"},{"text":"στρατεύῃ"},{"text":"ἐν"},{"text":"αὐταῖς"},{"text":"τὴν"},{"text":"καλὴν"},{"text":"στρατείαν"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἔχων πίστιν καὶ ἀγαθὴν συνείδησιν, ἥν τινες ἀπωσάμενοι περὶ τὴν πίστιν ἐναυάγησαν·","tokens":[{"text":"ἔχων"},{"text":"πίστιν"},{"text":"καὶ"},{"text":"ἀγαθὴν"},{"text":"συνείδησιν"},{"text":"ἥν"},{"text":"τινες"},{"text":"ἀπωσάμενοι"},{"text":"περὶ"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ἐναυάγησαν"}],"notes":[],"lang":"grc"},{"n":20,"text":"ὧν ἐστιν Ὑμέναιος καὶ Ἀλέξανδρος, οὓς παρέδωκα τῷ Σατανᾷ ἵνα παιδευθῶσι μὴ βλασφημεῖν.","tokens":[{"text":"ὧν"},{"text":"ἐστιν"},{"text":"Ὑμέναιος"},{"text":"καὶ"},{"text":"Ἀλέξανδρος"},{"text":"οὓς"},{"text":"παρέδωκα"},{"text":"τῷ"},{"text":"Σατανᾷ"},{"text":"ἵνα"},{"text":"παιδευθῶσι"},{"text":"μὴ"},{"text":"βλασφημεῖν"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Παρακαλῶ οὖν πρῶτον πάντων ποιεῖσθαι δεήσεις, προσευχάς, ἐντεύξεις, εὐχαριστίας, ὑπὲρ πάντων ἀνθρώπων,","tokens":[{"text":"Παρακαλῶ"},{"text":"οὖν"},{"text":"πρῶτον"},{"text":"πάντων"},{"text":"ποιεῖσθαι"},{"text":"δεήσεις"},{"text":"προσευχάς"},{"text":"ἐντεύξεις"},{"text":"εὐχαριστίας"},{"text":"ὑπὲρ"},{"text":"πάντων"},{"text":"ἀνθρώπων"}],"notes":[],"lang":"grc"},{"n":2,"text":"ὑπὲρ βασιλέων καὶ πάντων τῶν ἐν ὑπεροχῇ ὄντων, ἵνα ἤρεμον καὶ ἡσύχιον βίον διάγωμεν ἐν πάσῃ εὐσεβείᾳ καὶ σεμνότητι.","tokens":[{"text":"ὑπὲρ"},{"text":"βασιλέων"},{"text":"καὶ"},{"text":"πάντων"},{"text":"τῶν"},{"text":"ἐν"},{"text":"ὑπεροχῇ"},{"text":"ὄντων"},{"text":"ἵνα"},{"text":"ἤρεμον"},{"text":"καὶ"},{"text":"ἡσύχιον"},{"text":"βίον"},{"text":"διάγωμεν"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"εὐσεβείᾳ"},{"text":"καὶ"},{"text":"σεμνότητι"}],"notes":[],"lang":"grc"},{"n":3,"text":"⸀ τοῦτο καλὸν καὶ ἀπόδεκτον ἐνώπιον τοῦ σωτῆρος ἡμῶν θεοῦ,","tokens":[{"text":"τοῦτο"},{"text":"καλὸν"},{"text":"καὶ"},{"text":"ἀπόδεκτον"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὃς πάντας ἀνθρώπους θέλει σωθῆναι καὶ εἰς ἐπίγνωσιν ἀληθείας ἐλθεῖν.","tokens":[{"text":"ὃς"},{"text":"πάντας"},{"text":"ἀνθρώπους"},{"text":"θέλει"},{"text":"σωθῆναι"},{"text":"καὶ"},{"text":"εἰς"},{"text":"ἐπίγνωσιν"},{"text":"ἀληθείας"},{"text":"ἐλθεῖν"}],"notes":[],"lang":"grc"},{"n":5,"text":"εἷς γὰρ θεός, εἷς καὶ μεσίτης θεοῦ καὶ ἀνθρώπων ἄνθρωπος Χριστὸς Ἰησοῦς,","tokens":[{"text":"εἷς"},{"text":"γὰρ"},{"text":"θεός"},{"text":"εἷς"},{"text":"καὶ"},{"text":"μεσίτης"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"ἀνθρώπων"},{"text":"ἄνθρωπος"},{"text":"Χριστὸς"},{"text":"Ἰησοῦς"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὁ δοὺς ἑαυτὸν ἀντίλυτρον ὑπὲρ πάντων, τὸ μαρτύριον καιροῖς ἰδίοις·","tokens":[{"text":"ὁ"},{"text":"δοὺς"},{"text":"ἑαυτὸν"},{"text":"ἀντίλυτρον"},{"text":"ὑπὲρ"},{"text":"πάντων"},{"text":"τὸ"},{"text":"μαρτύριον"},{"text":"καιροῖς"},{"text":"ἰδίοις"}],"notes":[],"lang":"grc"},{"n":7,"text":"εἰς ὃ ἐτέθην ἐγὼ κῆρυξ καὶ ἀπόστολος— ἀλήθειαν ⸀ λέγω, οὐ ψεύδομαι— διδάσκαλος ἐθνῶν ἐν πίστει καὶ ἀληθείᾳ.","tokens":[{"text":"εἰς"},{"text":"ὃ"},{"text":"ἐτέθην"},{"text":"ἐγὼ"},{"text":"κῆρυξ"},{"text":"καὶ"},{"text":"ἀπόστολος"},{"text":"ἀλήθειαν"},{"text":"λέγω"},{"text":"οὐ"},{"text":"ψεύδομαι"},{"text":"διδάσκαλος"},{"text":"ἐθνῶν"},{"text":"ἐν"},{"text":"πίστει"},{"text":"καὶ"},{"text":"ἀληθείᾳ"}],"notes":[],"lang":"grc"},{"n":8,"text":"Βούλομαι οὖν προσεύχεσθαι τοὺς ἄνδρας ἐν παντὶ τόπῳ, ἐπαίροντας ὁσίους χεῖρας χωρὶς ὀργῆς καὶ ⸀ διαλογισμοῦ.","tokens":[{"text":"Βούλομαι"},{"text":"οὖν"},{"text":"προσεύχεσθαι"},{"text":"τοὺς"},{"text":"ἄνδρας"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"τόπῳ"},{"text":"ἐπαίροντας"},{"text":"ὁσίους"},{"text":"χεῖρας"},{"text":"χωρὶς"},{"text":"ὀργῆς"},{"text":"καὶ"},{"text":"διαλογισμοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"ὡσαύτως ⸀ καὶ γυναῖκας ἐν καταστολῇ κοσμίῳ μετὰ αἰδοῦς καὶ σωφροσύνης κοσμεῖν ἑαυτάς, μὴ ἐν πλέγμασιν ⸀ καὶ ⸀ χρυσίῳ ἢ μαργαρίταις ἢ ἱματισμῷ πολυτελεῖ,","tokens":[{"text":"ὡσαύτως"},{"text":"καὶ"},{"text":"γυναῖκας"},{"text":"ἐν"},{"text":"καταστολῇ"},{"text":"κοσμίῳ"},{"text":"μετὰ"},{"text":"αἰδοῦς"},{"text":"καὶ"},{"text":"σωφροσύνης"},{"text":"κοσμεῖν"},{"text":"ἑαυτάς"},{"text":"μὴ"},{"text":"ἐν"},{"text":"πλέγμασιν"},{"text":"καὶ"},{"text":"χρυσίῳ"},{"text":"ἢ"},{"text":"μαργαρίταις"},{"text":"ἢ"},{"text":"ἱματισμῷ"},{"text":"πολυτελεῖ"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἀλλʼ ὃ πρέπει γυναιξὶν ἐπαγγελλομέναις θεοσέβειαν, διʼ ἔργων ἀγαθῶν.","tokens":[{"text":"ἀλλʼ"},{"text":"ὃ"},{"text":"πρέπει"},{"text":"γυναιξὶν"},{"text":"ἐπαγγελλομέναις"},{"text":"θεοσέβειαν"},{"text":"διʼ"},{"text":"ἔργων"},{"text":"ἀγαθῶν"}],"notes":[],"lang":"grc"},{"n":11,"text":"γυνὴ ἐν ἡσυχίᾳ μανθανέτω ἐν πάσῃ ὑποταγῇ·","tokens":[{"text":"γυνὴ"},{"text":"ἐν"},{"text":"ἡσυχίᾳ"},{"text":"μανθανέτω"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"ὑποταγῇ"}],"notes":[],"lang":"grc"},{"n":12,"text":"⸂ διδάσκειν δὲ γυναικὶ⸃ οὐκ ἐπιτρέπω, οὐδὲ αὐθεντεῖν ἀνδρός, ἀλλʼ εἶναι ἐν ἡσυχίᾳ.","tokens":[{"text":"διδάσκειν"},{"text":"δὲ"},{"text":"γυναικὶ"},{"text":"οὐκ"},{"text":"ἐπιτρέπω"},{"text":"οὐδὲ"},{"text":"αὐθεντεῖν"},{"text":"ἀνδρός"},{"text":"ἀλλʼ"},{"text":"εἶναι"},{"text":"ἐν"},{"text":"ἡσυχίᾳ"}],"notes":[],"lang":"grc"},{"n":13,"text":"Ἀδὰμ γὰρ πρῶτος ἐπλάσθη, εἶτα Εὕα·","tokens":[{"text":"Ἀδὰμ"},{"text":"γὰρ"},{"text":"πρῶτος"},{"text":"ἐπλάσθη"},{"text":"εἶτα"},{"text":"Εὕα"}],"notes":[],"lang":"grc"},{"n":14,"text":"καὶ Ἀδὰμ οὐκ ἠπατήθη, ἡ δὲ γυνὴ ⸀ ἐξαπατηθεῖσα ἐν παραβάσει γέγονεν.","tokens":[{"text":"καὶ"},{"text":"Ἀδὰμ"},{"text":"οὐκ"},{"text":"ἠπατήθη"},{"text":"ἡ"},{"text":"δὲ"},{"text":"γυνὴ"},{"text":"ἐξαπατηθεῖσα"},{"text":"ἐν"},{"text":"παραβάσει"},{"text":"γέγονεν"}],"notes":[],"lang":"grc"},{"n":15,"text":"σωθήσεται δὲ διὰ τῆς τεκνογονίας, ἐὰν μείνωσιν ἐν πίστει καὶ ἀγάπῃ καὶ ἁγιασμῷ μετὰ σωφροσύνης.","tokens":[{"text":"σωθήσεται"},{"text":"δὲ"},{"text":"διὰ"},{"text":"τῆς"},{"text":"τεκνογονίας"},{"text":"ἐὰν"},{"text":"μείνωσιν"},{"text":"ἐν"},{"text":"πίστει"},{"text":"καὶ"},{"text":"ἀγάπῃ"},{"text":"καὶ"},{"text":"ἁγιασμῷ"},{"text":"μετὰ"},{"text":"σωφροσύνης"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Πιστὸς ὁ λόγος· εἴ τις ἐπισκοπῆς ὀρέγεται, καλοῦ ἔργου ἐπιθυμεῖ.","tokens":[{"text":"Πιστὸς"},{"text":"ὁ"},{"text":"λόγος"},{"text":"εἴ"},{"text":"τις"},{"text":"ἐπισκοπῆς"},{"text":"ὀρέγεται"},{"text":"καλοῦ"},{"text":"ἔργου"},{"text":"ἐπιθυμεῖ"}],"notes":[],"lang":"grc"},{"n":2,"text":"δεῖ οὖν τὸν ἐπίσκοπον ἀνεπίλημπτον εἶναι, μιᾶς γυναικὸς ἄνδρα, νηφάλιον, σώφρονα, κόσμιον, φιλόξενον, διδακτικόν,","tokens":[{"text":"δεῖ"},{"text":"οὖν"},{"text":"τὸν"},{"text":"ἐπίσκοπον"},{"text":"ἀνεπίλημπτον"},{"text":"εἶναι"},{"text":"μιᾶς"},{"text":"γυναικὸς"},{"text":"ἄνδρα"},{"text":"νηφάλιον"},{"text":"σώφρονα"},{"text":"κόσμιον"},{"text":"φιλόξενον"},{"text":"διδακτικόν"}],"notes":[],"lang":"grc"},{"n":3,"text":"μὴ πάροινον, μὴ ⸀ πλήκτην, ἀλλὰ ἐπιεικῆ, ἄμαχον, ἀφιλάργυρον,","tokens":[{"text":"μὴ"},{"text":"πάροινον"},{"text":"μὴ"},{"text":"πλήκτην"},{"text":"ἀλλὰ"},{"text":"ἐπιεικῆ"},{"text":"ἄμαχον"},{"text":"ἀφιλάργυρον"}],"notes":[],"lang":"grc"},{"n":4,"text":"τοῦ ἰδίου οἴκου καλῶς προϊστάμενον, τέκνα ἔχοντα ἐν ὑποταγῇ μετὰ πάσης σεμνότητος·","tokens":[{"text":"τοῦ"},{"text":"ἰδίου"},{"text":"οἴκου"},{"text":"καλῶς"},{"text":"προϊστάμενον"},{"text":"τέκνα"},{"text":"ἔχοντα"},{"text":"ἐν"},{"text":"ὑποταγῇ"},{"text":"μετὰ"},{"text":"πάσης"},{"text":"σεμνότητος"}],"notes":[],"lang":"grc"},{"n":5,"text":"( εἰ δέ τις τοῦ ἰδίου οἴκου προστῆναι οὐκ οἶδεν, πῶς ἐκκλησίας θεοῦ ἐπιμελήσεται;)","tokens":[{"text":"εἰ"},{"text":"δέ"},{"text":"τις"},{"text":"τοῦ"},{"text":"ἰδίου"},{"text":"οἴκου"},{"text":"προστῆναι"},{"text":"οὐκ"},{"text":"οἶδεν"},{"text":"πῶς"},{"text":"ἐκκλησίας"},{"text":"θεοῦ"},{"text":"ἐπιμελήσεται"}],"notes":[],"lang":"grc"},{"n":6,"text":"μὴ νεόφυτον, ἵνα μὴ τυφωθεὶς εἰς κρίμα ἐμπέσῃ τοῦ διαβόλου.","tokens":[{"text":"μὴ"},{"text":"νεόφυτον"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"τυφωθεὶς"},{"text":"εἰς"},{"text":"κρίμα"},{"text":"ἐμπέσῃ"},{"text":"τοῦ"},{"text":"διαβόλου"}],"notes":[],"lang":"grc"},{"n":7,"text":"δεῖ ⸀ δὲ καὶ μαρτυρίαν καλὴν ἔχειν ἀπὸ τῶν ἔξωθεν, ἵνα μὴ εἰς ὀνειδισμὸν ἐμπέσῃ καὶ παγίδα τοῦ διαβόλου.","tokens":[{"text":"δεῖ"},{"text":"δὲ"},{"text":"καὶ"},{"text":"μαρτυρίαν"},{"text":"καλὴν"},{"text":"ἔχειν"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"ἔξωθεν"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"εἰς"},{"text":"ὀνειδισμὸν"},{"text":"ἐμπέσῃ"},{"text":"καὶ"},{"text":"παγίδα"},{"text":"τοῦ"},{"text":"διαβόλου"}],"notes":[],"lang":"grc"},{"n":8,"text":"Διακόνους ὡσαύτως σεμνούς, μὴ διλόγους, μὴ οἴνῳ πολλῷ προσέχοντας, μὴ αἰσχροκερδεῖς,","tokens":[{"text":"Διακόνους"},{"text":"ὡσαύτως"},{"text":"σεμνούς"},{"text":"μὴ"},{"text":"διλόγους"},{"text":"μὴ"},{"text":"οἴνῳ"},{"text":"πολλῷ"},{"text":"προσέχοντας"},{"text":"μὴ"},{"text":"αἰσχροκερδεῖς"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἔχοντας τὸ μυστήριον τῆς πίστεως ἐν καθαρᾷ συνειδήσει.","tokens":[{"text":"ἔχοντας"},{"text":"τὸ"},{"text":"μυστήριον"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"ἐν"},{"text":"καθαρᾷ"},{"text":"συνειδήσει"}],"notes":[],"lang":"grc"},{"n":10,"text":"καὶ οὗτοι δὲ δοκιμαζέσθωσαν πρῶτον, εἶτα διακονείτωσαν ἀνέγκλητοι ὄντες.","tokens":[{"text":"καὶ"},{"text":"οὗτοι"},{"text":"δὲ"},{"text":"δοκιμαζέσθωσαν"},{"text":"πρῶτον"},{"text":"εἶτα"},{"text":"διακονείτωσαν"},{"text":"ἀνέγκλητοι"},{"text":"ὄντες"}],"notes":[],"lang":"grc"},{"n":11,"text":"γυναῖκας ὡσαύτως σεμνάς, μὴ διαβόλους, νηφαλίους, πιστὰς ἐν πᾶσιν.","tokens":[{"text":"γυναῖκας"},{"text":"ὡσαύτως"},{"text":"σεμνάς"},{"text":"μὴ"},{"text":"διαβόλους"},{"text":"νηφαλίους"},{"text":"πιστὰς"},{"text":"ἐν"},{"text":"πᾶσιν"}],"notes":[],"lang":"grc"},{"n":12,"text":"διάκονοι ἔστωσαν μιᾶς γυναικὸς ἄνδρες, τέκνων καλῶς προϊστάμενοι καὶ τῶν ἰδίων οἴκων·","tokens":[{"text":"διάκονοι"},{"text":"ἔστωσαν"},{"text":"μιᾶς"},{"text":"γυναικὸς"},{"text":"ἄνδρες"},{"text":"τέκνων"},{"text":"καλῶς"},{"text":"προϊστάμενοι"},{"text":"καὶ"},{"text":"τῶν"},{"text":"ἰδίων"},{"text":"οἴκων"}],"notes":[],"lang":"grc"},{"n":13,"text":"οἱ γὰρ καλῶς διακονήσαντες βαθμὸν ἑαυτοῖς καλὸν περιποιοῦνται καὶ πολλὴν παρρησίαν ἐν πίστει τῇ ἐν Χριστῷ Ἰησοῦ.","tokens":[{"text":"οἱ"},{"text":"γὰρ"},{"text":"καλῶς"},{"text":"διακονήσαντες"},{"text":"βαθμὸν"},{"text":"ἑαυτοῖς"},{"text":"καλὸν"},{"text":"περιποιοῦνται"},{"text":"καὶ"},{"text":"πολλὴν"},{"text":"παρρησίαν"},{"text":"ἐν"},{"text":"πίστει"},{"text":"τῇ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":14,"text":"Ταῦτά σοι γράφω, ἐλπίζων ἐλθεῖν πρὸς σὲ ⸂ ἐν τάχει⸃,","tokens":[{"text":"Ταῦτά"},{"text":"σοι"},{"text":"γράφω"},{"text":"ἐλπίζων"},{"text":"ἐλθεῖν"},{"text":"πρὸς"},{"text":"σὲ"},{"text":"ἐν"},{"text":"τάχει"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἐὰν δὲ βραδύνω, ἵνα εἰδῇς πῶς δεῖ ἐν οἴκῳ θεοῦ ἀναστρέφεσθαι, ἥτις ἐστὶν ἐκκλησία θεοῦ ζῶντος, στῦλος καὶ ἑδραίωμα τῆς ἀληθείας·","tokens":[{"text":"ἐὰν"},{"text":"δὲ"},{"text":"βραδύνω"},{"text":"ἵνα"},{"text":"εἰδῇς"},{"text":"πῶς"},{"text":"δεῖ"},{"text":"ἐν"},{"text":"οἴκῳ"},{"text":"θεοῦ"},{"text":"ἀναστρέφεσθαι"},{"text":"ἥτις"},{"text":"ἐστὶν"},{"text":"ἐκκλησία"},{"text":"θεοῦ"},{"text":"ζῶντος"},{"text":"στῦλος"},{"text":"καὶ"},{"text":"ἑδραίωμα"},{"text":"τῆς"},{"text":"ἀληθείας"}],"notes":[],"lang":"grc"},{"n":16,"text":"καὶ ὁμολογουμένως μέγα ἐστὶν τὸ τῆς εὐσεβείας μυστήριον·  ⸀ Ὃς ἐφανερώθη ἐν σαρκί, ἐδικαιώθη ἐν πνεύματι, ὤφθη ἀγγέλοις, ἐκηρύχθη ἐν ἔθνεσιν, ἐπιστεύθη ἐν κόσμῳ, ἀνελήμφθη ἐν δόξῃ.","tokens":[{"text":"καὶ"},{"text":"ὁμολογουμένως"},{"text":"μέγα"},{"text":"ἐστὶν"},{"text":"τὸ"},{"text":"τῆς"},{"text":"εὐσεβείας"},{"text":"μυστήριον"},{"text":"Ὃς"},{"text":"ἐφανερώθη"},{"text":"ἐν"},{"text":"σαρκί"},{"text":"ἐδικαιώθη"},{"text":"ἐν"},{"text":"πνεύματι"},{"text":"ὤφθη"},{"text":"ἀγγέλοις"},{"text":"ἐκηρύχθη"},{"text":"ἐν"},{"text":"ἔθνεσιν"},{"text":"ἐπιστεύθη"},{"text":"ἐν"},{"text":"κόσμῳ"},{"text":"ἀνελήμφθη"},{"text":"ἐν"},{"text":"δόξῃ"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"Τὸ δὲ πνεῦμα ῥητῶς λέγει ὅτι ἐν ὑστέροις καιροῖς ἀποστήσονταί τινες τῆς πίστεως, προσέχοντες πνεύμασι πλάνοις καὶ διδασκαλίαις δαιμονίων","tokens":[{"text":"Τὸ"},{"text":"δὲ"},{"text":"πνεῦμα"},{"text":"ῥητῶς"},{"text":"λέγει"},{"text":"ὅτι"},{"text":"ἐν"},{"text":"ὑστέροις"},{"text":"καιροῖς"},{"text":"ἀποστήσονταί"},{"text":"τινες"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"προσέχοντες"},{"text":"πνεύμασι"},{"text":"πλάνοις"},{"text":"καὶ"},{"text":"διδασκαλίαις"},{"text":"δαιμονίων"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἐν ὑποκρίσει ψευδολόγων, κεκαυστηριασμένων τὴν ἰδίαν συνείδησιν,","tokens":[{"text":"ἐν"},{"text":"ὑποκρίσει"},{"text":"ψευδολόγων"},{"text":"κεκαυστηριασμένων"},{"text":"τὴν"},{"text":"ἰδίαν"},{"text":"συνείδησιν"}],"notes":[],"lang":"grc"},{"n":3,"text":"κωλυόντων γαμεῖν, ἀπέχεσθαι βρωμάτων ἃ ὁ θεὸς ἔκτισεν εἰς μετάλημψιν μετὰ εὐχαριστίας τοῖς πιστοῖς καὶ ἐπεγνωκόσι τὴν ἀλήθειαν.","tokens":[{"text":"κωλυόντων"},{"text":"γαμεῖν"},{"text":"ἀπέχεσθαι"},{"text":"βρωμάτων"},{"text":"ἃ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἔκτισεν"},{"text":"εἰς"},{"text":"μετάλημψιν"},{"text":"μετὰ"},{"text":"εὐχαριστίας"},{"text":"τοῖς"},{"text":"πιστοῖς"},{"text":"καὶ"},{"text":"ἐπεγνωκόσι"},{"text":"τὴν"},{"text":"ἀλήθειαν"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὅτι πᾶν κτίσμα θεοῦ καλόν, καὶ οὐδὲν ἀπόβλητον μετὰ εὐχαριστίας λαμβανόμενον,","tokens":[{"text":"ὅτι"},{"text":"πᾶν"},{"text":"κτίσμα"},{"text":"θεοῦ"},{"text":"καλόν"},{"text":"καὶ"},{"text":"οὐδὲν"},{"text":"ἀπόβλητον"},{"text":"μετὰ"},{"text":"εὐχαριστίας"},{"text":"λαμβανόμενον"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἁγιάζεται γὰρ διὰ λόγου θεοῦ καὶ ἐντεύξεως.","tokens":[{"text":"ἁγιάζεται"},{"text":"γὰρ"},{"text":"διὰ"},{"text":"λόγου"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"ἐντεύξεως"}],"notes":[],"lang":"grc"},{"n":6,"text":"Ταῦτα ὑποτιθέμενος τοῖς ἀδελφοῖς καλὸς ἔσῃ διάκονος ⸂ Χριστοῦ Ἰησοῦ⸃, ἐντρεφόμενος τοῖς λόγοις τῆς πίστεως καὶ τῆς καλῆς διδασκαλίας ᾗ παρηκολούθηκας,","tokens":[{"text":"Ταῦτα"},{"text":"ὑποτιθέμενος"},{"text":"τοῖς"},{"text":"ἀδελφοῖς"},{"text":"καλὸς"},{"text":"ἔσῃ"},{"text":"διάκονος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"ἐντρεφόμενος"},{"text":"τοῖς"},{"text":"λόγοις"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"καὶ"},{"text":"τῆς"},{"text":"καλῆς"},{"text":"διδασκαλίας"},{"text":"ᾗ"},{"text":"παρηκολούθηκας"}],"notes":[],"lang":"grc"},{"n":7,"text":"τοὺς δὲ βεβήλους καὶ γραώδεις μύθους παραιτοῦ. γύμναζε δὲ σεαυτὸν πρὸς εὐσέβειαν·","tokens":[{"text":"τοὺς"},{"text":"δὲ"},{"text":"βεβήλους"},{"text":"καὶ"},{"text":"γραώδεις"},{"text":"μύθους"},{"text":"παραιτοῦ"},{"text":"γύμναζε"},{"text":"δὲ"},{"text":"σεαυτὸν"},{"text":"πρὸς"},{"text":"εὐσέβειαν"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἡ γὰρ σωματικὴ γυμνασία πρὸς ὀλίγον ἐστὶν ὠφέλιμος, ἡ δὲ εὐσέβεια πρὸς πάντα ὠφέλιμός ἐστιν, ἐπαγγελίαν ἔχουσα ζωῆς τῆς νῦν καὶ τῆς μελλούσης.","tokens":[{"text":"ἡ"},{"text":"γὰρ"},{"text":"σωματικὴ"},{"text":"γυμνασία"},{"text":"πρὸς"},{"text":"ὀλίγον"},{"text":"ἐστὶν"},{"text":"ὠφέλιμος"},{"text":"ἡ"},{"text":"δὲ"},{"text":"εὐσέβεια"},{"text":"πρὸς"},{"text":"πάντα"},{"text":"ὠφέλιμός"},{"text":"ἐστιν"},{"text":"ἐπαγγελίαν"},{"text":"ἔχουσα"},{"text":"ζωῆς"},{"text":"τῆς"},{"text":"νῦν"},{"text":"καὶ"},{"text":"τῆς"},{"text":"μελλούσης"}],"notes":[],"lang":"grc"},{"n":9,"text":"πιστὸς ὁ λόγος καὶ πάσης ἀποδοχῆς ἄξιος,","tokens":[{"text":"πιστὸς"},{"text":"ὁ"},{"text":"λόγος"},{"text":"καὶ"},{"text":"πάσης"},{"text":"ἀποδοχῆς"},{"text":"ἄξιος"}],"notes":[],"lang":"grc"},{"n":10,"text":"εἰς τοῦτο ⸀ γὰρ κοπιῶμεν καὶ ⸀ ὀνειδιζόμεθα, ὅτι ἠλπίκαμεν ἐπὶ θεῷ ζῶντι, ὅς ἐστιν σωτὴρ πάντων ἀνθρώπων, μάλιστα πιστῶν.","tokens":[{"text":"εἰς"},{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"κοπιῶμεν"},{"text":"καὶ"},{"text":"ὀνειδιζόμεθα"},{"text":"ὅτι"},{"text":"ἠλπίκαμεν"},{"text":"ἐπὶ"},{"text":"θεῷ"},{"text":"ζῶντι"},{"text":"ὅς"},{"text":"ἐστιν"},{"text":"σωτὴρ"},{"text":"πάντων"},{"text":"ἀνθρώπων"},{"text":"μάλιστα"},{"text":"πιστῶν"}],"notes":[],"lang":"grc"},{"n":11,"text":"Παράγγελλε ταῦτα καὶ δίδασκε.","tokens":[{"text":"Παράγγελλε"},{"text":"ταῦτα"},{"text":"καὶ"},{"text":"δίδασκε"}],"notes":[],"lang":"grc"},{"n":12,"text":"μηδείς σου τῆς νεότητος καταφρονείτω, ἀλλὰ τύπος γίνου τῶν πιστῶν ἐν λόγῳ, ἐν ἀναστροφῇ, ἐν ⸀ ἀγάπῃ, ἐν πίστει, ἐν ἁγνείᾳ.","tokens":[{"text":"μηδείς"},{"text":"σου"},{"text":"τῆς"},{"text":"νεότητος"},{"text":"καταφρονείτω"},{"text":"ἀλλὰ"},{"text":"τύπος"},{"text":"γίνου"},{"text":"τῶν"},{"text":"πιστῶν"},{"text":"ἐν"},{"text":"λόγῳ"},{"text":"ἐν"},{"text":"ἀναστροφῇ"},{"text":"ἐν"},{"text":"ἀγάπῃ"},{"text":"ἐν"},{"text":"πίστει"},{"text":"ἐν"},{"text":"ἁγνείᾳ"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἕως ἔρχομαι πρόσεχε τῇ ἀναγνώσει, τῇ παρακλήσει, τῇ διδασκαλίᾳ.","tokens":[{"text":"ἕως"},{"text":"ἔρχομαι"},{"text":"πρόσεχε"},{"text":"τῇ"},{"text":"ἀναγνώσει"},{"text":"τῇ"},{"text":"παρακλήσει"},{"text":"τῇ"},{"text":"διδασκαλίᾳ"}],"notes":[],"lang":"grc"},{"n":14,"text":"μὴ ἀμέλει τοῦ ἐν σοὶ χαρίσματος, ὃ ἐδόθη σοι διὰ προφητείας μετὰ ἐπιθέσεως τῶν χειρῶν τοῦ πρεσβυτερίου.","tokens":[{"text":"μὴ"},{"text":"ἀμέλει"},{"text":"τοῦ"},{"text":"ἐν"},{"text":"σοὶ"},{"text":"χαρίσματος"},{"text":"ὃ"},{"text":"ἐδόθη"},{"text":"σοι"},{"text":"διὰ"},{"text":"προφητείας"},{"text":"μετὰ"},{"text":"ἐπιθέσεως"},{"text":"τῶν"},{"text":"χειρῶν"},{"text":"τοῦ"},{"text":"πρεσβυτερίου"}],"notes":[],"lang":"grc"},{"n":15,"text":"ταῦτα μελέτα, ἐν τούτοις ἴσθι, ἵνα σου ἡ προκοπὴ φανερὰ ⸀ ᾖ πᾶσιν·","tokens":[{"text":"ταῦτα"},{"text":"μελέτα"},{"text":"ἐν"},{"text":"τούτοις"},{"text":"ἴσθι"},{"text":"ἵνα"},{"text":"σου"},{"text":"ἡ"},{"text":"προκοπὴ"},{"text":"φανερὰ"},{"text":"ᾖ"},{"text":"πᾶσιν"}],"notes":[],"lang":"grc"},{"n":16,"text":"ἔπεχε σεαυτῷ καὶ τῇ διδασκαλίᾳ· ἐπίμενε αὐτοῖς· τοῦτο γὰρ ποιῶν καὶ σεαυτὸν σώσεις καὶ τοὺς ἀκούοντάς σου.","tokens":[{"text":"ἔπεχε"},{"text":"σεαυτῷ"},{"text":"καὶ"},{"text":"τῇ"},{"text":"διδασκαλίᾳ"},{"text":"ἐπίμενε"},{"text":"αὐτοῖς"},{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"ποιῶν"},{"text":"καὶ"},{"text":"σεαυτὸν"},{"text":"σώσεις"},{"text":"καὶ"},{"text":"τοὺς"},{"text":"ἀκούοντάς"},{"text":"σου"}],"notes":[],"lang":"grc"}],"5":[{"n":1,"text":"Πρεσβυτέρῳ μὴ ἐπιπλήξῃς, ἀλλὰ παρακάλει ὡς πατέρα, νεωτέρους ὡς ἀδελφούς,","tokens":[{"text":"Πρεσβυτέρῳ"},{"text":"μὴ"},{"text":"ἐπιπλήξῃς"},{"text":"ἀλλὰ"},{"text":"παρακάλει"},{"text":"ὡς"},{"text":"πατέρα"},{"text":"νεωτέρους"},{"text":"ὡς"},{"text":"ἀδελφούς"}],"notes":[],"lang":"grc"},{"n":2,"text":"πρεσβυτέρας ὡς μητέρας, νεωτέρας ὡς ἀδελφὰς ἐν πάσῃ ἁγνείᾳ.","tokens":[{"text":"πρεσβυτέρας"},{"text":"ὡς"},{"text":"μητέρας"},{"text":"νεωτέρας"},{"text":"ὡς"},{"text":"ἀδελφὰς"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"ἁγνείᾳ"}],"notes":[],"lang":"grc"},{"n":3,"text":"Χήρας τίμα τὰς ὄντως χήρας.","tokens":[{"text":"Χήρας"},{"text":"τίμα"},{"text":"τὰς"},{"text":"ὄντως"},{"text":"χήρας"}],"notes":[],"lang":"grc"},{"n":4,"text":"εἰ δέ τις χήρα τέκνα ἢ ἔκγονα ἔχει, μανθανέτωσαν πρῶτον τὸν ἴδιον οἶκον εὐσεβεῖν καὶ ἀμοιβὰς ἀποδιδόναι τοῖς προγόνοις, τοῦτο γάρ ἐστιν ἀπόδεκτον ἐνώπιον τοῦ θεοῦ.","tokens":[{"text":"εἰ"},{"text":"δέ"},{"text":"τις"},{"text":"χήρα"},{"text":"τέκνα"},{"text":"ἢ"},{"text":"ἔκγονα"},{"text":"ἔχει"},{"text":"μανθανέτωσαν"},{"text":"πρῶτον"},{"text":"τὸν"},{"text":"ἴδιον"},{"text":"οἶκον"},{"text":"εὐσεβεῖν"},{"text":"καὶ"},{"text":"ἀμοιβὰς"},{"text":"ἀποδιδόναι"},{"text":"τοῖς"},{"text":"προγόνοις"},{"text":"τοῦτο"},{"text":"γάρ"},{"text":"ἐστιν"},{"text":"ἀπόδεκτον"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἡ δὲ ὄντως χήρα καὶ μεμονωμένη ἤλπικεν ἐπὶ ⸀ θεὸν καὶ προσμένει ταῖς δεήσεσιν καὶ ταῖς προσευχαῖς νυκτὸς καὶ ἡμέρας·","tokens":[{"text":"ἡ"},{"text":"δὲ"},{"text":"ὄντως"},{"text":"χήρα"},{"text":"καὶ"},{"text":"μεμονωμένη"},{"text":"ἤλπικεν"},{"text":"ἐπὶ"},{"text":"θεὸν"},{"text":"καὶ"},{"text":"προσμένει"},{"text":"ταῖς"},{"text":"δεήσεσιν"},{"text":"καὶ"},{"text":"ταῖς"},{"text":"προσευχαῖς"},{"text":"νυκτὸς"},{"text":"καὶ"},{"text":"ἡμέρας"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἡ δὲ σπαταλῶσα ζῶσα τέθνηκεν.","tokens":[{"text":"ἡ"},{"text":"δὲ"},{"text":"σπαταλῶσα"},{"text":"ζῶσα"},{"text":"τέθνηκεν"}],"notes":[],"lang":"grc"},{"n":7,"text":"καὶ ταῦτα παράγγελλε, ἵνα ἀνεπίλημπτοι ὦσιν·","tokens":[{"text":"καὶ"},{"text":"ταῦτα"},{"text":"παράγγελλε"},{"text":"ἵνα"},{"text":"ἀνεπίλημπτοι"},{"text":"ὦσιν"}],"notes":[],"lang":"grc"},{"n":8,"text":"εἰ δέ τις τῶν ἰδίων καὶ ⸀ μάλιστα οἰκείων οὐ ⸀ προνοεῖ, τὴν πίστιν ἤρνηται καὶ ἔστιν ἀπίστου χείρων.","tokens":[{"text":"εἰ"},{"text":"δέ"},{"text":"τις"},{"text":"τῶν"},{"text":"ἰδίων"},{"text":"καὶ"},{"text":"μάλιστα"},{"text":"οἰκείων"},{"text":"οὐ"},{"text":"προνοεῖ"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ἤρνηται"},{"text":"καὶ"},{"text":"ἔστιν"},{"text":"ἀπίστου"},{"text":"χείρων"}],"notes":[],"lang":"grc"},{"n":9,"text":"Χήρα καταλεγέσθω μὴ ἔλαττον ἐτῶν ἑξήκοντα γεγονυῖα, ἑνὸς ἀνδρὸς γυνή,","tokens":[{"text":"Χήρα"},{"text":"καταλεγέσθω"},{"text":"μὴ"},{"text":"ἔλαττον"},{"text":"ἐτῶν"},{"text":"ἑξήκοντα"},{"text":"γεγονυῖα"},{"text":"ἑνὸς"},{"text":"ἀνδρὸς"},{"text":"γυνή"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἐν ἔργοις καλοῖς μαρτυρουμένη, εἰ ἐτεκνοτρόφησεν, εἰ ἐξενοδόχησεν, εἰ ἁγίων πόδας ἔνιψεν, εἰ θλιβομένοις ἐπήρκεσεν, εἰ παντὶ ἔργῳ ἀγαθῷ ἐπηκολούθησεν.","tokens":[{"text":"ἐν"},{"text":"ἔργοις"},{"text":"καλοῖς"},{"text":"μαρτυρουμένη"},{"text":"εἰ"},{"text":"ἐτεκνοτρόφησεν"},{"text":"εἰ"},{"text":"ἐξενοδόχησεν"},{"text":"εἰ"},{"text":"ἁγίων"},{"text":"πόδας"},{"text":"ἔνιψεν"},{"text":"εἰ"},{"text":"θλιβομένοις"},{"text":"ἐπήρκεσεν"},{"text":"εἰ"},{"text":"παντὶ"},{"text":"ἔργῳ"},{"text":"ἀγαθῷ"},{"text":"ἐπηκολούθησεν"}],"notes":[],"lang":"grc"},{"n":11,"text":"νεωτέρας δὲ χήρας παραιτοῦ· ὅταν γὰρ καταστρηνιάσωσιν τοῦ Χριστοῦ, γαμεῖν θέλουσιν,","tokens":[{"text":"νεωτέρας"},{"text":"δὲ"},{"text":"χήρας"},{"text":"παραιτοῦ"},{"text":"ὅταν"},{"text":"γὰρ"},{"text":"καταστρηνιάσωσιν"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"γαμεῖν"},{"text":"θέλουσιν"}],"notes":[],"lang":"grc"},{"n":12,"text":"ἔχουσαι κρίμα ὅτι τὴν πρώτην πίστιν ἠθέτησαν·","tokens":[{"text":"ἔχουσαι"},{"text":"κρίμα"},{"text":"ὅτι"},{"text":"τὴν"},{"text":"πρώτην"},{"text":"πίστιν"},{"text":"ἠθέτησαν"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἅμα δὲ καὶ ἀργαὶ μανθάνουσιν, περιερχόμεναι τὰς οἰκίας, οὐ μόνον δὲ ἀργαὶ ἀλλὰ καὶ φλύαροι καὶ περίεργοι, λαλοῦσαι τὰ μὴ δέοντα.","tokens":[{"text":"ἅμα"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἀργαὶ"},{"text":"μανθάνουσιν"},{"text":"περιερχόμεναι"},{"text":"τὰς"},{"text":"οἰκίας"},{"text":"οὐ"},{"text":"μόνον"},{"text":"δὲ"},{"text":"ἀργαὶ"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"φλύαροι"},{"text":"καὶ"},{"text":"περίεργοι"},{"text":"λαλοῦσαι"},{"text":"τὰ"},{"text":"μὴ"},{"text":"δέοντα"}],"notes":[],"lang":"grc"},{"n":14,"text":"βούλομαι οὖν νεωτέρας γαμεῖν, τεκνογονεῖν, οἰκοδεσποτεῖν, μηδεμίαν ἀφορμὴν διδόναι τῷ ἀντικειμένῳ λοιδορίας χάριν·","tokens":[{"text":"βούλομαι"},{"text":"οὖν"},{"text":"νεωτέρας"},{"text":"γαμεῖν"},{"text":"τεκνογονεῖν"},{"text":"οἰκοδεσποτεῖν"},{"text":"μηδεμίαν"},{"text":"ἀφορμὴν"},{"text":"διδόναι"},{"text":"τῷ"},{"text":"ἀντικειμένῳ"},{"text":"λοιδορίας"},{"text":"χάριν"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἤδη γάρ τινες ἐξετράπησαν ὀπίσω τοῦ Σατανᾶ.","tokens":[{"text":"ἤδη"},{"text":"γάρ"},{"text":"τινες"},{"text":"ἐξετράπησαν"},{"text":"ὀπίσω"},{"text":"τοῦ"},{"text":"Σατανᾶ"}],"notes":[],"lang":"grc"},{"n":16,"text":"εἴ ⸀ τις πιστὴ ἔχει χήρας,  ⸀ ἐπαρκείτω αὐταῖς, καὶ μὴ βαρείσθω ἡ ἐκκλησία, ἵνα ταῖς ὄντως χήραις ἐπαρκέσῃ.","tokens":[{"text":"εἴ"},{"text":"τις"},{"text":"πιστὴ"},{"text":"ἔχει"},{"text":"χήρας"},{"text":"ἐπαρκείτω"},{"text":"αὐταῖς"},{"text":"καὶ"},{"text":"μὴ"},{"text":"βαρείσθω"},{"text":"ἡ"},{"text":"ἐκκλησία"},{"text":"ἵνα"},{"text":"ταῖς"},{"text":"ὄντως"},{"text":"χήραις"},{"text":"ἐπαρκέσῃ"}],"notes":[],"lang":"grc"},{"n":17,"text":"Οἱ καλῶς προεστῶτες πρεσβύτεροι διπλῆς τιμῆς ἀξιούσθωσαν, μάλιστα οἱ κοπιῶντες ἐν λόγῳ καὶ διδασκαλίᾳ·","tokens":[{"text":"Οἱ"},{"text":"καλῶς"},{"text":"προεστῶτες"},{"text":"πρεσβύτεροι"},{"text":"διπλῆς"},{"text":"τιμῆς"},{"text":"ἀξιούσθωσαν"},{"text":"μάλιστα"},{"text":"οἱ"},{"text":"κοπιῶντες"},{"text":"ἐν"},{"text":"λόγῳ"},{"text":"καὶ"},{"text":"διδασκαλίᾳ"}],"notes":[],"lang":"grc"},{"n":18,"text":"λέγει γὰρ ἡ γραφή· Βοῦν ἀλοῶντα οὐ φιμώσεις, καί· Ἄξιος ὁ ἐργάτης τοῦ μισθοῦ αὐτοῦ.","tokens":[{"text":"λέγει"},{"text":"γὰρ"},{"text":"ἡ"},{"text":"γραφή"},{"text":"Βοῦν"},{"text":"ἀλοῶντα"},{"text":"οὐ"},{"text":"φιμώσεις"},{"text":"καί"},{"text":"Ἄξιος"},{"text":"ὁ"},{"text":"ἐργάτης"},{"text":"τοῦ"},{"text":"μισθοῦ"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":19,"text":"κατὰ πρεσβυτέρου κατηγορίαν μὴ παραδέχου, ἐκτὸς εἰ μὴ ἐπὶ δύο ἢ τριῶν μαρτύρων·","tokens":[{"text":"κατὰ"},{"text":"πρεσβυτέρου"},{"text":"κατηγορίαν"},{"text":"μὴ"},{"text":"παραδέχου"},{"text":"ἐκτὸς"},{"text":"εἰ"},{"text":"μὴ"},{"text":"ἐπὶ"},{"text":"δύο"},{"text":"ἢ"},{"text":"τριῶν"},{"text":"μαρτύρων"}],"notes":[],"lang":"grc"},{"n":20,"text":"⸀ τοὺς ἁμαρτάνοντας ἐνώπιον πάντων ἔλεγχε, ἵνα καὶ οἱ λοιποὶ φόβον ἔχωσιν.","tokens":[{"text":"τοὺς"},{"text":"ἁμαρτάνοντας"},{"text":"ἐνώπιον"},{"text":"πάντων"},{"text":"ἔλεγχε"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"οἱ"},{"text":"λοιποὶ"},{"text":"φόβον"},{"text":"ἔχωσιν"}],"notes":[],"lang":"grc"},{"n":21,"text":"διαμαρτύρομαι ἐνώπιον τοῦ θεοῦ καὶ ⸂ Χριστοῦ Ἰησοῦ⸃ καὶ τῶν ἐκλεκτῶν ἀγγέλων, ἵνα ταῦτα φυλάξῃς χωρὶς προκρίματος, μηδὲν ποιῶν κατὰ πρόσκλισιν.","tokens":[{"text":"διαμαρτύρομαι"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"καὶ"},{"text":"τῶν"},{"text":"ἐκλεκτῶν"},{"text":"ἀγγέλων"},{"text":"ἵνα"},{"text":"ταῦτα"},{"text":"φυλάξῃς"},{"text":"χωρὶς"},{"text":"προκρίματος"},{"text":"μηδὲν"},{"text":"ποιῶν"},{"text":"κατὰ"},{"text":"πρόσκλισιν"}],"notes":[],"lang":"grc"},{"n":22,"text":"χεῖρας ταχέως μηδενὶ ἐπιτίθει, μηδὲ κοινώνει ἁμαρτίαις ἀλλοτρίαις· σεαυτὸν ἁγνὸν τήρει.","tokens":[{"text":"χεῖρας"},{"text":"ταχέως"},{"text":"μηδενὶ"},{"text":"ἐπιτίθει"},{"text":"μηδὲ"},{"text":"κοινώνει"},{"text":"ἁμαρτίαις"},{"text":"ἀλλοτρίαις"},{"text":"σεαυτὸν"},{"text":"ἁγνὸν"},{"text":"τήρει"}],"notes":[],"lang":"grc"},{"n":23,"text":"μηκέτι ὑδροπότει, ἀλλὰ οἴνῳ ὀλίγῳ χρῶ διὰ τὸν ⸀ στόμαχον καὶ τὰς πυκνάς σου ἀσθενείας.","tokens":[{"text":"μηκέτι"},{"text":"ὑδροπότει"},{"text":"ἀλλὰ"},{"text":"οἴνῳ"},{"text":"ὀλίγῳ"},{"text":"χρῶ"},{"text":"διὰ"},{"text":"τὸν"},{"text":"στόμαχον"},{"text":"καὶ"},{"text":"τὰς"},{"text":"πυκνάς"},{"text":"σου"},{"text":"ἀσθενείας"}],"notes":[],"lang":"grc"},{"n":24,"text":"Τινῶν ἀνθρώπων αἱ ἁμαρτίαι πρόδηλοί εἰσιν, προάγουσαι εἰς κρίσιν, τισὶν δὲ καὶ ἐπακολουθοῦσιν·","tokens":[{"text":"Τινῶν"},{"text":"ἀνθρώπων"},{"text":"αἱ"},{"text":"ἁμαρτίαι"},{"text":"πρόδηλοί"},{"text":"εἰσιν"},{"text":"προάγουσαι"},{"text":"εἰς"},{"text":"κρίσιν"},{"text":"τισὶν"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἐπακολουθοῦσιν"}],"notes":[],"lang":"grc"},{"n":25,"text":"ὡσαύτως καὶ τὰ ⸂ ἔργα τὰ καλὰ⸃  ⸀ πρόδηλα, καὶ τὰ ἄλλως ἔχοντα κρυβῆναι οὐ δύνανται.","tokens":[{"text":"ὡσαύτως"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἔργα"},{"text":"τὰ"},{"text":"καλὰ"},{"text":"πρόδηλα"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἄλλως"},{"text":"ἔχοντα"},{"text":"κρυβῆναι"},{"text":"οὐ"},{"text":"δύνανται"}],"notes":[],"lang":"grc"}],"6":[{"n":1,"text":"Ὅσοι εἰσὶν ὑπὸ ζυγὸν δοῦλοι, τοὺς ἰδίους δεσπότας πάσης τιμῆς ἀξίους ἡγείσθωσαν, ἵνα μὴ τὸ ὄνομα τοῦ θεοῦ καὶ ἡ διδασκαλία βλασφημῆται.","tokens":[{"text":"Ὅσοι"},{"text":"εἰσὶν"},{"text":"ὑπὸ"},{"text":"ζυγὸν"},{"text":"δοῦλοι"},{"text":"τοὺς"},{"text":"ἰδίους"},{"text":"δεσπότας"},{"text":"πάσης"},{"text":"τιμῆς"},{"text":"ἀξίους"},{"text":"ἡγείσθωσαν"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"τὸ"},{"text":"ὄνομα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"ἡ"},{"text":"διδασκαλία"},{"text":"βλασφημῆται"}],"notes":[],"lang":"grc"},{"n":2,"text":"οἱ δὲ πιστοὺς ἔχοντες δεσπότας μὴ καταφρονείτωσαν, ὅτι ἀδελφοί εἰσιν· ἀλλὰ μᾶλλον δουλευέτωσαν, ὅτι πιστοί εἰσιν καὶ ἀγαπητοὶ οἱ τῆς εὐεργεσίας ἀντιλαμβανόμενοι. Ταῦτα δίδασκε καὶ παρακάλει.","tokens":[{"text":"οἱ"},{"text":"δὲ"},{"text":"πιστοὺς"},{"text":"ἔχοντες"},{"text":"δεσπότας"},{"text":"μὴ"},{"text":"καταφρονείτωσαν"},{"text":"ὅτι"},{"text":"ἀδελφοί"},{"text":"εἰσιν"},{"text":"ἀλλὰ"},{"text":"μᾶλλον"},{"text":"δουλευέτωσαν"},{"text":"ὅτι"},{"text":"πιστοί"},{"text":"εἰσιν"},{"text":"καὶ"},{"text":"ἀγαπητοὶ"},{"text":"οἱ"},{"text":"τῆς"},{"text":"εὐεργεσίας"},{"text":"ἀντιλαμβανόμενοι"},{"text":"Ταῦτα"},{"text":"δίδασκε"},{"text":"καὶ"},{"text":"παρακάλει"}],"notes":[],"lang":"grc"},{"n":3,"text":"εἴ τις ἑτεροδιδασκαλεῖ καὶ μὴ προσέρχεται ὑγιαίνουσι λόγοις, τοῖς τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ, καὶ τῇ κατʼ εὐσέβειαν διδασκαλίᾳ,","tokens":[{"text":"εἴ"},{"text":"τις"},{"text":"ἑτεροδιδασκαλεῖ"},{"text":"καὶ"},{"text":"μὴ"},{"text":"προσέρχεται"},{"text":"ὑγιαίνουσι"},{"text":"λόγοις"},{"text":"τοῖς"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"καὶ"},{"text":"τῇ"},{"text":"κατʼ"},{"text":"εὐσέβειαν"},{"text":"διδασκαλίᾳ"}],"notes":[],"lang":"grc"},{"n":4,"text":"τετύφωται, μηδὲν ἐπιστάμενος, ἀλλὰ νοσῶν περὶ ζητήσεις καὶ λογομαχίας, ἐξ ὧν γίνεται φθόνος, ἔρις, βλασφημίαι, ὑπόνοιαι πονηραί,","tokens":[{"text":"τετύφωται"},{"text":"μηδὲν"},{"text":"ἐπιστάμενος"},{"text":"ἀλλὰ"},{"text":"νοσῶν"},{"text":"περὶ"},{"text":"ζητήσεις"},{"text":"καὶ"},{"text":"λογομαχίας"},{"text":"ἐξ"},{"text":"ὧν"},{"text":"γίνεται"},{"text":"φθόνος"},{"text":"ἔρις"},{"text":"βλασφημίαι"},{"text":"ὑπόνοιαι"},{"text":"πονηραί"}],"notes":[],"lang":"grc"},{"n":5,"text":"διαπαρατριβαὶ διεφθαρμένων ἀνθρώπων τὸν νοῦν καὶ ἀπεστερημένων τῆς ἀληθείας, νομιζόντων πορισμὸν εἶναι τὴν ⸀ εὐσέβειαν.","tokens":[{"text":"διαπαρατριβαὶ"},{"text":"διεφθαρμένων"},{"text":"ἀνθρώπων"},{"text":"τὸν"},{"text":"νοῦν"},{"text":"καὶ"},{"text":"ἀπεστερημένων"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"νομιζόντων"},{"text":"πορισμὸν"},{"text":"εἶναι"},{"text":"τὴν"},{"text":"εὐσέβειαν"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἔστιν δὲ πορισμὸς μέγας ἡ εὐσέβεια μετὰ αὐταρκείας·","tokens":[{"text":"ἔστιν"},{"text":"δὲ"},{"text":"πορισμὸς"},{"text":"μέγας"},{"text":"ἡ"},{"text":"εὐσέβεια"},{"text":"μετὰ"},{"text":"αὐταρκείας"}],"notes":[],"lang":"grc"},{"n":7,"text":"οὐδὲν γὰρ εἰσηνέγκαμεν εἰς τὸν κόσμον,  ⸀ ὅτι οὐδὲ ἐξενεγκεῖν τι δυνάμεθα·","tokens":[{"text":"οὐδὲν"},{"text":"γὰρ"},{"text":"εἰσηνέγκαμεν"},{"text":"εἰς"},{"text":"τὸν"},{"text":"κόσμον"},{"text":"ὅτι"},{"text":"οὐδὲ"},{"text":"ἐξενεγκεῖν"},{"text":"τι"},{"text":"δυνάμεθα"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἔχοντες δὲ διατροφὰς καὶ σκεπάσματα, τούτοις ἀρκεσθησόμεθα.","tokens":[{"text":"ἔχοντες"},{"text":"δὲ"},{"text":"διατροφὰς"},{"text":"καὶ"},{"text":"σκεπάσματα"},{"text":"τούτοις"},{"text":"ἀρκεσθησόμεθα"}],"notes":[],"lang":"grc"},{"n":9,"text":"οἱ δὲ βουλόμενοι πλουτεῖν ἐμπίπτουσιν εἰς πειρασμὸν καὶ παγίδα καὶ ἐπιθυμίας πολλὰς ἀνοήτους καὶ βλαβεράς, αἵτινες βυθίζουσι τοὺς ἀνθρώπους εἰς ὄλεθρον καὶ ἀπώλειαν·","tokens":[{"text":"οἱ"},{"text":"δὲ"},{"text":"βουλόμενοι"},{"text":"πλουτεῖν"},{"text":"ἐμπίπτουσιν"},{"text":"εἰς"},{"text":"πειρασμὸν"},{"text":"καὶ"},{"text":"παγίδα"},{"text":"καὶ"},{"text":"ἐπιθυμίας"},{"text":"πολλὰς"},{"text":"ἀνοήτους"},{"text":"καὶ"},{"text":"βλαβεράς"},{"text":"αἵτινες"},{"text":"βυθίζουσι"},{"text":"τοὺς"},{"text":"ἀνθρώπους"},{"text":"εἰς"},{"text":"ὄλεθρον"},{"text":"καὶ"},{"text":"ἀπώλειαν"}],"notes":[],"lang":"grc"},{"n":10,"text":"ῥίζα γὰρ πάντων τῶν κακῶν ἐστιν ἡ φιλαργυρία, ἧς τινες ὀρεγόμενοι ἀπεπλανήθησαν ἀπὸ τῆς πίστεως καὶ ἑαυτοὺς περιέπειραν ὀδύναις πολλαῖς.","tokens":[{"text":"ῥίζα"},{"text":"γὰρ"},{"text":"πάντων"},{"text":"τῶν"},{"text":"κακῶν"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"φιλαργυρία"},{"text":"ἧς"},{"text":"τινες"},{"text":"ὀρεγόμενοι"},{"text":"ἀπεπλανήθησαν"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"καὶ"},{"text":"ἑαυτοὺς"},{"text":"περιέπειραν"},{"text":"ὀδύναις"},{"text":"πολλαῖς"}],"notes":[],"lang":"grc"},{"n":11,"text":"Σὺ δέ, ὦ ἄνθρωπε ⸀ θεοῦ, ταῦτα φεῦγε· δίωκε δὲ δικαιοσύνην, εὐσέβειαν, πίστιν, ἀγάπην, ὑπομονήν,  ⸀ πραϋπαθίαν.","tokens":[{"text":"Σὺ"},{"text":"δέ"},{"text":"ὦ"},{"text":"ἄνθρωπε"},{"text":"θεοῦ"},{"text":"ταῦτα"},{"text":"φεῦγε"},{"text":"δίωκε"},{"text":"δὲ"},{"text":"δικαιοσύνην"},{"text":"εὐσέβειαν"},{"text":"πίστιν"},{"text":"ἀγάπην"},{"text":"ὑπομονήν"},{"text":"πραϋπαθίαν"}],"notes":[],"lang":"grc"},{"n":12,"text":"ἀγωνίζου τὸν καλὸν ἀγῶνα τῆς πίστεως, ἐπιλαβοῦ τῆς αἰωνίου ζωῆς, εἰς ἣν ἐκλήθης καὶ ὡμολόγησας τὴν καλὴν ὁμολογίαν ἐνώπιον πολλῶν μαρτύρων.","tokens":[{"text":"ἀγωνίζου"},{"text":"τὸν"},{"text":"καλὸν"},{"text":"ἀγῶνα"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"ἐπιλαβοῦ"},{"text":"τῆς"},{"text":"αἰωνίου"},{"text":"ζωῆς"},{"text":"εἰς"},{"text":"ἣν"},{"text":"ἐκλήθης"},{"text":"καὶ"},{"text":"ὡμολόγησας"},{"text":"τὴν"},{"text":"καλὴν"},{"text":"ὁμολογίαν"},{"text":"ἐνώπιον"},{"text":"πολλῶν"},{"text":"μαρτύρων"}],"notes":[],"lang":"grc"},{"n":13,"text":"παραγγέλλω σοι ἐνώπιον τοῦ θεοῦ τοῦ ⸀ ζῳογονοῦντος τὰ πάντα καὶ Χριστοῦ Ἰησοῦ τοῦ μαρτυρήσαντος ἐπὶ Ποντίου Πιλάτου τὴν καλὴν ὁμολογίαν,","tokens":[{"text":"παραγγέλλω"},{"text":"σοι"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"τοῦ"},{"text":"ζῳογονοῦντος"},{"text":"τὰ"},{"text":"πάντα"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"μαρτυρήσαντος"},{"text":"ἐπὶ"},{"text":"Ποντίου"},{"text":"Πιλάτου"},{"text":"τὴν"},{"text":"καλὴν"},{"text":"ὁμολογίαν"}],"notes":[],"lang":"grc"},{"n":14,"text":"τηρῆσαί σε τὴν ἐντολὴν ἄσπιλον ἀνεπίλημπτον μέχρι τῆς ἐπιφανείας τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ,","tokens":[{"text":"τηρῆσαί"},{"text":"σε"},{"text":"τὴν"},{"text":"ἐντολὴν"},{"text":"ἄσπιλον"},{"text":"ἀνεπίλημπτον"},{"text":"μέχρι"},{"text":"τῆς"},{"text":"ἐπιφανείας"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἣν καιροῖς ἰδίοις δείξει ὁ μακάριος καὶ μόνος δυνάστης, ὁ βασιλεὺς τῶν βασιλευόντων καὶ κύριος τῶν κυριευόντων,","tokens":[{"text":"ἣν"},{"text":"καιροῖς"},{"text":"ἰδίοις"},{"text":"δείξει"},{"text":"ὁ"},{"text":"μακάριος"},{"text":"καὶ"},{"text":"μόνος"},{"text":"δυνάστης"},{"text":"ὁ"},{"text":"βασιλεὺς"},{"text":"τῶν"},{"text":"βασιλευόντων"},{"text":"καὶ"},{"text":"κύριος"},{"text":"τῶν"},{"text":"κυριευόντων"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὁ μόνος ἔχων ἀθανασίαν, φῶς οἰκῶν ἀπρόσιτον, ὃν εἶδεν οὐδεὶς ἀνθρώπων οὐδὲ ἰδεῖν δύναται· ᾧ τιμὴ καὶ κράτος αἰώνιον· ἀμήν.","tokens":[{"text":"ὁ"},{"text":"μόνος"},{"text":"ἔχων"},{"text":"ἀθανασίαν"},{"text":"φῶς"},{"text":"οἰκῶν"},{"text":"ἀπρόσιτον"},{"text":"ὃν"},{"text":"εἶδεν"},{"text":"οὐδεὶς"},{"text":"ἀνθρώπων"},{"text":"οὐδὲ"},{"text":"ἰδεῖν"},{"text":"δύναται"},{"text":"ᾧ"},{"text":"τιμὴ"},{"text":"καὶ"},{"text":"κράτος"},{"text":"αἰώνιον"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":17,"text":"Τοῖς πλουσίοις ἐν τῷ νῦν αἰῶνι παράγγελλε μὴ ὑψηλοφρονεῖν μηδὲ ἠλπικέναι ἐπὶ πλούτου ἀδηλότητι, ἀλλʼ ⸀ ἐπὶ ⸀ θεῷ τῷ παρέχοντι ἡμῖν πάντα πλουσίως εἰς ἀπόλαυσιν,","tokens":[{"text":"Τοῖς"},{"text":"πλουσίοις"},{"text":"ἐν"},{"text":"τῷ"},{"text":"νῦν"},{"text":"αἰῶνι"},{"text":"παράγγελλε"},{"text":"μὴ"},{"text":"ὑψηλοφρονεῖν"},{"text":"μηδὲ"},{"text":"ἠλπικέναι"},{"text":"ἐπὶ"},{"text":"πλούτου"},{"text":"ἀδηλότητι"},{"text":"ἀλλʼ"},{"text":"ἐπὶ"},{"text":"θεῷ"},{"text":"τῷ"},{"text":"παρέχοντι"},{"text":"ἡμῖν"},{"text":"πάντα"},{"text":"πλουσίως"},{"text":"εἰς"},{"text":"ἀπόλαυσιν"}],"notes":[],"lang":"grc"},{"n":18,"text":"ἀγαθοεργεῖν, πλουτεῖν ἐν ἔργοις καλοῖς, εὐμεταδότους εἶναι, κοινωνικούς,","tokens":[{"text":"ἀγαθοεργεῖν"},{"text":"πλουτεῖν"},{"text":"ἐν"},{"text":"ἔργοις"},{"text":"καλοῖς"},{"text":"εὐμεταδότους"},{"text":"εἶναι"},{"text":"κοινωνικούς"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἀποθησαυρίζοντας ἑαυτοῖς θεμέλιον καλὸν εἰς τὸ μέλλον, ἵνα ἐπιλάβωνται τῆς ⸀ ὄντως ζωῆς.","tokens":[{"text":"ἀποθησαυρίζοντας"},{"text":"ἑαυτοῖς"},{"text":"θεμέλιον"},{"text":"καλὸν"},{"text":"εἰς"},{"text":"τὸ"},{"text":"μέλλον"},{"text":"ἵνα"},{"text":"ἐπιλάβωνται"},{"text":"τῆς"},{"text":"ὄντως"},{"text":"ζωῆς"}],"notes":[],"lang":"grc"},{"n":20,"text":"Ὦ Τιμόθεε, τὴν παραθήκην φύλαξον, ἐκτρεπόμενος τὰς βεβήλους κενοφωνίας καὶ ἀντιθέσεις τῆς ψευδωνύμου γνώσεως,","tokens":[{"text":"Ὦ"},{"text":"Τιμόθεε"},{"text":"τὴν"},{"text":"παραθήκην"},{"text":"φύλαξον"},{"text":"ἐκτρεπόμενος"},{"text":"τὰς"},{"text":"βεβήλους"},{"text":"κενοφωνίας"},{"text":"καὶ"},{"text":"ἀντιθέσεις"},{"text":"τῆς"},{"text":"ψευδωνύμου"},{"text":"γνώσεως"}],"notes":[],"lang":"grc"},{"n":21,"text":"ἥν τινες ἐπαγγελλόμενοι περὶ τὴν πίστιν ἠστόχησαν. Ἡ χάρις ⸂ μεθʼ ὑμῶν⸃.","tokens":[{"text":"ἥν"},{"text":"τινες"},{"text":"ἐπαγγελλόμενοι"},{"text":"περὶ"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ἠστόχησαν"},{"text":"Ἡ"},{"text":"χάρις"},{"text":"μεθʼ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}