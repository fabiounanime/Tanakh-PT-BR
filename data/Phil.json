{"book":{"id":"Phil","name":"Filipenses","testament":"NT","source":"SBLGNT","chapters":4,"verses":104},"chapters":{"1":[{"n":1,"text":"Παῦλος καὶ Τιμόθεος δοῦλοι ⸂ Χριστοῦ Ἰησοῦ⸃ πᾶσιν τοῖς ἁγίοις ἐν Χριστῷ Ἰησοῦ τοῖς οὖσιν ἐν Φιλίπποις σὺν ἐπισκόποις καὶ διακόνοις·","tokens":[{"text":"Παῦλος"},{"text":"καὶ"},{"text":"Τιμόθεος"},{"text":"δοῦλοι"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"πᾶσιν"},{"text":"τοῖς"},{"text":"ἁγίοις"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"τοῖς"},{"text":"οὖσιν"},{"text":"ἐν"},{"text":"Φιλίπποις"},{"text":"σὺν"},{"text":"ἐπισκόποις"},{"text":"καὶ"},{"text":"διακόνοις"}],"notes":[],"lang":"grc"},{"n":2,"text":"χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ.","tokens":[{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":3,"text":"Εὐχαριστῶ τῷ θεῷ μου ἐπὶ πάσῃ τῇ μνείᾳ ὑμῶν","tokens":[{"text":"Εὐχαριστῶ"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"μου"},{"text":"ἐπὶ"},{"text":"πάσῃ"},{"text":"τῇ"},{"text":"μνείᾳ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":4,"text":"πάντοτε ἐν πάσῃ δεήσει μου ὑπὲρ πάντων ὑμῶν, μετὰ χαρᾶς τὴν δέησιν ποιούμενος,","tokens":[{"text":"πάντοτε"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"δεήσει"},{"text":"μου"},{"text":"ὑπὲρ"},{"text":"πάντων"},{"text":"ὑμῶν"},{"text":"μετὰ"},{"text":"χαρᾶς"},{"text":"τὴν"},{"text":"δέησιν"},{"text":"ποιούμενος"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἐπὶ τῇ κοινωνίᾳ ὑμῶν εἰς τὸ εὐαγγέλιον ἀπὸ ⸀ τῆς πρώτης ἡμέρας ἄχρι τοῦ νῦν,","tokens":[{"text":"ἐπὶ"},{"text":"τῇ"},{"text":"κοινωνίᾳ"},{"text":"ὑμῶν"},{"text":"εἰς"},{"text":"τὸ"},{"text":"εὐαγγέλιον"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"πρώτης"},{"text":"ἡμέρας"},{"text":"ἄχρι"},{"text":"τοῦ"},{"text":"νῦν"}],"notes":[],"lang":"grc"},{"n":6,"text":"πεποιθὼς αὐτὸ τοῦτο ὅτι ὁ ἐναρξάμενος ἐν ὑμῖν ἔργον ἀγαθὸν ἐπιτελέσει ἄχρι ἡμέρας ⸂ Χριστοῦ Ἰησοῦ⸃·","tokens":[{"text":"πεποιθὼς"},{"text":"αὐτὸ"},{"text":"τοῦτο"},{"text":"ὅτι"},{"text":"ὁ"},{"text":"ἐναρξάμενος"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἔργον"},{"text":"ἀγαθὸν"},{"text":"ἐπιτελέσει"},{"text":"ἄχρι"},{"text":"ἡμέρας"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":7,"text":"καθώς ἐστιν δίκαιον ἐμοὶ τοῦτο φρονεῖν ὑπὲρ πάντων ὑμῶν, διὰ τὸ ἔχειν με ἐν τῇ καρδίᾳ ὑμᾶς, ἔν τε τοῖς δεσμοῖς μου καὶ ἐν τῇ ἀπολογίᾳ καὶ βεβαιώσει τοῦ εὐαγγελίου συγκοινωνούς μου τῆς χάριτος πάντας ὑμᾶς ὄντας·","tokens":[{"text":"καθώς"},{"text":"ἐστιν"},{"text":"δίκαιον"},{"text":"ἐμοὶ"},{"text":"τοῦτο"},{"text":"φρονεῖν"},{"text":"ὑπὲρ"},{"text":"πάντων"},{"text":"ὑμῶν"},{"text":"διὰ"},{"text":"τὸ"},{"text":"ἔχειν"},{"text":"με"},{"text":"ἐν"},{"text":"τῇ"},{"text":"καρδίᾳ"},{"text":"ὑμᾶς"},{"text":"ἔν"},{"text":"τε"},{"text":"τοῖς"},{"text":"δεσμοῖς"},{"text":"μου"},{"text":"καὶ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀπολογίᾳ"},{"text":"καὶ"},{"text":"βεβαιώσει"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"συγκοινωνούς"},{"text":"μου"},{"text":"τῆς"},{"text":"χάριτος"},{"text":"πάντας"},{"text":"ὑμᾶς"},{"text":"ὄντας"}],"notes":[],"lang":"grc"},{"n":8,"text":"μάρτυς γάρ ⸀ μου ὁ θεός, ὡς ἐπιποθῶ πάντας ὑμᾶς ἐν σπλάγχνοις ⸂ Χριστοῦ Ἰησοῦ⸃.","tokens":[{"text":"μάρτυς"},{"text":"γάρ"},{"text":"μου"},{"text":"ὁ"},{"text":"θεός"},{"text":"ὡς"},{"text":"ἐπιποθῶ"},{"text":"πάντας"},{"text":"ὑμᾶς"},{"text":"ἐν"},{"text":"σπλάγχνοις"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"καὶ τοῦτο προσεύχομαι ἵνα ἡ ἀγάπη ὑμῶν ἔτι μᾶλλον καὶ μᾶλλον περισσεύῃ ἐν ἐπιγνώσει καὶ πάσῃ αἰσθήσει,","tokens":[{"text":"καὶ"},{"text":"τοῦτο"},{"text":"προσεύχομαι"},{"text":"ἵνα"},{"text":"ἡ"},{"text":"ἀγάπη"},{"text":"ὑμῶν"},{"text":"ἔτι"},{"text":"μᾶλλον"},{"text":"καὶ"},{"text":"μᾶλλον"},{"text":"περισσεύῃ"},{"text":"ἐν"},{"text":"ἐπιγνώσει"},{"text":"καὶ"},{"text":"πάσῃ"},{"text":"αἰσθήσει"}],"notes":[],"lang":"grc"},{"n":10,"text":"εἰς τὸ δοκιμάζειν ὑμᾶς τὰ διαφέροντα, ἵνα ἦτε εἰλικρινεῖς καὶ ἀπρόσκοποι εἰς ἡμέραν Χριστοῦ,","tokens":[{"text":"εἰς"},{"text":"τὸ"},{"text":"δοκιμάζειν"},{"text":"ὑμᾶς"},{"text":"τὰ"},{"text":"διαφέροντα"},{"text":"ἵνα"},{"text":"ἦτε"},{"text":"εἰλικρινεῖς"},{"text":"καὶ"},{"text":"ἀπρόσκοποι"},{"text":"εἰς"},{"text":"ἡμέραν"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":11,"text":"πεπληρωμένοι ⸂ καρπὸν δικαιοσύνης τὸν⸃ διὰ Ἰησοῦ Χριστοῦ εἰς δόξαν καὶ ἔπαινον θεοῦ.","tokens":[{"text":"πεπληρωμένοι"},{"text":"καρπὸν"},{"text":"δικαιοσύνης"},{"text":"τὸν"},{"text":"διὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"εἰς"},{"text":"δόξαν"},{"text":"καὶ"},{"text":"ἔπαινον"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":12,"text":"Γινώσκειν δὲ ὑμᾶς βούλομαι, ἀδελφοί, ὅτι τὰ κατʼ ἐμὲ μᾶλλον εἰς προκοπὴν τοῦ εὐαγγελίου ἐλήλυθεν,","tokens":[{"text":"Γινώσκειν"},{"text":"δὲ"},{"text":"ὑμᾶς"},{"text":"βούλομαι"},{"text":"ἀδελφοί"},{"text":"ὅτι"},{"text":"τὰ"},{"text":"κατʼ"},{"text":"ἐμὲ"},{"text":"μᾶλλον"},{"text":"εἰς"},{"text":"προκοπὴν"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"ἐλήλυθεν"}],"notes":[],"lang":"grc"},{"n":13,"text":"ὥστε τοὺς δεσμούς μου φανεροὺς ἐν Χριστῷ γενέσθαι ἐν ὅλῳ τῷ πραιτωρίῳ καὶ τοῖς λοιποῖς πᾶσιν,","tokens":[{"text":"ὥστε"},{"text":"τοὺς"},{"text":"δεσμούς"},{"text":"μου"},{"text":"φανεροὺς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"γενέσθαι"},{"text":"ἐν"},{"text":"ὅλῳ"},{"text":"τῷ"},{"text":"πραιτωρίῳ"},{"text":"καὶ"},{"text":"τοῖς"},{"text":"λοιποῖς"},{"text":"πᾶσιν"}],"notes":[],"lang":"grc"},{"n":14,"text":"καὶ τοὺς πλείονας τῶν ἀδελφῶν ἐν κυρίῳ πεποιθότας τοῖς δεσμοῖς μου περισσοτέρως τολμᾶν ἀφόβως τὸν ⸀ λόγον λαλεῖν.","tokens":[{"text":"καὶ"},{"text":"τοὺς"},{"text":"πλείονας"},{"text":"τῶν"},{"text":"ἀδελφῶν"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"πεποιθότας"},{"text":"τοῖς"},{"text":"δεσμοῖς"},{"text":"μου"},{"text":"περισσοτέρως"},{"text":"τολμᾶν"},{"text":"ἀφόβως"},{"text":"τὸν"},{"text":"λόγον"},{"text":"λαλεῖν"}],"notes":[],"lang":"grc"},{"n":15,"text":"Τινὲς μὲν καὶ διὰ φθόνον καὶ ἔριν, τινὲς δὲ καὶ διʼ εὐδοκίαν τὸν Χριστὸν κηρύσσουσιν·","tokens":[{"text":"Τινὲς"},{"text":"μὲν"},{"text":"καὶ"},{"text":"διὰ"},{"text":"φθόνον"},{"text":"καὶ"},{"text":"ἔριν"},{"text":"τινὲς"},{"text":"δὲ"},{"text":"καὶ"},{"text":"διʼ"},{"text":"εὐδοκίαν"},{"text":"τὸν"},{"text":"Χριστὸν"},{"text":"κηρύσσουσιν"}],"notes":[],"lang":"grc"},{"n":16,"text":"οἱ μὲν ἐξ ⸂ ἀγάπης, εἰδότες ὅτι εἰς ἀπολογίαν τοῦ εὐαγγελίου κεῖμαι⸃,","tokens":[{"text":"οἱ"},{"text":"μὲν"},{"text":"ἐξ"},{"text":"ἀγάπης"},{"text":"εἰδότες"},{"text":"ὅτι"},{"text":"εἰς"},{"text":"ἀπολογίαν"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"κεῖμαι"}],"notes":[],"lang":"grc"},{"n":17,"text":"οἱ δὲ ἐξ ⸂ ἐριθείας τὸν Χριστὸν καταγγέλλουσιν, οὐχ ἁγνῶς, οἰόμενοι θλῖψιν ἐγείρειν τοῖς δεσμοῖς μου⸃.","tokens":[{"text":"οἱ"},{"text":"δὲ"},{"text":"ἐξ"},{"text":"ἐριθείας"},{"text":"τὸν"},{"text":"Χριστὸν"},{"text":"καταγγέλλουσιν"},{"text":"οὐχ"},{"text":"ἁγνῶς"},{"text":"οἰόμενοι"},{"text":"θλῖψιν"},{"text":"ἐγείρειν"},{"text":"τοῖς"},{"text":"δεσμοῖς"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":18,"text":"τί γάρ; πλὴν ⸀ ὅτι παντὶ τρόπῳ, εἴτε προφάσει εἴτε ἀληθείᾳ, Χριστὸς καταγγέλλεται, καὶ ἐν τούτῳ χαίρω· ἀλλὰ καὶ χαρήσομαι,","tokens":[{"text":"τί"},{"text":"γάρ"},{"text":"πλὴν"},{"text":"ὅτι"},{"text":"παντὶ"},{"text":"τρόπῳ"},{"text":"εἴτε"},{"text":"προφάσει"},{"text":"εἴτε"},{"text":"ἀληθείᾳ"},{"text":"Χριστὸς"},{"text":"καταγγέλλεται"},{"text":"καὶ"},{"text":"ἐν"},{"text":"τούτῳ"},{"text":"χαίρω"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"χαρήσομαι"}],"notes":[],"lang":"grc"},{"n":19,"text":"οἶδα γὰρ ὅτι τοῦτό μοι ἀποβήσεται εἰς σωτηρίαν διὰ τῆς ὑμῶν δεήσεως καὶ ἐπιχορηγίας τοῦ πνεύματος Ἰησοῦ Χριστοῦ,","tokens":[{"text":"οἶδα"},{"text":"γὰρ"},{"text":"ὅτι"},{"text":"τοῦτό"},{"text":"μοι"},{"text":"ἀποβήσεται"},{"text":"εἰς"},{"text":"σωτηρίαν"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ὑμῶν"},{"text":"δεήσεως"},{"text":"καὶ"},{"text":"ἐπιχορηγίας"},{"text":"τοῦ"},{"text":"πνεύματος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":20,"text":"κατὰ τὴν ἀποκαραδοκίαν καὶ ἐλπίδα μου ὅτι ἐν οὐδενὶ αἰσχυνθήσομαι, ἀλλʼ ἐν πάσῃ παρρησίᾳ ὡς πάντοτε καὶ νῦν μεγαλυνθήσεται Χριστὸς ἐν τῷ σώματί μου, εἴτε διὰ ζωῆς εἴτε διὰ θανάτου.","tokens":[{"text":"κατὰ"},{"text":"τὴν"},{"text":"ἀποκαραδοκίαν"},{"text":"καὶ"},{"text":"ἐλπίδα"},{"text":"μου"},{"text":"ὅτι"},{"text":"ἐν"},{"text":"οὐδενὶ"},{"text":"αἰσχυνθήσομαι"},{"text":"ἀλλʼ"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"παρρησίᾳ"},{"text":"ὡς"},{"text":"πάντοτε"},{"text":"καὶ"},{"text":"νῦν"},{"text":"μεγαλυνθήσεται"},{"text":"Χριστὸς"},{"text":"ἐν"},{"text":"τῷ"},{"text":"σώματί"},{"text":"μου"},{"text":"εἴτε"},{"text":"διὰ"},{"text":"ζωῆς"},{"text":"εἴτε"},{"text":"διὰ"},{"text":"θανάτου"}],"notes":[],"lang":"grc"},{"n":21,"text":"ἐμοὶ γὰρ τὸ ζῆν Χριστὸς καὶ τὸ ἀποθανεῖν κέρδος.","tokens":[{"text":"ἐμοὶ"},{"text":"γὰρ"},{"text":"τὸ"},{"text":"ζῆν"},{"text":"Χριστὸς"},{"text":"καὶ"},{"text":"τὸ"},{"text":"ἀποθανεῖν"},{"text":"κέρδος"}],"notes":[],"lang":"grc"},{"n":22,"text":"εἰ δὲ τὸ ζῆν ἐν σαρκί, τοῦτό μοι καρπὸς ἔργου— καὶ τί αἱρήσομαι οὐ γνωρίζω·","tokens":[{"text":"εἰ"},{"text":"δὲ"},{"text":"τὸ"},{"text":"ζῆν"},{"text":"ἐν"},{"text":"σαρκί"},{"text":"τοῦτό"},{"text":"μοι"},{"text":"καρπὸς"},{"text":"ἔργου"},{"text":"καὶ"},{"text":"τί"},{"text":"αἱρήσομαι"},{"text":"οὐ"},{"text":"γνωρίζω"}],"notes":[],"lang":"grc"},{"n":23,"text":"συνέχομαι δὲ ἐκ τῶν δύο, τὴν ἐπιθυμίαν ἔχων εἰς τὸ ἀναλῦσαι καὶ σὺν Χριστῷ εἶναι, πολλῷ ⸀ γὰρ μᾶλλον κρεῖσσον,","tokens":[{"text":"συνέχομαι"},{"text":"δὲ"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"δύο"},{"text":"τὴν"},{"text":"ἐπιθυμίαν"},{"text":"ἔχων"},{"text":"εἰς"},{"text":"τὸ"},{"text":"ἀναλῦσαι"},{"text":"καὶ"},{"text":"σὺν"},{"text":"Χριστῷ"},{"text":"εἶναι"},{"text":"πολλῷ"},{"text":"γὰρ"},{"text":"μᾶλλον"},{"text":"κρεῖσσον"}],"notes":[],"lang":"grc"},{"n":24,"text":"τὸ δὲ ἐπιμένειν ⸀ ἐν τῇ σαρκὶ ἀναγκαιότερον διʼ ὑμᾶς.","tokens":[{"text":"τὸ"},{"text":"δὲ"},{"text":"ἐπιμένειν"},{"text":"ἐν"},{"text":"τῇ"},{"text":"σαρκὶ"},{"text":"ἀναγκαιότερον"},{"text":"διʼ"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":25,"text":"καὶ τοῦτο πεποιθὼς οἶδα ὅτι μενῶ καὶ ⸀ παραμενῶ πᾶσιν ὑμῖν εἰς τὴν ὑμῶν προκοπὴν καὶ χαρὰν τῆς πίστεως,","tokens":[{"text":"καὶ"},{"text":"τοῦτο"},{"text":"πεποιθὼς"},{"text":"οἶδα"},{"text":"ὅτι"},{"text":"μενῶ"},{"text":"καὶ"},{"text":"παραμενῶ"},{"text":"πᾶσιν"},{"text":"ὑμῖν"},{"text":"εἰς"},{"text":"τὴν"},{"text":"ὑμῶν"},{"text":"προκοπὴν"},{"text":"καὶ"},{"text":"χαρὰν"},{"text":"τῆς"},{"text":"πίστεως"}],"notes":[],"lang":"grc"},{"n":26,"text":"ἵνα τὸ καύχημα ὑμῶν περισσεύῃ ἐν Χριστῷ Ἰησοῦ ἐν ἐμοὶ διὰ τῆς ἐμῆς παρουσίας πάλιν πρὸς ὑμᾶς.","tokens":[{"text":"ἵνα"},{"text":"τὸ"},{"text":"καύχημα"},{"text":"ὑμῶν"},{"text":"περισσεύῃ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"ἐν"},{"text":"ἐμοὶ"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ἐμῆς"},{"text":"παρουσίας"},{"text":"πάλιν"},{"text":"πρὸς"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":27,"text":"Μόνον ἀξίως τοῦ εὐαγγελίου τοῦ Χριστοῦ πολιτεύεσθε, ἵνα εἴτε ἐλθὼν καὶ ἰδὼν ὑμᾶς εἴτε ἀπὼν ⸀ ἀκούω τὰ περὶ ὑμῶν, ὅτι στήκετε ἐν ἑνὶ πνεύματι, μιᾷ ψυχῇ συναθλοῦντες τῇ πίστει τοῦ εὐαγγελίου,","tokens":[{"text":"Μόνον"},{"text":"ἀξίως"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"πολιτεύεσθε"},{"text":"ἵνα"},{"text":"εἴτε"},{"text":"ἐλθὼν"},{"text":"καὶ"},{"text":"ἰδὼν"},{"text":"ὑμᾶς"},{"text":"εἴτε"},{"text":"ἀπὼν"},{"text":"ἀκούω"},{"text":"τὰ"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"ὅτι"},{"text":"στήκετε"},{"text":"ἐν"},{"text":"ἑνὶ"},{"text":"πνεύματι"},{"text":"μιᾷ"},{"text":"ψυχῇ"},{"text":"συναθλοῦντες"},{"text":"τῇ"},{"text":"πίστει"},{"text":"τοῦ"},{"text":"εὐαγγελίου"}],"notes":[],"lang":"grc"},{"n":28,"text":"καὶ μὴ πτυρόμενοι ἐν μηδενὶ ὑπὸ τῶν ἀντικειμένων ( ἥτις ⸂ ἐστὶν αὐτοῖς⸃ ἔνδειξις ἀπωλείας,  ⸀ ὑμῶν δὲ σωτηρίας, καὶ τοῦτο ἀπὸ θεοῦ,","tokens":[{"text":"καὶ"},{"text":"μὴ"},{"text":"πτυρόμενοι"},{"text":"ἐν"},{"text":"μηδενὶ"},{"text":"ὑπὸ"},{"text":"τῶν"},{"text":"ἀντικειμένων"},{"text":"ἥτις"},{"text":"ἐστὶν"},{"text":"αὐτοῖς"},{"text":"ἔνδειξις"},{"text":"ἀπωλείας"},{"text":"ὑμῶν"},{"text":"δὲ"},{"text":"σωτηρίας"},{"text":"καὶ"},{"text":"τοῦτο"},{"text":"ἀπὸ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":29,"text":"ὅτι ὑμῖν ἐχαρίσθη τὸ ὑπὲρ Χριστοῦ, οὐ μόνον τὸ εἰς αὐτὸν πιστεύειν ἀλλὰ καὶ τὸ ὑπὲρ αὐτοῦ πάσχειν),","tokens":[{"text":"ὅτι"},{"text":"ὑμῖν"},{"text":"ἐχαρίσθη"},{"text":"τὸ"},{"text":"ὑπὲρ"},{"text":"Χριστοῦ"},{"text":"οὐ"},{"text":"μόνον"},{"text":"τὸ"},{"text":"εἰς"},{"text":"αὐτὸν"},{"text":"πιστεύειν"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"τὸ"},{"text":"ὑπὲρ"},{"text":"αὐτοῦ"},{"text":"πάσχειν"}],"notes":[],"lang":"grc"},{"n":30,"text":"τὸν αὐτὸν ἀγῶνα ἔχοντες οἷον εἴδετε ἐν ἐμοὶ καὶ νῦν ἀκούετε ἐν ἐμοί.","tokens":[{"text":"τὸν"},{"text":"αὐτὸν"},{"text":"ἀγῶνα"},{"text":"ἔχοντες"},{"text":"οἷον"},{"text":"εἴδετε"},{"text":"ἐν"},{"text":"ἐμοὶ"},{"text":"καὶ"},{"text":"νῦν"},{"text":"ἀκούετε"},{"text":"ἐν"},{"text":"ἐμοί"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Εἴ τις οὖν παράκλησις ἐν Χριστῷ, εἴ τι παραμύθιον ἀγάπης, εἴ τις κοινωνία πνεύματος, εἴ τις σπλάγχνα καὶ οἰκτιρμοί,","tokens":[{"text":"Εἴ"},{"text":"τις"},{"text":"οὖν"},{"text":"παράκλησις"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"εἴ"},{"text":"τι"},{"text":"παραμύθιον"},{"text":"ἀγάπης"},{"text":"εἴ"},{"text":"τις"},{"text":"κοινωνία"},{"text":"πνεύματος"},{"text":"εἴ"},{"text":"τις"},{"text":"σπλάγχνα"},{"text":"καὶ"},{"text":"οἰκτιρμοί"}],"notes":[],"lang":"grc"},{"n":2,"text":"πληρώσατέ μου τὴν χαρὰν ἵνα τὸ αὐτὸ φρονῆτε, τὴν αὐτὴν ἀγάπην ἔχοντες, σύμψυχοι, τὸ ἓν φρονοῦντες,","tokens":[{"text":"πληρώσατέ"},{"text":"μου"},{"text":"τὴν"},{"text":"χαρὰν"},{"text":"ἵνα"},{"text":"τὸ"},{"text":"αὐτὸ"},{"text":"φρονῆτε"},{"text":"τὴν"},{"text":"αὐτὴν"},{"text":"ἀγάπην"},{"text":"ἔχοντες"},{"text":"σύμψυχοι"},{"text":"τὸ"},{"text":"ἓν"},{"text":"φρονοῦντες"}],"notes":[],"lang":"grc"},{"n":3,"text":"μηδὲν κατʼ ἐριθείαν ⸂ μηδὲ κατὰ⸃ κενοδοξίαν, ἀλλὰ τῇ ταπεινοφροσύνῃ ἀλλήλους ἡγούμενοι ὑπερέχοντας ἑαυτῶν,","tokens":[{"text":"μηδὲν"},{"text":"κατʼ"},{"text":"ἐριθείαν"},{"text":"μηδὲ"},{"text":"κατὰ"},{"text":"κενοδοξίαν"},{"text":"ἀλλὰ"},{"text":"τῇ"},{"text":"ταπεινοφροσύνῃ"},{"text":"ἀλλήλους"},{"text":"ἡγούμενοι"},{"text":"ὑπερέχοντας"},{"text":"ἑαυτῶν"}],"notes":[],"lang":"grc"},{"n":4,"text":"μὴ τὰ ἑαυτῶν ⸀ ἕκαστοι ⸀ σκοποῦντες, ἀλλὰ καὶ τὰ ἑτέρων ⸁ ἕκαστοι.","tokens":[{"text":"μὴ"},{"text":"τὰ"},{"text":"ἑαυτῶν"},{"text":"ἕκαστοι"},{"text":"σκοποῦντες"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἑτέρων"},{"text":"ἕκαστοι"}],"notes":[],"lang":"grc"},{"n":5,"text":"τοῦτο ⸀ φρονεῖτε ἐν ὑμῖν ὃ καὶ ἐν Χριστῷ Ἰησοῦ,","tokens":[{"text":"τοῦτο"},{"text":"φρονεῖτε"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ὃ"},{"text":"καὶ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὃς ἐν μορφῇ θεοῦ ὑπάρχων οὐχ ἁρπαγμὸν ἡγήσατο τὸ εἶναι ἴσα θεῷ,","tokens":[{"text":"ὃς"},{"text":"ἐν"},{"text":"μορφῇ"},{"text":"θεοῦ"},{"text":"ὑπάρχων"},{"text":"οὐχ"},{"text":"ἁρπαγμὸν"},{"text":"ἡγήσατο"},{"text":"τὸ"},{"text":"εἶναι"},{"text":"ἴσα"},{"text":"θεῷ"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἀλλὰ ἑαυτὸν ἐκένωσεν μορφὴν δούλου λαβών, ἐν ὁμοιώματι ἀνθρώπων γενόμενος· καὶ σχήματι εὑρεθεὶς ὡς ἄνθρωπος","tokens":[{"text":"ἀλλὰ"},{"text":"ἑαυτὸν"},{"text":"ἐκένωσεν"},{"text":"μορφὴν"},{"text":"δούλου"},{"text":"λαβών"},{"text":"ἐν"},{"text":"ὁμοιώματι"},{"text":"ἀνθρώπων"},{"text":"γενόμενος"},{"text":"καὶ"},{"text":"σχήματι"},{"text":"εὑρεθεὶς"},{"text":"ὡς"},{"text":"ἄνθρωπος"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἐταπείνωσεν ἑαυτὸν γενόμενος ὑπήκοος μέχρι θανάτου, θανάτου δὲ σταυροῦ·","tokens":[{"text":"ἐταπείνωσεν"},{"text":"ἑαυτὸν"},{"text":"γενόμενος"},{"text":"ὑπήκοος"},{"text":"μέχρι"},{"text":"θανάτου"},{"text":"θανάτου"},{"text":"δὲ"},{"text":"σταυροῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"διὸ καὶ ὁ θεὸς αὐτὸν ὑπερύψωσεν, καὶ ἐχαρίσατο αὐτῷ ⸀ τὸ ὄνομα τὸ ὑπὲρ πᾶν ὄνομα,","tokens":[{"text":"διὸ"},{"text":"καὶ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"αὐτὸν"},{"text":"ὑπερύψωσεν"},{"text":"καὶ"},{"text":"ἐχαρίσατο"},{"text":"αὐτῷ"},{"text":"τὸ"},{"text":"ὄνομα"},{"text":"τὸ"},{"text":"ὑπὲρ"},{"text":"πᾶν"},{"text":"ὄνομα"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἵνα ἐν τῷ ὀνόματι Ἰησοῦ πᾶν γόνυ κάμψῃ ἐπουρανίων καὶ ἐπιγείων καὶ καταχθονίων,","tokens":[{"text":"ἵνα"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ὀνόματι"},{"text":"Ἰησοῦ"},{"text":"πᾶν"},{"text":"γόνυ"},{"text":"κάμψῃ"},{"text":"ἐπουρανίων"},{"text":"καὶ"},{"text":"ἐπιγείων"},{"text":"καὶ"},{"text":"καταχθονίων"}],"notes":[],"lang":"grc"},{"n":11,"text":"καὶ πᾶσα γλῶσσα ἐξομολογήσηται ὅτι κύριος Ἰησοῦς Χριστὸς εἰς δόξαν θεοῦ πατρός.","tokens":[{"text":"καὶ"},{"text":"πᾶσα"},{"text":"γλῶσσα"},{"text":"ἐξομολογήσηται"},{"text":"ὅτι"},{"text":"κύριος"},{"text":"Ἰησοῦς"},{"text":"Χριστὸς"},{"text":"εἰς"},{"text":"δόξαν"},{"text":"θεοῦ"},{"text":"πατρός"}],"notes":[],"lang":"grc"},{"n":12,"text":"Ὥστε, ἀγαπητοί μου, καθὼς πάντοτε ὑπηκούσατε, μὴ ὡς ἐν τῇ παρουσίᾳ μου μόνον ἀλλὰ νῦν πολλῷ μᾶλλον ἐν τῇ ἀπουσίᾳ μου, μετὰ φόβου καὶ τρόμου τὴν ἑαυτῶν σωτηρίαν κατεργάζεσθε,","tokens":[{"text":"Ὥστε"},{"text":"ἀγαπητοί"},{"text":"μου"},{"text":"καθὼς"},{"text":"πάντοτε"},{"text":"ὑπηκούσατε"},{"text":"μὴ"},{"text":"ὡς"},{"text":"ἐν"},{"text":"τῇ"},{"text":"παρουσίᾳ"},{"text":"μου"},{"text":"μόνον"},{"text":"ἀλλὰ"},{"text":"νῦν"},{"text":"πολλῷ"},{"text":"μᾶλλον"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀπουσίᾳ"},{"text":"μου"},{"text":"μετὰ"},{"text":"φόβου"},{"text":"καὶ"},{"text":"τρόμου"},{"text":"τὴν"},{"text":"ἑαυτῶν"},{"text":"σωτηρίαν"},{"text":"κατεργάζεσθε"}],"notes":[],"lang":"grc"},{"n":13,"text":"⸀ θεὸς γάρ ἐστιν ὁ ἐνεργῶν ἐν ὑμῖν καὶ τὸ θέλειν καὶ τὸ ἐνεργεῖν ὑπὲρ τῆς εὐδοκίας.","tokens":[{"text":"θεὸς"},{"text":"γάρ"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"ἐνεργῶν"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"τὸ"},{"text":"θέλειν"},{"text":"καὶ"},{"text":"τὸ"},{"text":"ἐνεργεῖν"},{"text":"ὑπὲρ"},{"text":"τῆς"},{"text":"εὐδοκίας"}],"notes":[],"lang":"grc"},{"n":14,"text":"Πάντα ποιεῖτε χωρὶς γογγυσμῶν καὶ διαλογισμῶν,","tokens":[{"text":"Πάντα"},{"text":"ποιεῖτε"},{"text":"χωρὶς"},{"text":"γογγυσμῶν"},{"text":"καὶ"},{"text":"διαλογισμῶν"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἵνα γένησθε ἄμεμπτοι καὶ ἀκέραιοι, τέκνα θεοῦ ⸂ ἄμωμα μέσον⸃ γενεᾶς σκολιᾶς καὶ διεστραμμένης, ἐν οἷς φαίνεσθε ὡς φωστῆρες ἐν κόσμῳ","tokens":[{"text":"ἵνα"},{"text":"γένησθε"},{"text":"ἄμεμπτοι"},{"text":"καὶ"},{"text":"ἀκέραιοι"},{"text":"τέκνα"},{"text":"θεοῦ"},{"text":"ἄμωμα"},{"text":"μέσον"},{"text":"γενεᾶς"},{"text":"σκολιᾶς"},{"text":"καὶ"},{"text":"διεστραμμένης"},{"text":"ἐν"},{"text":"οἷς"},{"text":"φαίνεσθε"},{"text":"ὡς"},{"text":"φωστῆρες"},{"text":"ἐν"},{"text":"κόσμῳ"}],"notes":[],"lang":"grc"},{"n":16,"text":"λόγον ζωῆς ἐπέχοντες, εἰς καύχημα ἐμοὶ εἰς ἡμέραν Χριστοῦ, ὅτι οὐκ εἰς κενὸν ἔδραμον οὐδὲ εἰς κενὸν ἐκοπίασα.","tokens":[{"text":"λόγον"},{"text":"ζωῆς"},{"text":"ἐπέχοντες"},{"text":"εἰς"},{"text":"καύχημα"},{"text":"ἐμοὶ"},{"text":"εἰς"},{"text":"ἡμέραν"},{"text":"Χριστοῦ"},{"text":"ὅτι"},{"text":"οὐκ"},{"text":"εἰς"},{"text":"κενὸν"},{"text":"ἔδραμον"},{"text":"οὐδὲ"},{"text":"εἰς"},{"text":"κενὸν"},{"text":"ἐκοπίασα"}],"notes":[],"lang":"grc"},{"n":17,"text":"ἀλλὰ εἰ καὶ σπένδομαι ἐπὶ τῇ θυσίᾳ καὶ λειτουργίᾳ τῆς πίστεως ὑμῶν, χαίρω καὶ συγχαίρω πᾶσιν ὑμῖν·","tokens":[{"text":"ἀλλὰ"},{"text":"εἰ"},{"text":"καὶ"},{"text":"σπένδομαι"},{"text":"ἐπὶ"},{"text":"τῇ"},{"text":"θυσίᾳ"},{"text":"καὶ"},{"text":"λειτουργίᾳ"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"ὑμῶν"},{"text":"χαίρω"},{"text":"καὶ"},{"text":"συγχαίρω"},{"text":"πᾶσιν"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":18,"text":"τὸ δὲ αὐτὸ καὶ ὑμεῖς χαίρετε καὶ συγχαίρετέ μοι.","tokens":[{"text":"τὸ"},{"text":"δὲ"},{"text":"αὐτὸ"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"χαίρετε"},{"text":"καὶ"},{"text":"συγχαίρετέ"},{"text":"μοι"}],"notes":[],"lang":"grc"},{"n":19,"text":"Ἐλπίζω δὲ ἐν κυρίῳ Ἰησοῦ Τιμόθεον ταχέως πέμψαι ὑμῖν, ἵνα κἀγὼ εὐψυχῶ γνοὺς τὰ περὶ ὑμῶν.","tokens":[{"text":"Ἐλπίζω"},{"text":"δὲ"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"Ἰησοῦ"},{"text":"Τιμόθεον"},{"text":"ταχέως"},{"text":"πέμψαι"},{"text":"ὑμῖν"},{"text":"ἵνα"},{"text":"κἀγὼ"},{"text":"εὐψυχῶ"},{"text":"γνοὺς"},{"text":"τὰ"},{"text":"περὶ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":20,"text":"οὐδένα γὰρ ἔχω ἰσόψυχον ὅστις γνησίως τὰ περὶ ὑμῶν μεριμνήσει,","tokens":[{"text":"οὐδένα"},{"text":"γὰρ"},{"text":"ἔχω"},{"text":"ἰσόψυχον"},{"text":"ὅστις"},{"text":"γνησίως"},{"text":"τὰ"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"μεριμνήσει"}],"notes":[],"lang":"grc"},{"n":21,"text":"οἱ πάντες γὰρ τὰ ἑαυτῶν ζητοῦσιν, οὐ τὰ ⸂ Ἰησοῦ Χριστοῦ⸃.","tokens":[{"text":"οἱ"},{"text":"πάντες"},{"text":"γὰρ"},{"text":"τὰ"},{"text":"ἑαυτῶν"},{"text":"ζητοῦσιν"},{"text":"οὐ"},{"text":"τὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":22,"text":"τὴν δὲ δοκιμὴν αὐτοῦ γινώσκετε, ὅτι ὡς πατρὶ τέκνον σὺν ἐμοὶ ἐδούλευσεν εἰς τὸ εὐαγγέλιον.","tokens":[{"text":"τὴν"},{"text":"δὲ"},{"text":"δοκιμὴν"},{"text":"αὐτοῦ"},{"text":"γινώσκετε"},{"text":"ὅτι"},{"text":"ὡς"},{"text":"πατρὶ"},{"text":"τέκνον"},{"text":"σὺν"},{"text":"ἐμοὶ"},{"text":"ἐδούλευσεν"},{"text":"εἰς"},{"text":"τὸ"},{"text":"εὐαγγέλιον"}],"notes":[],"lang":"grc"},{"n":23,"text":"τοῦτον μὲν οὖν ἐλπίζω πέμψαι ὡς ἂν ἀφίδω τὰ περὶ ἐμὲ ἐξαυτῆς·","tokens":[{"text":"τοῦτον"},{"text":"μὲν"},{"text":"οὖν"},{"text":"ἐλπίζω"},{"text":"πέμψαι"},{"text":"ὡς"},{"text":"ἂν"},{"text":"ἀφίδω"},{"text":"τὰ"},{"text":"περὶ"},{"text":"ἐμὲ"},{"text":"ἐξαυτῆς"}],"notes":[],"lang":"grc"},{"n":24,"text":"πέποιθα δὲ ἐν κυρίῳ ὅτι καὶ αὐτὸς ταχέως ἐλεύσομαι.","tokens":[{"text":"πέποιθα"},{"text":"δὲ"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"αὐτὸς"},{"text":"ταχέως"},{"text":"ἐλεύσομαι"}],"notes":[],"lang":"grc"},{"n":25,"text":"Ἀναγκαῖον δὲ ἡγησάμην Ἐπαφρόδιτον τὸν ἀδελφὸν καὶ συνεργὸν καὶ συστρατιώτην μου, ὑμῶν δὲ ἀπόστολον καὶ λειτουργὸν τῆς χρείας μου, πέμψαι πρὸς ὑμᾶς,","tokens":[{"text":"Ἀναγκαῖον"},{"text":"δὲ"},{"text":"ἡγησάμην"},{"text":"Ἐπαφρόδιτον"},{"text":"τὸν"},{"text":"ἀδελφὸν"},{"text":"καὶ"},{"text":"συνεργὸν"},{"text":"καὶ"},{"text":"συστρατιώτην"},{"text":"μου"},{"text":"ὑμῶν"},{"text":"δὲ"},{"text":"ἀπόστολον"},{"text":"καὶ"},{"text":"λειτουργὸν"},{"text":"τῆς"},{"text":"χρείας"},{"text":"μου"},{"text":"πέμψαι"},{"text":"πρὸς"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":26,"text":"ἐπειδὴ ἐπιποθῶν ἦν πάντας ⸀ ὑμᾶς, καὶ ἀδημονῶν διότι ἠκούσατε ὅτι ἠσθένησεν.","tokens":[{"text":"ἐπειδὴ"},{"text":"ἐπιποθῶν"},{"text":"ἦν"},{"text":"πάντας"},{"text":"ὑμᾶς"},{"text":"καὶ"},{"text":"ἀδημονῶν"},{"text":"διότι"},{"text":"ἠκούσατε"},{"text":"ὅτι"},{"text":"ἠσθένησεν"}],"notes":[],"lang":"grc"},{"n":27,"text":"καὶ γὰρ ἠσθένησεν παραπλήσιον ⸀ θανάτῳ· ἀλλὰ ὁ θεὸς ⸂ ἠλέησεν αὐτόν⸃, οὐκ αὐτὸν δὲ μόνον ἀλλὰ καὶ ἐμέ, ἵνα μὴ λύπην ἐπὶ λύπην σχῶ.","tokens":[{"text":"καὶ"},{"text":"γὰρ"},{"text":"ἠσθένησεν"},{"text":"παραπλήσιον"},{"text":"θανάτῳ"},{"text":"ἀλλὰ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἠλέησεν"},{"text":"αὐτόν"},{"text":"οὐκ"},{"text":"αὐτὸν"},{"text":"δὲ"},{"text":"μόνον"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"ἐμέ"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"λύπην"},{"text":"ἐπὶ"},{"text":"λύπην"},{"text":"σχῶ"}],"notes":[],"lang":"grc"},{"n":28,"text":"σπουδαιοτέρως οὖν ἔπεμψα αὐτὸν ἵνα ἰδόντες αὐτὸν πάλιν χαρῆτε κἀγὼ ἀλυπότερος ὦ.","tokens":[{"text":"σπουδαιοτέρως"},{"text":"οὖν"},{"text":"ἔπεμψα"},{"text":"αὐτὸν"},{"text":"ἵνα"},{"text":"ἰδόντες"},{"text":"αὐτὸν"},{"text":"πάλιν"},{"text":"χαρῆτε"},{"text":"κἀγὼ"},{"text":"ἀλυπότερος"},{"text":"ὦ"}],"notes":[],"lang":"grc"},{"n":29,"text":"προσδέχεσθε οὖν αὐτὸν ἐν κυρίῳ μετὰ πάσης χαρᾶς, καὶ τοὺς τοιούτους ἐντίμους ἔχετε,","tokens":[{"text":"προσδέχεσθε"},{"text":"οὖν"},{"text":"αὐτὸν"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"μετὰ"},{"text":"πάσης"},{"text":"χαρᾶς"},{"text":"καὶ"},{"text":"τοὺς"},{"text":"τοιούτους"},{"text":"ἐντίμους"},{"text":"ἔχετε"}],"notes":[],"lang":"grc"},{"n":30,"text":"ὅτι διὰ τὸ ἔργον ⸀ Χριστοῦ μέχρι θανάτου ἤγγισεν,  ⸀ παραβολευσάμενος τῇ ψυχῇ ἵνα ἀναπληρώσῃ τὸ ὑμῶν ὑστέρημα τῆς πρός με λειτουργίας.","tokens":[{"text":"ὅτι"},{"text":"διὰ"},{"text":"τὸ"},{"text":"ἔργον"},{"text":"Χριστοῦ"},{"text":"μέχρι"},{"text":"θανάτου"},{"text":"ἤγγισεν"},{"text":"παραβολευσάμενος"},{"text":"τῇ"},{"text":"ψυχῇ"},{"text":"ἵνα"},{"text":"ἀναπληρώσῃ"},{"text":"τὸ"},{"text":"ὑμῶν"},{"text":"ὑστέρημα"},{"text":"τῆς"},{"text":"πρός"},{"text":"με"},{"text":"λειτουργίας"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Τὸ λοιπόν, ἀδελφοί μου, χαίρετε ἐν κυρίῳ. τὰ αὐτὰ γράφειν ὑμῖν ἐμοὶ μὲν οὐκ ὀκνηρόν, ὑμῖν δὲ ἀσφαλές.","tokens":[{"text":"Τὸ"},{"text":"λοιπόν"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"χαίρετε"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"τὰ"},{"text":"αὐτὰ"},{"text":"γράφειν"},{"text":"ὑμῖν"},{"text":"ἐμοὶ"},{"text":"μὲν"},{"text":"οὐκ"},{"text":"ὀκνηρόν"},{"text":"ὑμῖν"},{"text":"δὲ"},{"text":"ἀσφαλές"}],"notes":[],"lang":"grc"},{"n":2,"text":"Βλέπετε τοὺς κύνας, βλέπετε τοὺς κακοὺς ἐργάτας, βλέπετε τὴν κατατομήν.","tokens":[{"text":"Βλέπετε"},{"text":"τοὺς"},{"text":"κύνας"},{"text":"βλέπετε"},{"text":"τοὺς"},{"text":"κακοὺς"},{"text":"ἐργάτας"},{"text":"βλέπετε"},{"text":"τὴν"},{"text":"κατατομήν"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἡμεῖς γάρ ἐσμεν ἡ περιτομή, οἱ πνεύματι θεοῦ λατρεύοντες καὶ καυχώμενοι ἐν Χριστῷ Ἰησοῦ καὶ οὐκ ἐν σαρκὶ πεποιθότες,","tokens":[{"text":"ἡμεῖς"},{"text":"γάρ"},{"text":"ἐσμεν"},{"text":"ἡ"},{"text":"περιτομή"},{"text":"οἱ"},{"text":"πνεύματι"},{"text":"θεοῦ"},{"text":"λατρεύοντες"},{"text":"καὶ"},{"text":"καυχώμενοι"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἐν"},{"text":"σαρκὶ"},{"text":"πεποιθότες"}],"notes":[],"lang":"grc"},{"n":4,"text":"καίπερ ἐγὼ ἔχων πεποίθησιν καὶ ἐν σαρκί. Εἴ τις δοκεῖ ἄλλος πεποιθέναι ἐν σαρκί, ἐγὼ μᾶλλον·","tokens":[{"text":"καίπερ"},{"text":"ἐγὼ"},{"text":"ἔχων"},{"text":"πεποίθησιν"},{"text":"καὶ"},{"text":"ἐν"},{"text":"σαρκί"},{"text":"Εἴ"},{"text":"τις"},{"text":"δοκεῖ"},{"text":"ἄλλος"},{"text":"πεποιθέναι"},{"text":"ἐν"},{"text":"σαρκί"},{"text":"ἐγὼ"},{"text":"μᾶλλον"}],"notes":[],"lang":"grc"},{"n":5,"text":"περιτομῇ ὀκταήμερος, ἐκ γένους Ἰσραήλ, φυλῆς Βενιαμίν, Ἑβραῖος ἐξ Ἑβραίων, κατὰ νόμον Φαρισαῖος,","tokens":[{"text":"περιτομῇ"},{"text":"ὀκταήμερος"},{"text":"ἐκ"},{"text":"γένους"},{"text":"Ἰσραήλ"},{"text":"φυλῆς"},{"text":"Βενιαμίν"},{"text":"Ἑβραῖος"},{"text":"ἐξ"},{"text":"Ἑβραίων"},{"text":"κατὰ"},{"text":"νόμον"},{"text":"Φαρισαῖος"}],"notes":[],"lang":"grc"},{"n":6,"text":"κατὰ ⸀ ζῆλος διώκων τὴν ἐκκλησίαν, κατὰ δικαιοσύνην τὴν ἐν νόμῳ γενόμενος ἄμεμπτος.","tokens":[{"text":"κατὰ"},{"text":"ζῆλος"},{"text":"διώκων"},{"text":"τὴν"},{"text":"ἐκκλησίαν"},{"text":"κατὰ"},{"text":"δικαιοσύνην"},{"text":"τὴν"},{"text":"ἐν"},{"text":"νόμῳ"},{"text":"γενόμενος"},{"text":"ἄμεμπτος"}],"notes":[],"lang":"grc"},{"n":7,"text":"Ἀλλὰ ἅτινα ἦν μοι κέρδη, ταῦτα ἥγημαι διὰ τὸν Χριστὸν ζημίαν.","tokens":[{"text":"Ἀλλὰ"},{"text":"ἅτινα"},{"text":"ἦν"},{"text":"μοι"},{"text":"κέρδη"},{"text":"ταῦτα"},{"text":"ἥγημαι"},{"text":"διὰ"},{"text":"τὸν"},{"text":"Χριστὸν"},{"text":"ζημίαν"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἀλλὰ ⸀ μενοῦνγε καὶ ἡγοῦμαι πάντα ζημίαν εἶναι διὰ τὸ ὑπερέχον τῆς γνώσεως Χριστοῦ Ἰησοῦ τοῦ κυρίου μου διʼ ὃν τὰ πάντα ἐζημιώθην, καὶ ἡγοῦμαι ⸀ σκύβαλα ἵνα Χριστὸν κερδήσω","tokens":[{"text":"ἀλλὰ"},{"text":"μενοῦνγε"},{"text":"καὶ"},{"text":"ἡγοῦμαι"},{"text":"πάντα"},{"text":"ζημίαν"},{"text":"εἶναι"},{"text":"διὰ"},{"text":"τὸ"},{"text":"ὑπερέχον"},{"text":"τῆς"},{"text":"γνώσεως"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"μου"},{"text":"διʼ"},{"text":"ὃν"},{"text":"τὰ"},{"text":"πάντα"},{"text":"ἐζημιώθην"},{"text":"καὶ"},{"text":"ἡγοῦμαι"},{"text":"σκύβαλα"},{"text":"ἵνα"},{"text":"Χριστὸν"},{"text":"κερδήσω"}],"notes":[],"lang":"grc"},{"n":9,"text":"καὶ εὑρεθῶ ἐν αὐτῷ, μὴ ἔχων ἐμὴν δικαιοσύνην τὴν ἐκ νόμου ἀλλὰ τὴν διὰ πίστεως Χριστοῦ, τὴν ἐκ θεοῦ δικαιοσύνην ἐπὶ τῇ πίστει,","tokens":[{"text":"καὶ"},{"text":"εὑρεθῶ"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"μὴ"},{"text":"ἔχων"},{"text":"ἐμὴν"},{"text":"δικαιοσύνην"},{"text":"τὴν"},{"text":"ἐκ"},{"text":"νόμου"},{"text":"ἀλλὰ"},{"text":"τὴν"},{"text":"διὰ"},{"text":"πίστεως"},{"text":"Χριστοῦ"},{"text":"τὴν"},{"text":"ἐκ"},{"text":"θεοῦ"},{"text":"δικαιοσύνην"},{"text":"ἐπὶ"},{"text":"τῇ"},{"text":"πίστει"}],"notes":[],"lang":"grc"},{"n":10,"text":"τοῦ γνῶναι αὐτὸν καὶ τὴν δύναμιν τῆς ἀναστάσεως αὐτοῦ καὶ ⸀ κοινωνίαν παθημάτων αὐτοῦ,  ⸀ συμμορφιζόμενος τῷ θανάτῳ αὐτοῦ,","tokens":[{"text":"τοῦ"},{"text":"γνῶναι"},{"text":"αὐτὸν"},{"text":"καὶ"},{"text":"τὴν"},{"text":"δύναμιν"},{"text":"τῆς"},{"text":"ἀναστάσεως"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"κοινωνίαν"},{"text":"παθημάτων"},{"text":"αὐτοῦ"},{"text":"συμμορφιζόμενος"},{"text":"τῷ"},{"text":"θανάτῳ"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":11,"text":"εἴ πως καταντήσω εἰς τὴν ἐξανάστασιν ⸂ τὴν ἐκ⸃ νεκρῶν.","tokens":[{"text":"εἴ"},{"text":"πως"},{"text":"καταντήσω"},{"text":"εἰς"},{"text":"τὴν"},{"text":"ἐξανάστασιν"},{"text":"τὴν"},{"text":"ἐκ"},{"text":"νεκρῶν"}],"notes":[],"lang":"grc"},{"n":12,"text":"Οὐχ ὅτι ἤδη ἔλαβον ἢ ἤδη τετελείωμαι, διώκω δὲ εἰ καὶ καταλάβω, ἐφʼ ᾧ καὶ κατελήμφθην ὑπὸ ⸀ Χριστοῦ.","tokens":[{"text":"Οὐχ"},{"text":"ὅτι"},{"text":"ἤδη"},{"text":"ἔλαβον"},{"text":"ἢ"},{"text":"ἤδη"},{"text":"τετελείωμαι"},{"text":"διώκω"},{"text":"δὲ"},{"text":"εἰ"},{"text":"καὶ"},{"text":"καταλάβω"},{"text":"ἐφʼ"},{"text":"ᾧ"},{"text":"καὶ"},{"text":"κατελήμφθην"},{"text":"ὑπὸ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἀδελφοί, ἐγὼ ἐμαυτὸν ⸀ οὐ λογίζομαι κατειληφέναι· ἓν δέ, τὰ μὲν ὀπίσω ἐπιλανθανόμενος τοῖς δὲ ἔμπροσθεν ἐπεκτεινόμενος,","tokens":[{"text":"ἀδελφοί"},{"text":"ἐγὼ"},{"text":"ἐμαυτὸν"},{"text":"οὐ"},{"text":"λογίζομαι"},{"text":"κατειληφέναι"},{"text":"ἓν"},{"text":"δέ"},{"text":"τὰ"},{"text":"μὲν"},{"text":"ὀπίσω"},{"text":"ἐπιλανθανόμενος"},{"text":"τοῖς"},{"text":"δὲ"},{"text":"ἔμπροσθεν"},{"text":"ἐπεκτεινόμενος"}],"notes":[],"lang":"grc"},{"n":14,"text":"κατὰ σκοπὸν διώκω ⸀ εἰς τὸ βραβεῖον τῆς ἄνω κλήσεως τοῦ θεοῦ ἐν Χριστῷ Ἰησοῦ.","tokens":[{"text":"κατὰ"},{"text":"σκοπὸν"},{"text":"διώκω"},{"text":"εἰς"},{"text":"τὸ"},{"text":"βραβεῖον"},{"text":"τῆς"},{"text":"ἄνω"},{"text":"κλήσεως"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ὅσοι οὖν τέλειοι, τοῦτο φρονῶμεν· καὶ εἴ τι ἑτέρως φρονεῖτε, καὶ τοῦτο ὁ θεὸς ὑμῖν ἀποκαλύψει·","tokens":[{"text":"ὅσοι"},{"text":"οὖν"},{"text":"τέλειοι"},{"text":"τοῦτο"},{"text":"φρονῶμεν"},{"text":"καὶ"},{"text":"εἴ"},{"text":"τι"},{"text":"ἑτέρως"},{"text":"φρονεῖτε"},{"text":"καὶ"},{"text":"τοῦτο"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ὑμῖν"},{"text":"ἀποκαλύψει"}],"notes":[],"lang":"grc"},{"n":16,"text":"πλὴν εἰς ὃ ἐφθάσαμεν, τῷ αὐτῷ ⸀ στοιχεῖν.","tokens":[{"text":"πλὴν"},{"text":"εἰς"},{"text":"ὃ"},{"text":"ἐφθάσαμεν"},{"text":"τῷ"},{"text":"αὐτῷ"},{"text":"στοιχεῖν"}],"notes":[],"lang":"grc"},{"n":17,"text":"Συμμιμηταί μου γίνεσθε, ἀδελφοί, καὶ σκοπεῖτε τοὺς οὕτω περιπατοῦντας καθὼς ἔχετε τύπον ἡμᾶς·","tokens":[{"text":"Συμμιμηταί"},{"text":"μου"},{"text":"γίνεσθε"},{"text":"ἀδελφοί"},{"text":"καὶ"},{"text":"σκοπεῖτε"},{"text":"τοὺς"},{"text":"οὕτω"},{"text":"περιπατοῦντας"},{"text":"καθὼς"},{"text":"ἔχετε"},{"text":"τύπον"},{"text":"ἡμᾶς"}],"notes":[],"lang":"grc"},{"n":18,"text":"πολλοὶ γὰρ περιπατοῦσιν οὓς πολλάκις ἔλεγον ὑμῖν, νῦν δὲ καὶ κλαίων λέγω, τοὺς ἐχθροὺς τοῦ σταυροῦ τοῦ Χριστοῦ,","tokens":[{"text":"πολλοὶ"},{"text":"γὰρ"},{"text":"περιπατοῦσιν"},{"text":"οὓς"},{"text":"πολλάκις"},{"text":"ἔλεγον"},{"text":"ὑμῖν"},{"text":"νῦν"},{"text":"δὲ"},{"text":"καὶ"},{"text":"κλαίων"},{"text":"λέγω"},{"text":"τοὺς"},{"text":"ἐχθροὺς"},{"text":"τοῦ"},{"text":"σταυροῦ"},{"text":"τοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":19,"text":"ὧν τὸ τέλος ἀπώλεια, ὧν ὁ θεὸς ἡ κοιλία καὶ ἡ δόξα ἐν τῇ αἰσχύνῃ αὐτῶν, οἱ τὰ ἐπίγεια φρονοῦντες.","tokens":[{"text":"ὧν"},{"text":"τὸ"},{"text":"τέλος"},{"text":"ἀπώλεια"},{"text":"ὧν"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἡ"},{"text":"κοιλία"},{"text":"καὶ"},{"text":"ἡ"},{"text":"δόξα"},{"text":"ἐν"},{"text":"τῇ"},{"text":"αἰσχύνῃ"},{"text":"αὐτῶν"},{"text":"οἱ"},{"text":"τὰ"},{"text":"ἐπίγεια"},{"text":"φρονοῦντες"}],"notes":[],"lang":"grc"},{"n":20,"text":"ἡμῶν γὰρ τὸ πολίτευμα ἐν οὐρανοῖς ὑπάρχει, ἐξ οὗ καὶ σωτῆρα ἀπεκδεχόμεθα κύριον Ἰησοῦν Χριστόν,","tokens":[{"text":"ἡμῶν"},{"text":"γὰρ"},{"text":"τὸ"},{"text":"πολίτευμα"},{"text":"ἐν"},{"text":"οὐρανοῖς"},{"text":"ὑπάρχει"},{"text":"ἐξ"},{"text":"οὗ"},{"text":"καὶ"},{"text":"σωτῆρα"},{"text":"ἀπεκδεχόμεθα"},{"text":"κύριον"},{"text":"Ἰησοῦν"},{"text":"Χριστόν"}],"notes":[],"lang":"grc"},{"n":21,"text":"ὃς μετασχηματίσει τὸ σῶμα τῆς ταπεινώσεως ⸀ ἡμῶν σύμμορφον τῷ σώματι τῆς δόξης αὐτοῦ κατὰ τὴν ἐνέργειαν τοῦ δύνασθαι αὐτὸν καὶ ὑποτάξαι ⸀ αὑτῷ τὰ πάντα.","tokens":[{"text":"ὃς"},{"text":"μετασχηματίσει"},{"text":"τὸ"},{"text":"σῶμα"},{"text":"τῆς"},{"text":"ταπεινώσεως"},{"text":"ἡμῶν"},{"text":"σύμμορφον"},{"text":"τῷ"},{"text":"σώματι"},{"text":"τῆς"},{"text":"δόξης"},{"text":"αὐτοῦ"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"ἐνέργειαν"},{"text":"τοῦ"},{"text":"δύνασθαι"},{"text":"αὐτὸν"},{"text":"καὶ"},{"text":"ὑποτάξαι"},{"text":"αὑτῷ"},{"text":"τὰ"},{"text":"πάντα"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"ὥστε, ἀδελφοί μου ἀγαπητοὶ καὶ ἐπιπόθητοι, χαρὰ καὶ στέφανός μου, οὕτως στήκετε ἐν κυρίῳ, ἀγαπητοί.","tokens":[{"text":"ὥστε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ἀγαπητοὶ"},{"text":"καὶ"},{"text":"ἐπιπόθητοι"},{"text":"χαρὰ"},{"text":"καὶ"},{"text":"στέφανός"},{"text":"μου"},{"text":"οὕτως"},{"text":"στήκετε"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"ἀγαπητοί"}],"notes":[],"lang":"grc"},{"n":2,"text":"Εὐοδίαν παρακαλῶ καὶ Συντύχην παρακαλῶ τὸ αὐτὸ φρονεῖν ἐν κυρίῳ.","tokens":[{"text":"Εὐοδίαν"},{"text":"παρακαλῶ"},{"text":"καὶ"},{"text":"Συντύχην"},{"text":"παρακαλῶ"},{"text":"τὸ"},{"text":"αὐτὸ"},{"text":"φρονεῖν"},{"text":"ἐν"},{"text":"κυρίῳ"}],"notes":[],"lang":"grc"},{"n":3,"text":"ναὶ ἐρωτῶ καὶ σέ,  ⸂ γνήσιε σύζυγε⸃, συλλαμβάνου αὐταῖς, αἵτινες ἐν τῷ εὐαγγελίῳ συνήθλησάν μοι μετὰ καὶ Κλήμεντος καὶ τῶν λοιπῶν συνεργῶν μου, ὧν τὰ ὀνόματα ἐν βίβλῳ ζωῆς.","tokens":[{"text":"ναὶ"},{"text":"ἐρωτῶ"},{"text":"καὶ"},{"text":"σέ"},{"text":"γνήσιε"},{"text":"σύζυγε"},{"text":"συλλαμβάνου"},{"text":"αὐταῖς"},{"text":"αἵτινες"},{"text":"ἐν"},{"text":"τῷ"},{"text":"εὐαγγελίῳ"},{"text":"συνήθλησάν"},{"text":"μοι"},{"text":"μετὰ"},{"text":"καὶ"},{"text":"Κλήμεντος"},{"text":"καὶ"},{"text":"τῶν"},{"text":"λοιπῶν"},{"text":"συνεργῶν"},{"text":"μου"},{"text":"ὧν"},{"text":"τὰ"},{"text":"ὀνόματα"},{"text":"ἐν"},{"text":"βίβλῳ"},{"text":"ζωῆς"}],"notes":[],"lang":"grc"},{"n":4,"text":"Χαίρετε ἐν κυρίῳ πάντοτε· πάλιν ἐρῶ, χαίρετε.","tokens":[{"text":"Χαίρετε"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"πάντοτε"},{"text":"πάλιν"},{"text":"ἐρῶ"},{"text":"χαίρετε"}],"notes":[],"lang":"grc"},{"n":5,"text":"τὸ ἐπιεικὲς ὑμῶν γνωσθήτω πᾶσιν ἀνθρώποις. ὁ κύριος ἐγγύς·","tokens":[{"text":"τὸ"},{"text":"ἐπιεικὲς"},{"text":"ὑμῶν"},{"text":"γνωσθήτω"},{"text":"πᾶσιν"},{"text":"ἀνθρώποις"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἐγγύς"}],"notes":[],"lang":"grc"},{"n":6,"text":"μηδὲν μεριμνᾶτε, ἀλλʼ ἐν παντὶ τῇ προσευχῇ καὶ τῇ δεήσει μετʼ εὐχαριστίας τὰ αἰτήματα ὑμῶν γνωριζέσθω πρὸς τὸν θεόν·","tokens":[{"text":"μηδὲν"},{"text":"μεριμνᾶτε"},{"text":"ἀλλʼ"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"τῇ"},{"text":"προσευχῇ"},{"text":"καὶ"},{"text":"τῇ"},{"text":"δεήσει"},{"text":"μετʼ"},{"text":"εὐχαριστίας"},{"text":"τὰ"},{"text":"αἰτήματα"},{"text":"ὑμῶν"},{"text":"γνωριζέσθω"},{"text":"πρὸς"},{"text":"τὸν"},{"text":"θεόν"}],"notes":[],"lang":"grc"},{"n":7,"text":"καὶ ἡ εἰρήνη τοῦ θεοῦ ἡ ὑπερέχουσα πάντα νοῦν φρουρήσει τὰς καρδίας ὑμῶν καὶ τὰ νοήματα ὑμῶν ἐν Χριστῷ Ἰησοῦ.","tokens":[{"text":"καὶ"},{"text":"ἡ"},{"text":"εἰρήνη"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἡ"},{"text":"ὑπερέχουσα"},{"text":"πάντα"},{"text":"νοῦν"},{"text":"φρουρήσει"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"τὰ"},{"text":"νοήματα"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":8,"text":"Τὸ λοιπόν, ἀδελφοί, ὅσα ἐστὶν ἀληθῆ, ὅσα σεμνά, ὅσα δίκαια, ὅσα ἁγνά, ὅσα προσφιλῆ, ὅσα εὔφημα, εἴ τις ἀρετὴ καὶ εἴ τις ἔπαινος, ταῦτα λογίζεσθε·","tokens":[{"text":"Τὸ"},{"text":"λοιπόν"},{"text":"ἀδελφοί"},{"text":"ὅσα"},{"text":"ἐστὶν"},{"text":"ἀληθῆ"},{"text":"ὅσα"},{"text":"σεμνά"},{"text":"ὅσα"},{"text":"δίκαια"},{"text":"ὅσα"},{"text":"ἁγνά"},{"text":"ὅσα"},{"text":"προσφιλῆ"},{"text":"ὅσα"},{"text":"εὔφημα"},{"text":"εἴ"},{"text":"τις"},{"text":"ἀρετὴ"},{"text":"καὶ"},{"text":"εἴ"},{"text":"τις"},{"text":"ἔπαινος"},{"text":"ταῦτα"},{"text":"λογίζεσθε"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἃ καὶ ἐμάθετε καὶ παρελάβετε καὶ ἠκούσατε καὶ εἴδετε ἐν ἐμοί, ταῦτα πράσσετε· καὶ ὁ θεὸς τῆς εἰρήνης ἔσται μεθʼ ὑμῶν.","tokens":[{"text":"ἃ"},{"text":"καὶ"},{"text":"ἐμάθετε"},{"text":"καὶ"},{"text":"παρελάβετε"},{"text":"καὶ"},{"text":"ἠκούσατε"},{"text":"καὶ"},{"text":"εἴδετε"},{"text":"ἐν"},{"text":"ἐμοί"},{"text":"ταῦτα"},{"text":"πράσσετε"},{"text":"καὶ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"τῆς"},{"text":"εἰρήνης"},{"text":"ἔσται"},{"text":"μεθʼ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":10,"text":"Ἐχάρην δὲ ἐν κυρίῳ μεγάλως ὅτι ἤδη ποτὲ ἀνεθάλετε τὸ ὑπὲρ ἐμοῦ φρονεῖν, ἐφʼ ᾧ καὶ ἐφρονεῖτε ἠκαιρεῖσθε δέ.","tokens":[{"text":"Ἐχάρην"},{"text":"δὲ"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"μεγάλως"},{"text":"ὅτι"},{"text":"ἤδη"},{"text":"ποτὲ"},{"text":"ἀνεθάλετε"},{"text":"τὸ"},{"text":"ὑπὲρ"},{"text":"ἐμοῦ"},{"text":"φρονεῖν"},{"text":"ἐφʼ"},{"text":"ᾧ"},{"text":"καὶ"},{"text":"ἐφρονεῖτε"},{"text":"ἠκαιρεῖσθε"},{"text":"δέ"}],"notes":[],"lang":"grc"},{"n":11,"text":"οὐχ ὅτι καθʼ ὑστέρησιν λέγω, ἐγὼ γὰρ ἔμαθον ἐν οἷς εἰμι αὐτάρκης εἶναι·","tokens":[{"text":"οὐχ"},{"text":"ὅτι"},{"text":"καθʼ"},{"text":"ὑστέρησιν"},{"text":"λέγω"},{"text":"ἐγὼ"},{"text":"γὰρ"},{"text":"ἔμαθον"},{"text":"ἐν"},{"text":"οἷς"},{"text":"εἰμι"},{"text":"αὐτάρκης"},{"text":"εἶναι"}],"notes":[],"lang":"grc"},{"n":12,"text":"οἶδα καὶ ταπεινοῦσθαι, οἶδα καὶ περισσεύειν· ἐν παντὶ καὶ ἐν πᾶσιν μεμύημαι, καὶ χορτάζεσθαι καὶ πεινᾶν, καὶ περισσεύειν καὶ ὑστερεῖσθαι·","tokens":[{"text":"οἶδα"},{"text":"καὶ"},{"text":"ταπεινοῦσθαι"},{"text":"οἶδα"},{"text":"καὶ"},{"text":"περισσεύειν"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"καὶ"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"μεμύημαι"},{"text":"καὶ"},{"text":"χορτάζεσθαι"},{"text":"καὶ"},{"text":"πεινᾶν"},{"text":"καὶ"},{"text":"περισσεύειν"},{"text":"καὶ"},{"text":"ὑστερεῖσθαι"}],"notes":[],"lang":"grc"},{"n":13,"text":"πάντα ἰσχύω ἐν τῷ ἐνδυναμοῦντί ⸀ με.","tokens":[{"text":"πάντα"},{"text":"ἰσχύω"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ἐνδυναμοῦντί"},{"text":"με"}],"notes":[],"lang":"grc"},{"n":14,"text":"πλὴν καλῶς ἐποιήσατε συγκοινωνήσαντές μου τῇ θλίψει.","tokens":[{"text":"πλὴν"},{"text":"καλῶς"},{"text":"ἐποιήσατε"},{"text":"συγκοινωνήσαντές"},{"text":"μου"},{"text":"τῇ"},{"text":"θλίψει"}],"notes":[],"lang":"grc"},{"n":15,"text":"Οἴδατε δὲ καὶ ὑμεῖς, Φιλιππήσιοι, ὅτι ἐν ἀρχῇ τοῦ εὐαγγελίου, ὅτε ἐξῆλθον ἀπὸ Μακεδονίας, οὐδεμία μοι ἐκκλησία ἐκοινώνησεν εἰς λόγον δόσεως καὶ λήμψεως εἰ μὴ ὑμεῖς μόνοι,","tokens":[{"text":"Οἴδατε"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"Φιλιππήσιοι"},{"text":"ὅτι"},{"text":"ἐν"},{"text":"ἀρχῇ"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"ὅτε"},{"text":"ἐξῆλθον"},{"text":"ἀπὸ"},{"text":"Μακεδονίας"},{"text":"οὐδεμία"},{"text":"μοι"},{"text":"ἐκκλησία"},{"text":"ἐκοινώνησεν"},{"text":"εἰς"},{"text":"λόγον"},{"text":"δόσεως"},{"text":"καὶ"},{"text":"λήμψεως"},{"text":"εἰ"},{"text":"μὴ"},{"text":"ὑμεῖς"},{"text":"μόνοι"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὅτι καὶ ἐν Θεσσαλονίκῃ καὶ ἅπαξ καὶ δὶς εἰς τὴν χρείαν μοι ἐπέμψατε.","tokens":[{"text":"ὅτι"},{"text":"καὶ"},{"text":"ἐν"},{"text":"Θεσσαλονίκῃ"},{"text":"καὶ"},{"text":"ἅπαξ"},{"text":"καὶ"},{"text":"δὶς"},{"text":"εἰς"},{"text":"τὴν"},{"text":"χρείαν"},{"text":"μοι"},{"text":"ἐπέμψατε"}],"notes":[],"lang":"grc"},{"n":17,"text":"οὐχ ὅτι ἐπιζητῶ τὸ δόμα, ἀλλὰ ἐπιζητῶ τὸν καρπὸν τὸν πλεονάζοντα εἰς λόγον ὑμῶν.","tokens":[{"text":"οὐχ"},{"text":"ὅτι"},{"text":"ἐπιζητῶ"},{"text":"τὸ"},{"text":"δόμα"},{"text":"ἀλλὰ"},{"text":"ἐπιζητῶ"},{"text":"τὸν"},{"text":"καρπὸν"},{"text":"τὸν"},{"text":"πλεονάζοντα"},{"text":"εἰς"},{"text":"λόγον"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":18,"text":"ἀπέχω δὲ πάντα καὶ περισσεύω· πεπλήρωμαι δεξάμενος παρὰ Ἐπαφροδίτου τὰ παρʼ ὑμῶν, ὀσμὴν εὐωδίας, θυσίαν δεκτήν, εὐάρεστον τῷ θεῷ.","tokens":[{"text":"ἀπέχω"},{"text":"δὲ"},{"text":"πάντα"},{"text":"καὶ"},{"text":"περισσεύω"},{"text":"πεπλήρωμαι"},{"text":"δεξάμενος"},{"text":"παρὰ"},{"text":"Ἐπαφροδίτου"},{"text":"τὰ"},{"text":"παρʼ"},{"text":"ὑμῶν"},{"text":"ὀσμὴν"},{"text":"εὐωδίας"},{"text":"θυσίαν"},{"text":"δεκτήν"},{"text":"εὐάρεστον"},{"text":"τῷ"},{"text":"θεῷ"}],"notes":[],"lang":"grc"},{"n":19,"text":"ὁ δὲ θεός μου πληρώσει πᾶσαν χρείαν ὑμῶν κατὰ ⸂ τὸ πλοῦτος⸃ αὐτοῦ ἐν δόξῃ ἐν Χριστῷ Ἰησοῦ.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"θεός"},{"text":"μου"},{"text":"πληρώσει"},{"text":"πᾶσαν"},{"text":"χρείαν"},{"text":"ὑμῶν"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"πλοῦτος"},{"text":"αὐτοῦ"},{"text":"ἐν"},{"text":"δόξῃ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":20,"text":"τῷ δὲ θεῷ καὶ πατρὶ ἡμῶν ἡ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων· ἀμήν.","tokens":[{"text":"τῷ"},{"text":"δὲ"},{"text":"θεῷ"},{"text":"καὶ"},{"text":"πατρὶ"},{"text":"ἡμῶν"},{"text":"ἡ"},{"text":"δόξα"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":21,"text":"Ἀσπάσασθε πάντα ἅγιον ἐν Χριστῷ Ἰησοῦ. ἀσπάζονται ὑμᾶς οἱ σὺν ἐμοὶ ἀδελφοί.","tokens":[{"text":"Ἀσπάσασθε"},{"text":"πάντα"},{"text":"ἅγιον"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"ἀσπάζονται"},{"text":"ὑμᾶς"},{"text":"οἱ"},{"text":"σὺν"},{"text":"ἐμοὶ"},{"text":"ἀδελφοί"}],"notes":[],"lang":"grc"},{"n":22,"text":"ἀσπάζονται ὑμᾶς πάντες οἱ ἅγιοι, μάλιστα δὲ οἱ ἐκ τῆς Καίσαρος οἰκίας.","tokens":[{"text":"ἀσπάζονται"},{"text":"ὑμᾶς"},{"text":"πάντες"},{"text":"οἱ"},{"text":"ἅγιοι"},{"text":"μάλιστα"},{"text":"δὲ"},{"text":"οἱ"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"Καίσαρος"},{"text":"οἰκίας"}],"notes":[],"lang":"grc"},{"n":23,"text":"ἡ χάρις τοῦ κυρίου Ἰησοῦ Χριστοῦ μετὰ ⸂ τοῦ πνεύματος⸃  ⸀ ὑμῶν.","tokens":[{"text":"ἡ"},{"text":"χάρις"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"μετὰ"},{"text":"τοῦ"},{"text":"πνεύματος"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}