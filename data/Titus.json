{"book":{"id":"Titus","name":"Tito","testament":"NT","source":"SBLGNT","chapters":3,"verses":46},"chapters":{"1":[{"n":1,"text":"Παῦλος δοῦλος θεοῦ, ἀπόστολος δὲ Ἰησοῦ Χριστοῦ κατὰ πίστιν ἐκλεκτῶν θεοῦ καὶ ἐπίγνωσιν ἀληθείας τῆς κατʼ εὐσέβειαν","tokens":[{"text":"Παῦλος"},{"text":"δοῦλος"},{"text":"θεοῦ"},{"text":"ἀπόστολος"},{"text":"δὲ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"κατὰ"},{"text":"πίστιν"},{"text":"ἐκλεκτῶν"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"ἐπίγνωσιν"},{"text":"ἀληθείας"},{"text":"τῆς"},{"text":"κατʼ"},{"text":"εὐσέβειαν"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἐπʼ ἐλπίδι ζωῆς αἰωνίου, ἣν ἐπηγγείλατο ὁ ἀψευδὴς θεὸς πρὸ χρόνων αἰωνίων","tokens":[{"text":"ἐπʼ"},{"text":"ἐλπίδι"},{"text":"ζωῆς"},{"text":"αἰωνίου"},{"text":"ἣν"},{"text":"ἐπηγγείλατο"},{"text":"ὁ"},{"text":"ἀψευδὴς"},{"text":"θεὸς"},{"text":"πρὸ"},{"text":"χρόνων"},{"text":"αἰωνίων"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἐφανέρωσεν δὲ καιροῖς ἰδίοις, τὸν λόγον αὐτοῦ ἐν κηρύγματι ὃ ἐπιστεύθην ἐγὼ κατʼ ἐπιταγὴν τοῦ σωτῆρος ἡμῶν θεοῦ,","tokens":[{"text":"ἐφανέρωσεν"},{"text":"δὲ"},{"text":"καιροῖς"},{"text":"ἰδίοις"},{"text":"τὸν"},{"text":"λόγον"},{"text":"αὐτοῦ"},{"text":"ἐν"},{"text":"κηρύγματι"},{"text":"ὃ"},{"text":"ἐπιστεύθην"},{"text":"ἐγὼ"},{"text":"κατʼ"},{"text":"ἐπιταγὴν"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":4,"text":"Τίτῳ γνησίῳ τέκνῳ κατὰ κοινὴν πίστιν· χάρις ⸀ καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς καὶ ⸂ Χριστοῦ Ἰησοῦ⸃ τοῦ σωτῆρος ἡμῶν.","tokens":[{"text":"Τίτῳ"},{"text":"γνησίῳ"},{"text":"τέκνῳ"},{"text":"κατὰ"},{"text":"κοινὴν"},{"text":"πίστιν"},{"text":"χάρις"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":5,"text":"Τούτου χάριν ⸀ ἀπέλιπόν σε ἐν Κρήτῃ ἵνα τὰ λείποντα ἐπιδιορθώσῃ, καὶ καταστήσῃς κατὰ πόλιν πρεσβυτέρους, ὡς ἐγώ σοι διεταξάμην,","tokens":[{"text":"Τούτου"},{"text":"χάριν"},{"text":"ἀπέλιπόν"},{"text":"σε"},{"text":"ἐν"},{"text":"Κρήτῃ"},{"text":"ἵνα"},{"text":"τὰ"},{"text":"λείποντα"},{"text":"ἐπιδιορθώσῃ"},{"text":"καὶ"},{"text":"καταστήσῃς"},{"text":"κατὰ"},{"text":"πόλιν"},{"text":"πρεσβυτέρους"},{"text":"ὡς"},{"text":"ἐγώ"},{"text":"σοι"},{"text":"διεταξάμην"}],"notes":[],"lang":"grc"},{"n":6,"text":"εἴ τίς ἐστιν ἀνέγκλητος, μιᾶς γυναικὸς ἀνήρ, τέκνα ἔχων πιστά, μὴ ἐν κατηγορίᾳ ἀσωτίας ἢ ἀνυπότακτα.","tokens":[{"text":"εἴ"},{"text":"τίς"},{"text":"ἐστιν"},{"text":"ἀνέγκλητος"},{"text":"μιᾶς"},{"text":"γυναικὸς"},{"text":"ἀνήρ"},{"text":"τέκνα"},{"text":"ἔχων"},{"text":"πιστά"},{"text":"μὴ"},{"text":"ἐν"},{"text":"κατηγορίᾳ"},{"text":"ἀσωτίας"},{"text":"ἢ"},{"text":"ἀνυπότακτα"}],"notes":[],"lang":"grc"},{"n":7,"text":"δεῖ γὰρ τὸν ἐπίσκοπον ἀνέγκλητον εἶναι ὡς θεοῦ οἰκονόμον, μὴ αὐθάδη, μὴ ὀργίλον, μὴ πάροινον, μὴ πλήκτην, μὴ αἰσχροκερδῆ,","tokens":[{"text":"δεῖ"},{"text":"γὰρ"},{"text":"τὸν"},{"text":"ἐπίσκοπον"},{"text":"ἀνέγκλητον"},{"text":"εἶναι"},{"text":"ὡς"},{"text":"θεοῦ"},{"text":"οἰκονόμον"},{"text":"μὴ"},{"text":"αὐθάδη"},{"text":"μὴ"},{"text":"ὀργίλον"},{"text":"μὴ"},{"text":"πάροινον"},{"text":"μὴ"},{"text":"πλήκτην"},{"text":"μὴ"},{"text":"αἰσχροκερδῆ"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἀλλὰ φιλόξενον, φιλάγαθον, σώφρονα, δίκαιον, ὅσιον, ἐγκρατῆ,","tokens":[{"text":"ἀλλὰ"},{"text":"φιλόξενον"},{"text":"φιλάγαθον"},{"text":"σώφρονα"},{"text":"δίκαιον"},{"text":"ὅσιον"},{"text":"ἐγκρατῆ"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἀντεχόμενον τοῦ κατὰ τὴν διδαχὴν πιστοῦ λόγου, ἵνα δυνατὸς ᾖ καὶ παρακαλεῖν ἐν τῇ διδασκαλίᾳ τῇ ὑγιαινούσῃ καὶ τοὺς ἀντιλέγοντας ἐλέγχειν.","tokens":[{"text":"ἀντεχόμενον"},{"text":"τοῦ"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"διδαχὴν"},{"text":"πιστοῦ"},{"text":"λόγου"},{"text":"ἵνα"},{"text":"δυνατὸς"},{"text":"ᾖ"},{"text":"καὶ"},{"text":"παρακαλεῖν"},{"text":"ἐν"},{"text":"τῇ"},{"text":"διδασκαλίᾳ"},{"text":"τῇ"},{"text":"ὑγιαινούσῃ"},{"text":"καὶ"},{"text":"τοὺς"},{"text":"ἀντιλέγοντας"},{"text":"ἐλέγχειν"}],"notes":[],"lang":"grc"},{"n":10,"text":"Εἰσὶν γὰρ πολλοὶ ⸀ καὶ ἀνυπότακτοι, ματαιολόγοι καὶ φρεναπάται, μάλιστα οἱ ἐκ ⸀ τῆς περιτομῆς,","tokens":[{"text":"Εἰσὶν"},{"text":"γὰρ"},{"text":"πολλοὶ"},{"text":"καὶ"},{"text":"ἀνυπότακτοι"},{"text":"ματαιολόγοι"},{"text":"καὶ"},{"text":"φρεναπάται"},{"text":"μάλιστα"},{"text":"οἱ"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"περιτομῆς"}],"notes":[],"lang":"grc"},{"n":11,"text":"οὓς δεῖ ἐπιστομίζειν, οἵτινες ὅλους οἴκους ἀνατρέπουσιν διδάσκοντες ἃ μὴ δεῖ αἰσχροῦ κέρδους χάριν.","tokens":[{"text":"οὓς"},{"text":"δεῖ"},{"text":"ἐπιστομίζειν"},{"text":"οἵτινες"},{"text":"ὅλους"},{"text":"οἴκους"},{"text":"ἀνατρέπουσιν"},{"text":"διδάσκοντες"},{"text":"ἃ"},{"text":"μὴ"},{"text":"δεῖ"},{"text":"αἰσχροῦ"},{"text":"κέρδους"},{"text":"χάριν"}],"notes":[],"lang":"grc"},{"n":12,"text":"εἶπέν τις ἐξ αὐτῶν, ἴδιος αὐτῶν προφήτης, Κρῆτες ἀεὶ ψεῦσται, κακὰ θηρία, γαστέρες ἀργαί·","tokens":[{"text":"εἶπέν"},{"text":"τις"},{"text":"ἐξ"},{"text":"αὐτῶν"},{"text":"ἴδιος"},{"text":"αὐτῶν"},{"text":"προφήτης"},{"text":"Κρῆτες"},{"text":"ἀεὶ"},{"text":"ψεῦσται"},{"text":"κακὰ"},{"text":"θηρία"},{"text":"γαστέρες"},{"text":"ἀργαί"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἡ μαρτυρία αὕτη ἐστὶν ἀληθής. διʼ ἣν αἰτίαν ἔλεγχε αὐτοὺς ἀποτόμως, ἵνα ὑγιαίνωσιν ἐν τῇ πίστει,","tokens":[{"text":"ἡ"},{"text":"μαρτυρία"},{"text":"αὕτη"},{"text":"ἐστὶν"},{"text":"ἀληθής"},{"text":"διʼ"},{"text":"ἣν"},{"text":"αἰτίαν"},{"text":"ἔλεγχε"},{"text":"αὐτοὺς"},{"text":"ἀποτόμως"},{"text":"ἵνα"},{"text":"ὑγιαίνωσιν"},{"text":"ἐν"},{"text":"τῇ"},{"text":"πίστει"}],"notes":[],"lang":"grc"},{"n":14,"text":"μὴ προσέχοντες Ἰουδαϊκοῖς μύθοις καὶ ἐντολαῖς ἀνθρώπων ἀποστρεφομένων τὴν ἀλήθειαν.","tokens":[{"text":"μὴ"},{"text":"προσέχοντες"},{"text":"Ἰουδαϊκοῖς"},{"text":"μύθοις"},{"text":"καὶ"},{"text":"ἐντολαῖς"},{"text":"ἀνθρώπων"},{"text":"ἀποστρεφομένων"},{"text":"τὴν"},{"text":"ἀλήθειαν"}],"notes":[],"lang":"grc"},{"n":15,"text":"⸀ πάντα καθαρὰ τοῖς καθαροῖς· τοῖς δὲ μεμιαμμένοις καὶ ἀπίστοις οὐδὲν καθαρόν, ἀλλὰ μεμίανται αὐτῶν καὶ ὁ νοῦς καὶ ἡ συνείδησις.","tokens":[{"text":"πάντα"},{"text":"καθαρὰ"},{"text":"τοῖς"},{"text":"καθαροῖς"},{"text":"τοῖς"},{"text":"δὲ"},{"text":"μεμιαμμένοις"},{"text":"καὶ"},{"text":"ἀπίστοις"},{"text":"οὐδὲν"},{"text":"καθαρόν"},{"text":"ἀλλὰ"},{"text":"μεμίανται"},{"text":"αὐτῶν"},{"text":"καὶ"},{"text":"ὁ"},{"text":"νοῦς"},{"text":"καὶ"},{"text":"ἡ"},{"text":"συνείδησις"}],"notes":[],"lang":"grc"},{"n":16,"text":"θεὸν ὁμολογοῦσιν εἰδέναι, τοῖς δὲ ἔργοις ἀρνοῦνται, βδελυκτοὶ ὄντες καὶ ἀπειθεῖς καὶ πρὸς πᾶν ἔργον ἀγαθὸν ἀδόκιμοι.","tokens":[{"text":"θεὸν"},{"text":"ὁμολογοῦσιν"},{"text":"εἰδέναι"},{"text":"τοῖς"},{"text":"δὲ"},{"text":"ἔργοις"},{"text":"ἀρνοῦνται"},{"text":"βδελυκτοὶ"},{"text":"ὄντες"},{"text":"καὶ"},{"text":"ἀπειθεῖς"},{"text":"καὶ"},{"text":"πρὸς"},{"text":"πᾶν"},{"text":"ἔργον"},{"text":"ἀγαθὸν"},{"text":"ἀδόκιμοι"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Σὺ δὲ λάλει ἃ πρέπει τῇ ὑγιαινούσῃ διδασκαλίᾳ.","tokens":[{"text":"Σὺ"},{"text":"δὲ"},{"text":"λάλει"},{"text":"ἃ"},{"text":"πρέπει"},{"text":"τῇ"},{"text":"ὑγιαινούσῃ"},{"text":"διδασκαλίᾳ"}],"notes":[],"lang":"grc"},{"n":2,"text":"πρεσβύτας νηφαλίους εἶναι, σεμνούς, σώφρονας, ὑγιαίνοντας τῇ πίστει, τῇ ἀγάπῃ, τῇ ὑπομονῇ.","tokens":[{"text":"πρεσβύτας"},{"text":"νηφαλίους"},{"text":"εἶναι"},{"text":"σεμνούς"},{"text":"σώφρονας"},{"text":"ὑγιαίνοντας"},{"text":"τῇ"},{"text":"πίστει"},{"text":"τῇ"},{"text":"ἀγάπῃ"},{"text":"τῇ"},{"text":"ὑπομονῇ"}],"notes":[],"lang":"grc"},{"n":3,"text":"Πρεσβύτιδας ὡσαύτως ἐν καταστήματι ἱεροπρεπεῖς, μὴ διαβόλους ⸀ μηδὲ οἴνῳ πολλῷ δεδουλωμένας, καλοδιδασκάλους,","tokens":[{"text":"Πρεσβύτιδας"},{"text":"ὡσαύτως"},{"text":"ἐν"},{"text":"καταστήματι"},{"text":"ἱεροπρεπεῖς"},{"text":"μὴ"},{"text":"διαβόλους"},{"text":"μηδὲ"},{"text":"οἴνῳ"},{"text":"πολλῷ"},{"text":"δεδουλωμένας"},{"text":"καλοδιδασκάλους"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἵνα ⸀ σωφρονίζωσι τὰς νέας φιλάνδρους εἶναι, φιλοτέκνους,","tokens":[{"text":"ἵνα"},{"text":"σωφρονίζωσι"},{"text":"τὰς"},{"text":"νέας"},{"text":"φιλάνδρους"},{"text":"εἶναι"},{"text":"φιλοτέκνους"}],"notes":[],"lang":"grc"},{"n":5,"text":"σώφρονας, ἁγνάς,  ⸀ οἰκουργούς, ἀγαθάς, ὑποτασσομένας τοῖς ἰδίοις ἀνδράσιν, ἵνα μὴ ὁ λόγος τοῦ θεοῦ βλασφημῆται.","tokens":[{"text":"σώφρονας"},{"text":"ἁγνάς"},{"text":"οἰκουργούς"},{"text":"ἀγαθάς"},{"text":"ὑποτασσομένας"},{"text":"τοῖς"},{"text":"ἰδίοις"},{"text":"ἀνδράσιν"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ὁ"},{"text":"λόγος"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"βλασφημῆται"}],"notes":[],"lang":"grc"},{"n":6,"text":"Τοὺς νεωτέρους ὡσαύτως παρακάλει σωφρονεῖν·","tokens":[{"text":"Τοὺς"},{"text":"νεωτέρους"},{"text":"ὡσαύτως"},{"text":"παρακάλει"},{"text":"σωφρονεῖν"}],"notes":[],"lang":"grc"},{"n":7,"text":"περὶ πάντα σεαυτὸν παρεχόμενος τύπον καλῶν ἔργων, ἐν τῇ διδασκαλίᾳ ⸀ ἀφθορίαν,  ⸀ σεμνότητα,","tokens":[{"text":"περὶ"},{"text":"πάντα"},{"text":"σεαυτὸν"},{"text":"παρεχόμενος"},{"text":"τύπον"},{"text":"καλῶν"},{"text":"ἔργων"},{"text":"ἐν"},{"text":"τῇ"},{"text":"διδασκαλίᾳ"},{"text":"ἀφθορίαν"},{"text":"σεμνότητα"}],"notes":[],"lang":"grc"},{"n":8,"text":"λόγον ὑγιῆ ἀκατάγνωστον, ἵνα ὁ ἐξ ἐναντίας ἐντραπῇ μηδὲν ἔχων ⸂ λέγειν περὶ ἡμῶν⸃ φαῦλον.","tokens":[{"text":"λόγον"},{"text":"ὑγιῆ"},{"text":"ἀκατάγνωστον"},{"text":"ἵνα"},{"text":"ὁ"},{"text":"ἐξ"},{"text":"ἐναντίας"},{"text":"ἐντραπῇ"},{"text":"μηδὲν"},{"text":"ἔχων"},{"text":"λέγειν"},{"text":"περὶ"},{"text":"ἡμῶν"},{"text":"φαῦλον"}],"notes":[],"lang":"grc"},{"n":9,"text":"Δούλους ἰδίοις δεσπόταις ὑποτάσσεσθαι ἐν πᾶσιν, εὐαρέστους εἶναι, μὴ ἀντιλέγοντας,","tokens":[{"text":"Δούλους"},{"text":"ἰδίοις"},{"text":"δεσπόταις"},{"text":"ὑποτάσσεσθαι"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"εὐαρέστους"},{"text":"εἶναι"},{"text":"μὴ"},{"text":"ἀντιλέγοντας"}],"notes":[],"lang":"grc"},{"n":10,"text":"μὴ νοσφιζομένους, ἀλλὰ ⸂ πᾶσαν πίστιν⸃ ἐνδεικνυμένους ἀγαθήν, ἵνα τὴν διδασκαλίαν ⸀ τὴν τοῦ σωτῆρος ἡμῶν θεοῦ κοσμῶσιν ἐν πᾶσιν.","tokens":[{"text":"μὴ"},{"text":"νοσφιζομένους"},{"text":"ἀλλὰ"},{"text":"πᾶσαν"},{"text":"πίστιν"},{"text":"ἐνδεικνυμένους"},{"text":"ἀγαθήν"},{"text":"ἵνα"},{"text":"τὴν"},{"text":"διδασκαλίαν"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"θεοῦ"},{"text":"κοσμῶσιν"},{"text":"ἐν"},{"text":"πᾶσιν"}],"notes":[],"lang":"grc"},{"n":11,"text":"Ἐπεφάνη γὰρ ἡ χάρις τοῦ ⸀ θεοῦ σωτήριος πᾶσιν ἀνθρώποις","tokens":[{"text":"Ἐπεφάνη"},{"text":"γὰρ"},{"text":"ἡ"},{"text":"χάρις"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"σωτήριος"},{"text":"πᾶσιν"},{"text":"ἀνθρώποις"}],"notes":[],"lang":"grc"},{"n":12,"text":"παιδεύουσα ἡμᾶς, ἵνα ἀρνησάμενοι τὴν ἀσέβειαν καὶ τὰς κοσμικὰς ἐπιθυμίας σωφρόνως καὶ δικαίως καὶ εὐσεβῶς ζήσωμεν ἐν τῷ νῦν αἰῶνι,","tokens":[{"text":"παιδεύουσα"},{"text":"ἡμᾶς"},{"text":"ἵνα"},{"text":"ἀρνησάμενοι"},{"text":"τὴν"},{"text":"ἀσέβειαν"},{"text":"καὶ"},{"text":"τὰς"},{"text":"κοσμικὰς"},{"text":"ἐπιθυμίας"},{"text":"σωφρόνως"},{"text":"καὶ"},{"text":"δικαίως"},{"text":"καὶ"},{"text":"εὐσεβῶς"},{"text":"ζήσωμεν"},{"text":"ἐν"},{"text":"τῷ"},{"text":"νῦν"},{"text":"αἰῶνι"}],"notes":[],"lang":"grc"},{"n":13,"text":"προσδεχόμενοι τὴν μακαρίαν ἐλπίδα καὶ ἐπιφάνειαν τῆς δόξης τοῦ μεγάλου θεοῦ καὶ σωτῆρος ἡμῶν ⸂ Ἰησοῦ Χριστοῦ⸃,","tokens":[{"text":"προσδεχόμενοι"},{"text":"τὴν"},{"text":"μακαρίαν"},{"text":"ἐλπίδα"},{"text":"καὶ"},{"text":"ἐπιφάνειαν"},{"text":"τῆς"},{"text":"δόξης"},{"text":"τοῦ"},{"text":"μεγάλου"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":14,"text":"ὃς ἔδωκεν ἑαυτὸν ὑπὲρ ἡμῶν ἵνα λυτρώσηται ἡμᾶς ἀπὸ πάσης ἀνομίας καὶ καθαρίσῃ ἑαυτῷ λαὸν περιούσιον, ζηλωτὴν καλῶν ἔργων.","tokens":[{"text":"ὃς"},{"text":"ἔδωκεν"},{"text":"ἑαυτὸν"},{"text":"ὑπὲρ"},{"text":"ἡμῶν"},{"text":"ἵνα"},{"text":"λυτρώσηται"},{"text":"ἡμᾶς"},{"text":"ἀπὸ"},{"text":"πάσης"},{"text":"ἀνομίας"},{"text":"καὶ"},{"text":"καθαρίσῃ"},{"text":"ἑαυτῷ"},{"text":"λαὸν"},{"text":"περιούσιον"},{"text":"ζηλωτὴν"},{"text":"καλῶν"},{"text":"ἔργων"}],"notes":[],"lang":"grc"},{"n":15,"text":"Ταῦτα λάλει καὶ παρακάλει καὶ ἔλεγχε μετὰ πάσης ἐπιταγῆς· μηδείς σου περιφρονείτω.","tokens":[{"text":"Ταῦτα"},{"text":"λάλει"},{"text":"καὶ"},{"text":"παρακάλει"},{"text":"καὶ"},{"text":"ἔλεγχε"},{"text":"μετὰ"},{"text":"πάσης"},{"text":"ἐπιταγῆς"},{"text":"μηδείς"},{"text":"σου"},{"text":"περιφρονείτω"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Ὑπομίμνῃσκε αὐτοὺς ⸀ ἀρχαῖς ἐξουσίαις ὑποτάσσεσθαι πειθαρχεῖν, πρὸς πᾶν ἔργον ἀγαθὸν ἑτοίμους εἶναι,","tokens":[{"text":"Ὑπομίμνῃσκε"},{"text":"αὐτοὺς"},{"text":"ἀρχαῖς"},{"text":"ἐξουσίαις"},{"text":"ὑποτάσσεσθαι"},{"text":"πειθαρχεῖν"},{"text":"πρὸς"},{"text":"πᾶν"},{"text":"ἔργον"},{"text":"ἀγαθὸν"},{"text":"ἑτοίμους"},{"text":"εἶναι"}],"notes":[],"lang":"grc"},{"n":2,"text":"μηδένα βλασφημεῖν, ἀμάχους εἶναι, ἐπιεικεῖς, πᾶσαν ἐνδεικνυμένους πραΰτητα πρὸς πάντας ἀνθρώπους.","tokens":[{"text":"μηδένα"},{"text":"βλασφημεῖν"},{"text":"ἀμάχους"},{"text":"εἶναι"},{"text":"ἐπιεικεῖς"},{"text":"πᾶσαν"},{"text":"ἐνδεικνυμένους"},{"text":"πραΰτητα"},{"text":"πρὸς"},{"text":"πάντας"},{"text":"ἀνθρώπους"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἦμεν γάρ ποτε καὶ ἡμεῖς ἀνόητοι, ἀπειθεῖς, πλανώμενοι, δουλεύοντες ἐπιθυμίαις καὶ ἡδοναῖς ποικίλαις, ἐν κακίᾳ καὶ φθόνῳ διάγοντες, στυγητοί, μισοῦντες ἀλλήλους.","tokens":[{"text":"ἦμεν"},{"text":"γάρ"},{"text":"ποτε"},{"text":"καὶ"},{"text":"ἡμεῖς"},{"text":"ἀνόητοι"},{"text":"ἀπειθεῖς"},{"text":"πλανώμενοι"},{"text":"δουλεύοντες"},{"text":"ἐπιθυμίαις"},{"text":"καὶ"},{"text":"ἡδοναῖς"},{"text":"ποικίλαις"},{"text":"ἐν"},{"text":"κακίᾳ"},{"text":"καὶ"},{"text":"φθόνῳ"},{"text":"διάγοντες"},{"text":"στυγητοί"},{"text":"μισοῦντες"},{"text":"ἀλλήλους"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὅτε δὲ ἡ χρηστότης καὶ ἡ φιλανθρωπία ἐπεφάνη τοῦ σωτῆρος ἡμῶν θεοῦ,","tokens":[{"text":"ὅτε"},{"text":"δὲ"},{"text":"ἡ"},{"text":"χρηστότης"},{"text":"καὶ"},{"text":"ἡ"},{"text":"φιλανθρωπία"},{"text":"ἐπεφάνη"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":5,"text":"οὐκ ἐξ ἔργων τῶν ἐν δικαιοσύνῃ ⸀ ἃ ἐποιήσαμεν ἡμεῖς ἀλλὰ κατὰ ⸂ τὸ αὐτοῦ ἔλεος⸃ ἔσωσεν ἡμᾶς διὰ λουτροῦ παλιγγενεσίας καὶ ἀνακαινώσεως πνεύματος ἁγίου,","tokens":[{"text":"οὐκ"},{"text":"ἐξ"},{"text":"ἔργων"},{"text":"τῶν"},{"text":"ἐν"},{"text":"δικαιοσύνῃ"},{"text":"ἃ"},{"text":"ἐποιήσαμεν"},{"text":"ἡμεῖς"},{"text":"ἀλλὰ"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"αὐτοῦ"},{"text":"ἔλεος"},{"text":"ἔσωσεν"},{"text":"ἡμᾶς"},{"text":"διὰ"},{"text":"λουτροῦ"},{"text":"παλιγγενεσίας"},{"text":"καὶ"},{"text":"ἀνακαινώσεως"},{"text":"πνεύματος"},{"text":"ἁγίου"}],"notes":[],"lang":"grc"},{"n":6,"text":"οὗ ἐξέχεεν ἐφʼ ἡμᾶς πλουσίως διὰ Ἰησοῦ Χριστοῦ τοῦ σωτῆρος ἡμῶν,","tokens":[{"text":"οὗ"},{"text":"ἐξέχεεν"},{"text":"ἐφʼ"},{"text":"ἡμᾶς"},{"text":"πλουσίως"},{"text":"διὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἵνα δικαιωθέντες τῇ ἐκείνου χάριτι κληρονόμοι ⸀ γενηθῶμεν κατʼ ἐλπίδα ζωῆς αἰωνίου.","tokens":[{"text":"ἵνα"},{"text":"δικαιωθέντες"},{"text":"τῇ"},{"text":"ἐκείνου"},{"text":"χάριτι"},{"text":"κληρονόμοι"},{"text":"γενηθῶμεν"},{"text":"κατʼ"},{"text":"ἐλπίδα"},{"text":"ζωῆς"},{"text":"αἰωνίου"}],"notes":[],"lang":"grc"},{"n":8,"text":"Πιστὸς ὁ λόγος, καὶ περὶ τούτων βούλομαί σε διαβεβαιοῦσθαι, ἵνα φροντίζωσιν καλῶν ἔργων προΐστασθαι οἱ πεπιστευκότες θεῷ. ταῦτά ⸀ ἐστιν καλὰ καὶ ὠφέλιμα τοῖς ἀνθρώποις·","tokens":[{"text":"Πιστὸς"},{"text":"ὁ"},{"text":"λόγος"},{"text":"καὶ"},{"text":"περὶ"},{"text":"τούτων"},{"text":"βούλομαί"},{"text":"σε"},{"text":"διαβεβαιοῦσθαι"},{"text":"ἵνα"},{"text":"φροντίζωσιν"},{"text":"καλῶν"},{"text":"ἔργων"},{"text":"προΐστασθαι"},{"text":"οἱ"},{"text":"πεπιστευκότες"},{"text":"θεῷ"},{"text":"ταῦτά"},{"text":"ἐστιν"},{"text":"καλὰ"},{"text":"καὶ"},{"text":"ὠφέλιμα"},{"text":"τοῖς"},{"text":"ἀνθρώποις"}],"notes":[],"lang":"grc"},{"n":9,"text":"μωρὰς δὲ ζητήσεις καὶ γενεαλογίας καὶ ⸀ ἔρεις καὶ μάχας νομικὰς περιΐστασο, εἰσὶν γὰρ ἀνωφελεῖς καὶ μάταιοι.","tokens":[{"text":"μωρὰς"},{"text":"δὲ"},{"text":"ζητήσεις"},{"text":"καὶ"},{"text":"γενεαλογίας"},{"text":"καὶ"},{"text":"ἔρεις"},{"text":"καὶ"},{"text":"μάχας"},{"text":"νομικὰς"},{"text":"περιΐστασο"},{"text":"εἰσὶν"},{"text":"γὰρ"},{"text":"ἀνωφελεῖς"},{"text":"καὶ"},{"text":"μάταιοι"}],"notes":[],"lang":"grc"},{"n":10,"text":"αἱρετικὸν ἄνθρωπον μετὰ μίαν καὶ δευτέραν νουθεσίαν παραιτοῦ,","tokens":[{"text":"αἱρετικὸν"},{"text":"ἄνθρωπον"},{"text":"μετὰ"},{"text":"μίαν"},{"text":"καὶ"},{"text":"δευτέραν"},{"text":"νουθεσίαν"},{"text":"παραιτοῦ"}],"notes":[],"lang":"grc"},{"n":11,"text":"εἰδὼς ὅτι ἐξέστραπται ὁ τοιοῦτος καὶ ἁμαρτάνει, ὢν αὐτοκατάκριτος.","tokens":[{"text":"εἰδὼς"},{"text":"ὅτι"},{"text":"ἐξέστραπται"},{"text":"ὁ"},{"text":"τοιοῦτος"},{"text":"καὶ"},{"text":"ἁμαρτάνει"},{"text":"ὢν"},{"text":"αὐτοκατάκριτος"}],"notes":[],"lang":"grc"},{"n":12,"text":"Ὅταν πέμψω Ἀρτεμᾶν πρὸς σὲ ἢ Τυχικόν, σπούδασον ἐλθεῖν πρός με εἰς Νικόπολιν, ἐκεῖ γὰρ κέκρικα παραχειμάσαι.","tokens":[{"text":"Ὅταν"},{"text":"πέμψω"},{"text":"Ἀρτεμᾶν"},{"text":"πρὸς"},{"text":"σὲ"},{"text":"ἢ"},{"text":"Τυχικόν"},{"text":"σπούδασον"},{"text":"ἐλθεῖν"},{"text":"πρός"},{"text":"με"},{"text":"εἰς"},{"text":"Νικόπολιν"},{"text":"ἐκεῖ"},{"text":"γὰρ"},{"text":"κέκρικα"},{"text":"παραχειμάσαι"}],"notes":[],"lang":"grc"},{"n":13,"text":"Ζηνᾶν τὸν νομικὸν καὶ ⸀ Ἀπολλῶν σπουδαίως πρόπεμψον, ἵνα μηδὲν αὐτοῖς λείπῃ.","tokens":[{"text":"Ζηνᾶν"},{"text":"τὸν"},{"text":"νομικὸν"},{"text":"καὶ"},{"text":"Ἀπολλῶν"},{"text":"σπουδαίως"},{"text":"πρόπεμψον"},{"text":"ἵνα"},{"text":"μηδὲν"},{"text":"αὐτοῖς"},{"text":"λείπῃ"}],"notes":[],"lang":"grc"},{"n":14,"text":"μανθανέτωσαν δὲ καὶ οἱ ἡμέτεροι καλῶν ἔργων προΐστασθαι εἰς τὰς ἀναγκαίας χρείας, ἵνα μὴ ὦσιν ἄκαρποι.","tokens":[{"text":"μανθανέτωσαν"},{"text":"δὲ"},{"text":"καὶ"},{"text":"οἱ"},{"text":"ἡμέτεροι"},{"text":"καλῶν"},{"text":"ἔργων"},{"text":"προΐστασθαι"},{"text":"εἰς"},{"text":"τὰς"},{"text":"ἀναγκαίας"},{"text":"χρείας"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ὦσιν"},{"text":"ἄκαρποι"}],"notes":[],"lang":"grc"},{"n":15,"text":"Ἀσπάζονταί σε οἱ μετʼ ἐμοῦ πάντες. ἄσπασαι τοὺς φιλοῦντας ἡμᾶς ἐν πίστει. ἡ χάρις μετὰ πάντων ⸀ ὑμῶν.","tokens":[{"text":"Ἀσπάζονταί"},{"text":"σε"},{"text":"οἱ"},{"text":"μετʼ"},{"text":"ἐμοῦ"},{"text":"πάντες"},{"text":"ἄσπασαι"},{"text":"τοὺς"},{"text":"φιλοῦντας"},{"text":"ἡμᾶς"},{"text":"ἐν"},{"text":"πίστει"},{"text":"ἡ"},{"text":"χάρις"},{"text":"μετὰ"},{"text":"πάντων"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}