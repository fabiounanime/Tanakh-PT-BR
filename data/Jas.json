{"book":{"id":"Jas","name":"Tiago","testament":"NT","source":"SBLGNT","chapters":5,"verses":108},"chapters":{"1":[{"n":1,"text":"Ἰάκωβος θεοῦ καὶ κυρίου Ἰησοῦ Χριστοῦ δοῦλος ταῖς δώδεκα φυλαῖς ταῖς ἐν τῇ διασπορᾷ χαίρειν.","tokens":[{"text":"Ἰάκωβος"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"δοῦλος"},{"text":"ταῖς"},{"text":"δώδεκα"},{"text":"φυλαῖς"},{"text":"ταῖς"},{"text":"ἐν"},{"text":"τῇ"},{"text":"διασπορᾷ"},{"text":"χαίρειν"}],"notes":[],"lang":"grc"},{"n":2,"text":"Πᾶσαν χαρὰν ἡγήσασθε, ἀδελφοί μου, ὅταν πειρασμοῖς περιπέσητε ποικίλοις,","tokens":[{"text":"Πᾶσαν"},{"text":"χαρὰν"},{"text":"ἡγήσασθε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ὅταν"},{"text":"πειρασμοῖς"},{"text":"περιπέσητε"},{"text":"ποικίλοις"}],"notes":[],"lang":"grc"},{"n":3,"text":"γινώσκοντες ὅτι τὸ δοκίμιον ὑμῶν τῆς πίστεως κατεργάζεται ὑπομονήν·","tokens":[{"text":"γινώσκοντες"},{"text":"ὅτι"},{"text":"τὸ"},{"text":"δοκίμιον"},{"text":"ὑμῶν"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"κατεργάζεται"},{"text":"ὑπομονήν"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἡ δὲ ὑπομονὴ ἔργον τέλειον ἐχέτω, ἵνα ἦτε τέλειοι καὶ ὁλόκληροι, ἐν μηδενὶ λειπόμενοι.","tokens":[{"text":"ἡ"},{"text":"δὲ"},{"text":"ὑπομονὴ"},{"text":"ἔργον"},{"text":"τέλειον"},{"text":"ἐχέτω"},{"text":"ἵνα"},{"text":"ἦτε"},{"text":"τέλειοι"},{"text":"καὶ"},{"text":"ὁλόκληροι"},{"text":"ἐν"},{"text":"μηδενὶ"},{"text":"λειπόμενοι"}],"notes":[],"lang":"grc"},{"n":5,"text":"Εἰ δέ τις ὑμῶν λείπεται σοφίας, αἰτείτω παρὰ τοῦ διδόντος θεοῦ πᾶσιν ἁπλῶς καὶ ⸀ μὴ ὀνειδίζοντος, καὶ δοθήσεται αὐτῷ·","tokens":[{"text":"Εἰ"},{"text":"δέ"},{"text":"τις"},{"text":"ὑμῶν"},{"text":"λείπεται"},{"text":"σοφίας"},{"text":"αἰτείτω"},{"text":"παρὰ"},{"text":"τοῦ"},{"text":"διδόντος"},{"text":"θεοῦ"},{"text":"πᾶσιν"},{"text":"ἁπλῶς"},{"text":"καὶ"},{"text":"μὴ"},{"text":"ὀνειδίζοντος"},{"text":"καὶ"},{"text":"δοθήσεται"},{"text":"αὐτῷ"}],"notes":[],"lang":"grc"},{"n":6,"text":"αἰτείτω δὲ ἐν πίστει, μηδὲν διακρινόμενος, ὁ γὰρ διακρινόμενος ἔοικεν κλύδωνι θαλάσσης ἀνεμιζομένῳ καὶ ῥιπιζομένῳ·","tokens":[{"text":"αἰτείτω"},{"text":"δὲ"},{"text":"ἐν"},{"text":"πίστει"},{"text":"μηδὲν"},{"text":"διακρινόμενος"},{"text":"ὁ"},{"text":"γὰρ"},{"text":"διακρινόμενος"},{"text":"ἔοικεν"},{"text":"κλύδωνι"},{"text":"θαλάσσης"},{"text":"ἀνεμιζομένῳ"},{"text":"καὶ"},{"text":"ῥιπιζομένῳ"}],"notes":[],"lang":"grc"},{"n":7,"text":"μὴ γὰρ οἰέσθω ὁ ἄνθρωπος ἐκεῖνος ὅτι λήμψεταί τι παρὰ τοῦ κυρίου","tokens":[{"text":"μὴ"},{"text":"γὰρ"},{"text":"οἰέσθω"},{"text":"ὁ"},{"text":"ἄνθρωπος"},{"text":"ἐκεῖνος"},{"text":"ὅτι"},{"text":"λήμψεταί"},{"text":"τι"},{"text":"παρὰ"},{"text":"τοῦ"},{"text":"κυρίου"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἀνὴρ δίψυχος, ἀκατάστατος ἐν πάσαις ταῖς ὁδοῖς αὐτοῦ.","tokens":[{"text":"ἀνὴρ"},{"text":"δίψυχος"},{"text":"ἀκατάστατος"},{"text":"ἐν"},{"text":"πάσαις"},{"text":"ταῖς"},{"text":"ὁδοῖς"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"Καυχάσθω δὲ ὁ ἀδελφὸς ὁ ταπεινὸς ἐν τῷ ὕψει αὐτοῦ,","tokens":[{"text":"Καυχάσθω"},{"text":"δὲ"},{"text":"ὁ"},{"text":"ἀδελφὸς"},{"text":"ὁ"},{"text":"ταπεινὸς"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ὕψει"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὁ δὲ πλούσιος ἐν τῇ ταπεινώσει αὐτοῦ, ὅτι ὡς ἄνθος χόρτου παρελεύσεται.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"πλούσιος"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ταπεινώσει"},{"text":"αὐτοῦ"},{"text":"ὅτι"},{"text":"ὡς"},{"text":"ἄνθος"},{"text":"χόρτου"},{"text":"παρελεύσεται"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἀνέτειλεν γὰρ ὁ ἥλιος σὺν τῷ καύσωνι καὶ ἐξήρανεν τὸν χόρτον, καὶ τὸ ἄνθος αὐτοῦ ἐξέπεσεν καὶ ἡ εὐπρέπεια τοῦ προσώπου αὐτοῦ ἀπώλετο· οὕτως καὶ ὁ πλούσιος ἐν ταῖς πορείαις αὐτοῦ μαρανθήσεται.","tokens":[{"text":"ἀνέτειλεν"},{"text":"γὰρ"},{"text":"ὁ"},{"text":"ἥλιος"},{"text":"σὺν"},{"text":"τῷ"},{"text":"καύσωνι"},{"text":"καὶ"},{"text":"ἐξήρανεν"},{"text":"τὸν"},{"text":"χόρτον"},{"text":"καὶ"},{"text":"τὸ"},{"text":"ἄνθος"},{"text":"αὐτοῦ"},{"text":"ἐξέπεσεν"},{"text":"καὶ"},{"text":"ἡ"},{"text":"εὐπρέπεια"},{"text":"τοῦ"},{"text":"προσώπου"},{"text":"αὐτοῦ"},{"text":"ἀπώλετο"},{"text":"οὕτως"},{"text":"καὶ"},{"text":"ὁ"},{"text":"πλούσιος"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"πορείαις"},{"text":"αὐτοῦ"},{"text":"μαρανθήσεται"}],"notes":[],"lang":"grc"},{"n":12,"text":"Μακάριος ἀνὴρ ὃς ὑπομένει πειρασμόν, ὅτι δόκιμος γενόμενος λήμψεται τὸν στέφανον τῆς ζωῆς, ὃν ⸀ ἐπηγγείλατο τοῖς ἀγαπῶσιν αὐτόν.","tokens":[{"text":"Μακάριος"},{"text":"ἀνὴρ"},{"text":"ὃς"},{"text":"ὑπομένει"},{"text":"πειρασμόν"},{"text":"ὅτι"},{"text":"δόκιμος"},{"text":"γενόμενος"},{"text":"λήμψεται"},{"text":"τὸν"},{"text":"στέφανον"},{"text":"τῆς"},{"text":"ζωῆς"},{"text":"ὃν"},{"text":"ἐπηγγείλατο"},{"text":"τοῖς"},{"text":"ἀγαπῶσιν"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":13,"text":"μηδεὶς πειραζόμενος λεγέτω ὅτι Ἀπὸ θεοῦ πειράζομαι· ὁ γὰρ θεὸς ἀπείραστός ἐστιν κακῶν, πειράζει δὲ αὐτὸς οὐδένα.","tokens":[{"text":"μηδεὶς"},{"text":"πειραζόμενος"},{"text":"λεγέτω"},{"text":"ὅτι"},{"text":"Ἀπὸ"},{"text":"θεοῦ"},{"text":"πειράζομαι"},{"text":"ὁ"},{"text":"γὰρ"},{"text":"θεὸς"},{"text":"ἀπείραστός"},{"text":"ἐστιν"},{"text":"κακῶν"},{"text":"πειράζει"},{"text":"δὲ"},{"text":"αὐτὸς"},{"text":"οὐδένα"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἕκαστος δὲ πειράζεται ὑπὸ τῆς ἰδίας ἐπιθυμίας ἐξελκόμενος καὶ δελεαζόμενος·","tokens":[{"text":"ἕκαστος"},{"text":"δὲ"},{"text":"πειράζεται"},{"text":"ὑπὸ"},{"text":"τῆς"},{"text":"ἰδίας"},{"text":"ἐπιθυμίας"},{"text":"ἐξελκόμενος"},{"text":"καὶ"},{"text":"δελεαζόμενος"}],"notes":[],"lang":"grc"},{"n":15,"text":"εἶτα ἡ ἐπιθυμία συλλαβοῦσα τίκτει ἁμαρτίαν, ἡ δὲ ἁμαρτία ἀποτελεσθεῖσα ἀποκύει θάνατον.","tokens":[{"text":"εἶτα"},{"text":"ἡ"},{"text":"ἐπιθυμία"},{"text":"συλλαβοῦσα"},{"text":"τίκτει"},{"text":"ἁμαρτίαν"},{"text":"ἡ"},{"text":"δὲ"},{"text":"ἁμαρτία"},{"text":"ἀποτελεσθεῖσα"},{"text":"ἀποκύει"},{"text":"θάνατον"}],"notes":[],"lang":"grc"},{"n":16,"text":"μὴ πλανᾶσθε, ἀδελφοί μου ἀγαπητοί.","tokens":[{"text":"μὴ"},{"text":"πλανᾶσθε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ἀγαπητοί"}],"notes":[],"lang":"grc"},{"n":17,"text":"Πᾶσα δόσις ἀγαθὴ καὶ πᾶν δώρημα τέλειον ἄνωθέν ἐστιν, καταβαῖνον ἀπὸ τοῦ πατρὸς τῶν φώτων, παρʼ ᾧ οὐκ ἔνι παραλλαγὴ ἢ τροπῆς ἀποσκίασμα.","tokens":[{"text":"Πᾶσα"},{"text":"δόσις"},{"text":"ἀγαθὴ"},{"text":"καὶ"},{"text":"πᾶν"},{"text":"δώρημα"},{"text":"τέλειον"},{"text":"ἄνωθέν"},{"text":"ἐστιν"},{"text":"καταβαῖνον"},{"text":"ἀπὸ"},{"text":"τοῦ"},{"text":"πατρὸς"},{"text":"τῶν"},{"text":"φώτων"},{"text":"παρʼ"},{"text":"ᾧ"},{"text":"οὐκ"},{"text":"ἔνι"},{"text":"παραλλαγὴ"},{"text":"ἢ"},{"text":"τροπῆς"},{"text":"ἀποσκίασμα"}],"notes":[],"lang":"grc"},{"n":18,"text":"βουληθεὶς ἀπεκύησεν ἡμᾶς λόγῳ ἀληθείας, εἰς τὸ εἶναι ἡμᾶς ἀπαρχήν τινα τῶν αὐτοῦ κτισμάτων.","tokens":[{"text":"βουληθεὶς"},{"text":"ἀπεκύησεν"},{"text":"ἡμᾶς"},{"text":"λόγῳ"},{"text":"ἀληθείας"},{"text":"εἰς"},{"text":"τὸ"},{"text":"εἶναι"},{"text":"ἡμᾶς"},{"text":"ἀπαρχήν"},{"text":"τινα"},{"text":"τῶν"},{"text":"αὐτοῦ"},{"text":"κτισμάτων"}],"notes":[],"lang":"grc"},{"n":19,"text":"⸀ Ἴστε, ἀδελφοί μου ἀγαπητοί. ἔστω ⸀ δὲ πᾶς ἄνθρωπος ταχὺς εἰς τὸ ἀκοῦσαι, βραδὺς εἰς τὸ λαλῆσαι, βραδὺς εἰς ὀργήν,","tokens":[{"text":"Ἴστε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ἀγαπητοί"},{"text":"ἔστω"},{"text":"δὲ"},{"text":"πᾶς"},{"text":"ἄνθρωπος"},{"text":"ταχὺς"},{"text":"εἰς"},{"text":"τὸ"},{"text":"ἀκοῦσαι"},{"text":"βραδὺς"},{"text":"εἰς"},{"text":"τὸ"},{"text":"λαλῆσαι"},{"text":"βραδὺς"},{"text":"εἰς"},{"text":"ὀργήν"}],"notes":[],"lang":"grc"},{"n":20,"text":"ὀργὴ γὰρ ἀνδρὸς δικαιοσύνην θεοῦ ⸂ οὐκ ἐργάζεται⸃.","tokens":[{"text":"ὀργὴ"},{"text":"γὰρ"},{"text":"ἀνδρὸς"},{"text":"δικαιοσύνην"},{"text":"θεοῦ"},{"text":"οὐκ"},{"text":"ἐργάζεται"}],"notes":[],"lang":"grc"},{"n":21,"text":"διὸ ἀποθέμενοι πᾶσαν ῥυπαρίαν καὶ περισσείαν κακίας ἐν πραΰτητι δέξασθε τὸν ἔμφυτον λόγον τὸν δυνάμενον σῶσαι τὰς ψυχὰς ὑμῶν.","tokens":[{"text":"διὸ"},{"text":"ἀποθέμενοι"},{"text":"πᾶσαν"},{"text":"ῥυπαρίαν"},{"text":"καὶ"},{"text":"περισσείαν"},{"text":"κακίας"},{"text":"ἐν"},{"text":"πραΰτητι"},{"text":"δέξασθε"},{"text":"τὸν"},{"text":"ἔμφυτον"},{"text":"λόγον"},{"text":"τὸν"},{"text":"δυνάμενον"},{"text":"σῶσαι"},{"text":"τὰς"},{"text":"ψυχὰς"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":22,"text":"Γίνεσθε δὲ ποιηταὶ λόγου καὶ μὴ ⸂ ἀκροαταὶ μόνον⸃ παραλογιζόμενοι ἑαυτούς.","tokens":[{"text":"Γίνεσθε"},{"text":"δὲ"},{"text":"ποιηταὶ"},{"text":"λόγου"},{"text":"καὶ"},{"text":"μὴ"},{"text":"ἀκροαταὶ"},{"text":"μόνον"},{"text":"παραλογιζόμενοι"},{"text":"ἑαυτούς"}],"notes":[],"lang":"grc"},{"n":23,"text":"ὅτι εἴ τις ἀκροατὴς λόγου ἐστὶν καὶ οὐ ποιητής, οὗτος ἔοικεν ἀνδρὶ κατανοοῦντι τὸ πρόσωπον τῆς γενέσεως αὐτοῦ ἐν ἐσόπτρῳ,","tokens":[{"text":"ὅτι"},{"text":"εἴ"},{"text":"τις"},{"text":"ἀκροατὴς"},{"text":"λόγου"},{"text":"ἐστὶν"},{"text":"καὶ"},{"text":"οὐ"},{"text":"ποιητής"},{"text":"οὗτος"},{"text":"ἔοικεν"},{"text":"ἀνδρὶ"},{"text":"κατανοοῦντι"},{"text":"τὸ"},{"text":"πρόσωπον"},{"text":"τῆς"},{"text":"γενέσεως"},{"text":"αὐτοῦ"},{"text":"ἐν"},{"text":"ἐσόπτρῳ"}],"notes":[],"lang":"grc"},{"n":24,"text":"κατενόησεν γὰρ ἑαυτὸν καὶ ἀπελήλυθεν καὶ εὐθέως ἐπελάθετο ὁποῖος ἦν.","tokens":[{"text":"κατενόησεν"},{"text":"γὰρ"},{"text":"ἑαυτὸν"},{"text":"καὶ"},{"text":"ἀπελήλυθεν"},{"text":"καὶ"},{"text":"εὐθέως"},{"text":"ἐπελάθετο"},{"text":"ὁποῖος"},{"text":"ἦν"}],"notes":[],"lang":"grc"},{"n":25,"text":"ὁ δὲ παρακύψας εἰς νόμον τέλειον τὸν τῆς ἐλευθερίας καὶ παραμείνας,  ⸀ οὐκ ἀκροατὴς ἐπιλησμονῆς γενόμενος ἀλλὰ ποιητὴς ἔργου, οὗτος μακάριος ἐν τῇ ποιήσει αὐτοῦ ἔσται.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"παρακύψας"},{"text":"εἰς"},{"text":"νόμον"},{"text":"τέλειον"},{"text":"τὸν"},{"text":"τῆς"},{"text":"ἐλευθερίας"},{"text":"καὶ"},{"text":"παραμείνας"},{"text":"οὐκ"},{"text":"ἀκροατὴς"},{"text":"ἐπιλησμονῆς"},{"text":"γενόμενος"},{"text":"ἀλλὰ"},{"text":"ποιητὴς"},{"text":"ἔργου"},{"text":"οὗτος"},{"text":"μακάριος"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ποιήσει"},{"text":"αὐτοῦ"},{"text":"ἔσται"}],"notes":[],"lang":"grc"},{"n":26,"text":"Εἴ τις δοκεῖ θρησκὸς ⸀ εἶναι μὴ χαλιναγωγῶν γλῶσσαν ⸀ αὐτοῦ ἀλλὰ ἀπατῶν καρδίαν ⸀ αὐτοῦ, τούτου μάταιος ἡ θρησκεία.","tokens":[{"text":"Εἴ"},{"text":"τις"},{"text":"δοκεῖ"},{"text":"θρησκὸς"},{"text":"εἶναι"},{"text":"μὴ"},{"text":"χαλιναγωγῶν"},{"text":"γλῶσσαν"},{"text":"αὐτοῦ"},{"text":"ἀλλὰ"},{"text":"ἀπατῶν"},{"text":"καρδίαν"},{"text":"αὐτοῦ"},{"text":"τούτου"},{"text":"μάταιος"},{"text":"ἡ"},{"text":"θρησκεία"}],"notes":[],"lang":"grc"},{"n":27,"text":"θρησκεία καθαρὰ καὶ ἀμίαντος παρὰ ⸀ τῷ θεῷ καὶ πατρὶ αὕτη ἐστίν, ἐπισκέπτεσθαι ὀρφανοὺς καὶ χήρας ἐν τῇ θλίψει αὐτῶν, ἄσπιλον ἑαυτὸν τηρεῖν ἀπὸ τοῦ κόσμου.","tokens":[{"text":"θρησκεία"},{"text":"καθαρὰ"},{"text":"καὶ"},{"text":"ἀμίαντος"},{"text":"παρὰ"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"καὶ"},{"text":"πατρὶ"},{"text":"αὕτη"},{"text":"ἐστίν"},{"text":"ἐπισκέπτεσθαι"},{"text":"ὀρφανοὺς"},{"text":"καὶ"},{"text":"χήρας"},{"text":"ἐν"},{"text":"τῇ"},{"text":"θλίψει"},{"text":"αὐτῶν"},{"text":"ἄσπιλον"},{"text":"ἑαυτὸν"},{"text":"τηρεῖν"},{"text":"ἀπὸ"},{"text":"τοῦ"},{"text":"κόσμου"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Ἀδελφοί μου, μὴ ἐν προσωπολημψίαις ἔχετε τὴν πίστιν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ τῆς δόξης;","tokens":[{"text":"Ἀδελφοί"},{"text":"μου"},{"text":"μὴ"},{"text":"ἐν"},{"text":"προσωπολημψίαις"},{"text":"ἔχετε"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τῆς"},{"text":"δόξης"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἐὰν γὰρ εἰσέλθῃ ⸀ εἰς συναγωγὴν ὑμῶν ἀνὴρ χρυσοδακτύλιος ἐν ἐσθῆτι λαμπρᾷ, εἰσέλθῃ δὲ καὶ πτωχὸς ἐν ῥυπαρᾷ ἐσθῆτι,","tokens":[{"text":"ἐὰν"},{"text":"γὰρ"},{"text":"εἰσέλθῃ"},{"text":"εἰς"},{"text":"συναγωγὴν"},{"text":"ὑμῶν"},{"text":"ἀνὴρ"},{"text":"χρυσοδακτύλιος"},{"text":"ἐν"},{"text":"ἐσθῆτι"},{"text":"λαμπρᾷ"},{"text":"εἰσέλθῃ"},{"text":"δὲ"},{"text":"καὶ"},{"text":"πτωχὸς"},{"text":"ἐν"},{"text":"ῥυπαρᾷ"},{"text":"ἐσθῆτι"}],"notes":[],"lang":"grc"},{"n":3,"text":"⸂ ἐπιβλέψητε δὲ⸃ ἐπὶ τὸν φοροῦντα τὴν ἐσθῆτα τὴν λαμπρὰν καὶ ⸀ εἴπητε· Σὺ κάθου ὧδε καλῶς, καὶ τῷ πτωχῷ εἴπητε· Σὺ στῆθι ⸂ ἢ κάθου ἐκεῖ⸃ ὑπὸ τὸ ὑποπόδιόν μου,","tokens":[{"text":"ἐπιβλέψητε"},{"text":"δὲ"},{"text":"ἐπὶ"},{"text":"τὸν"},{"text":"φοροῦντα"},{"text":"τὴν"},{"text":"ἐσθῆτα"},{"text":"τὴν"},{"text":"λαμπρὰν"},{"text":"καὶ"},{"text":"εἴπητε"},{"text":"Σὺ"},{"text":"κάθου"},{"text":"ὧδε"},{"text":"καλῶς"},{"text":"καὶ"},{"text":"τῷ"},{"text":"πτωχῷ"},{"text":"εἴπητε"},{"text":"Σὺ"},{"text":"στῆθι"},{"text":"ἢ"},{"text":"κάθου"},{"text":"ἐκεῖ"},{"text":"ὑπὸ"},{"text":"τὸ"},{"text":"ὑποπόδιόν"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":4,"text":"⸀ οὐ διεκρίθητε ἐν ἑαυτοῖς καὶ ἐγένεσθε κριταὶ διαλογισμῶν πονηρῶν;","tokens":[{"text":"οὐ"},{"text":"διεκρίθητε"},{"text":"ἐν"},{"text":"ἑαυτοῖς"},{"text":"καὶ"},{"text":"ἐγένεσθε"},{"text":"κριταὶ"},{"text":"διαλογισμῶν"},{"text":"πονηρῶν"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἀκούσατε, ἀδελφοί μου ἀγαπητοί. οὐχ ὁ θεὸς ἐξελέξατο τοὺς πτωχοὺς ⸂ τῷ κόσμῳ⸃ πλουσίους ἐν πίστει καὶ κληρονόμους τῆς βασιλείας ἧς ἐπηγγείλατο τοῖς ἀγαπῶσιν αὐτόν;","tokens":[{"text":"ἀκούσατε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ἀγαπητοί"},{"text":"οὐχ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἐξελέξατο"},{"text":"τοὺς"},{"text":"πτωχοὺς"},{"text":"τῷ"},{"text":"κόσμῳ"},{"text":"πλουσίους"},{"text":"ἐν"},{"text":"πίστει"},{"text":"καὶ"},{"text":"κληρονόμους"},{"text":"τῆς"},{"text":"βασιλείας"},{"text":"ἧς"},{"text":"ἐπηγγείλατο"},{"text":"τοῖς"},{"text":"ἀγαπῶσιν"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὑμεῖς δὲ ἠτιμάσατε τὸν πτωχόν. οὐχ οἱ πλούσιοι καταδυναστεύουσιν ὑμῶν, καὶ αὐτοὶ ἕλκουσιν ὑμᾶς εἰς κριτήρια;","tokens":[{"text":"ὑμεῖς"},{"text":"δὲ"},{"text":"ἠτιμάσατε"},{"text":"τὸν"},{"text":"πτωχόν"},{"text":"οὐχ"},{"text":"οἱ"},{"text":"πλούσιοι"},{"text":"καταδυναστεύουσιν"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"αὐτοὶ"},{"text":"ἕλκουσιν"},{"text":"ὑμᾶς"},{"text":"εἰς"},{"text":"κριτήρια"}],"notes":[],"lang":"grc"},{"n":7,"text":"οὐκ αὐτοὶ βλασφημοῦσιν τὸ καλὸν ὄνομα τὸ ἐπικληθὲν ἐφʼ ὑμᾶς;","tokens":[{"text":"οὐκ"},{"text":"αὐτοὶ"},{"text":"βλασφημοῦσιν"},{"text":"τὸ"},{"text":"καλὸν"},{"text":"ὄνομα"},{"text":"τὸ"},{"text":"ἐπικληθὲν"},{"text":"ἐφʼ"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":8,"text":"Εἰ μέντοι νόμον τελεῖτε βασιλικὸν κατὰ τὴν γραφήν Ἀγαπήσεις τὸν πλησίον σου ὡς σεαυτόν, καλῶς ποιεῖτε·","tokens":[{"text":"Εἰ"},{"text":"μέντοι"},{"text":"νόμον"},{"text":"τελεῖτε"},{"text":"βασιλικὸν"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"γραφήν"},{"text":"Ἀγαπήσεις"},{"text":"τὸν"},{"text":"πλησίον"},{"text":"σου"},{"text":"ὡς"},{"text":"σεαυτόν"},{"text":"καλῶς"},{"text":"ποιεῖτε"}],"notes":[],"lang":"grc"},{"n":9,"text":"εἰ δὲ προσωπολημπτεῖτε, ἁμαρτίαν ἐργάζεσθε, ἐλεγχόμενοι ὑπὸ τοῦ νόμου ὡς παραβάται.","tokens":[{"text":"εἰ"},{"text":"δὲ"},{"text":"προσωπολημπτεῖτε"},{"text":"ἁμαρτίαν"},{"text":"ἐργάζεσθε"},{"text":"ἐλεγχόμενοι"},{"text":"ὑπὸ"},{"text":"τοῦ"},{"text":"νόμου"},{"text":"ὡς"},{"text":"παραβάται"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὅστις γὰρ ὅλον τὸν νόμον ⸂ τηρήσῃ, πταίσῃ⸃ δὲ ἐν ἑνί, γέγονεν πάντων ἔνοχος.","tokens":[{"text":"ὅστις"},{"text":"γὰρ"},{"text":"ὅλον"},{"text":"τὸν"},{"text":"νόμον"},{"text":"τηρήσῃ"},{"text":"πταίσῃ"},{"text":"δὲ"},{"text":"ἐν"},{"text":"ἑνί"},{"text":"γέγονεν"},{"text":"πάντων"},{"text":"ἔνοχος"}],"notes":[],"lang":"grc"},{"n":11,"text":"ὁ γὰρ εἰπών· Μὴ ⸀ μοιχεύσῃς εἶπεν καί· Μὴ ⸀ φονεύσῃς· εἰ δὲ οὐ ⸂ μοιχεύεις φονεύεις⸃ δέ, γέγονας παραβάτης νόμου.","tokens":[{"text":"ὁ"},{"text":"γὰρ"},{"text":"εἰπών"},{"text":"Μὴ"},{"text":"μοιχεύσῃς"},{"text":"εἶπεν"},{"text":"καί"},{"text":"Μὴ"},{"text":"φονεύσῃς"},{"text":"εἰ"},{"text":"δὲ"},{"text":"οὐ"},{"text":"μοιχεύεις"},{"text":"φονεύεις"},{"text":"δέ"},{"text":"γέγονας"},{"text":"παραβάτης"},{"text":"νόμου"}],"notes":[],"lang":"grc"},{"n":12,"text":"οὕτως λαλεῖτε καὶ οὕτως ποιεῖτε ὡς διὰ νόμου ἐλευθερίας μέλλοντες κρίνεσθαι.","tokens":[{"text":"οὕτως"},{"text":"λαλεῖτε"},{"text":"καὶ"},{"text":"οὕτως"},{"text":"ποιεῖτε"},{"text":"ὡς"},{"text":"διὰ"},{"text":"νόμου"},{"text":"ἐλευθερίας"},{"text":"μέλλοντες"},{"text":"κρίνεσθαι"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἡ γὰρ κρίσις ἀνέλεος τῷ μὴ ποιήσαντι ἔλεος· κατακαυχᾶται ⸀ ἔλεος κρίσεως.","tokens":[{"text":"ἡ"},{"text":"γὰρ"},{"text":"κρίσις"},{"text":"ἀνέλεος"},{"text":"τῷ"},{"text":"μὴ"},{"text":"ποιήσαντι"},{"text":"ἔλεος"},{"text":"κατακαυχᾶται"},{"text":"ἔλεος"},{"text":"κρίσεως"}],"notes":[],"lang":"grc"},{"n":14,"text":"⸀ Τί ὄφελος, ἀδελφοί μου, ἐὰν πίστιν λέγῃ τις ἔχειν ἔργα δὲ μὴ ἔχῃ; μὴ δύναται ἡ πίστις σῶσαι αὐτόν;","tokens":[{"text":"Τί"},{"text":"ὄφελος"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ἐὰν"},{"text":"πίστιν"},{"text":"λέγῃ"},{"text":"τις"},{"text":"ἔχειν"},{"text":"ἔργα"},{"text":"δὲ"},{"text":"μὴ"},{"text":"ἔχῃ"},{"text":"μὴ"},{"text":"δύναται"},{"text":"ἡ"},{"text":"πίστις"},{"text":"σῶσαι"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":15,"text":"⸀ ἐὰν ἀδελφὸς ἢ ἀδελφὴ γυμνοὶ ὑπάρχωσιν καὶ ⸀ λειπόμενοι τῆς ἐφημέρου τροφῆς,","tokens":[{"text":"ἐὰν"},{"text":"ἀδελφὸς"},{"text":"ἢ"},{"text":"ἀδελφὴ"},{"text":"γυμνοὶ"},{"text":"ὑπάρχωσιν"},{"text":"καὶ"},{"text":"λειπόμενοι"},{"text":"τῆς"},{"text":"ἐφημέρου"},{"text":"τροφῆς"}],"notes":[],"lang":"grc"},{"n":16,"text":"εἴπῃ δέ τις αὐτοῖς ἐξ ὑμῶν· Ὑπάγετε ἐν εἰρήνῃ, θερμαίνεσθε καὶ χορτάζεσθε, μὴ δῶτε δὲ αὐτοῖς τὰ ἐπιτήδεια τοῦ σώματος,  ⸀ τί ὄφελος;","tokens":[{"text":"εἴπῃ"},{"text":"δέ"},{"text":"τις"},{"text":"αὐτοῖς"},{"text":"ἐξ"},{"text":"ὑμῶν"},{"text":"Ὑπάγετε"},{"text":"ἐν"},{"text":"εἰρήνῃ"},{"text":"θερμαίνεσθε"},{"text":"καὶ"},{"text":"χορτάζεσθε"},{"text":"μὴ"},{"text":"δῶτε"},{"text":"δὲ"},{"text":"αὐτοῖς"},{"text":"τὰ"},{"text":"ἐπιτήδεια"},{"text":"τοῦ"},{"text":"σώματος"},{"text":"τί"},{"text":"ὄφελος"}],"notes":[],"lang":"grc"},{"n":17,"text":"οὕτως καὶ ἡ πίστις, ἐὰν μὴ ⸂ ἔχῃ ἔργα⸃, νεκρά ἐστιν καθʼ ἑαυτήν.","tokens":[{"text":"οὕτως"},{"text":"καὶ"},{"text":"ἡ"},{"text":"πίστις"},{"text":"ἐὰν"},{"text":"μὴ"},{"text":"ἔχῃ"},{"text":"ἔργα"},{"text":"νεκρά"},{"text":"ἐστιν"},{"text":"καθʼ"},{"text":"ἑαυτήν"}],"notes":[],"lang":"grc"},{"n":18,"text":"Ἀλλʼ ἐρεῖ τις· Σὺ πίστιν ἔχεις κἀγὼ ἔργα ἔχω. δεῖξόν μοι τὴν πίστιν σου ⸀ χωρὶς τῶν ⸀ ἔργων, κἀγώ ⸂ σοι δείξω⸃ ἐκ τῶν ἔργων μου τὴν ⸀ πίστιν.","tokens":[{"text":"Ἀλλʼ"},{"text":"ἐρεῖ"},{"text":"τις"},{"text":"Σὺ"},{"text":"πίστιν"},{"text":"ἔχεις"},{"text":"κἀγὼ"},{"text":"ἔργα"},{"text":"ἔχω"},{"text":"δεῖξόν"},{"text":"μοι"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"σου"},{"text":"χωρὶς"},{"text":"τῶν"},{"text":"ἔργων"},{"text":"κἀγώ"},{"text":"σοι"},{"text":"δείξω"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"ἔργων"},{"text":"μου"},{"text":"τὴν"},{"text":"πίστιν"}],"notes":[],"lang":"grc"},{"n":19,"text":"σὺ πιστεύεις ὅτι ⸂ εἷς ἐστιν ὁ θεός⸃; καλῶς ποιεῖς· καὶ τὰ δαιμόνια πιστεύουσιν καὶ φρίσσουσιν.","tokens":[{"text":"σὺ"},{"text":"πιστεύεις"},{"text":"ὅτι"},{"text":"εἷς"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"θεός"},{"text":"καλῶς"},{"text":"ποιεῖς"},{"text":"καὶ"},{"text":"τὰ"},{"text":"δαιμόνια"},{"text":"πιστεύουσιν"},{"text":"καὶ"},{"text":"φρίσσουσιν"}],"notes":[],"lang":"grc"},{"n":20,"text":"θέλεις δὲ γνῶναι, ὦ ἄνθρωπε κενέ, ὅτι ἡ πίστις χωρὶς τῶν ἔργων ⸀ ἀργή ἐστιν;","tokens":[{"text":"θέλεις"},{"text":"δὲ"},{"text":"γνῶναι"},{"text":"ὦ"},{"text":"ἄνθρωπε"},{"text":"κενέ"},{"text":"ὅτι"},{"text":"ἡ"},{"text":"πίστις"},{"text":"χωρὶς"},{"text":"τῶν"},{"text":"ἔργων"},{"text":"ἀργή"},{"text":"ἐστιν"}],"notes":[],"lang":"grc"},{"n":21,"text":"Ἀβραὰμ ὁ πατὴρ ἡμῶν οὐκ ἐξ ἔργων ἐδικαιώθη, ἀνενέγκας Ἰσαὰκ τὸν υἱὸν αὐτοῦ ἐπὶ τὸ θυσιαστήριον;","tokens":[{"text":"Ἀβραὰμ"},{"text":"ὁ"},{"text":"πατὴρ"},{"text":"ἡμῶν"},{"text":"οὐκ"},{"text":"ἐξ"},{"text":"ἔργων"},{"text":"ἐδικαιώθη"},{"text":"ἀνενέγκας"},{"text":"Ἰσαὰκ"},{"text":"τὸν"},{"text":"υἱὸν"},{"text":"αὐτοῦ"},{"text":"ἐπὶ"},{"text":"τὸ"},{"text":"θυσιαστήριον"}],"notes":[],"lang":"grc"},{"n":22,"text":"βλέπεις ὅτι ἡ πίστις συνήργει τοῖς ἔργοις αὐτοῦ καὶ ἐκ τῶν ἔργων ἡ πίστις ἐτελειώθη,","tokens":[{"text":"βλέπεις"},{"text":"ὅτι"},{"text":"ἡ"},{"text":"πίστις"},{"text":"συνήργει"},{"text":"τοῖς"},{"text":"ἔργοις"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"ἔργων"},{"text":"ἡ"},{"text":"πίστις"},{"text":"ἐτελειώθη"}],"notes":[],"lang":"grc"},{"n":23,"text":"καὶ ἐπληρώθη ἡ γραφὴ ἡ λέγουσα· Ἐπίστευσεν δὲ Ἀβραὰμ τῷ θεῷ, καὶ ἐλογίσθη αὐτῷ εἰς δικαιοσύνην, καὶ φίλος θεοῦ ἐκλήθη.","tokens":[{"text":"καὶ"},{"text":"ἐπληρώθη"},{"text":"ἡ"},{"text":"γραφὴ"},{"text":"ἡ"},{"text":"λέγουσα"},{"text":"Ἐπίστευσεν"},{"text":"δὲ"},{"text":"Ἀβραὰμ"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"καὶ"},{"text":"ἐλογίσθη"},{"text":"αὐτῷ"},{"text":"εἰς"},{"text":"δικαιοσύνην"},{"text":"καὶ"},{"text":"φίλος"},{"text":"θεοῦ"},{"text":"ἐκλήθη"}],"notes":[],"lang":"grc"},{"n":24,"text":"⸀ ὁρᾶτε ὅτι ἐξ ἔργων δικαιοῦται ἄνθρωπος καὶ οὐκ ἐκ πίστεως μόνον.","tokens":[{"text":"ὁρᾶτε"},{"text":"ὅτι"},{"text":"ἐξ"},{"text":"ἔργων"},{"text":"δικαιοῦται"},{"text":"ἄνθρωπος"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἐκ"},{"text":"πίστεως"},{"text":"μόνον"}],"notes":[],"lang":"grc"},{"n":25,"text":"ὁμοίως δὲ καὶ Ῥαὰβ ἡ πόρνη οὐκ ἐξ ἔργων ἐδικαιώθη, ὑποδεξαμένη τοὺς ἀγγέλους καὶ ἑτέρᾳ ὁδῷ ἐκβαλοῦσα;","tokens":[{"text":"ὁμοίως"},{"text":"δὲ"},{"text":"καὶ"},{"text":"Ῥαὰβ"},{"text":"ἡ"},{"text":"πόρνη"},{"text":"οὐκ"},{"text":"ἐξ"},{"text":"ἔργων"},{"text":"ἐδικαιώθη"},{"text":"ὑποδεξαμένη"},{"text":"τοὺς"},{"text":"ἀγγέλους"},{"text":"καὶ"},{"text":"ἑτέρᾳ"},{"text":"ὁδῷ"},{"text":"ἐκβαλοῦσα"}],"notes":[],"lang":"grc"},{"n":26,"text":"ὥσπερ ⸀ γὰρ τὸ σῶμα χωρὶς πνεύματος νεκρόν ἐστιν, οὕτως καὶ ἡ πίστις ⸀ χωρὶς ἔργων νεκρά ἐστιν.","tokens":[{"text":"ὥσπερ"},{"text":"γὰρ"},{"text":"τὸ"},{"text":"σῶμα"},{"text":"χωρὶς"},{"text":"πνεύματος"},{"text":"νεκρόν"},{"text":"ἐστιν"},{"text":"οὕτως"},{"text":"καὶ"},{"text":"ἡ"},{"text":"πίστις"},{"text":"χωρὶς"},{"text":"ἔργων"},{"text":"νεκρά"},{"text":"ἐστιν"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Μὴ πολλοὶ διδάσκαλοι γίνεσθε, ἀδελφοί μου, εἰδότες ὅτι μεῖζον κρίμα λημψόμεθα·","tokens":[{"text":"Μὴ"},{"text":"πολλοὶ"},{"text":"διδάσκαλοι"},{"text":"γίνεσθε"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"εἰδότες"},{"text":"ὅτι"},{"text":"μεῖζον"},{"text":"κρίμα"},{"text":"λημψόμεθα"}],"notes":[],"lang":"grc"},{"n":2,"text":"πολλὰ γὰρ πταίομεν ἅπαντες. εἴ τις ἐν λόγῳ οὐ πταίει, οὗτος τέλειος ἀνήρ, δυνατὸς χαλιναγωγῆσαι καὶ ὅλον τὸ σῶμα.","tokens":[{"text":"πολλὰ"},{"text":"γὰρ"},{"text":"πταίομεν"},{"text":"ἅπαντες"},{"text":"εἴ"},{"text":"τις"},{"text":"ἐν"},{"text":"λόγῳ"},{"text":"οὐ"},{"text":"πταίει"},{"text":"οὗτος"},{"text":"τέλειος"},{"text":"ἀνήρ"},{"text":"δυνατὸς"},{"text":"χαλιναγωγῆσαι"},{"text":"καὶ"},{"text":"ὅλον"},{"text":"τὸ"},{"text":"σῶμα"}],"notes":[],"lang":"grc"},{"n":3,"text":"⸂ εἰ δὲ⸃ τῶν ἵππων τοὺς χαλινοὺς εἰς τὰ στόματα βάλλομεν ⸀ εἰς τὸ πείθεσθαι αὐτοὺς ἡμῖν, καὶ ὅλον τὸ σῶμα αὐτῶν μετάγομεν.","tokens":[{"text":"εἰ"},{"text":"δὲ"},{"text":"τῶν"},{"text":"ἵππων"},{"text":"τοὺς"},{"text":"χαλινοὺς"},{"text":"εἰς"},{"text":"τὰ"},{"text":"στόματα"},{"text":"βάλλομεν"},{"text":"εἰς"},{"text":"τὸ"},{"text":"πείθεσθαι"},{"text":"αὐτοὺς"},{"text":"ἡμῖν"},{"text":"καὶ"},{"text":"ὅλον"},{"text":"τὸ"},{"text":"σῶμα"},{"text":"αὐτῶν"},{"text":"μετάγομεν"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἰδοὺ καὶ τὰ πλοῖα, τηλικαῦτα ὄντα καὶ ὑπὸ ⸂ ἀνέμων σκληρῶν⸃ ἐλαυνόμενα, μετάγεται ὑπὸ ἐλαχίστου πηδαλίου ὅπου ⸂ ἡ ὁρμὴ τοῦ εὐθύνοντος βούλεται⸃·","tokens":[{"text":"ἰδοὺ"},{"text":"καὶ"},{"text":"τὰ"},{"text":"πλοῖα"},{"text":"τηλικαῦτα"},{"text":"ὄντα"},{"text":"καὶ"},{"text":"ὑπὸ"},{"text":"ἀνέμων"},{"text":"σκληρῶν"},{"text":"ἐλαυνόμενα"},{"text":"μετάγεται"},{"text":"ὑπὸ"},{"text":"ἐλαχίστου"},{"text":"πηδαλίου"},{"text":"ὅπου"},{"text":"ἡ"},{"text":"ὁρμὴ"},{"text":"τοῦ"},{"text":"εὐθύνοντος"},{"text":"βούλεται"}],"notes":[],"lang":"grc"},{"n":5,"text":"οὕτως καὶ ἡ γλῶσσα μικρὸν μέλος ἐστὶν καὶ ⸂ μεγάλα αὐχεῖ⸃. Ἰδοὺ ⸀ ἡλίκον πῦρ ἡλίκην ὕλην ἀνάπτει·","tokens":[{"text":"οὕτως"},{"text":"καὶ"},{"text":"ἡ"},{"text":"γλῶσσα"},{"text":"μικρὸν"},{"text":"μέλος"},{"text":"ἐστὶν"},{"text":"καὶ"},{"text":"μεγάλα"},{"text":"αὐχεῖ"},{"text":"Ἰδοὺ"},{"text":"ἡλίκον"},{"text":"πῦρ"},{"text":"ἡλίκην"},{"text":"ὕλην"},{"text":"ἀνάπτει"}],"notes":[],"lang":"grc"},{"n":6,"text":"καὶ ἡ γλῶσσα πῦρ, ὁ κόσμος τῆς ⸀ ἀδικίας ἡ γλῶσσα καθίσταται ἐν τοῖς μέλεσιν ἡμῶν, ἡ σπιλοῦσα ὅλον τὸ σῶμα καὶ φλογίζουσα τὸν τροχὸν τῆς γενέσεως καὶ φλογιζομένη ὑπὸ τῆς γεέννης.","tokens":[{"text":"καὶ"},{"text":"ἡ"},{"text":"γλῶσσα"},{"text":"πῦρ"},{"text":"ὁ"},{"text":"κόσμος"},{"text":"τῆς"},{"text":"ἀδικίας"},{"text":"ἡ"},{"text":"γλῶσσα"},{"text":"καθίσταται"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"μέλεσιν"},{"text":"ἡμῶν"},{"text":"ἡ"},{"text":"σπιλοῦσα"},{"text":"ὅλον"},{"text":"τὸ"},{"text":"σῶμα"},{"text":"καὶ"},{"text":"φλογίζουσα"},{"text":"τὸν"},{"text":"τροχὸν"},{"text":"τῆς"},{"text":"γενέσεως"},{"text":"καὶ"},{"text":"φλογιζομένη"},{"text":"ὑπὸ"},{"text":"τῆς"},{"text":"γεέννης"}],"notes":[],"lang":"grc"},{"n":7,"text":"πᾶσα γὰρ φύσις θηρίων τε καὶ πετεινῶν ἑρπετῶν τε καὶ ἐναλίων δαμάζεται καὶ δεδάμασται τῇ φύσει τῇ ἀνθρωπίνῃ·","tokens":[{"text":"πᾶσα"},{"text":"γὰρ"},{"text":"φύσις"},{"text":"θηρίων"},{"text":"τε"},{"text":"καὶ"},{"text":"πετεινῶν"},{"text":"ἑρπετῶν"},{"text":"τε"},{"text":"καὶ"},{"text":"ἐναλίων"},{"text":"δαμάζεται"},{"text":"καὶ"},{"text":"δεδάμασται"},{"text":"τῇ"},{"text":"φύσει"},{"text":"τῇ"},{"text":"ἀνθρωπίνῃ"}],"notes":[],"lang":"grc"},{"n":8,"text":"τὴν δὲ γλῶσσαν οὐδεὶς ⸂ δαμάσαι δύναται ἀνθρώπων⸃·  ⸀ ἀκατάστατον κακόν, μεστὴ ἰοῦ θανατηφόρου.","tokens":[{"text":"τὴν"},{"text":"δὲ"},{"text":"γλῶσσαν"},{"text":"οὐδεὶς"},{"text":"δαμάσαι"},{"text":"δύναται"},{"text":"ἀνθρώπων"},{"text":"ἀκατάστατον"},{"text":"κακόν"},{"text":"μεστὴ"},{"text":"ἰοῦ"},{"text":"θανατηφόρου"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἐν αὐτῇ εὐλογοῦμεν τὸν ⸀ κύριον καὶ πατέρα, καὶ ἐν αὐτῇ καταρώμεθα τοὺς ἀνθρώπους τοὺς καθʼ ὁμοίωσιν θεοῦ γεγονότας·","tokens":[{"text":"ἐν"},{"text":"αὐτῇ"},{"text":"εὐλογοῦμεν"},{"text":"τὸν"},{"text":"κύριον"},{"text":"καὶ"},{"text":"πατέρα"},{"text":"καὶ"},{"text":"ἐν"},{"text":"αὐτῇ"},{"text":"καταρώμεθα"},{"text":"τοὺς"},{"text":"ἀνθρώπους"},{"text":"τοὺς"},{"text":"καθʼ"},{"text":"ὁμοίωσιν"},{"text":"θεοῦ"},{"text":"γεγονότας"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἐκ τοῦ αὐτοῦ στόματος ἐξέρχεται εὐλογία καὶ κατάρα. οὐ χρή, ἀδελφοί μου, ταῦτα οὕτως γίνεσθαι.","tokens":[{"text":"ἐκ"},{"text":"τοῦ"},{"text":"αὐτοῦ"},{"text":"στόματος"},{"text":"ἐξέρχεται"},{"text":"εὐλογία"},{"text":"καὶ"},{"text":"κατάρα"},{"text":"οὐ"},{"text":"χρή"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"ταῦτα"},{"text":"οὕτως"},{"text":"γίνεσθαι"}],"notes":[],"lang":"grc"},{"n":11,"text":"μήτι ἡ πηγὴ ἐκ τῆς αὐτῆς ὀπῆς βρύει τὸ γλυκὺ καὶ τὸ πικρόν;","tokens":[{"text":"μήτι"},{"text":"ἡ"},{"text":"πηγὴ"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"αὐτῆς"},{"text":"ὀπῆς"},{"text":"βρύει"},{"text":"τὸ"},{"text":"γλυκὺ"},{"text":"καὶ"},{"text":"τὸ"},{"text":"πικρόν"}],"notes":[],"lang":"grc"},{"n":12,"text":"μὴ δύναται, ἀδελφοί μου, συκῆ ἐλαίας ποιῆσαι ἢ ἄμπελος σῦκα;  ⸂ οὔτε ἁλυκὸν⸃ γλυκὺ ποιῆσαι ὕδωρ.","tokens":[{"text":"μὴ"},{"text":"δύναται"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"συκῆ"},{"text":"ἐλαίας"},{"text":"ποιῆσαι"},{"text":"ἢ"},{"text":"ἄμπελος"},{"text":"σῦκα"},{"text":"οὔτε"},{"text":"ἁλυκὸν"},{"text":"γλυκὺ"},{"text":"ποιῆσαι"},{"text":"ὕδωρ"}],"notes":[],"lang":"grc"},{"n":13,"text":"Τίς σοφὸς καὶ ἐπιστήμων ἐν ὑμῖν; δειξάτω ἐκ τῆς καλῆς ἀναστροφῆς τὰ ἔργα αὐτοῦ ἐν πραΰτητι σοφίας.","tokens":[{"text":"Τίς"},{"text":"σοφὸς"},{"text":"καὶ"},{"text":"ἐπιστήμων"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"δειξάτω"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"καλῆς"},{"text":"ἀναστροφῆς"},{"text":"τὰ"},{"text":"ἔργα"},{"text":"αὐτοῦ"},{"text":"ἐν"},{"text":"πραΰτητι"},{"text":"σοφίας"}],"notes":[],"lang":"grc"},{"n":14,"text":"εἰ δὲ ζῆλον πικρὸν ἔχετε καὶ ἐριθείαν ἐν τῇ καρδίᾳ ὑμῶν, μὴ κατακαυχᾶσθε καὶ ψεύδεσθε κατὰ τῆς ἀληθείας.","tokens":[{"text":"εἰ"},{"text":"δὲ"},{"text":"ζῆλον"},{"text":"πικρὸν"},{"text":"ἔχετε"},{"text":"καὶ"},{"text":"ἐριθείαν"},{"text":"ἐν"},{"text":"τῇ"},{"text":"καρδίᾳ"},{"text":"ὑμῶν"},{"text":"μὴ"},{"text":"κατακαυχᾶσθε"},{"text":"καὶ"},{"text":"ψεύδεσθε"},{"text":"κατὰ"},{"text":"τῆς"},{"text":"ἀληθείας"}],"notes":[],"lang":"grc"},{"n":15,"text":"οὐκ ἔστιν αὕτη ἡ σοφία ἄνωθεν κατερχομένη, ἀλλὰ ἐπίγειος, ψυχική, δαιμονιώδης·","tokens":[{"text":"οὐκ"},{"text":"ἔστιν"},{"text":"αὕτη"},{"text":"ἡ"},{"text":"σοφία"},{"text":"ἄνωθεν"},{"text":"κατερχομένη"},{"text":"ἀλλὰ"},{"text":"ἐπίγειος"},{"text":"ψυχική"},{"text":"δαιμονιώδης"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὅπου γὰρ ζῆλος καὶ ἐριθεία, ἐκεῖ ἀκαταστασία καὶ πᾶν φαῦλον πρᾶγμα.","tokens":[{"text":"ὅπου"},{"text":"γὰρ"},{"text":"ζῆλος"},{"text":"καὶ"},{"text":"ἐριθεία"},{"text":"ἐκεῖ"},{"text":"ἀκαταστασία"},{"text":"καὶ"},{"text":"πᾶν"},{"text":"φαῦλον"},{"text":"πρᾶγμα"}],"notes":[],"lang":"grc"},{"n":17,"text":"ἡ δὲ ἄνωθεν σοφία πρῶτον μὲν ἁγνή ἐστιν, ἔπειτα εἰρηνική, ἐπιεικής, εὐπειθής, μεστὴ ἐλέους καὶ καρπῶν ἀγαθῶν,  ⸀ ἀδιάκριτος, ἀνυπόκριτος·","tokens":[{"text":"ἡ"},{"text":"δὲ"},{"text":"ἄνωθεν"},{"text":"σοφία"},{"text":"πρῶτον"},{"text":"μὲν"},{"text":"ἁγνή"},{"text":"ἐστιν"},{"text":"ἔπειτα"},{"text":"εἰρηνική"},{"text":"ἐπιεικής"},{"text":"εὐπειθής"},{"text":"μεστὴ"},{"text":"ἐλέους"},{"text":"καὶ"},{"text":"καρπῶν"},{"text":"ἀγαθῶν"},{"text":"ἀδιάκριτος"},{"text":"ἀνυπόκριτος"}],"notes":[],"lang":"grc"},{"n":18,"text":"καρπὸς ⸀ δὲ δικαιοσύνης ἐν εἰρήνῃ σπείρεται τοῖς ποιοῦσιν εἰρήνην.","tokens":[{"text":"καρπὸς"},{"text":"δὲ"},{"text":"δικαιοσύνης"},{"text":"ἐν"},{"text":"εἰρήνῃ"},{"text":"σπείρεται"},{"text":"τοῖς"},{"text":"ποιοῦσιν"},{"text":"εἰρήνην"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"Πόθεν πόλεμοι καὶ ⸀ πόθεν μάχαι ἐν ὑμῖν; οὐκ ἐντεῦθεν, ἐκ τῶν ἡδονῶν ὑμῶν τῶν στρατευομένων ἐν τοῖς μέλεσιν ὑμῶν;","tokens":[{"text":"Πόθεν"},{"text":"πόλεμοι"},{"text":"καὶ"},{"text":"πόθεν"},{"text":"μάχαι"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"οὐκ"},{"text":"ἐντεῦθεν"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"ἡδονῶν"},{"text":"ὑμῶν"},{"text":"τῶν"},{"text":"στρατευομένων"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"μέλεσιν"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἐπιθυμεῖτε, καὶ οὐκ ἔχετε· φονεύετε καὶ ζηλοῦτε, καὶ οὐ δύνασθε ἐπιτυχεῖν· μάχεσθε καὶ πολεμεῖτε. οὐκ ἔχετε διὰ τὸ μὴ αἰτεῖσθαι ὑμᾶς·","tokens":[{"text":"ἐπιθυμεῖτε"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἔχετε"},{"text":"φονεύετε"},{"text":"καὶ"},{"text":"ζηλοῦτε"},{"text":"καὶ"},{"text":"οὐ"},{"text":"δύνασθε"},{"text":"ἐπιτυχεῖν"},{"text":"μάχεσθε"},{"text":"καὶ"},{"text":"πολεμεῖτε"},{"text":"οὐκ"},{"text":"ἔχετε"},{"text":"διὰ"},{"text":"τὸ"},{"text":"μὴ"},{"text":"αἰτεῖσθαι"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":3,"text":"αἰτεῖτε καὶ οὐ λαμβάνετε, διότι κακῶς αἰτεῖσθε, ἵνα ἐν ταῖς ἡδοναῖς ὑμῶν δαπανήσητε.","tokens":[{"text":"αἰτεῖτε"},{"text":"καὶ"},{"text":"οὐ"},{"text":"λαμβάνετε"},{"text":"διότι"},{"text":"κακῶς"},{"text":"αἰτεῖσθε"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"ἡδοναῖς"},{"text":"ὑμῶν"},{"text":"δαπανήσητε"}],"notes":[],"lang":"grc"},{"n":4,"text":"⸀ μοιχαλίδες, οὐκ οἴδατε ὅτι ἡ φιλία τοῦ κόσμου ἔχθρα τοῦ θεοῦ ἐστιν; ὃς ⸀ ἐὰν οὖν βουληθῇ φίλος εἶναι τοῦ κόσμου, ἐχθρὸς τοῦ θεοῦ καθίσταται.","tokens":[{"text":"μοιχαλίδες"},{"text":"οὐκ"},{"text":"οἴδατε"},{"text":"ὅτι"},{"text":"ἡ"},{"text":"φιλία"},{"text":"τοῦ"},{"text":"κόσμου"},{"text":"ἔχθρα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐστιν"},{"text":"ὃς"},{"text":"ἐὰν"},{"text":"οὖν"},{"text":"βουληθῇ"},{"text":"φίλος"},{"text":"εἶναι"},{"text":"τοῦ"},{"text":"κόσμου"},{"text":"ἐχθρὸς"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καθίσταται"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἢ δοκεῖτε ὅτι κενῶς ἡ γραφὴ λέγει· Πρὸς φθόνον ἐπιποθεῖ τὸ πνεῦμα ὃ ⸀ κατῴκισεν ἐν ἡμῖν;","tokens":[{"text":"ἢ"},{"text":"δοκεῖτε"},{"text":"ὅτι"},{"text":"κενῶς"},{"text":"ἡ"},{"text":"γραφὴ"},{"text":"λέγει"},{"text":"Πρὸς"},{"text":"φθόνον"},{"text":"ἐπιποθεῖ"},{"text":"τὸ"},{"text":"πνεῦμα"},{"text":"ὃ"},{"text":"κατῴκισεν"},{"text":"ἐν"},{"text":"ἡμῖν"}],"notes":[],"lang":"grc"},{"n":6,"text":"μείζονα δὲ δίδωσιν χάριν· διὸ λέγει· Ὁ θεὸς ὑπερηφάνοις ἀντιτάσσεται ταπεινοῖς δὲ δίδωσιν χάριν.","tokens":[{"text":"μείζονα"},{"text":"δὲ"},{"text":"δίδωσιν"},{"text":"χάριν"},{"text":"διὸ"},{"text":"λέγει"},{"text":"Ὁ"},{"text":"θεὸς"},{"text":"ὑπερηφάνοις"},{"text":"ἀντιτάσσεται"},{"text":"ταπεινοῖς"},{"text":"δὲ"},{"text":"δίδωσιν"},{"text":"χάριν"}],"notes":[],"lang":"grc"},{"n":7,"text":"ὑποτάγητε οὖν τῷ θεῷ· ἀντίστητε δὲ τῷ διαβόλῳ, καὶ φεύξεται ἀφʼ ὑμῶν·","tokens":[{"text":"ὑποτάγητε"},{"text":"οὖν"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"ἀντίστητε"},{"text":"δὲ"},{"text":"τῷ"},{"text":"διαβόλῳ"},{"text":"καὶ"},{"text":"φεύξεται"},{"text":"ἀφʼ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἐγγίσατε τῷ θεῷ, καὶ ⸀ ἐγγιεῖ ὑμῖν. καθαρίσατε χεῖρας, ἁμαρτωλοί, καὶ ἁγνίσατε καρδίας, δίψυχοι.","tokens":[{"text":"ἐγγίσατε"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"καὶ"},{"text":"ἐγγιεῖ"},{"text":"ὑμῖν"},{"text":"καθαρίσατε"},{"text":"χεῖρας"},{"text":"ἁμαρτωλοί"},{"text":"καὶ"},{"text":"ἁγνίσατε"},{"text":"καρδίας"},{"text":"δίψυχοι"}],"notes":[],"lang":"grc"},{"n":9,"text":"ταλαιπωρήσατε καὶ πενθήσατε καὶ κλαύσατε· ὁ γέλως ὑμῶν εἰς πένθος ⸀ μετατραπήτω καὶ ἡ χαρὰ εἰς κατήφειαν·","tokens":[{"text":"ταλαιπωρήσατε"},{"text":"καὶ"},{"text":"πενθήσατε"},{"text":"καὶ"},{"text":"κλαύσατε"},{"text":"ὁ"},{"text":"γέλως"},{"text":"ὑμῶν"},{"text":"εἰς"},{"text":"πένθος"},{"text":"μετατραπήτω"},{"text":"καὶ"},{"text":"ἡ"},{"text":"χαρὰ"},{"text":"εἰς"},{"text":"κατήφειαν"}],"notes":[],"lang":"grc"},{"n":10,"text":"ταπεινώθητε ἐνώπιον ⸀ κυρίου, καὶ ὑψώσει ὑμᾶς.","tokens":[{"text":"ταπεινώθητε"},{"text":"ἐνώπιον"},{"text":"κυρίου"},{"text":"καὶ"},{"text":"ὑψώσει"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":11,"text":"Μὴ καταλαλεῖτε ἀλλήλων, ἀδελφοί· ὁ καταλαλῶν ἀδελφοῦ ⸀ ἢ κρίνων τὸν ἀδελφὸν αὐτοῦ καταλαλεῖ νόμου καὶ κρίνει νόμον· εἰ δὲ νόμον κρίνεις, οὐκ εἶ ποιητὴς νόμου ἀλλὰ κριτής.","tokens":[{"text":"Μὴ"},{"text":"καταλαλεῖτε"},{"text":"ἀλλήλων"},{"text":"ἀδελφοί"},{"text":"ὁ"},{"text":"καταλαλῶν"},{"text":"ἀδελφοῦ"},{"text":"ἢ"},{"text":"κρίνων"},{"text":"τὸν"},{"text":"ἀδελφὸν"},{"text":"αὐτοῦ"},{"text":"καταλαλεῖ"},{"text":"νόμου"},{"text":"καὶ"},{"text":"κρίνει"},{"text":"νόμον"},{"text":"εἰ"},{"text":"δὲ"},{"text":"νόμον"},{"text":"κρίνεις"},{"text":"οὐκ"},{"text":"εἶ"},{"text":"ποιητὴς"},{"text":"νόμου"},{"text":"ἀλλὰ"},{"text":"κριτής"}],"notes":[],"lang":"grc"},{"n":12,"text":"εἷς ⸀ ἐστιν νομοθέτης ⸂ καὶ κριτής⸃, ὁ δυνάμενος σῶσαι καὶ ἀπολέσαι· σὺ δὲ τίς εἶ,  ⸂ ὁ κρίνων⸃ τὸν ⸀ πλησίον;","tokens":[{"text":"εἷς"},{"text":"ἐστιν"},{"text":"νομοθέτης"},{"text":"καὶ"},{"text":"κριτής"},{"text":"ὁ"},{"text":"δυνάμενος"},{"text":"σῶσαι"},{"text":"καὶ"},{"text":"ἀπολέσαι"},{"text":"σὺ"},{"text":"δὲ"},{"text":"τίς"},{"text":"εἶ"},{"text":"ὁ"},{"text":"κρίνων"},{"text":"τὸν"},{"text":"πλησίον"}],"notes":[],"lang":"grc"},{"n":13,"text":"Ἄγε νῦν οἱ λέγοντες· Σήμερον ⸀ ἢ αὔριον ⸀ πορευσόμεθα εἰς τήνδε τὴν πόλιν καὶ ⸀ ποιήσομεν ἐκεῖ ⸀ ἐνιαυτὸν καὶ ⸀ ἐμπορευσόμεθα καὶ ⸀ κερδήσομεν·","tokens":[{"text":"Ἄγε"},{"text":"νῦν"},{"text":"οἱ"},{"text":"λέγοντες"},{"text":"Σήμερον"},{"text":"ἢ"},{"text":"αὔριον"},{"text":"πορευσόμεθα"},{"text":"εἰς"},{"text":"τήνδε"},{"text":"τὴν"},{"text":"πόλιν"},{"text":"καὶ"},{"text":"ποιήσομεν"},{"text":"ἐκεῖ"},{"text":"ἐνιαυτὸν"},{"text":"καὶ"},{"text":"ἐμπορευσόμεθα"},{"text":"καὶ"},{"text":"κερδήσομεν"}],"notes":[],"lang":"grc"},{"n":14,"text":"οἵτινες οὐκ ἐπίστασθε ⸀ τὸ τῆς αὔριον ⸀ ποία ἡ ζωὴ ὑμῶν· ἀτμὶς γάρ ⸀ ἐστε ⸀ ἡ πρὸς ὀλίγον φαινομένη,  ⸀ ἔπειτα καὶ ἀφανιζομένη·","tokens":[{"text":"οἵτινες"},{"text":"οὐκ"},{"text":"ἐπίστασθε"},{"text":"τὸ"},{"text":"τῆς"},{"text":"αὔριον"},{"text":"ποία"},{"text":"ἡ"},{"text":"ζωὴ"},{"text":"ὑμῶν"},{"text":"ἀτμὶς"},{"text":"γάρ"},{"text":"ἐστε"},{"text":"ἡ"},{"text":"πρὸς"},{"text":"ὀλίγον"},{"text":"φαινομένη"},{"text":"ἔπειτα"},{"text":"καὶ"},{"text":"ἀφανιζομένη"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἀντὶ τοῦ λέγειν ὑμᾶς· Ἐὰν ὁ κύριος ⸀ θελήσῃ, καὶ ⸀ ζήσομεν καὶ ⸀ ποιήσομεν τοῦτο ἢ ἐκεῖνο.","tokens":[{"text":"ἀντὶ"},{"text":"τοῦ"},{"text":"λέγειν"},{"text":"ὑμᾶς"},{"text":"Ἐὰν"},{"text":"ὁ"},{"text":"κύριος"},{"text":"θελήσῃ"},{"text":"καὶ"},{"text":"ζήσομεν"},{"text":"καὶ"},{"text":"ποιήσομεν"},{"text":"τοῦτο"},{"text":"ἢ"},{"text":"ἐκεῖνο"}],"notes":[],"lang":"grc"},{"n":16,"text":"νῦν δὲ καυχᾶσθε ἐν ταῖς ἀλαζονείαις ὑμῶν· πᾶσα καύχησις τοιαύτη πονηρά ἐστιν.","tokens":[{"text":"νῦν"},{"text":"δὲ"},{"text":"καυχᾶσθε"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"ἀλαζονείαις"},{"text":"ὑμῶν"},{"text":"πᾶσα"},{"text":"καύχησις"},{"text":"τοιαύτη"},{"text":"πονηρά"},{"text":"ἐστιν"}],"notes":[],"lang":"grc"},{"n":17,"text":"εἰδότι οὖν καλὸν ποιεῖν καὶ μὴ ποιοῦντι, ἁμαρτία αὐτῷ ἐστιν.","tokens":[{"text":"εἰδότι"},{"text":"οὖν"},{"text":"καλὸν"},{"text":"ποιεῖν"},{"text":"καὶ"},{"text":"μὴ"},{"text":"ποιοῦντι"},{"text":"ἁμαρτία"},{"text":"αὐτῷ"},{"text":"ἐστιν"}],"notes":[],"lang":"grc"}],"5":[{"n":1,"text":"Ἄγε νῦν οἱ πλούσιοι, κλαύσατε ὀλολύζοντες ἐπὶ ταῖς ταλαιπωρίαις ὑμῶν ταῖς ἐπερχομέναις.","tokens":[{"text":"Ἄγε"},{"text":"νῦν"},{"text":"οἱ"},{"text":"πλούσιοι"},{"text":"κλαύσατε"},{"text":"ὀλολύζοντες"},{"text":"ἐπὶ"},{"text":"ταῖς"},{"text":"ταλαιπωρίαις"},{"text":"ὑμῶν"},{"text":"ταῖς"},{"text":"ἐπερχομέναις"}],"notes":[],"lang":"grc"},{"n":2,"text":"ὁ πλοῦτος ὑμῶν σέσηπεν, καὶ τὰ ἱμάτια ὑμῶν σητόβρωτα γέγονεν,","tokens":[{"text":"ὁ"},{"text":"πλοῦτος"},{"text":"ὑμῶν"},{"text":"σέσηπεν"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἱμάτια"},{"text":"ὑμῶν"},{"text":"σητόβρωτα"},{"text":"γέγονεν"}],"notes":[],"lang":"grc"},{"n":3,"text":"ὁ χρυσὸς ὑμῶν καὶ ὁ ἄργυρος κατίωται, καὶ ὁ ἰὸς αὐτῶν εἰς μαρτύριον ὑμῖν ἔσται καὶ φάγεται τὰς σάρκας ὑμῶν· ὡς πῦρ ἐθησαυρίσατε ἐν ἐσχάταις ἡμέραις.","tokens":[{"text":"ὁ"},{"text":"χρυσὸς"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"ὁ"},{"text":"ἄργυρος"},{"text":"κατίωται"},{"text":"καὶ"},{"text":"ὁ"},{"text":"ἰὸς"},{"text":"αὐτῶν"},{"text":"εἰς"},{"text":"μαρτύριον"},{"text":"ὑμῖν"},{"text":"ἔσται"},{"text":"καὶ"},{"text":"φάγεται"},{"text":"τὰς"},{"text":"σάρκας"},{"text":"ὑμῶν"},{"text":"ὡς"},{"text":"πῦρ"},{"text":"ἐθησαυρίσατε"},{"text":"ἐν"},{"text":"ἐσχάταις"},{"text":"ἡμέραις"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἰδοὺ ὁ μισθὸς τῶν ἐργατῶν τῶν ἀμησάντων τὰς χώρας ὑμῶν ὁ ⸀ ἀφυστερημένος ἀφʼ ὑμῶν κράζει, καὶ αἱ βοαὶ τῶν θερισάντων εἰς τὰ ὦτα Κυρίου Σαβαὼθ ⸀ εἰσεληλύθασιν·","tokens":[{"text":"ἰδοὺ"},{"text":"ὁ"},{"text":"μισθὸς"},{"text":"τῶν"},{"text":"ἐργατῶν"},{"text":"τῶν"},{"text":"ἀμησάντων"},{"text":"τὰς"},{"text":"χώρας"},{"text":"ὑμῶν"},{"text":"ὁ"},{"text":"ἀφυστερημένος"},{"text":"ἀφʼ"},{"text":"ὑμῶν"},{"text":"κράζει"},{"text":"καὶ"},{"text":"αἱ"},{"text":"βοαὶ"},{"text":"τῶν"},{"text":"θερισάντων"},{"text":"εἰς"},{"text":"τὰ"},{"text":"ὦτα"},{"text":"Κυρίου"},{"text":"Σαβαὼθ"},{"text":"εἰσεληλύθασιν"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἐτρυφήσατε ἐπὶ τῆς γῆς καὶ ἐσπαταλήσατε, ἐθρέψατε τὰς καρδίας ⸀ ὑμῶν ἐν ἡμέρᾳ σφαγῆς.","tokens":[{"text":"ἐτρυφήσατε"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"},{"text":"καὶ"},{"text":"ἐσπαταλήσατε"},{"text":"ἐθρέψατε"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"ἡμέρᾳ"},{"text":"σφαγῆς"}],"notes":[],"lang":"grc"},{"n":6,"text":"κατεδικάσατε, ἐφονεύσατε τὸν δίκαιον. οὐκ ἀντιτάσσεται ὑμῖν;","tokens":[{"text":"κατεδικάσατε"},{"text":"ἐφονεύσατε"},{"text":"τὸν"},{"text":"δίκαιον"},{"text":"οὐκ"},{"text":"ἀντιτάσσεται"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":7,"text":"Μακροθυμήσατε οὖν, ἀδελφοί, ἕως τῆς παρουσίας τοῦ κυρίου. ἰδοὺ ὁ γεωργὸς ἐκδέχεται τὸν τίμιον καρπὸν τῆς γῆς, μακροθυμῶν ἐπʼ ⸀ αὐτῷ ἕως ⸀ λάβῃ πρόϊμον καὶ ὄψιμον.","tokens":[{"text":"Μακροθυμήσατε"},{"text":"οὖν"},{"text":"ἀδελφοί"},{"text":"ἕως"},{"text":"τῆς"},{"text":"παρουσίας"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἰδοὺ"},{"text":"ὁ"},{"text":"γεωργὸς"},{"text":"ἐκδέχεται"},{"text":"τὸν"},{"text":"τίμιον"},{"text":"καρπὸν"},{"text":"τῆς"},{"text":"γῆς"},{"text":"μακροθυμῶν"},{"text":"ἐπʼ"},{"text":"αὐτῷ"},{"text":"ἕως"},{"text":"λάβῃ"},{"text":"πρόϊμον"},{"text":"καὶ"},{"text":"ὄψιμον"}],"notes":[],"lang":"grc"},{"n":8,"text":"μακροθυμήσατε καὶ ὑμεῖς, στηρίξατε τὰς καρδίας ὑμῶν, ὅτι ἡ παρουσία τοῦ κυρίου ἤγγικεν.","tokens":[{"text":"μακροθυμήσατε"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"στηρίξατε"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"ὑμῶν"},{"text":"ὅτι"},{"text":"ἡ"},{"text":"παρουσία"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἤγγικεν"}],"notes":[],"lang":"grc"},{"n":9,"text":"μὴ στενάζετε,  ⸂ ἀδελφοί, κατʼ ἀλλήλων⸃, ἵνα μὴ κριθῆτε· ἰδοὺ ὁ κριτὴς πρὸ τῶν θυρῶν ἕστηκεν.","tokens":[{"text":"μὴ"},{"text":"στενάζετε"},{"text":"ἀδελφοί"},{"text":"κατʼ"},{"text":"ἀλλήλων"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"κριθῆτε"},{"text":"ἰδοὺ"},{"text":"ὁ"},{"text":"κριτὴς"},{"text":"πρὸ"},{"text":"τῶν"},{"text":"θυρῶν"},{"text":"ἕστηκεν"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὑπόδειγμα λάβετε,  ⸀ ἀδελφοί, τῆς κακοπαθίας καὶ τῆς μακροθυμίας τοὺς προφήτας, οἳ ἐλάλησαν ⸀ ἐν τῷ ὀνόματι κυρίου.","tokens":[{"text":"ὑπόδειγμα"},{"text":"λάβετε"},{"text":"ἀδελφοί"},{"text":"τῆς"},{"text":"κακοπαθίας"},{"text":"καὶ"},{"text":"τῆς"},{"text":"μακροθυμίας"},{"text":"τοὺς"},{"text":"προφήτας"},{"text":"οἳ"},{"text":"ἐλάλησαν"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ὀνόματι"},{"text":"κυρίου"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἰδοὺ μακαρίζομεν τοὺς ⸀ ὑπομείναντας· τὴν ὑπομονὴν Ἰὼβ ἠκούσατε, καὶ τὸ τέλος κυρίου ⸀ εἴδετε, ὅτι πολύσπλαγχνός ἐστιν ⸂ ὁ κύριος⸃ καὶ οἰκτίρμων.","tokens":[{"text":"ἰδοὺ"},{"text":"μακαρίζομεν"},{"text":"τοὺς"},{"text":"ὑπομείναντας"},{"text":"τὴν"},{"text":"ὑπομονὴν"},{"text":"Ἰὼβ"},{"text":"ἠκούσατε"},{"text":"καὶ"},{"text":"τὸ"},{"text":"τέλος"},{"text":"κυρίου"},{"text":"εἴδετε"},{"text":"ὅτι"},{"text":"πολύσπλαγχνός"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"κύριος"},{"text":"καὶ"},{"text":"οἰκτίρμων"}],"notes":[],"lang":"grc"},{"n":12,"text":"Πρὸ πάντων δέ, ἀδελφοί μου, μὴ ὀμνύετε, μήτε τὸν οὐρανὸν μήτε τὴν γῆν μήτε ἄλλον τινὰ ὅρκον· ἤτω δὲ ὑμῶν τὸ Ναὶ ναὶ καὶ τὸ Οὒ οὔ, ἵνα μὴ ⸂ ὑπὸ κρίσιν⸃ πέσητε.","tokens":[{"text":"Πρὸ"},{"text":"πάντων"},{"text":"δέ"},{"text":"ἀδελφοί"},{"text":"μου"},{"text":"μὴ"},{"text":"ὀμνύετε"},{"text":"μήτε"},{"text":"τὸν"},{"text":"οὐρανὸν"},{"text":"μήτε"},{"text":"τὴν"},{"text":"γῆν"},{"text":"μήτε"},{"text":"ἄλλον"},{"text":"τινὰ"},{"text":"ὅρκον"},{"text":"ἤτω"},{"text":"δὲ"},{"text":"ὑμῶν"},{"text":"τὸ"},{"text":"Ναὶ"},{"text":"ναὶ"},{"text":"καὶ"},{"text":"τὸ"},{"text":"Οὒ"},{"text":"οὔ"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ὑπὸ"},{"text":"κρίσιν"},{"text":"πέσητε"}],"notes":[],"lang":"grc"},{"n":13,"text":"Κακοπαθεῖ τις ἐν ὑμῖν; προσευχέσθω· εὐθυμεῖ τις; ψαλλέτω.","tokens":[{"text":"Κακοπαθεῖ"},{"text":"τις"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"προσευχέσθω"},{"text":"εὐθυμεῖ"},{"text":"τις"},{"text":"ψαλλέτω"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἀσθενεῖ τις ἐν ὑμῖν; προσκαλεσάσθω τοὺς πρεσβυτέρους τῆς ἐκκλησίας, καὶ προσευξάσθωσαν ἐπʼ αὐτὸν ἀλείψαντες ⸀ αὐτὸν ἐλαίῳ ἐν τῷ ὀνόματι τοῦ κυρίου·","tokens":[{"text":"ἀσθενεῖ"},{"text":"τις"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"προσκαλεσάσθω"},{"text":"τοὺς"},{"text":"πρεσβυτέρους"},{"text":"τῆς"},{"text":"ἐκκλησίας"},{"text":"καὶ"},{"text":"προσευξάσθωσαν"},{"text":"ἐπʼ"},{"text":"αὐτὸν"},{"text":"ἀλείψαντες"},{"text":"αὐτὸν"},{"text":"ἐλαίῳ"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ὀνόματι"},{"text":"τοῦ"},{"text":"κυρίου"}],"notes":[],"lang":"grc"},{"n":15,"text":"καὶ ἡ εὐχὴ τῆς πίστεως σώσει τὸν κάμνοντα, καὶ ἐγερεῖ αὐτὸν ὁ κύριος· κἂν ἁμαρτίας ᾖ πεποιηκώς, ἀφεθήσεται αὐτῷ.","tokens":[{"text":"καὶ"},{"text":"ἡ"},{"text":"εὐχὴ"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"σώσει"},{"text":"τὸν"},{"text":"κάμνοντα"},{"text":"καὶ"},{"text":"ἐγερεῖ"},{"text":"αὐτὸν"},{"text":"ὁ"},{"text":"κύριος"},{"text":"κἂν"},{"text":"ἁμαρτίας"},{"text":"ᾖ"},{"text":"πεποιηκώς"},{"text":"ἀφεθήσεται"},{"text":"αὐτῷ"}],"notes":[],"lang":"grc"},{"n":16,"text":"ἐξομολογεῖσθε ⸀ οὖν ἀλλήλοις ⸂ τὰς ἁμαρτίας⸃ καὶ ⸀ εὔχεσθε ὑπὲρ ἀλλήλων, ὅπως ἰαθῆτε. πολὺ ἰσχύει δέησις δικαίου ἐνεργουμένη.","tokens":[{"text":"ἐξομολογεῖσθε"},{"text":"οὖν"},{"text":"ἀλλήλοις"},{"text":"τὰς"},{"text":"ἁμαρτίας"},{"text":"καὶ"},{"text":"εὔχεσθε"},{"text":"ὑπὲρ"},{"text":"ἀλλήλων"},{"text":"ὅπως"},{"text":"ἰαθῆτε"},{"text":"πολὺ"},{"text":"ἰσχύει"},{"text":"δέησις"},{"text":"δικαίου"},{"text":"ἐνεργουμένη"}],"notes":[],"lang":"grc"},{"n":17,"text":"Ἠλίας ἄνθρωπος ἦν ὁμοιοπαθὴς ἡμῖν, καὶ προσευχῇ προσηύξατο τοῦ μὴ βρέξαι, καὶ οὐκ ἔβρεξεν ἐπὶ τῆς γῆς ἐνιαυτοὺς τρεῖς καὶ μῆνας ἕξ·","tokens":[{"text":"Ἠλίας"},{"text":"ἄνθρωπος"},{"text":"ἦν"},{"text":"ὁμοιοπαθὴς"},{"text":"ἡμῖν"},{"text":"καὶ"},{"text":"προσευχῇ"},{"text":"προσηύξατο"},{"text":"τοῦ"},{"text":"μὴ"},{"text":"βρέξαι"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἔβρεξεν"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"},{"text":"ἐνιαυτοὺς"},{"text":"τρεῖς"},{"text":"καὶ"},{"text":"μῆνας"},{"text":"ἕξ"}],"notes":[],"lang":"grc"},{"n":18,"text":"καὶ πάλιν προσηύξατο, καὶ ὁ οὐρανὸς ⸂ ὑετὸν ἔδωκεν⸃ καὶ ἡ γῆ ἐβλάστησεν τὸν καρπὸν αὐτῆς.","tokens":[{"text":"καὶ"},{"text":"πάλιν"},{"text":"προσηύξατο"},{"text":"καὶ"},{"text":"ὁ"},{"text":"οὐρανὸς"},{"text":"ὑετὸν"},{"text":"ἔδωκεν"},{"text":"καὶ"},{"text":"ἡ"},{"text":"γῆ"},{"text":"ἐβλάστησεν"},{"text":"τὸν"},{"text":"καρπὸν"},{"text":"αὐτῆς"}],"notes":[],"lang":"grc"},{"n":19,"text":"Ἀδελφοί ⸀ μου, ἐάν τις ἐν ὑμῖν πλανηθῇ ἀπὸ τῆς ἀληθείας καὶ ἐπιστρέψῃ τις αὐτόν,","tokens":[{"text":"Ἀδελφοί"},{"text":"μου"},{"text":"ἐάν"},{"text":"τις"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"πλανηθῇ"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"καὶ"},{"text":"ἐπιστρέψῃ"},{"text":"τις"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":20,"text":"⸀ γινωσκέτω ὅτι ὁ ἐπιστρέψας ἁμαρτωλὸν ἐκ πλάνης ὁδοῦ αὐτοῦ σώσει ψυχὴν ⸀ αὐτοῦ ἐκ θανάτου καὶ καλύψει πλῆθος ἁμαρτιῶν.","tokens":[{"text":"γινωσκέτω"},{"text":"ὅτι"},{"text":"ὁ"},{"text":"ἐπιστρέψας"},{"text":"ἁμαρτωλὸν"},{"text":"ἐκ"},{"text":"πλάνης"},{"text":"ὁδοῦ"},{"text":"αὐτοῦ"},{"text":"σώσει"},{"text":"ψυχὴν"},{"text":"αὐτοῦ"},{"text":"ἐκ"},{"text":"θανάτου"},{"text":"καὶ"},{"text":"καλύψει"},{"text":"πλῆθος"},{"text":"ἁμαρτιῶν"}],"notes":[],"lang":"grc"}]}}