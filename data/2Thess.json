{"book":{"id":"2Thess","name":"2 Tessalonicenses","testament":"NT","source":"SBLGNT","chapters":3,"verses":47},"chapters":{"1":[{"n":1,"text":"Παῦλος καὶ Σιλουανὸς καὶ Τιμόθεος τῇ ἐκκλησίᾳ Θεσσαλονικέων ἐν θεῷ πατρὶ ἡμῶν καὶ κυρίῳ Ἰησοῦ Χριστῷ·","tokens":[{"text":"Παῦλος"},{"text":"καὶ"},{"text":"Σιλουανὸς"},{"text":"καὶ"},{"text":"Τιμόθεος"},{"text":"τῇ"},{"text":"ἐκκλησίᾳ"},{"text":"Θεσσαλονικέων"},{"text":"ἐν"},{"text":"θεῷ"},{"text":"πατρὶ"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"κυρίῳ"},{"text":"Ἰησοῦ"},{"text":"Χριστῷ"}],"notes":[],"lang":"grc"},{"n":2,"text":"χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ ⸀ πατρὸς καὶ κυρίου Ἰησοῦ Χριστοῦ.","tokens":[{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"καὶ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":3,"text":"Εὐχαριστεῖν ὀφείλομεν τῷ θεῷ πάντοτε περὶ ὑμῶν, ἀδελφοί, καθὼς ἄξιόν ἐστιν, ὅτι ὑπεραυξάνει ἡ πίστις ὑμῶν καὶ πλεονάζει ἡ ἀγάπη ἑνὸς ἑκάστου πάντων ὑμῶν εἰς ἀλλήλους,","tokens":[{"text":"Εὐχαριστεῖν"},{"text":"ὀφείλομεν"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"πάντοτε"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"ἀδελφοί"},{"text":"καθὼς"},{"text":"ἄξιόν"},{"text":"ἐστιν"},{"text":"ὅτι"},{"text":"ὑπεραυξάνει"},{"text":"ἡ"},{"text":"πίστις"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"πλεονάζει"},{"text":"ἡ"},{"text":"ἀγάπη"},{"text":"ἑνὸς"},{"text":"ἑκάστου"},{"text":"πάντων"},{"text":"ὑμῶν"},{"text":"εἰς"},{"text":"ἀλλήλους"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὥστε ⸂ αὐτοὺς ἡμᾶς⸃ ἐν ὑμῖν ⸀ ἐγκαυχᾶσθαι ἐν ταῖς ἐκκλησίαις τοῦ θεοῦ ὑπὲρ τῆς ὑπομονῆς ὑμῶν καὶ πίστεως ἐν πᾶσιν τοῖς διωγμοῖς ὑμῶν καὶ ταῖς θλίψεσιν αἷς ἀνέχεσθε,","tokens":[{"text":"ὥστε"},{"text":"αὐτοὺς"},{"text":"ἡμᾶς"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἐγκαυχᾶσθαι"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"ἐκκλησίαις"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ὑπὲρ"},{"text":"τῆς"},{"text":"ὑπομονῆς"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"πίστεως"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"τοῖς"},{"text":"διωγμοῖς"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"ταῖς"},{"text":"θλίψεσιν"},{"text":"αἷς"},{"text":"ἀνέχεσθε"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἔνδειγμα τῆς δικαίας κρίσεως τοῦ θεοῦ, εἰς τὸ καταξιωθῆναι ὑμᾶς τῆς βασιλείας τοῦ θεοῦ, ὑπὲρ ἧς καὶ πάσχετε,","tokens":[{"text":"ἔνδειγμα"},{"text":"τῆς"},{"text":"δικαίας"},{"text":"κρίσεως"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"εἰς"},{"text":"τὸ"},{"text":"καταξιωθῆναι"},{"text":"ὑμᾶς"},{"text":"τῆς"},{"text":"βασιλείας"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ὑπὲρ"},{"text":"ἧς"},{"text":"καὶ"},{"text":"πάσχετε"}],"notes":[],"lang":"grc"},{"n":6,"text":"εἴπερ δίκαιον παρὰ θεῷ ἀνταποδοῦναι τοῖς θλίβουσιν ὑμᾶς θλῖψιν","tokens":[{"text":"εἴπερ"},{"text":"δίκαιον"},{"text":"παρὰ"},{"text":"θεῷ"},{"text":"ἀνταποδοῦναι"},{"text":"τοῖς"},{"text":"θλίβουσιν"},{"text":"ὑμᾶς"},{"text":"θλῖψιν"}],"notes":[],"lang":"grc"},{"n":7,"text":"καὶ ὑμῖν τοῖς θλιβομένοις ἄνεσιν μεθʼ ἡμῶν ἐν τῇ ἀποκαλύψει τοῦ κυρίου Ἰησοῦ ἀπʼ οὐρανοῦ μετʼ ἀγγέλων δυνάμεως αὐτοῦ","tokens":[{"text":"καὶ"},{"text":"ὑμῖν"},{"text":"τοῖς"},{"text":"θλιβομένοις"},{"text":"ἄνεσιν"},{"text":"μεθʼ"},{"text":"ἡμῶν"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀποκαλύψει"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"ἀπʼ"},{"text":"οὐρανοῦ"},{"text":"μετʼ"},{"text":"ἀγγέλων"},{"text":"δυνάμεως"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἐν ⸂ φλογὶ πυρός⸃, διδόντος ἐκδίκησιν τοῖς μὴ εἰδόσι θεὸν καὶ τοῖς μὴ ὑπακούουσιν τῷ εὐαγγελίῳ τοῦ κυρίου ἡμῶν Ἰησοῦ,","tokens":[{"text":"ἐν"},{"text":"φλογὶ"},{"text":"πυρός"},{"text":"διδόντος"},{"text":"ἐκδίκησιν"},{"text":"τοῖς"},{"text":"μὴ"},{"text":"εἰδόσι"},{"text":"θεὸν"},{"text":"καὶ"},{"text":"τοῖς"},{"text":"μὴ"},{"text":"ὑπακούουσιν"},{"text":"τῷ"},{"text":"εὐαγγελίῳ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"οἵτινες δίκην τίσουσιν ὄλεθρον αἰώνιον ἀπὸ προσώπου τοῦ κυρίου καὶ ἀπὸ τῆς δόξης τῆς ἰσχύος αὐτοῦ,","tokens":[{"text":"οἵτινες"},{"text":"δίκην"},{"text":"τίσουσιν"},{"text":"ὄλεθρον"},{"text":"αἰώνιον"},{"text":"ἀπὸ"},{"text":"προσώπου"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"καὶ"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"δόξης"},{"text":"τῆς"},{"text":"ἰσχύος"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":10,"text":"ὅταν ἔλθῃ ἐνδοξασθῆναι ἐν τοῖς ἁγίοις αὐτοῦ καὶ θαυμασθῆναι ἐν πᾶσιν τοῖς πιστεύσασιν, ὅτι ἐπιστεύθη τὸ μαρτύριον ἡμῶν ἐφʼ ὑμᾶς, ἐν τῇ ἡμέρᾳ ἐκείνῃ.","tokens":[{"text":"ὅταν"},{"text":"ἔλθῃ"},{"text":"ἐνδοξασθῆναι"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"ἁγίοις"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"θαυμασθῆναι"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"τοῖς"},{"text":"πιστεύσασιν"},{"text":"ὅτι"},{"text":"ἐπιστεύθη"},{"text":"τὸ"},{"text":"μαρτύριον"},{"text":"ἡμῶν"},{"text":"ἐφʼ"},{"text":"ὑμᾶς"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἡμέρᾳ"},{"text":"ἐκείνῃ"}],"notes":[],"lang":"grc"},{"n":11,"text":"εἰς ὃ καὶ προσευχόμεθα πάντοτε περὶ ὑμῶν, ἵνα ὑμᾶς ἀξιώσῃ τῆς κλήσεως ὁ θεὸς ἡμῶν καὶ πληρώσῃ πᾶσαν εὐδοκίαν ἀγαθωσύνης καὶ ἔργον πίστεως ἐν δυνάμει,","tokens":[{"text":"εἰς"},{"text":"ὃ"},{"text":"καὶ"},{"text":"προσευχόμεθα"},{"text":"πάντοτε"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"ἵνα"},{"text":"ὑμᾶς"},{"text":"ἀξιώσῃ"},{"text":"τῆς"},{"text":"κλήσεως"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"πληρώσῃ"},{"text":"πᾶσαν"},{"text":"εὐδοκίαν"},{"text":"ἀγαθωσύνης"},{"text":"καὶ"},{"text":"ἔργον"},{"text":"πίστεως"},{"text":"ἐν"},{"text":"δυνάμει"}],"notes":[],"lang":"grc"},{"n":12,"text":"ὅπως ἐνδοξασθῇ τὸ ὄνομα τοῦ κυρίου ἡμῶν Ἰησοῦ ἐν ὑμῖν, καὶ ὑμεῖς ἐν αὐτῷ, κατὰ τὴν χάριν τοῦ θεοῦ ἡμῶν καὶ κυρίου Ἰησοῦ Χριστοῦ.","tokens":[{"text":"ὅπως"},{"text":"ἐνδοξασθῇ"},{"text":"τὸ"},{"text":"ὄνομα"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"χάριν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Ἐρωτῶμεν δὲ ὑμᾶς, ἀδελφοί, ὑπὲρ τῆς παρουσίας τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ καὶ ἡμῶν ἐπισυναγωγῆς ἐπʼ αὐτόν,","tokens":[{"text":"Ἐρωτῶμεν"},{"text":"δὲ"},{"text":"ὑμᾶς"},{"text":"ἀδελφοί"},{"text":"ὑπὲρ"},{"text":"τῆς"},{"text":"παρουσίας"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"καὶ"},{"text":"ἡμῶν"},{"text":"ἐπισυναγωγῆς"},{"text":"ἐπʼ"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":2,"text":"εἰς τὸ μὴ ταχέως σαλευθῆναι ὑμᾶς ἀπὸ τοῦ νοὸς ⸀ μηδὲ θροεῖσθαι μήτε διὰ πνεύματος μήτε διὰ λόγου μήτε διʼ ἐπιστολῆς ὡς διʼ ἡμῶν, ὡς ὅτι ἐνέστηκεν ἡ ἡμέρα τοῦ ⸀ κυρίου.","tokens":[{"text":"εἰς"},{"text":"τὸ"},{"text":"μὴ"},{"text":"ταχέως"},{"text":"σαλευθῆναι"},{"text":"ὑμᾶς"},{"text":"ἀπὸ"},{"text":"τοῦ"},{"text":"νοὸς"},{"text":"μηδὲ"},{"text":"θροεῖσθαι"},{"text":"μήτε"},{"text":"διὰ"},{"text":"πνεύματος"},{"text":"μήτε"},{"text":"διὰ"},{"text":"λόγου"},{"text":"μήτε"},{"text":"διʼ"},{"text":"ἐπιστολῆς"},{"text":"ὡς"},{"text":"διʼ"},{"text":"ἡμῶν"},{"text":"ὡς"},{"text":"ὅτι"},{"text":"ἐνέστηκεν"},{"text":"ἡ"},{"text":"ἡμέρα"},{"text":"τοῦ"},{"text":"κυρίου"}],"notes":[],"lang":"grc"},{"n":3,"text":"μή τις ὑμᾶς ἐξαπατήσῃ κατὰ μηδένα τρόπον· ὅτι ἐὰν μὴ ἔλθῃ ἡ ἀποστασία πρῶτον καὶ ἀποκαλυφθῇ ὁ ἄνθρωπος τῆς ⸀ ἀνομίας, ὁ υἱὸς τῆς ἀπωλείας,","tokens":[{"text":"μή"},{"text":"τις"},{"text":"ὑμᾶς"},{"text":"ἐξαπατήσῃ"},{"text":"κατὰ"},{"text":"μηδένα"},{"text":"τρόπον"},{"text":"ὅτι"},{"text":"ἐὰν"},{"text":"μὴ"},{"text":"ἔλθῃ"},{"text":"ἡ"},{"text":"ἀποστασία"},{"text":"πρῶτον"},{"text":"καὶ"},{"text":"ἀποκαλυφθῇ"},{"text":"ὁ"},{"text":"ἄνθρωπος"},{"text":"τῆς"},{"text":"ἀνομίας"},{"text":"ὁ"},{"text":"υἱὸς"},{"text":"τῆς"},{"text":"ἀπωλείας"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὁ ἀντικείμενος καὶ ὑπεραιρόμενος ἐπὶ πάντα λεγόμενον θεὸν ἢ σέβασμα, ὥστε αὐτὸν εἰς τὸν ναὸν τοῦ ⸀ θεοῦ καθίσαι ἀποδεικνύντα ἑαυτὸν ὅτι ἔστιν θεός.","tokens":[{"text":"ὁ"},{"text":"ἀντικείμενος"},{"text":"καὶ"},{"text":"ὑπεραιρόμενος"},{"text":"ἐπὶ"},{"text":"πάντα"},{"text":"λεγόμενον"},{"text":"θεὸν"},{"text":"ἢ"},{"text":"σέβασμα"},{"text":"ὥστε"},{"text":"αὐτὸν"},{"text":"εἰς"},{"text":"τὸν"},{"text":"ναὸν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καθίσαι"},{"text":"ἀποδεικνύντα"},{"text":"ἑαυτὸν"},{"text":"ὅτι"},{"text":"ἔστιν"},{"text":"θεός"}],"notes":[],"lang":"grc"},{"n":5,"text":"οὐ μνημονεύετε ὅτι ἔτι ὢν πρὸς ὑμᾶς ταῦτα ἔλεγον ὑμῖν;","tokens":[{"text":"οὐ"},{"text":"μνημονεύετε"},{"text":"ὅτι"},{"text":"ἔτι"},{"text":"ὢν"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"ταῦτα"},{"text":"ἔλεγον"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":6,"text":"καὶ νῦν τὸ κατέχον οἴδατε, εἰς τὸ ἀποκαλυφθῆναι αὐτὸν ἐν τῷ ⸀ ἑαυτοῦ καιρῷ·","tokens":[{"text":"καὶ"},{"text":"νῦν"},{"text":"τὸ"},{"text":"κατέχον"},{"text":"οἴδατε"},{"text":"εἰς"},{"text":"τὸ"},{"text":"ἀποκαλυφθῆναι"},{"text":"αὐτὸν"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ἑαυτοῦ"},{"text":"καιρῷ"}],"notes":[],"lang":"grc"},{"n":7,"text":"τὸ γὰρ μυστήριον ἤδη ἐνεργεῖται τῆς ἀνομίας· μόνον ὁ κατέχων ἄρτι ἕως ἐκ μέσου γένηται.","tokens":[{"text":"τὸ"},{"text":"γὰρ"},{"text":"μυστήριον"},{"text":"ἤδη"},{"text":"ἐνεργεῖται"},{"text":"τῆς"},{"text":"ἀνομίας"},{"text":"μόνον"},{"text":"ὁ"},{"text":"κατέχων"},{"text":"ἄρτι"},{"text":"ἕως"},{"text":"ἐκ"},{"text":"μέσου"},{"text":"γένηται"}],"notes":[],"lang":"grc"},{"n":8,"text":"καὶ τότε ἀποκαλυφθήσεται ὁ ἄνομος, ὃν ὁ κύριος ⸀ Ἰησοῦς ⸀ ἀνελεῖ τῷ πνεύματι τοῦ στόματος αὐτοῦ καὶ καταργήσει τῇ ἐπιφανείᾳ τῆς παρουσίας αὐτοῦ,","tokens":[{"text":"καὶ"},{"text":"τότε"},{"text":"ἀποκαλυφθήσεται"},{"text":"ὁ"},{"text":"ἄνομος"},{"text":"ὃν"},{"text":"ὁ"},{"text":"κύριος"},{"text":"Ἰησοῦς"},{"text":"ἀνελεῖ"},{"text":"τῷ"},{"text":"πνεύματι"},{"text":"τοῦ"},{"text":"στόματος"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"καταργήσει"},{"text":"τῇ"},{"text":"ἐπιφανείᾳ"},{"text":"τῆς"},{"text":"παρουσίας"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"οὗ ἐστιν ἡ παρουσία κατʼ ἐνέργειαν τοῦ Σατανᾶ ἐν πάσῃ δυνάμει καὶ σημείοις καὶ τέρασιν ψεύδους","tokens":[{"text":"οὗ"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"παρουσία"},{"text":"κατʼ"},{"text":"ἐνέργειαν"},{"text":"τοῦ"},{"text":"Σατανᾶ"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"δυνάμει"},{"text":"καὶ"},{"text":"σημείοις"},{"text":"καὶ"},{"text":"τέρασιν"},{"text":"ψεύδους"}],"notes":[],"lang":"grc"},{"n":10,"text":"καὶ ἐν πάσῃ ἀπάτῃ ⸀ ἀδικίας τοῖς ἀπολλυμένοις, ἀνθʼ ὧν τὴν ἀγάπην τῆς ἀληθείας οὐκ ἐδέξαντο εἰς τὸ σωθῆναι αὐτούς·","tokens":[{"text":"καὶ"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"ἀπάτῃ"},{"text":"ἀδικίας"},{"text":"τοῖς"},{"text":"ἀπολλυμένοις"},{"text":"ἀνθʼ"},{"text":"ὧν"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"οὐκ"},{"text":"ἐδέξαντο"},{"text":"εἰς"},{"text":"τὸ"},{"text":"σωθῆναι"},{"text":"αὐτούς"}],"notes":[],"lang":"grc"},{"n":11,"text":"καὶ διὰ τοῦτο ⸀ πέμπει αὐτοῖς ὁ θεὸς ἐνέργειαν πλάνης εἰς τὸ πιστεῦσαι αὐτοὺς τῷ ψεύδει,","tokens":[{"text":"καὶ"},{"text":"διὰ"},{"text":"τοῦτο"},{"text":"πέμπει"},{"text":"αὐτοῖς"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἐνέργειαν"},{"text":"πλάνης"},{"text":"εἰς"},{"text":"τὸ"},{"text":"πιστεῦσαι"},{"text":"αὐτοὺς"},{"text":"τῷ"},{"text":"ψεύδει"}],"notes":[],"lang":"grc"},{"n":12,"text":"ἵνα κριθῶσιν ⸀ πάντες οἱ μὴ πιστεύσαντες τῇ ἀληθείᾳ ἀλλὰ εὐδοκήσαντες ⸀ τῇ ἀδικίᾳ.","tokens":[{"text":"ἵνα"},{"text":"κριθῶσιν"},{"text":"πάντες"},{"text":"οἱ"},{"text":"μὴ"},{"text":"πιστεύσαντες"},{"text":"τῇ"},{"text":"ἀληθείᾳ"},{"text":"ἀλλὰ"},{"text":"εὐδοκήσαντες"},{"text":"τῇ"},{"text":"ἀδικίᾳ"}],"notes":[],"lang":"grc"},{"n":13,"text":"Ἡμεῖς δὲ ὀφείλομεν εὐχαριστεῖν τῷ θεῷ πάντοτε περὶ ὑμῶν, ἀδελφοὶ ἠγαπημένοι ὑπὸ κυρίου, ὅτι εἵλατο ὑμᾶς ὁ θεὸς ⸀ ἀπαρχὴν εἰς σωτηρίαν ἐν ἁγιασμῷ πνεύματος καὶ πίστει ἀληθείας,","tokens":[{"text":"Ἡμεῖς"},{"text":"δὲ"},{"text":"ὀφείλομεν"},{"text":"εὐχαριστεῖν"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"πάντοτε"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"ἀδελφοὶ"},{"text":"ἠγαπημένοι"},{"text":"ὑπὸ"},{"text":"κυρίου"},{"text":"ὅτι"},{"text":"εἵλατο"},{"text":"ὑμᾶς"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἀπαρχὴν"},{"text":"εἰς"},{"text":"σωτηρίαν"},{"text":"ἐν"},{"text":"ἁγιασμῷ"},{"text":"πνεύματος"},{"text":"καὶ"},{"text":"πίστει"},{"text":"ἀληθείας"}],"notes":[],"lang":"grc"},{"n":14,"text":"εἰς ⸀ ὃ ἐκάλεσεν ὑμᾶς διὰ τοῦ εὐαγγελίου ἡμῶν, εἰς περιποίησιν δόξης τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ.","tokens":[{"text":"εἰς"},{"text":"ὃ"},{"text":"ἐκάλεσεν"},{"text":"ὑμᾶς"},{"text":"διὰ"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"ἡμῶν"},{"text":"εἰς"},{"text":"περιποίησιν"},{"text":"δόξης"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἄρα οὖν, ἀδελφοί, στήκετε, καὶ κρατεῖτε τὰς παραδόσεις ἃς ἐδιδάχθητε εἴτε διὰ λόγου εἴτε διʼ ἐπιστολῆς ἡμῶν.","tokens":[{"text":"ἄρα"},{"text":"οὖν"},{"text":"ἀδελφοί"},{"text":"στήκετε"},{"text":"καὶ"},{"text":"κρατεῖτε"},{"text":"τὰς"},{"text":"παραδόσεις"},{"text":"ἃς"},{"text":"ἐδιδάχθητε"},{"text":"εἴτε"},{"text":"διὰ"},{"text":"λόγου"},{"text":"εἴτε"},{"text":"διʼ"},{"text":"ἐπιστολῆς"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":16,"text":"Αὐτὸς δὲ ὁ κύριος ἡμῶν Ἰησοῦς Χριστὸς καὶ ⸀ θεὸς ⸀ ὁ πατὴρ ἡμῶν, ὁ ἀγαπήσας ἡμᾶς καὶ δοὺς παράκλησιν αἰωνίαν καὶ ἐλπίδα ἀγαθὴν ἐν χάριτι,","tokens":[{"text":"Αὐτὸς"},{"text":"δὲ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἡμῶν"},{"text":"Ἰησοῦς"},{"text":"Χριστὸς"},{"text":"καὶ"},{"text":"θεὸς"},{"text":"ὁ"},{"text":"πατὴρ"},{"text":"ἡμῶν"},{"text":"ὁ"},{"text":"ἀγαπήσας"},{"text":"ἡμᾶς"},{"text":"καὶ"},{"text":"δοὺς"},{"text":"παράκλησιν"},{"text":"αἰωνίαν"},{"text":"καὶ"},{"text":"ἐλπίδα"},{"text":"ἀγαθὴν"},{"text":"ἐν"},{"text":"χάριτι"}],"notes":[],"lang":"grc"},{"n":17,"text":"παρακαλέσαι ὑμῶν τὰς καρδίας καὶ ⸀ στηρίξαι ἐν παντὶ ⸂ ἔργῳ καὶ λόγῳ⸃ ἀγαθῷ.","tokens":[{"text":"παρακαλέσαι"},{"text":"ὑμῶν"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"καὶ"},{"text":"στηρίξαι"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"ἔργῳ"},{"text":"καὶ"},{"text":"λόγῳ"},{"text":"ἀγαθῷ"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Τὸ λοιπὸν προσεύχεσθε, ἀδελφοί, περὶ ἡμῶν, ἵνα ὁ λόγος τοῦ κυρίου τρέχῃ καὶ δοξάζηται καθὼς καὶ πρὸς ὑμᾶς,","tokens":[{"text":"Τὸ"},{"text":"λοιπὸν"},{"text":"προσεύχεσθε"},{"text":"ἀδελφοί"},{"text":"περὶ"},{"text":"ἡμῶν"},{"text":"ἵνα"},{"text":"ὁ"},{"text":"λόγος"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"τρέχῃ"},{"text":"καὶ"},{"text":"δοξάζηται"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"πρὸς"},{"text":"ὑμᾶς"}],"notes":[],"lang":"grc"},{"n":2,"text":"καὶ ἵνα ῥυσθῶμεν ἀπὸ τῶν ἀτόπων καὶ πονηρῶν ἀνθρώπων, οὐ γὰρ πάντων ἡ πίστις.","tokens":[{"text":"καὶ"},{"text":"ἵνα"},{"text":"ῥυσθῶμεν"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"ἀτόπων"},{"text":"καὶ"},{"text":"πονηρῶν"},{"text":"ἀνθρώπων"},{"text":"οὐ"},{"text":"γὰρ"},{"text":"πάντων"},{"text":"ἡ"},{"text":"πίστις"}],"notes":[],"lang":"grc"},{"n":3,"text":"πιστὸς δέ ἐστιν ὁ κύριος, ὃς στηρίξει ὑμᾶς καὶ φυλάξει ἀπὸ τοῦ πονηροῦ.","tokens":[{"text":"πιστὸς"},{"text":"δέ"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ὃς"},{"text":"στηρίξει"},{"text":"ὑμᾶς"},{"text":"καὶ"},{"text":"φυλάξει"},{"text":"ἀπὸ"},{"text":"τοῦ"},{"text":"πονηροῦ"}],"notes":[],"lang":"grc"},{"n":4,"text":"πεποίθαμεν δὲ ἐν κυρίῳ ἐφʼ ὑμᾶς, ὅτι ἃ ⸀ παραγγέλλομεν καὶ ποιεῖτε καὶ ποιήσετε.","tokens":[{"text":"πεποίθαμεν"},{"text":"δὲ"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"ἐφʼ"},{"text":"ὑμᾶς"},{"text":"ὅτι"},{"text":"ἃ"},{"text":"παραγγέλλομεν"},{"text":"καὶ"},{"text":"ποιεῖτε"},{"text":"καὶ"},{"text":"ποιήσετε"}],"notes":[],"lang":"grc"},{"n":5,"text":"ὁ δὲ κύριος κατευθύναι ὑμῶν τὰς καρδίας εἰς τὴν ἀγάπην τοῦ θεοῦ καὶ εἰς τὴν ὑπομονὴν τοῦ Χριστοῦ.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"κύριος"},{"text":"κατευθύναι"},{"text":"ὑμῶν"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"εἰς"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"εἰς"},{"text":"τὴν"},{"text":"ὑπομονὴν"},{"text":"τοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":6,"text":"Παραγγέλλομεν δὲ ὑμῖν, ἀδελφοί, ἐν ὀνόματι τοῦ κυρίου ⸀ ἡμῶν Ἰησοῦ Χριστοῦ στέλλεσθαι ὑμᾶς ἀπὸ παντὸς ἀδελφοῦ ἀτάκτως περιπατοῦντος καὶ μὴ κατὰ τὴν παράδοσιν ἣν ⸀ παρελάβοσαν παρʼ ἡμῶν.","tokens":[{"text":"Παραγγέλλομεν"},{"text":"δὲ"},{"text":"ὑμῖν"},{"text":"ἀδελφοί"},{"text":"ἐν"},{"text":"ὀνόματι"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"στέλλεσθαι"},{"text":"ὑμᾶς"},{"text":"ἀπὸ"},{"text":"παντὸς"},{"text":"ἀδελφοῦ"},{"text":"ἀτάκτως"},{"text":"περιπατοῦντος"},{"text":"καὶ"},{"text":"μὴ"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"παράδοσιν"},{"text":"ἣν"},{"text":"παρελάβοσαν"},{"text":"παρʼ"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":7,"text":"αὐτοὶ γὰρ οἴδατε πῶς δεῖ μιμεῖσθαι ἡμᾶς, ὅτι οὐκ ἠτακτήσαμεν ἐν ὑμῖν","tokens":[{"text":"αὐτοὶ"},{"text":"γὰρ"},{"text":"οἴδατε"},{"text":"πῶς"},{"text":"δεῖ"},{"text":"μιμεῖσθαι"},{"text":"ἡμᾶς"},{"text":"ὅτι"},{"text":"οὐκ"},{"text":"ἠτακτήσαμεν"},{"text":"ἐν"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":8,"text":"οὐδὲ δωρεὰν ἄρτον ἐφάγομεν παρά τινος, ἀλλʼ ἐν κόπῳ καὶ μόχθῳ ⸂ νυκτὸς καὶ ἡμέρας⸃ ἐργαζόμενοι πρὸς τὸ μὴ ἐπιβαρῆσαί τινα ὑμῶν·","tokens":[{"text":"οὐδὲ"},{"text":"δωρεὰν"},{"text":"ἄρτον"},{"text":"ἐφάγομεν"},{"text":"παρά"},{"text":"τινος"},{"text":"ἀλλʼ"},{"text":"ἐν"},{"text":"κόπῳ"},{"text":"καὶ"},{"text":"μόχθῳ"},{"text":"νυκτὸς"},{"text":"καὶ"},{"text":"ἡμέρας"},{"text":"ἐργαζόμενοι"},{"text":"πρὸς"},{"text":"τὸ"},{"text":"μὴ"},{"text":"ἐπιβαρῆσαί"},{"text":"τινα"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":9,"text":"οὐχ ὅτι οὐκ ἔχομεν ἐξουσίαν, ἀλλʼ ἵνα ἑαυτοὺς τύπον δῶμεν ὑμῖν εἰς τὸ μιμεῖσθαι ἡμᾶς.","tokens":[{"text":"οὐχ"},{"text":"ὅτι"},{"text":"οὐκ"},{"text":"ἔχομεν"},{"text":"ἐξουσίαν"},{"text":"ἀλλʼ"},{"text":"ἵνα"},{"text":"ἑαυτοὺς"},{"text":"τύπον"},{"text":"δῶμεν"},{"text":"ὑμῖν"},{"text":"εἰς"},{"text":"τὸ"},{"text":"μιμεῖσθαι"},{"text":"ἡμᾶς"}],"notes":[],"lang":"grc"},{"n":10,"text":"καὶ γὰρ ὅτε ἦμεν πρὸς ὑμᾶς, τοῦτο παρηγγέλλομεν ὑμῖν, ὅτι εἴ τις οὐ θέλει ἐργάζεσθαι μηδὲ ἐσθιέτω.","tokens":[{"text":"καὶ"},{"text":"γὰρ"},{"text":"ὅτε"},{"text":"ἦμεν"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"τοῦτο"},{"text":"παρηγγέλλομεν"},{"text":"ὑμῖν"},{"text":"ὅτι"},{"text":"εἴ"},{"text":"τις"},{"text":"οὐ"},{"text":"θέλει"},{"text":"ἐργάζεσθαι"},{"text":"μηδὲ"},{"text":"ἐσθιέτω"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἀκούομεν γάρ τινας περιπατοῦντας ἐν ὑμῖν ἀτάκτως, μηδὲν ἐργαζομένους ἀλλὰ περιεργαζομένους·","tokens":[{"text":"ἀκούομεν"},{"text":"γάρ"},{"text":"τινας"},{"text":"περιπατοῦντας"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἀτάκτως"},{"text":"μηδὲν"},{"text":"ἐργαζομένους"},{"text":"ἀλλὰ"},{"text":"περιεργαζομένους"}],"notes":[],"lang":"grc"},{"n":12,"text":"τοῖς δὲ τοιούτοις παραγγέλλομεν καὶ παρακαλοῦμεν ⸂ ἐν κυρίῳ Ἰησοῦ Χριστῷ⸃ ἵνα μετὰ ἡσυχίας ἐργαζόμενοι τὸν ἑαυτῶν ἄρτον ἐσθίωσιν.","tokens":[{"text":"τοῖς"},{"text":"δὲ"},{"text":"τοιούτοις"},{"text":"παραγγέλλομεν"},{"text":"καὶ"},{"text":"παρακαλοῦμεν"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"Ἰησοῦ"},{"text":"Χριστῷ"},{"text":"ἵνα"},{"text":"μετὰ"},{"text":"ἡσυχίας"},{"text":"ἐργαζόμενοι"},{"text":"τὸν"},{"text":"ἑαυτῶν"},{"text":"ἄρτον"},{"text":"ἐσθίωσιν"}],"notes":[],"lang":"grc"},{"n":13,"text":"ὑμεῖς δέ, ἀδελφοί, μὴ ⸀ ἐγκακήσητε καλοποιοῦντες.","tokens":[{"text":"ὑμεῖς"},{"text":"δέ"},{"text":"ἀδελφοί"},{"text":"μὴ"},{"text":"ἐγκακήσητε"},{"text":"καλοποιοῦντες"}],"notes":[],"lang":"grc"},{"n":14,"text":"Εἰ δέ τις οὐχ ὑπακούει τῷ λόγῳ ἡμῶν διὰ τῆς ἐπιστολῆς, τοῦτον σημειοῦσθε,  ⸀ μὴ ⸀ συναναμίγνυσθαι αὐτῷ, ἵνα ἐντραπῇ·","tokens":[{"text":"Εἰ"},{"text":"δέ"},{"text":"τις"},{"text":"οὐχ"},{"text":"ὑπακούει"},{"text":"τῷ"},{"text":"λόγῳ"},{"text":"ἡμῶν"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ἐπιστολῆς"},{"text":"τοῦτον"},{"text":"σημειοῦσθε"},{"text":"μὴ"},{"text":"συναναμίγνυσθαι"},{"text":"αὐτῷ"},{"text":"ἵνα"},{"text":"ἐντραπῇ"}],"notes":[],"lang":"grc"},{"n":15,"text":"καὶ μὴ ὡς ἐχθρὸν ἡγεῖσθε, ἀλλὰ νουθετεῖτε ὡς ἀδελφόν.","tokens":[{"text":"καὶ"},{"text":"μὴ"},{"text":"ὡς"},{"text":"ἐχθρὸν"},{"text":"ἡγεῖσθε"},{"text":"ἀλλὰ"},{"text":"νουθετεῖτε"},{"text":"ὡς"},{"text":"ἀδελφόν"}],"notes":[],"lang":"grc"},{"n":16,"text":"Αὐτὸς δὲ ὁ κύριος τῆς εἰρήνης δῴη ὑμῖν τὴν εἰρήνην διὰ παντὸς ἐν παντὶ τρόπῳ. ὁ κύριος μετὰ πάντων ὑμῶν.","tokens":[{"text":"Αὐτὸς"},{"text":"δὲ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"τῆς"},{"text":"εἰρήνης"},{"text":"δῴη"},{"text":"ὑμῖν"},{"text":"τὴν"},{"text":"εἰρήνην"},{"text":"διὰ"},{"text":"παντὸς"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"τρόπῳ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"μετὰ"},{"text":"πάντων"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":17,"text":"Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου, ὅ ἐστιν σημεῖον ἐν πάσῃ ἐπιστολῇ· οὕτως γράφω.","tokens":[{"text":"Ὁ"},{"text":"ἀσπασμὸς"},{"text":"τῇ"},{"text":"ἐμῇ"},{"text":"χειρὶ"},{"text":"Παύλου"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"σημεῖον"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"ἐπιστολῇ"},{"text":"οὕτως"},{"text":"γράφω"}],"notes":[],"lang":"grc"},{"n":18,"text":"ἡ χάρις τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ μετὰ πάντων ⸀ ὑμῶν.","tokens":[{"text":"ἡ"},{"text":"χάρις"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"μετὰ"},{"text":"πάντων"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}