{"book":{"id":"3John","name":"3 João","testament":"NT","source":"SBLGNT","chapters":1,"verses":15},"chapters":{"1":[{"n":1,"text":"Ὁ πρεσβύτερος Γαΐῳ τῷ ἀγαπητῷ, ὃν ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ.","tokens":[{"text":"Ὁ"},{"text":"πρεσβύτερος"},{"text":"Γαΐῳ"},{"text":"τῷ"},{"text":"ἀγαπητῷ"},{"text":"ὃν"},{"text":"ἐγὼ"},{"text":"ἀγαπῶ"},{"text":"ἐν"},{"text":"ἀληθείᾳ"}],"notes":[],"lang":"grc"},{"n":2,"text":"Ἀγαπητέ, περὶ πάντων εὔχομαί σε εὐοδοῦσθαι καὶ ὑγιαίνειν, καθὼς εὐοδοῦταί σου ἡ ψυχή.","tokens":[{"text":"Ἀγαπητέ"},{"text":"περὶ"},{"text":"πάντων"},{"text":"εὔχομαί"},{"text":"σε"},{"text":"εὐοδοῦσθαι"},{"text":"καὶ"},{"text":"ὑγιαίνειν"},{"text":"καθὼς"},{"text":"εὐοδοῦταί"},{"text":"σου"},{"text":"ἡ"},{"text":"ψυχή"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἐχάρην γὰρ λίαν ἐρχομένων ἀδελφῶν καὶ μαρτυρούντων σου τῇ ἀληθείᾳ, καθὼς σὺ ἐν ἀληθείᾳ περιπατεῖς.","tokens":[{"text":"ἐχάρην"},{"text":"γὰρ"},{"text":"λίαν"},{"text":"ἐρχομένων"},{"text":"ἀδελφῶν"},{"text":"καὶ"},{"text":"μαρτυρούντων"},{"text":"σου"},{"text":"τῇ"},{"text":"ἀληθείᾳ"},{"text":"καθὼς"},{"text":"σὺ"},{"text":"ἐν"},{"text":"ἀληθείᾳ"},{"text":"περιπατεῖς"}],"notes":[],"lang":"grc"},{"n":4,"text":"μειζοτέραν τούτων οὐκ ἔχω ⸀ χαράν, ἵνα ἀκούω τὰ ἐμὰ τέκνα ἐν ⸀ τῇ ἀληθείᾳ περιπατοῦντα.","tokens":[{"text":"μειζοτέραν"},{"text":"τούτων"},{"text":"οὐκ"},{"text":"ἔχω"},{"text":"χαράν"},{"text":"ἵνα"},{"text":"ἀκούω"},{"text":"τὰ"},{"text":"ἐμὰ"},{"text":"τέκνα"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀληθείᾳ"},{"text":"περιπατοῦντα"}],"notes":[],"lang":"grc"},{"n":5,"text":"Ἀγαπητέ, πιστὸν ποιεῖς ὃ ἐὰν ἐργάσῃ εἰς τοὺς ἀδελφοὺς καὶ ⸀ τοῦτο ξένους,","tokens":[{"text":"Ἀγαπητέ"},{"text":"πιστὸν"},{"text":"ποιεῖς"},{"text":"ὃ"},{"text":"ἐὰν"},{"text":"ἐργάσῃ"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"ἀδελφοὺς"},{"text":"καὶ"},{"text":"τοῦτο"},{"text":"ξένους"}],"notes":[],"lang":"grc"},{"n":6,"text":"οἳ ἐμαρτύρησάν σου τῇ ἀγάπῃ ἐνώπιον ἐκκλησίας, οὓς καλῶς ποιήσεις προπέμψας ἀξίως τοῦ θεοῦ·","tokens":[{"text":"οἳ"},{"text":"ἐμαρτύρησάν"},{"text":"σου"},{"text":"τῇ"},{"text":"ἀγάπῃ"},{"text":"ἐνώπιον"},{"text":"ἐκκλησίας"},{"text":"οὓς"},{"text":"καλῶς"},{"text":"ποιήσεις"},{"text":"προπέμψας"},{"text":"ἀξίως"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":7,"text":"ὑπὲρ γὰρ τοῦ ὀνόματος ἐξῆλθον μηδὲν λαμβάνοντες ἀπὸ τῶν ⸀ ἐθνικῶν.","tokens":[{"text":"ὑπὲρ"},{"text":"γὰρ"},{"text":"τοῦ"},{"text":"ὀνόματος"},{"text":"ἐξῆλθον"},{"text":"μηδὲν"},{"text":"λαμβάνοντες"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"ἐθνικῶν"}],"notes":[],"lang":"grc"},{"n":8,"text":"ἡμεῖς οὖν ὀφείλομεν ⸀ ὑπολαμβάνειν τοὺς τοιούτους, ἵνα συνεργοὶ γινώμεθα τῇ ἀληθείᾳ.","tokens":[{"text":"ἡμεῖς"},{"text":"οὖν"},{"text":"ὀφείλομεν"},{"text":"ὑπολαμβάνειν"},{"text":"τοὺς"},{"text":"τοιούτους"},{"text":"ἵνα"},{"text":"συνεργοὶ"},{"text":"γινώμεθα"},{"text":"τῇ"},{"text":"ἀληθείᾳ"}],"notes":[],"lang":"grc"},{"n":9,"text":"Ἔγραψά ⸀ τι τῇ ἐκκλησίᾳ· ἀλλʼ ὁ φιλοπρωτεύων αὐτῶν Διοτρέφης οὐκ ἐπιδέχεται ἡμᾶς.","tokens":[{"text":"Ἔγραψά"},{"text":"τι"},{"text":"τῇ"},{"text":"ἐκκλησίᾳ"},{"text":"ἀλλʼ"},{"text":"ὁ"},{"text":"φιλοπρωτεύων"},{"text":"αὐτῶν"},{"text":"Διοτρέφης"},{"text":"οὐκ"},{"text":"ἐπιδέχεται"},{"text":"ἡμᾶς"}],"notes":[],"lang":"grc"},{"n":10,"text":"διὰ τοῦτο, ἐὰν ἔλθω, ὑπομνήσω αὐτοῦ τὰ ἔργα ἃ ποιεῖ, λόγοις πονηροῖς φλυαρῶν ἡμᾶς, καὶ μὴ ἀρκούμενος ἐπὶ τούτοις οὔτε αὐτὸς ἐπιδέχεται τοὺς ἀδελφοὺς καὶ τοὺς βουλομένους κωλύει καὶ ἐκ τῆς ἐκκλησίας ἐκβάλλει.","tokens":[{"text":"διὰ"},{"text":"τοῦτο"},{"text":"ἐὰν"},{"text":"ἔλθω"},{"text":"ὑπομνήσω"},{"text":"αὐτοῦ"},{"text":"τὰ"},{"text":"ἔργα"},{"text":"ἃ"},{"text":"ποιεῖ"},{"text":"λόγοις"},{"text":"πονηροῖς"},{"text":"φλυαρῶν"},{"text":"ἡμᾶς"},{"text":"καὶ"},{"text":"μὴ"},{"text":"ἀρκούμενος"},{"text":"ἐπὶ"},{"text":"τούτοις"},{"text":"οὔτε"},{"text":"αὐτὸς"},{"text":"ἐπιδέχεται"},{"text":"τοὺς"},{"text":"ἀδελφοὺς"},{"text":"καὶ"},{"text":"τοὺς"},{"text":"βουλομένους"},{"text":"κωλύει"},{"text":"καὶ"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"ἐκκλησίας"},{"text":"ἐκβάλλει"}],"notes":[],"lang":"grc"},{"n":11,"text":"Ἀγαπητέ, μὴ μιμοῦ τὸ κακὸν ἀλλὰ τὸ ἀγαθόν. ὁ ἀγαθοποιῶν ἐκ τοῦ θεοῦ ἐστιν· ὁ κακοποιῶν οὐχ ἑώρακεν τὸν θεόν.","tokens":[{"text":"Ἀγαπητέ"},{"text":"μὴ"},{"text":"μιμοῦ"},{"text":"τὸ"},{"text":"κακὸν"},{"text":"ἀλλὰ"},{"text":"τὸ"},{"text":"ἀγαθόν"},{"text":"ὁ"},{"text":"ἀγαθοποιῶν"},{"text":"ἐκ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"κακοποιῶν"},{"text":"οὐχ"},{"text":"ἑώρακεν"},{"text":"τὸν"},{"text":"θεόν"}],"notes":[],"lang":"grc"},{"n":12,"text":"Δημητρίῳ μεμαρτύρηται ὑπὸ πάντων καὶ ὑπὸ αὐτῆς τῆς ἀληθείας· καὶ ἡμεῖς δὲ μαρτυροῦμεν, καὶ ⸀ οἶδας ὅτι ἡ μαρτυρία ἡμῶν ἀληθής ἐστιν.","tokens":[{"text":"Δημητρίῳ"},{"text":"μεμαρτύρηται"},{"text":"ὑπὸ"},{"text":"πάντων"},{"text":"καὶ"},{"text":"ὑπὸ"},{"text":"αὐτῆς"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"καὶ"},{"text":"ἡμεῖς"},{"text":"δὲ"},{"text":"μαρτυροῦμεν"},{"text":"καὶ"},{"text":"οἶδας"},{"text":"ὅτι"},{"text":"ἡ"},{"text":"μαρτυρία"},{"text":"ἡμῶν"},{"text":"ἀληθής"},{"text":"ἐστιν"}],"notes":[],"lang":"grc"},{"n":13,"text":"Πολλὰ εἶχον ⸂ γράψαι σοι⸃, ἀλλʼ οὐ θέλω διὰ μέλανος καὶ καλάμου σοι ⸀ γράφειν·","tokens":[{"text":"Πολλὰ"},{"text":"εἶχον"},{"text":"γράψαι"},{"text":"σοι"},{"text":"ἀλλʼ"},{"text":"οὐ"},{"text":"θέλω"},{"text":"διὰ"},{"text":"μέλανος"},{"text":"καὶ"},{"text":"καλάμου"},{"text":"σοι"},{"text":"γράφειν"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἐλπίζω δὲ εὐθέως ⸂ σε ἰδεῖν⸃, καὶ στόμα πρὸς στόμα λαλήσομεν.","tokens":[{"text":"ἐλπίζω"},{"text":"δὲ"},{"text":"εὐθέως"},{"text":"σε"},{"text":"ἰδεῖν"},{"text":"καὶ"},{"text":"στόμα"},{"text":"πρὸς"},{"text":"στόμα"},{"text":"λαλήσομεν"}],"notes":[],"lang":"grc"},{"n":15,"text":"Εἰρήνη σοι. ἀσπάζονταί σε οἱ φίλοι. ἀσπάζου τοὺς φίλους κατʼ ὄνομα.","tokens":[{"text":"Εἰρήνη"},{"text":"σοι"},{"text":"ἀσπάζονταί"},{"text":"σε"},{"text":"οἱ"},{"text":"φίλοι"},{"text":"ἀσπάζου"},{"text":"τοὺς"},{"text":"φίλους"},{"text":"κατʼ"},{"text":"ὄνομα"}],"notes":[],"lang":"grc"}]}}