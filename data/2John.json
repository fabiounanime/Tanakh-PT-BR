{"book":{"id":"2John","name":"2 João","testament":"NT","source":"SBLGNT","chapters":1,"verses":13},"chapters":{"1":[{"n":1,"text":"Ὁ πρεσβύτερος ἐκλεκτῇ κυρίᾳ καὶ τοῖς τέκνοις αὐτῆς, οὓς ἐγὼ ἀγαπῶ ἐν ἀληθείᾳ, καὶ οὐκ ἐγὼ μόνος ἀλλὰ καὶ πάντες οἱ ἐγνωκότες τὴν ἀλήθειαν,","tokens":[{"text":"Ὁ"},{"text":"πρεσβύτερος"},{"text":"ἐκλεκτῇ"},{"text":"κυρίᾳ"},{"text":"καὶ"},{"text":"τοῖς"},{"text":"τέκνοις"},{"text":"αὐτῆς"},{"text":"οὓς"},{"text":"ἐγὼ"},{"text":"ἀγαπῶ"},{"text":"ἐν"},{"text":"ἀληθείᾳ"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἐγὼ"},{"text":"μόνος"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"πάντες"},{"text":"οἱ"},{"text":"ἐγνωκότες"},{"text":"τὴν"},{"text":"ἀλήθειαν"}],"notes":[],"lang":"grc"},{"n":2,"text":"διὰ τὴν ἀλήθειαν τὴν μένουσαν ἐν ἡμῖν, καὶ μεθʼ ἡμῶν ἔσται εἰς τὸν αἰῶνα·","tokens":[{"text":"διὰ"},{"text":"τὴν"},{"text":"ἀλήθειαν"},{"text":"τὴν"},{"text":"μένουσαν"},{"text":"ἐν"},{"text":"ἡμῖν"},{"text":"καὶ"},{"text":"μεθʼ"},{"text":"ἡμῶν"},{"text":"ἔσται"},{"text":"εἰς"},{"text":"τὸν"},{"text":"αἰῶνα"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἔσται μεθʼ ἡμῶν χάρις ἔλεος εἰρήνη παρὰ θεοῦ πατρός, καὶ ⸀ παρὰ Ἰησοῦ Χριστοῦ τοῦ υἱοῦ τοῦ πατρός, ἐν ἀληθείᾳ καὶ ἀγάπῃ.","tokens":[{"text":"ἔσται"},{"text":"μεθʼ"},{"text":"ἡμῶν"},{"text":"χάρις"},{"text":"ἔλεος"},{"text":"εἰρήνη"},{"text":"παρὰ"},{"text":"θεοῦ"},{"text":"πατρός"},{"text":"καὶ"},{"text":"παρὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τοῦ"},{"text":"υἱοῦ"},{"text":"τοῦ"},{"text":"πατρός"},{"text":"ἐν"},{"text":"ἀληθείᾳ"},{"text":"καὶ"},{"text":"ἀγάπῃ"}],"notes":[],"lang":"grc"},{"n":4,"text":"Ἐχάρην λίαν ὅτι εὕρηκα ἐκ τῶν τέκνων σου περιπατοῦντας ἐν ἀληθείᾳ, καθὼς ἐντολὴν ἐλάβομεν παρὰ τοῦ πατρός.","tokens":[{"text":"Ἐχάρην"},{"text":"λίαν"},{"text":"ὅτι"},{"text":"εὕρηκα"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"τέκνων"},{"text":"σου"},{"text":"περιπατοῦντας"},{"text":"ἐν"},{"text":"ἀληθείᾳ"},{"text":"καθὼς"},{"text":"ἐντολὴν"},{"text":"ἐλάβομεν"},{"text":"παρὰ"},{"text":"τοῦ"},{"text":"πατρός"}],"notes":[],"lang":"grc"},{"n":5,"text":"καὶ νῦν ἐρωτῶ σε, κυρία, οὐχ ὡς ἐντολὴν ⸂ καινὴν γράφων σοι⸃ ἀλλὰ ἣν εἴχομεν ἀπʼ ἀρχῆς, ἵνα ἀγαπῶμεν ἀλλήλους.","tokens":[{"text":"καὶ"},{"text":"νῦν"},{"text":"ἐρωτῶ"},{"text":"σε"},{"text":"κυρία"},{"text":"οὐχ"},{"text":"ὡς"},{"text":"ἐντολὴν"},{"text":"καινὴν"},{"text":"γράφων"},{"text":"σοι"},{"text":"ἀλλὰ"},{"text":"ἣν"},{"text":"εἴχομεν"},{"text":"ἀπʼ"},{"text":"ἀρχῆς"},{"text":"ἵνα"},{"text":"ἀγαπῶμεν"},{"text":"ἀλλήλους"}],"notes":[],"lang":"grc"},{"n":6,"text":"καὶ αὕτη ἐστὶν ἡ ἀγάπη, ἵνα περιπατῶμεν κατὰ τὰς ἐντολὰς αὐτοῦ· αὕτη ⸂ ἡ ἐντολή ἐστιν⸃, καθὼς ἠκούσατε ἀπʼ ἀρχῆς, ἵνα ἐν αὐτῇ περιπατῆτε.","tokens":[{"text":"καὶ"},{"text":"αὕτη"},{"text":"ἐστὶν"},{"text":"ἡ"},{"text":"ἀγάπη"},{"text":"ἵνα"},{"text":"περιπατῶμεν"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"ἐντολὰς"},{"text":"αὐτοῦ"},{"text":"αὕτη"},{"text":"ἡ"},{"text":"ἐντολή"},{"text":"ἐστιν"},{"text":"καθὼς"},{"text":"ἠκούσατε"},{"text":"ἀπʼ"},{"text":"ἀρχῆς"},{"text":"ἵνα"},{"text":"ἐν"},{"text":"αὐτῇ"},{"text":"περιπατῆτε"}],"notes":[],"lang":"grc"},{"n":7,"text":"ὅτι πολλοὶ πλάνοι ⸀ ἐξῆλθον εἰς τὸν κόσμον, οἱ μὴ ὁμολογοῦντες Ἰησοῦν Χριστὸν ἐρχόμενον ἐν σαρκί· οὗτός ἐστιν ὁ πλάνος καὶ ὁ ἀντίχριστος.","tokens":[{"text":"ὅτι"},{"text":"πολλοὶ"},{"text":"πλάνοι"},{"text":"ἐξῆλθον"},{"text":"εἰς"},{"text":"τὸν"},{"text":"κόσμον"},{"text":"οἱ"},{"text":"μὴ"},{"text":"ὁμολογοῦντες"},{"text":"Ἰησοῦν"},{"text":"Χριστὸν"},{"text":"ἐρχόμενον"},{"text":"ἐν"},{"text":"σαρκί"},{"text":"οὗτός"},{"text":"ἐστιν"},{"text":"ὁ"},{"text":"πλάνος"},{"text":"καὶ"},{"text":"ὁ"},{"text":"ἀντίχριστος"}],"notes":[],"lang":"grc"},{"n":8,"text":"βλέπετε ἑαυτούς, ἵνα μὴ ⸀ ἀπολέσητε ἃ ⸀ εἰργασάμεθα, ἀλλὰ μισθὸν πλήρη ⸀ ἀπολάβητε.","tokens":[{"text":"βλέπετε"},{"text":"ἑαυτούς"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ἀπολέσητε"},{"text":"ἃ"},{"text":"εἰργασάμεθα"},{"text":"ἀλλὰ"},{"text":"μισθὸν"},{"text":"πλήρη"},{"text":"ἀπολάβητε"}],"notes":[],"lang":"grc"},{"n":9,"text":"πᾶς ὁ ⸀ προάγων καὶ μὴ μένων ἐν τῇ διδαχῇ τοῦ Χριστοῦ θεὸν οὐκ ἔχει· ὁ μένων ἐν τῇ ⸀ διδαχῇ, οὗτος καὶ τὸν πατέρα καὶ τὸν υἱὸν ἔχει.","tokens":[{"text":"πᾶς"},{"text":"ὁ"},{"text":"προάγων"},{"text":"καὶ"},{"text":"μὴ"},{"text":"μένων"},{"text":"ἐν"},{"text":"τῇ"},{"text":"διδαχῇ"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"θεὸν"},{"text":"οὐκ"},{"text":"ἔχει"},{"text":"ὁ"},{"text":"μένων"},{"text":"ἐν"},{"text":"τῇ"},{"text":"διδαχῇ"},{"text":"οὗτος"},{"text":"καὶ"},{"text":"τὸν"},{"text":"πατέρα"},{"text":"καὶ"},{"text":"τὸν"},{"text":"υἱὸν"},{"text":"ἔχει"}],"notes":[],"lang":"grc"},{"n":10,"text":"εἴ τις ἔρχεται πρὸς ὑμᾶς καὶ ταύτην τὴν διδαχὴν οὐ φέρει, μὴ λαμβάνετε αὐτὸν εἰς οἰκίαν καὶ χαίρειν αὐτῷ μὴ λέγετε·","tokens":[{"text":"εἴ"},{"text":"τις"},{"text":"ἔρχεται"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"καὶ"},{"text":"ταύτην"},{"text":"τὴν"},{"text":"διδαχὴν"},{"text":"οὐ"},{"text":"φέρει"},{"text":"μὴ"},{"text":"λαμβάνετε"},{"text":"αὐτὸν"},{"text":"εἰς"},{"text":"οἰκίαν"},{"text":"καὶ"},{"text":"χαίρειν"},{"text":"αὐτῷ"},{"text":"μὴ"},{"text":"λέγετε"}],"notes":[],"lang":"grc"},{"n":11,"text":"ὁ ⸂ λέγων γὰρ⸃ αὐτῷ χαίρειν κοινωνεῖ τοῖς ἔργοις αὐτοῦ τοῖς πονηροῖς.","tokens":[{"text":"ὁ"},{"text":"λέγων"},{"text":"γὰρ"},{"text":"αὐτῷ"},{"text":"χαίρειν"},{"text":"κοινωνεῖ"},{"text":"τοῖς"},{"text":"ἔργοις"},{"text":"αὐτοῦ"},{"text":"τοῖς"},{"text":"πονηροῖς"}],"notes":[],"lang":"grc"},{"n":12,"text":"Πολλὰ ἔχων ὑμῖν γράφειν οὐκ ἐβουλήθην διὰ χάρτου καὶ μέλανος, ἀλλὰ ἐλπίζω ⸀ γενέσθαι πρὸς ὑμᾶς καὶ στόμα πρὸς στόμα λαλῆσαι, ἵνα ἡ χαρὰ ⸀ ὑμῶν ⸂ πεπληρωμένη ᾖ⸃.","tokens":[{"text":"Πολλὰ"},{"text":"ἔχων"},{"text":"ὑμῖν"},{"text":"γράφειν"},{"text":"οὐκ"},{"text":"ἐβουλήθην"},{"text":"διὰ"},{"text":"χάρτου"},{"text":"καὶ"},{"text":"μέλανος"},{"text":"ἀλλὰ"},{"text":"ἐλπίζω"},{"text":"γενέσθαι"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"καὶ"},{"text":"στόμα"},{"text":"πρὸς"},{"text":"στόμα"},{"text":"λαλῆσαι"},{"text":"ἵνα"},{"text":"ἡ"},{"text":"χαρὰ"},{"text":"ὑμῶν"},{"t