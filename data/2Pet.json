{"book":{"id":"2Pet","name":"2 Pedro","testament":"NT","source":"SBLGNT","chapters":3,"verses":61},"chapters":{"1":[{"n":1,"text":"⸀ Συμεὼν Πέτρος δοῦλος καὶ ἀπόστολος Ἰησοῦ Χριστοῦ τοῖς ἰσότιμον ἡμῖν λαχοῦσιν πίστιν ἐν δικαιοσύνῃ τοῦ θεοῦ ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ·","tokens":[{"text":"Συμεὼν"},{"text":"Πέτρος"},{"text":"δοῦλος"},{"text":"καὶ"},{"text":"ἀπόστολος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τοῖς"},{"text":"ἰσότιμον"},{"text":"ἡμῖν"},{"text":"λαχοῦσιν"},{"text":"πίστιν"},{"text":"ἐν"},{"text":"δικαιοσύνῃ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"σωτῆρος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":2,"text":"χάρις ὑμῖν καὶ εἰρήνη πληθυνθείη ἐν ἐπιγνώσει τοῦ θεοῦ καὶ Ἰησοῦ τοῦ κυρίου ἡμῶν.","tokens":[{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"πληθυνθείη"},{"text":"ἐν"},{"text":"ἐπιγνώσει"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":3,"text":"Ὡς πάντα ἡμῖν τῆς θείας δυνάμεως αὐτοῦ τὰ πρὸς ζωὴν καὶ εὐσέβειαν δεδωρημένης διὰ τῆς ἐπιγνώσεως τοῦ καλέσαντος ἡμᾶς ⸂ ἰδίᾳ δόξῃ καὶ ἀρετῇ⸃,","tokens":[{"text":"Ὡς"},{"text":"πάντα"},{"text":"ἡμῖν"},{"text":"τῆς"},{"text":"θείας"},{"text":"δυνάμεως"},{"text":"αὐτοῦ"},{"text":"τὰ"},{"text":"πρὸς"},{"text":"ζωὴν"},{"text":"καὶ"},{"text":"εὐσέβειαν"},{"text":"δεδωρημένης"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ἐπιγνώσεως"},{"text":"τοῦ"},{"text":"καλέσαντος"},{"text":"ἡμᾶς"},{"text":"ἰδίᾳ"},{"text":"δόξῃ"},{"text":"καὶ"},{"text":"ἀρετῇ"}],"notes":[],"lang":"grc"},{"n":4,"text":"διʼ ὧν τὰ ⸂ τίμια καὶ μέγιστα ἡμῖν⸃ ἐπαγγέλματα δεδώρηται, ἵνα διὰ τούτων γένησθε θείας κοινωνοὶ φύσεως, ἀποφυγόντες τῆς ἐν ⸀ τῷ κόσμῳ ἐν ἐπιθυμίᾳ φθορᾶς.","tokens":[{"text":"διʼ"},{"text":"ὧν"},{"text":"τὰ"},{"text":"τίμια"},{"text":"καὶ"},{"text":"μέγιστα"},{"text":"ἡμῖν"},{"text":"ἐπαγγέλματα"},{"text":"δεδώρηται"},{"text":"ἵνα"},{"text":"διὰ"},{"text":"τούτων"},{"text":"γένησθε"},{"text":"θείας"},{"text":"κοινωνοὶ"},{"text":"φύσεως"},{"text":"ἀποφυγόντες"},{"text":"τῆς"},{"text":"ἐν"},{"text":"τῷ"},{"text":"κόσμῳ"},{"text":"ἐν"},{"text":"ἐπιθυμίᾳ"},{"text":"φθορᾶς"}],"notes":[],"lang":"grc"},{"n":5,"text":"καὶ αὐτὸ τοῦτο δὲ σπουδὴν πᾶσαν παρεισενέγκαντες ἐπιχορηγήσατε ἐν τῇ πίστει ὑμῶν τὴν ἀρετήν, ἐν δὲ τῇ ἀρετῇ τὴν γνῶσιν,","tokens":[{"text":"καὶ"},{"text":"αὐτὸ"},{"text":"τοῦτο"},{"text":"δὲ"},{"text":"σπουδὴν"},{"text":"πᾶσαν"},{"text":"παρεισενέγκαντες"},{"text":"ἐπιχορηγήσατε"},{"text":"ἐν"},{"text":"τῇ"},{"text":"πίστει"},{"text":"ὑμῶν"},{"text":"τὴν"},{"text":"ἀρετήν"},{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"ἀρετῇ"},{"text":"τὴν"},{"text":"γνῶσιν"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἐν δὲ τῇ γνώσει τὴν ἐγκράτειαν, ἐν δὲ τῇ ἐγκρατείᾳ τὴν ὑπομονήν, ἐν δὲ τῇ ὑπομονῇ τὴν εὐσέβειαν,","tokens":[{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"γνώσει"},{"text":"τὴν"},{"text":"ἐγκράτειαν"},{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"ἐγκρατείᾳ"},{"text":"τὴν"},{"text":"ὑπομονήν"},{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"ὑπομονῇ"},{"text":"τὴν"},{"text":"εὐσέβειαν"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἐν δὲ τῇ εὐσεβείᾳ τὴν φιλαδελφίαν, ἐν δὲ τῇ φιλαδελφίᾳ τὴν ἀγάπην·","tokens":[{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"εὐσεβείᾳ"},{"text":"τὴν"},{"text":"φιλαδελφίαν"},{"text":"ἐν"},{"text":"δὲ"},{"text":"τῇ"},{"text":"φιλαδελφίᾳ"},{"text":"τὴν"},{"text":"ἀγάπην"}],"notes":[],"lang":"grc"},{"n":8,"text":"ταῦτα γὰρ ὑμῖν ὑπάρχοντα καὶ πλεονάζοντα οὐκ ἀργοὺς οὐδὲ ἀκάρπους καθίστησιν εἰς τὴν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ ἐπίγνωσιν·","tokens":[{"text":"ταῦτα"},{"text":"γὰρ"},{"text":"ὑμῖν"},{"text":"ὑπάρχοντα"},{"text":"καὶ"},{"text":"πλεονάζοντα"},{"text":"οὐκ"},{"text":"ἀργοὺς"},{"text":"οὐδὲ"},{"text":"ἀκάρπους"},{"text":"καθίστησιν"},{"text":"εἰς"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"ἐπίγνωσιν"}],"notes":[],"lang":"grc"},{"n":9,"text":"ᾧ γὰρ μὴ πάρεστιν ταῦτα, τυφλός ἐστιν μυωπάζων, λήθην λαβὼν τοῦ καθαρισμοῦ τῶν πάλαι αὐτοῦ ⸀ ἁμαρτημάτων.","tokens":[{"text":"ᾧ"},{"text":"γὰρ"},{"text":"μὴ"},{"text":"πάρεστιν"},{"text":"ταῦτα"},{"text":"τυφλός"},{"text":"ἐστιν"},{"text":"μυωπάζων"},{"text":"λήθην"},{"text":"λαβὼν"},{"text":"τοῦ"},{"text":"καθαρισμοῦ"},{"text":"τῶν"},{"text":"πάλαι"},{"text":"αὐτοῦ"},{"text":"ἁμαρτημάτων"}],"notes":[],"lang":"grc"},{"n":10,"text":"διὸ μᾶλλον, ἀδελφοί, σπουδάσατε βεβαίαν ὑμῶν τὴν κλῆσιν καὶ ἐκλογὴν ποιεῖσθαι· ταῦτα γὰρ ποιοῦντες οὐ μὴ πταίσητέ ποτε·","tokens":[{"text":"διὸ"},{"text":"μᾶλλον"},{"text":"ἀδελφοί"},{"text":"σπουδάσατε"},{"text":"βεβαίαν"},{"text":"ὑμῶν"},{"text":"τὴν"},{"text":"κλῆσιν"},{"text":"καὶ"},{"text":"ἐκλογὴν"},{"text":"ποιεῖσθαι"},{"text":"ταῦτα"},{"text":"γὰρ"},{"text":"ποιοῦντες"},{"text":"οὐ"},{"text":"μὴ"},{"text":"πταίσητέ"},{"text":"ποτε"}],"notes":[],"lang":"grc"},{"n":11,"text":"οὕτως γὰρ πλουσίως ἐπιχορηγηθήσεται ὑμῖν ἡ εἴσοδος εἰς τὴν αἰώνιον βασιλείαν τοῦ κυρίου ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ.","tokens":[{"text":"οὕτως"},{"text":"γὰρ"},{"text":"πλουσίως"},{"text":"ἐπιχορηγηθήσεται"},{"text":"ὑμῖν"},{"text":"ἡ"},{"text":"εἴσοδος"},{"text":"εἰς"},{"text":"τὴν"},{"text":"αἰώνιον"},{"text":"βασιλείαν"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"σωτῆρος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":12,"text":"Διὸ ⸀ μελλήσω ἀεὶ ὑμᾶς ὑπομιμνῄσκειν περὶ τούτων, καίπερ εἰδότας καὶ ἐστηριγμένους ἐν τῇ παρούσῃ ἀληθείᾳ.","tokens":[{"text":"Διὸ"},{"text":"μελλήσω"},{"text":"ἀεὶ"},{"text":"ὑμᾶς"},{"text":"ὑπομιμνῄσκειν"},{"text":"περὶ"},{"text":"τούτων"},{"text":"καίπερ"},{"text":"εἰδότας"},{"text":"καὶ"},{"text":"ἐστηριγμένους"},{"text":"ἐν"},{"text":"τῇ"},{"text":"παρούσῃ"},{"text":"ἀληθείᾳ"}],"notes":[],"lang":"grc"},{"n":13,"text":"δίκαιον δὲ ἡγοῦμαι, ἐφʼ ὅσον εἰμὶ ἐν τούτῳ τῷ σκηνώματι, διεγείρειν ὑμᾶς ἐν ὑπομνήσει,","tokens":[{"text":"δίκαιον"},{"text":"δὲ"},{"text":"ἡγοῦμαι"},{"text":"ἐφʼ"},{"text":"ὅσον"},{"text":"εἰμὶ"},{"text":"ἐν"},{"text":"τούτῳ"},{"text":"τῷ"},{"text":"σκηνώματι"},{"text":"διεγείρειν"},{"text":"ὑμᾶς"},{"text":"ἐν"},{"text":"ὑπομνήσει"}],"notes":[],"lang":"grc"},{"n":14,"text":"εἰδὼς ὅτι ταχινή ἐστιν ἡ ἀπόθεσις τοῦ σκηνώματός μου, καθὼς καὶ ὁ κύριος ἡμῶν Ἰησοῦς Χριστὸς ἐδήλωσέν μοι·","tokens":[{"text":"εἰδὼς"},{"text":"ὅτι"},{"text":"ταχινή"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"ἀπόθεσις"},{"text":"τοῦ"},{"text":"σκηνώματός"},{"text":"μου"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἡμῶν"},{"text":"Ἰησοῦς"},{"text":"Χριστὸς"},{"text":"ἐδήλωσέν"},{"text":"μοι"}],"notes":[],"lang":"grc"},{"n":15,"text":"σπουδάσω δὲ καὶ ἑκάστοτε ἔχειν ὑμᾶς μετὰ τὴν ἐμὴν ἔξοδον τὴν τούτων μνήμην ποιεῖσθαι.","tokens":[{"text":"σπουδάσω"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἑκάστοτε"},{"text":"ἔχειν"},{"text":"ὑμᾶς"},{"text":"μετὰ"},{"text":"τὴν"},{"text":"ἐμὴν"},{"text":"ἔξοδον"},{"text":"τὴν"},{"text":"τούτων"},{"text":"μνήμην"},{"text":"ποιεῖσθαι"}],"notes":[],"lang":"grc"},{"n":16,"text":"Οὐ γὰρ σεσοφισμένοις μύθοις ἐξακολουθήσαντες ἐγνωρίσαμεν ὑμῖν τὴν τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ δύναμιν καὶ παρουσίαν, ἀλλʼ ἐπόπται γενηθέντες τῆς ἐκείνου μεγαλειότητος.","tokens":[{"text":"Οὐ"},{"text":"γὰρ"},{"text":"σεσοφισμένοις"},{"text":"μύθοις"},{"text":"ἐξακολουθήσαντες"},{"text":"ἐγνωρίσαμεν"},{"text":"ὑμῖν"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"δύναμιν"},{"text":"καὶ"},{"text":"παρουσίαν"},{"text":"ἀλλʼ"},{"text":"ἐπόπται"},{"text":"γενηθέντες"},{"text":"τῆς"},{"text":"ἐκείνου"},{"text":"μεγαλειότητος"}],"notes":[],"lang":"grc"},{"n":17,"text":"λαβὼν γὰρ παρὰ θεοῦ πατρὸς τιμὴν καὶ δόξαν φωνῆς ἐνεχθείσης αὐτῷ τοιᾶσδε ὑπὸ τῆς μεγαλοπρεποῦς δόξης·  ⸂ Ὁ υἱός μου ὁ ἀγαπητός μου οὗτός ἐστιν⸃, εἰς ὃν ἐγὼ εὐδόκησα—","tokens":[{"text":"λαβὼν"},{"text":"γὰρ"},{"text":"παρὰ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"τιμὴν"},{"text":"καὶ"},{"text":"δόξαν"},{"text":"φωνῆς"},{"text":"ἐνεχθείσης"},{"text":"αὐτῷ"},{"text":"τοιᾶσδε"},{"text":"ὑπὸ"},{"text":"τῆς"},{"text":"μεγαλοπρεποῦς"},{"text":"δόξης"},{"text":"Ὁ"},{"text":"υἱός"},{"text":"μου"},{"text":"ὁ"},{"text":"ἀγαπητός"},{"text":"μου"},{"text":"οὗτός"},{"text":"ἐστιν"},{"text":"εἰς"},{"text":"ὃν"},{"text":"ἐγὼ"},{"text":"εὐδόκησα"}],"notes":[],"lang":"grc"},{"n":18,"text":"καὶ ταύτην τὴν φωνὴν ἡμεῖς ἠκούσαμεν ἐξ οὐρανοῦ ἐνεχθεῖσαν σὺν αὐτῷ ὄντες ἐν τῷ ⸂ ἁγίῳ ὄρει⸃.","tokens":[{"text":"καὶ"},{"text":"ταύτην"},{"text":"τὴν"},{"text":"φωνὴν"},{"text":"ἡμεῖς"},{"text":"ἠκούσαμεν"},{"text":"ἐξ"},{"text":"οὐρανοῦ"},{"text":"ἐνεχθεῖσαν"},{"text":"σὺν"},{"text":"αὐτῷ"},{"text":"ὄντες"},{"text":"ἐν"},{"text":"τῷ"},{"text":"ἁγίῳ"},{"text":"ὄρει"}],"notes":[],"lang":"grc"},{"n":19,"text":"καὶ ἔχομεν βεβαιότερον τὸν προφητικὸν λόγον, ᾧ καλῶς ποιεῖτε προσέχοντες ὡς λύχνῳ φαίνοντι ἐν αὐχμηρῷ τόπῳ, ἕως οὗ ἡμέρα διαυγάσῃ καὶ φωσφόρος ἀνατείλῃ ἐν ταῖς καρδίαις ὑμῶν·","tokens":[{"text":"καὶ"},{"text":"ἔχομεν"},{"text":"βεβαιότερον"},{"text":"τὸν"},{"text":"προφητικὸν"},{"text":"λόγον"},{"text":"ᾧ"},{"text":"καλῶς"},{"text":"ποιεῖτε"},{"text":"προσέχοντες"},{"text":"ὡς"},{"text":"λύχνῳ"},{"text":"φαίνοντι"},{"text":"ἐν"},{"text":"αὐχμηρῷ"},{"text":"τόπῳ"},{"text":"ἕως"},{"text":"οὗ"},{"text":"ἡμέρα"},{"text":"διαυγάσῃ"},{"text":"καὶ"},{"text":"φωσφόρος"},{"text":"ἀνατείλῃ"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"καρδίαις"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":20,"text":"τοῦτο πρῶτον γινώσκοντες ὅτι πᾶσα προφητεία γραφῆς ἰδίας ἐπιλύσεως οὐ γίνεται,","tokens":[{"text":"τοῦτο"},{"text":"πρῶτον"},{"text":"γινώσκοντες"},{"text":"ὅτι"},{"text":"πᾶσα"},{"text":"προφητεία"},{"text":"γραφῆς"},{"text":"ἰδίας"},{"text":"ἐπιλύσεως"},{"text":"οὐ"},{"text":"γίνεται"}],"notes":[],"lang":"grc"},{"n":21,"text":"οὐ γὰρ θελήματι ἀνθρώπου ἠνέχθη ⸂ προφητεία ποτέ⸃, ἀλλὰ ὑπὸ πνεύματος ἁγίου φερόμενοι ἐλάλησαν ⸀ ἀπὸ θεοῦ ἄνθρωποι.","tokens":[{"text":"οὐ"},{"text":"γὰρ"},{"text":"θελήματι"},{"text":"ἀνθρώπου"},{"text":"ἠνέχθη"},{"text":"προφητεία"},{"text":"ποτέ"},{"text":"ἀλλὰ"},{"text":"ὑπὸ"},{"text":"πνεύματος"},{"text":"ἁγίου"},{"text":"φερόμενοι"},{"text":"ἐλάλησαν"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"ἄνθρωποι"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Ἐγένοντο δὲ καὶ ψευδοπροφῆται ἐν τῷ λαῷ, ὡς καὶ ἐν ὑμῖν ἔσονται ψευδοδιδάσκαλοι, οἵτινες παρεισάξουσιν αἱρέσεις ἀπωλείας, καὶ τὸν ἀγοράσαντα αὐτοὺς δεσπότην ἀρνούμενοι, ἐπάγοντες ἑαυτοῖς ταχινὴν ἀπώλειαν·","tokens":[{"text":"Ἐγένοντο"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ψευδοπροφῆται"},{"text":"ἐν"},{"text":"τῷ"},{"text":"λαῷ"},{"text":"ὡς"},{"text":"καὶ"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἔσονται"},{"text":"ψευδοδιδάσκαλοι"},{"text":"οἵτινες"},{"text":"παρεισάξουσιν"},{"text":"αἱρέσεις"},{"text":"ἀπωλείας"},{"text":"καὶ"},{"text":"τὸν"},{"text":"ἀγοράσαντα"},{"text":"αὐτοὺς"},{"text":"δεσπότην"},{"text":"ἀρνούμενοι"},{"text":"ἐπάγοντες"},{"text":"ἑαυτοῖς"},{"text":"ταχινὴν"},{"text":"ἀπώλειαν"}],"notes":[],"lang":"grc"},{"n":2,"text":"καὶ πολλοὶ ἐξακολουθήσουσιν αὐτῶν ταῖς ἀσελγείαις, διʼ οὓς ἡ ὁδὸς τῆς ἀληθείας βλασφημηθήσεται·","tokens":[{"text":"καὶ"},{"text":"πολλοὶ"},{"text":"ἐξακολουθήσουσιν"},{"text":"αὐτῶν"},{"text":"ταῖς"},{"text":"ἀσελγείαις"},{"text":"διʼ"},{"text":"οὓς"},{"text":"ἡ"},{"text":"ὁδὸς"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"βλασφημηθήσεται"}],"notes":[],"lang":"grc"},{"n":3,"text":"καὶ ἐν πλεονεξίᾳ πλαστοῖς λόγοις ὑμᾶς ἐμπορεύσονται· οἷς τὸ κρίμα ἔκπαλαι οὐκ ἀργεῖ, καὶ ἡ ἀπώλεια αὐτῶν οὐ ⸀ νυστάζει.","tokens":[{"text":"καὶ"},{"text":"ἐν"},{"text":"πλεονεξίᾳ"},{"text":"πλαστοῖς"},{"text":"λόγοις"},{"text":"ὑμᾶς"},{"text":"ἐμπορεύσονται"},{"text":"οἷς"},{"text":"τὸ"},{"text":"κρίμα"},{"text":"ἔκπαλαι"},{"text":"οὐκ"},{"text":"ἀργεῖ"},{"text":"καὶ"},{"text":"ἡ"},{"text":"ἀπώλεια"},{"text":"αὐτῶν"},{"text":"οὐ"},{"text":"νυστάζει"}],"notes":[],"lang":"grc"},{"n":4,"text":"Εἰ γὰρ ὁ θεὸς ἀγγέλων ἁμαρτησάντων οὐκ ἐφείσατο, ἀλλὰ ⸀ σειραῖς ζόφου ταρταρώσας παρέδωκεν εἰς κρίσιν τηρουμένους,","tokens":[{"text":"Εἰ"},{"text":"γὰρ"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἀγγέλων"},{"text":"ἁμαρτησάντων"},{"text":"οὐκ"},{"text":"ἐφείσατο"},{"text":"ἀλλὰ"},{"text":"σειραῖς"},{"text":"ζόφου"},{"text":"ταρταρώσας"},{"text":"παρέδωκεν"},{"text":"εἰς"},{"text":"κρίσιν"},{"text":"τηρουμένους"}],"notes":[],"lang":"grc"},{"n":5,"text":"καὶ ἀρχαίου κόσμου οὐκ ἐφείσατο, ἀλλὰ ὄγδοον Νῶε δικαιοσύνης κήρυκα ἐφύλαξεν, κατακλυσμὸν κόσμῳ ἀσεβῶν ἐπάξας,","tokens":[{"text":"καὶ"},{"text":"ἀρχαίου"},{"text":"κόσμου"},{"text":"οὐκ"},{"text":"ἐφείσατο"},{"text":"ἀλλὰ"},{"text":"ὄγδοον"},{"text":"Νῶε"},{"text":"δικαιοσύνης"},{"text":"κήρυκα"},{"text":"ἐφύλαξεν"},{"text":"κατακλυσμὸν"},{"text":"κόσμῳ"},{"text":"ἀσεβῶν"},{"text":"ἐπάξας"}],"notes":[],"lang":"grc"},{"n":6,"text":"καὶ πόλεις Σοδόμων καὶ Γομόρρας τεφρώσας ⸀ καταστροφῇ κατέκρινεν, ὑπόδειγμα μελλόντων ⸀ ἀσεβέσιν τεθεικώς,","tokens":[{"text":"καὶ"},{"text":"πόλεις"},{"text":"Σοδόμων"},{"text":"καὶ"},{"text":"Γομόρρας"},{"text":"τεφρώσας"},{"text":"καταστροφῇ"},{"text":"κατέκρινεν"},{"text":"ὑπόδειγμα"},{"text":"μελλόντων"},{"text":"ἀσεβέσιν"},{"text":"τεθεικώς"}],"notes":[],"lang":"grc"},{"n":7,"text":"καὶ δίκαιον Λὼτ καταπονούμενον ὑπὸ τῆς τῶν ἀθέσμων ἐν ἀσελγείᾳ ἀναστροφῆς ἐρρύσατο—","tokens":[{"text":"καὶ"},{"text":"δίκαιον"},{"text":"Λὼτ"},{"text":"καταπονούμενον"},{"text":"ὑπὸ"},{"text":"τῆς"},{"text":"τῶν"},{"text":"ἀθέσμων"},{"text":"ἐν"},{"text":"ἀσελγείᾳ"},{"text":"ἀναστροφῆς"},{"text":"ἐρρύσατο"}],"notes":[],"lang":"grc"},{"n":8,"text":"βλέμματι γὰρ καὶ ἀκοῇ ⸀ ὁ δίκαιος ἐγκατοικῶν ἐν αὐτοῖς ἡμέραν ἐξ ἡμέρας ψυχὴν δικαίαν ἀνόμοις ἔργοις ἐβασάνιζεν—","tokens":[{"text":"βλέμματι"},{"text":"γὰρ"},{"text":"καὶ"},{"text":"ἀκοῇ"},{"text":"ὁ"},{"text":"δίκαιος"},{"text":"ἐγκατοικῶν"},{"text":"ἐν"},{"text":"αὐτοῖς"},{"text":"ἡμέραν"},{"text":"ἐξ"},{"text":"ἡμέρας"},{"text":"ψυχὴν"},{"text":"δικαίαν"},{"text":"ἀνόμοις"},{"text":"ἔργοις"},{"text":"ἐβασάνιζεν"}],"notes":[],"lang":"grc"},{"n":9,"text":"οἶδεν κύριος εὐσεβεῖς ἐκ πειρασμοῦ ῥύεσθαι, ἀδίκους δὲ εἰς ἡμέραν κρίσεως κολαζομένους τηρεῖν,","tokens":[{"text":"οἶδεν"},{"text":"κύριος"},{"text":"εὐσεβεῖς"},{"text":"ἐκ"},{"text":"πειρασμοῦ"},{"text":"ῥύεσθαι"},{"text":"ἀδίκους"},{"text":"δὲ"},{"text":"εἰς"},{"text":"ἡμέραν"},{"text":"κρίσεως"},{"text":"κολαζομένους"},{"text":"τηρεῖν"}],"notes":[],"lang":"grc"},{"n":10,"text":"μάλιστα δὲ τοὺς ὀπίσω σαρκὸς ἐν ἐπιθυμίᾳ μιασμοῦ πορευομένους καὶ κυριότητος καταφρονοῦντας. Τολμηταί, αὐθάδεις, δόξας οὐ τρέμουσιν, βλασφημοῦντες,","tokens":[{"text":"μάλιστα"},{"text":"δὲ"},{"text":"τοὺς"},{"text":"ὀπίσω"},{"text":"σαρκὸς"},{"text":"ἐν"},{"text":"ἐπιθυμίᾳ"},{"text":"μιασμοῦ"},{"text":"πορευομένους"},{"text":"καὶ"},{"text":"κυριότητος"},{"text":"καταφρονοῦντας"},{"text":"Τολμηταί"},{"text":"αὐθάδεις"},{"text":"δόξας"},{"text":"οὐ"},{"text":"τρέμουσιν"},{"text":"βλασφημοῦντες"}],"notes":[],"lang":"grc"},{"n":11,"text":"ὅπου ἄγγελοι ἰσχύϊ καὶ δυνάμει μείζονες ὄντες οὐ φέρουσιν κατʼ ⸀ αὐτῶν βλάσφημον κρίσιν.","tokens":[{"text":"ὅπου"},{"text":"ἄγγελοι"},{"text":"ἰσχύϊ"},{"text":"καὶ"},{"text":"δυνάμει"},{"text":"μείζονες"},{"text":"ὄντες"},{"text":"οὐ"},{"text":"φέρουσιν"},{"text":"κατʼ"},{"text":"αὐτῶν"},{"text":"βλάσφημον"},{"text":"κρίσιν"}],"notes":[],"lang":"grc"},{"n":12,"text":"οὗτοι δέ, ὡς ἄλογα ζῷα ⸂ γεγεννημένα φυσικὰ⸃ εἰς ἅλωσιν καὶ φθοράν, ἐν οἷς ἀγνοοῦσιν βλασφημοῦντες, ἐν τῇ φθορᾷ αὐτῶν ⸂ καὶ φθαρήσονται⸃,","tokens":[{"text":"οὗτοι"},{"text":"δέ"},{"text":"ὡς"},{"text":"ἄλογα"},{"text":"ζῷα"},{"text":"γεγεννημένα"},{"text":"φυσικὰ"},{"text":"εἰς"},{"text":"ἅλωσιν"},{"text":"καὶ"},{"text":"φθοράν"},{"text":"ἐν"},{"text":"οἷς"},{"text":"ἀγνοοῦσιν"},{"text":"βλασφημοῦντες"},{"text":"ἐν"},{"text":"τῇ"},{"text":"φθορᾷ"},{"text":"αὐτῶν"},{"text":"καὶ"},{"text":"φθαρήσονται"}],"notes":[],"lang":"grc"},{"n":13,"text":"⸀ ἀδικούμενοι μισθὸν ἀδικίας· ἡδονὴν ἡγούμενοι τὴν ἐν ἡμέρᾳ τρυφήν, σπίλοι καὶ μῶμοι ἐντρυφῶντες ἐν ταῖς ⸀ ἀπάταις αὐτῶν συνευωχούμενοι ὑμῖν,","tokens":[{"text":"ἀδικούμενοι"},{"text":"μισθὸν"},{"text":"ἀδικίας"},{"text":"ἡδονὴν"},{"text":"ἡγούμενοι"},{"text":"τὴν"},{"text":"ἐν"},{"text":"ἡμέρᾳ"},{"text":"τρυφήν"},{"text":"σπίλοι"},{"text":"καὶ"},{"text":"μῶμοι"},{"text":"ἐντρυφῶντες"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"ἀπάταις"},{"text":"αὐτῶν"},{"text":"συνευωχούμενοι"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":14,"text":"ὀφθαλμοὺς ἔχοντες μεστοὺς μοιχαλίδος καὶ ⸀ ἀκαταπαύστους ἁμαρτίας, δελεάζοντες ψυχὰς ἀστηρίκτους, καρδίαν γεγυμνασμένην πλεονεξίας ἔχοντες, κατάρας τέκνα,","tokens":[{"text":"ὀφθαλμοὺς"},{"text":"ἔχοντες"},{"text":"μεστοὺς"},{"text":"μοιχαλίδος"},{"text":"καὶ"},{"text":"ἀκαταπαύστους"},{"text":"ἁμαρτίας"},{"text":"δελεάζοντες"},{"text":"ψυχὰς"},{"text":"ἀστηρίκτους"},{"text":"καρδίαν"},{"text":"γεγυμνασμένην"},{"text":"πλεονεξίας"},{"text":"ἔχοντες"},{"text":"κατάρας"},{"text":"τέκνα"}],"notes":[],"lang":"grc"},{"n":15,"text":"⸀ καταλιπόντες εὐθεῖαν ὁδὸν ἐπλανήθησαν, ἐξακολουθήσαντες τῇ ὁδῷ τοῦ Βαλαὰμ τοῦ ⸀ Βοσὸρ ὃς μισθὸν ἀδικίας ἠγάπησεν","tokens":[{"text":"καταλιπόντες"},{"text":"εὐθεῖαν"},{"text":"ὁδὸν"},{"text":"ἐπλανήθησαν"},{"text":"ἐξακολουθήσαντες"},{"text":"τῇ"},{"text":"ὁδῷ"},{"text":"τοῦ"},{"text":"Βαλαὰμ"},{"text":"τοῦ"},{"text":"Βοσὸρ"},{"text":"ὃς"},{"text":"μισθὸν"},{"text":"ἀδικίας"},{"text":"ἠγάπησεν"}],"notes":[],"lang":"grc"},{"n":16,"text":"ἔλεγξιν δὲ ἔσχεν ἰδίας παρανομίας· ὑποζύγιον ἄφωνον ἐν ἀνθρώπου φωνῇ φθεγξάμενον ἐκώλυσεν τὴν τοῦ προφήτου παραφρονίαν.","tokens":[{"text":"ἔλεγξιν"},{"text":"δὲ"},{"text":"ἔσχεν"},{"text":"ἰδίας"},{"text":"παρανομίας"},{"text":"ὑποζύγιον"},{"text":"ἄφωνον"},{"text":"ἐν"},{"text":"ἀνθρώπου"},{"text":"φωνῇ"},{"text":"φθεγξάμενον"},{"text":"ἐκώλυσεν"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"προφήτου"},{"text":"παραφρονίαν"}],"notes":[],"lang":"grc"},{"n":17,"text":"Οὗτοί εἰσιν πηγαὶ ἄνυδροι ⸂ καὶ ὁμίχλαι⸃ ὑπὸ λαίλαπος ἐλαυνόμεναι, οἷς ὁ ζόφος τοῦ ⸀ σκότους τετήρηται.","tokens":[{"text":"Οὗτοί"},{"text":"εἰσιν"},{"text":"πηγαὶ"},{"text":"ἄνυδροι"},{"text":"καὶ"},{"text":"ὁμίχλαι"},{"text":"ὑπὸ"},{"text":"λαίλαπος"},{"text":"ἐλαυνόμεναι"},{"text":"οἷς"},{"text":"ὁ"},{"text":"ζόφος"},{"text":"τοῦ"},{"text":"σκότους"},{"text":"τετήρηται"}],"notes":[],"lang":"grc"},{"n":18,"text":"ὑπέρογκα γὰρ ματαιότητος φθεγγόμενοι δελεάζουσιν ἐν ἐπιθυμίαις σαρκὸς ἀσελγείαις τοὺς ⸀ ὀλίγως ⸀ ἀποφεύγοντας τοὺς ἐν πλάνῃ ἀναστρεφομένους,","tokens":[{"text":"ὑπέρογκα"},{"text":"γὰρ"},{"text":"ματαιότητος"},{"text":"φθεγγόμενοι"},{"text":"δελεάζουσιν"},{"text":"ἐν"},{"text":"ἐπιθυμίαις"},{"text":"σαρκὸς"},{"text":"ἀσελγείαις"},{"text":"τοὺς"},{"text":"ὀλίγως"},{"text":"ἀποφεύγοντας"},{"text":"τοὺς"},{"text":"ἐν"},{"text":"πλάνῃ"},{"text":"ἀναστρεφομένους"}],"notes":[],"lang":"grc"},{"n":19,"text":"ἐλευθερίαν αὐτοῖς ἐπαγγελλόμενοι, αὐτοὶ δοῦλοι ὑπάρχοντες τῆς φθορᾶς· ᾧ γάρ τις ἥττηται, τούτῳ ⸀ καὶ δεδούλωται.","tokens":[{"text":"ἐλευθερίαν"},{"text":"αὐτοῖς"},{"text":"ἐπαγγελλόμενοι"},{"text":"αὐτοὶ"},{"text":"δοῦλοι"},{"text":"ὑπάρχοντες"},{"text":"τῆς"},{"text":"φθορᾶς"},{"text":"ᾧ"},{"text":"γάρ"},{"text":"τις"},{"text":"ἥττηται"},{"text":"τούτῳ"},{"text":"καὶ"},{"text":"δεδούλωται"}],"notes":[],"lang":"grc"},{"n":20,"text":"εἰ γὰρ ἀποφυγόντες τὰ μιάσματα τοῦ κόσμου ἐν ἐπιγνώσει τοῦ ⸀ κυρίου καὶ σωτῆρος Ἰησοῦ Χριστοῦ τούτοις δὲ πάλιν ἐμπλακέντες ἡττῶνται, γέγονεν αὐτοῖς τὰ ἔσχατα χείρονα τῶν πρώτων.","tokens":[{"text":"εἰ"},{"text":"γὰρ"},{"text":"ἀποφυγόντες"},{"text":"τὰ"},{"text":"μιάσματα"},{"text":"τοῦ"},{"text":"κόσμου"},{"text":"ἐν"},{"text":"ἐπιγνώσει"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"καὶ"},{"text":"σωτῆρος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τούτοις"},{"text":"δὲ"},{"text":"πάλιν"},{"text":"ἐμπλακέντες"},{"text":"ἡττῶνται"},{"text":"γέγονεν"},{"text":"αὐτοῖς"},{"text":"τὰ"},{"text":"ἔσχατα"},{"text":"χείρονα"},{"text":"τῶν"},{"text":"πρώτων"}],"notes":[],"lang":"grc"},{"n":21,"text":"κρεῖττον γὰρ ἦν αὐτοῖς μὴ ἐπεγνωκέναι τὴν ὁδὸν τῆς δικαιοσύνης ἢ ἐπιγνοῦσιν ⸀ ὑποστρέψαι ἐκ τῆς παραδοθείσης αὐτοῖς ἁγίας ἐντολῆς·","tokens":[{"text":"κρεῖττον"},{"text":"γὰρ"},{"text":"ἦν"},{"text":"αὐτοῖς"},{"text":"μὴ"},{"text":"ἐπεγνωκέναι"},{"text":"τὴν"},{"text":"ὁδὸν"},{"text":"τῆς"},{"text":"δικαιοσύνης"},{"text":"ἢ"},{"text":"ἐπιγνοῦσιν"},{"text":"ὑποστρέψαι"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"παραδοθείσης"},{"text":"αὐτοῖς"},{"text":"ἁγίας"},{"text":"ἐντολῆς"}],"notes":[],"lang":"grc"},{"n":22,"text":"⸀ συμβέβηκεν αὐτοῖς τὸ τῆς ἀληθοῦς παροιμίας· Κύων ἐπιστρέψας ἐπὶ τὸ ἴδιον ἐξέραμα, καί· Ὗς λουσαμένη εἰς ⸀ κυλισμὸν βορβόρου.","tokens":[{"text":"συμβέβηκεν"},{"text":"αὐτοῖς"},{"text":"τὸ"},{"text":"τῆς"},{"text":"ἀληθοῦς"},{"text":"παροιμίας"},{"text":"Κύων"},{"text":"ἐπιστρέψας"},{"text":"ἐπὶ"},{"text":"τὸ"},{"text":"ἴδιον"},{"text":"ἐξέραμα"},{"text":"καί"},{"text":"Ὗς"},{"text":"λουσαμένη"},{"text":"εἰς"},{"text":"κυλισμὸν"},{"text":"βορβόρου"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Ταύτην ἤδη, ἀγαπητοί, δευτέραν ὑμῖν γράφω ἐπιστολήν, ἐν αἷς διεγείρω ὑμῶν ἐν ὑπομνήσει τὴν εἰλικρινῆ διάνοιαν,","tokens":[{"text":"Ταύτην"},{"text":"ἤδη"},{"text":"ἀγαπητοί"},{"text":"δευτέραν"},{"text":"ὑμῖν"},{"text":"γράφω"},{"text":"ἐπιστολήν"},{"text":"ἐν"},{"text":"αἷς"},{"text":"διεγείρω"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"ὑπομνήσει"},{"text":"τὴν"},{"text":"εἰλικρινῆ"},{"text":"διάνοιαν"}],"notes":[],"lang":"grc"},{"n":2,"text":"μνησθῆναι τῶν προειρημένων ῥημάτων ὑπὸ τῶν ἁγίων προφητῶν καὶ τῆς τῶν ἀποστόλων ὑμῶν ἐντολῆς τοῦ κυρίου καὶ σωτῆρος,","tokens":[{"text":"μνησθῆναι"},{"text":"τῶν"},{"text":"προειρημένων"},{"text":"ῥημάτων"},{"text":"ὑπὸ"},{"text":"τῶν"},{"text":"ἁγίων"},{"text":"προφητῶν"},{"text":"καὶ"},{"text":"τῆς"},{"text":"τῶν"},{"text":"ἀποστόλων"},{"text":"ὑμῶν"},{"text":"ἐντολῆς"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"καὶ"},{"text":"σωτῆρος"}],"notes":[],"lang":"grc"},{"n":3,"text":"τοῦτο πρῶτον γινώσκοντες ὅτι ἐλεύσονται ἐπʼ ⸀ ἐσχάτων τῶν ἡμερῶν ⸂ ἐν ἐμπαιγμονῇ⸃ ἐμπαῖκται κατὰ τὰς ἰδίας ἐπιθυμίας αὐτῶν πορευόμενοι","tokens":[{"text":"τοῦτο"},{"text":"πρῶτον"},{"text":"γινώσκοντες"},{"text":"ὅτι"},{"text":"ἐλεύσονται"},{"text":"ἐπʼ"},{"text":"ἐσχάτων"},{"text":"τῶν"},{"text":"ἡμερῶν"},{"text":"ἐν"},{"text":"ἐμπαιγμονῇ"},{"text":"ἐμπαῖκται"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"ἰδίας"},{"text":"ἐπιθυμίας"},{"text":"αὐτῶν"},{"text":"πορευόμενοι"}],"notes":[],"lang":"grc"},{"n":4,"text":"καὶ λέγοντες· Ποῦ ἐστιν ἡ ἐπαγγελία τῆς παρουσίας αὐτοῦ; ἀφʼ ἧς γὰρ οἱ πατέρες ἐκοιμήθησαν, πάντα οὕτως διαμένει ἀπʼ ἀρχῆς κτίσεως.","tokens":[{"text":"καὶ"},{"text":"λέγοντες"},{"text":"Ποῦ"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"ἐπαγγελία"},{"text":"τῆς"},{"text":"παρουσίας"},{"text":"αὐτοῦ"},{"text":"ἀφʼ"},{"text":"ἧς"},{"text":"γὰρ"},{"text":"οἱ"},{"text":"πατέρες"},{"text":"ἐκοιμήθησαν"},{"text":"πάντα"},{"text":"οὕτως"},{"text":"διαμένει"},{"text":"ἀπʼ"},{"text":"ἀρχῆς"},{"text":"κτίσεως"}],"notes":[],"lang":"grc"},{"n":5,"text":"λανθάνει γὰρ αὐτοὺς τοῦτο θέλοντας ὅτι οὐρανοὶ ἦσαν ἔκπαλαι καὶ γῆ ἐξ ὕδατος καὶ διʼ ὕδατος συνεστῶσα τῷ τοῦ θεοῦ λόγῳ,","tokens":[{"text":"λανθάνει"},{"text":"γὰρ"},{"text":"αὐτοὺς"},{"text":"τοῦτο"},{"text":"θέλοντας"},{"text":"ὅτι"},{"text":"οὐρανοὶ"},{"text":"ἦσαν"},{"text":"ἔκπαλαι"},{"text":"καὶ"},{"text":"γῆ"},{"text":"ἐξ"},{"text":"ὕδατος"},{"text":"καὶ"},{"text":"διʼ"},{"text":"ὕδατος"},{"text":"συνεστῶσα"},{"text":"τῷ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"λόγῳ"}],"notes":[],"lang":"grc"},{"n":6,"text":"⸂ διʼ ὧν⸃ ὁ τότε κόσμος ὕδατι κατακλυσθεὶς ἀπώλετο·","tokens":[{"text":"διʼ"},{"text":"ὧν"},{"text":"ὁ"},{"text":"τότε"},{"text":"κόσμος"},{"text":"ὕδατι"},{"text":"κατακλυσθεὶς"},{"text":"ἀπώλετο"}],"notes":[],"lang":"grc"},{"n":7,"text":"οἱ δὲ νῦν οὐρανοὶ καὶ ἡ γῆ τῷ ⸀ αὐτῷ λόγῳ τεθησαυρισμένοι εἰσὶν πυρὶ τηρούμενοι εἰς ἡμέραν κρίσεως καὶ ἀπωλείας τῶν ἀσεβῶν ἀνθρώπων.","tokens":[{"text":"οἱ"},{"text":"δὲ"},{"text":"νῦν"},{"text":"οὐρανοὶ"},{"text":"καὶ"},{"text":"ἡ"},{"text":"γῆ"},{"text":"τῷ"},{"text":"αὐτῷ"},{"text":"λόγῳ"},{"text":"τεθησαυρισμένοι"},{"text":"εἰσὶν"},{"text":"πυρὶ"},{"text":"τηρούμενοι"},{"text":"εἰς"},{"text":"ἡμέραν"},{"text":"κρίσεως"},{"text":"καὶ"},{"text":"ἀπωλείας"},{"text":"τῶν"},{"text":"ἀσεβῶν"},{"text":"ἀνθρώπων"}],"notes":[],"lang":"grc"},{"n":8,"text":"Ἓν δὲ τοῦτο μὴ λανθανέτω ὑμᾶς, ἀγαπητοί, ὅτι μία ἡμέρα παρὰ κυρίῳ ὡς χίλια ἔτη καὶ χίλια ἔτη ὡς ἡμέρα μία.","tokens":[{"text":"Ἓν"},{"text":"δὲ"},{"text":"τοῦτο"},{"text":"μὴ"},{"text":"λανθανέτω"},{"text":"ὑμᾶς"},{"text":"ἀγαπητοί"},{"text":"ὅτι"},{"text":"μία"},{"text":"ἡμέρα"},{"text":"παρὰ"},{"text":"κυρίῳ"},{"text":"ὡς"},{"text":"χίλια"},{"text":"ἔτη"},{"text":"καὶ"},{"text":"χίλια"},{"text":"ἔτη"},{"text":"ὡς"},{"text":"ἡμέρα"},{"text":"μία"}],"notes":[],"lang":"grc"},{"n":9,"text":"οὐ βραδύνει ⸀ κύριος τῆς ἐπαγγελίας, ὥς τινες βραδύτητα ἡγοῦνται, ἀλλὰ μακροθυμεῖ εἰς ⸀ ὑμᾶς, μὴ βουλόμενός τινας ἀπολέσθαι ἀλλὰ πάντας εἰς μετάνοιαν χωρῆσαι.","tokens":[{"text":"οὐ"},{"text":"βραδύνει"},{"text":"κύριος"},{"text":"τῆς"},{"text":"ἐπαγγελίας"},{"text":"ὥς"},{"text":"τινες"},{"text":"βραδύτητα"},{"text":"ἡγοῦνται"},{"text":"ἀλλὰ"},{"text":"μακροθυμεῖ"},{"text":"εἰς"},{"text":"ὑμᾶς"},{"text":"μὴ"},{"text":"βουλόμενός"},{"text":"τινας"},{"text":"ἀπολέσθαι"},{"text":"ἀλλὰ"},{"text":"πάντας"},{"text":"εἰς"},{"text":"μετάνοιαν"},{"text":"χωρῆσαι"}],"notes":[],"lang":"grc"},{"n":10,"text":"ἥξει δὲ ⸀ ἡμέρα κυρίου ὡς ⸀ κλέπτης, ἐν ᾗ οἱ οὐρανοὶ ῥοιζηδὸν παρελεύσονται, στοιχεῖα δὲ καυσούμενα ⸀ λυθήσεται, καὶ γῆ καὶ τὰ ἐν αὐτῇ ἔργα ⸀ εὑρεθήσεται.","tokens":[{"text":"ἥξει"},{"text":"δὲ"},{"text":"ἡμέρα"},{"text":"κυρίου"},{"text":"ὡς"},{"text":"κλέπτης"},{"text":"ἐν"},{"text":"ᾗ"},{"text":"οἱ"},{"text":"οὐρανοὶ"},{"text":"ῥοιζηδὸν"},{"text":"παρελεύσονται"},{"text":"στοιχεῖα"},{"text":"δὲ"},{"text":"καυσούμενα"},{"text":"λυθήσεται"},{"text":"καὶ"},{"text":"γῆ"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἐν"},{"text":"αὐτῇ"},{"text":"ἔργα"},{"text":"εὑρεθήσεται"}],"notes":[],"lang":"grc"},{"n":11,"text":"Τούτων ⸀ οὕτως πάντων λυομένων ποταποὺς δεῖ ὑπάρχειν ὑμᾶς ἐν ἁγίαις ἀναστροφαῖς καὶ εὐσεβείαις,","tokens":[{"text":"Τούτων"},{"text":"οὕτως"},{"text":"πάντων"},{"text":"λυομένων"},{"text":"ποταποὺς"},{"text":"δεῖ"},{"text":"ὑπάρχειν"},{"text":"ὑμᾶς"},{"text":"ἐν"},{"text":"ἁγίαις"},{"text":"ἀναστροφαῖς"},{"text":"καὶ"},{"text":"εὐσεβείαις"}],"notes":[],"lang":"grc"},{"n":12,"text":"προσδοκῶντας καὶ σπεύδοντας τὴν παρουσίαν τῆς τοῦ θεοῦ ἡμέρας, διʼ ἣν οὐρανοὶ πυρούμενοι λυθήσονται καὶ στοιχεῖα καυσούμενα τήκεται·","tokens":[{"text":"προσδοκῶντας"},{"text":"καὶ"},{"text":"σπεύδοντας"},{"text":"τὴν"},{"text":"παρουσίαν"},{"text":"τῆς"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἡμέρας"},{"text":"διʼ"},{"text":"ἣν"},{"text":"οὐρανοὶ"},{"text":"πυρούμενοι"},{"text":"λυθήσονται"},{"text":"καὶ"},{"text":"στοιχεῖα"},{"text":"καυσούμενα"},{"text":"τήκεται"}],"notes":[],"lang":"grc"},{"n":13,"text":"καινοὺς δὲ οὐρανοὺς καὶ γῆν καινὴν κατὰ τὸ ἐπάγγελμα αὐτοῦ προσδοκῶμεν, ἐν οἷς δικαιοσύνη κατοικεῖ.","tokens":[{"text":"καινοὺς"},{"text":"δὲ"},{"text":"οὐρανοὺς"},{"text":"καὶ"},{"text":"γῆν"},{"text":"καινὴν"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"ἐπάγγελμα"},{"text":"αὐτοῦ"},{"text":"προσδοκῶμεν"},{"text":"ἐν"},{"text":"οἷς"},{"text":"δικαιοσύνη"},{"text":"κατοικεῖ"}],"notes":[],"lang":"grc"},{"n":14,"text":"Διό, ἀγαπητοί, ταῦτα προσδοκῶντες σπουδάσατε ἄσπιλοι καὶ ἀμώμητοι αὐτῷ εὑρεθῆναι ἐν εἰρήνῃ,","tokens":[{"text":"Διό"},{"text":"ἀγαπητοί"},{"text":"ταῦτα"},{"text":"προσδοκῶντες"},{"text":"σπουδάσατε"},{"text":"ἄσπιλοι"},{"text":"καὶ"},{"text":"ἀμώμητοι"},{"text":"αὐτῷ"},{"text":"εὑρεθῆναι"},{"text":"ἐν"},{"text":"εἰρήνῃ"}],"notes":[],"lang":"grc"},{"n":15,"text":"καὶ τὴν τοῦ κυρίου ἡμῶν μακροθυμίαν σωτηρίαν ἡγεῖσθε, καθὼς καὶ ὁ ἀγαπητὸς ἡμῶν ἀδελφὸς Παῦλος κατὰ τὴν ⸂ δοθεῖσαν αὐτῷ⸃ σοφίαν ἔγραψεν ὑμῖν,","tokens":[{"text":"καὶ"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"μακροθυμίαν"},{"text":"σωτηρίαν"},{"text":"ἡγεῖσθε"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"ὁ"},{"text":"ἀγαπητὸς"},{"text":"ἡμῶν"},{"text":"ἀδελφὸς"},{"text":"Παῦλος"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"δοθεῖσαν"},{"text":"αὐτῷ"},{"text":"σοφίαν"},{"text":"ἔγραψεν"},{"text":"ὑμῖν"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὡς καὶ ἐν πάσαις ⸀ ταῖς ἐπιστολαῖς λαλῶν ἐν αὐταῖς περὶ τούτων, ἐν ⸀ αἷς ἐστιν δυσνόητά τινα, ἃ οἱ ἀμαθεῖς καὶ ἀστήρικτοι ⸀ στρεβλοῦσιν ὡς καὶ τὰς λοιπὰς γραφὰς πρὸς τὴν ἰδίαν αὐτῶν ἀπώλειαν.","tokens":[{"text":"ὡς"},{"text":"καὶ"},{"text":"ἐν"},{"text":"πάσαις"},{"text":"ταῖς"},{"text":"ἐπιστολαῖς"},{"text":"λαλῶν"},{"text":"ἐν"},{"text":"αὐταῖς"},{"text":"περὶ"},{"text":"τούτων"},{"text":"ἐν"},{"text":"αἷς"},{"text":"ἐστιν"},{"text":"δυσνόητά"},{"text":"τινα"},{"text":"ἃ"},{"text":"οἱ"},{"text":"ἀμαθεῖς"},{"text":"καὶ"},{"text":"ἀστήρικτοι"},{"text":"στρεβλοῦσιν"},{"text":"ὡς"},{"text":"καὶ"},{"text":"τὰς"},{"text":"λοιπὰς"},{"text":"γραφὰς"},{"text":"πρὸς"},{"text":"τὴν"},{"text":"ἰδίαν"},{"text":"αὐτῶν"},{"text":"ἀπώλειαν"}],"notes":[],"lang":"grc"},{"n":17,"text":"ὑμεῖς οὖν, ἀγαπητοί, προγινώσκοντες φυλάσσεσθε ἵνα μὴ τῇ τῶν ἀθέσμων πλάνῃ συναπαχθέντες ἐκπέσητε τοῦ ἰδίου στηριγμοῦ,","tokens":[{"text":"ὑμεῖς"},{"text":"οὖν"},{"text":"ἀγαπητοί"},{"text":"προγινώσκοντες"},{"text":"φυλάσσεσθε"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"τῇ"},{"text":"τῶν"},{"text":"ἀθέσμων"},{"text":"πλάνῃ"},{"text":"συναπαχθέντες"},{"text":"ἐκπέσητε"},{"text":"τοῦ"},{"text":"ἰδίου"},{"text":"στηριγμοῦ"}],"notes":[],"lang":"grc"},{"n":18,"text":"αὐξάνετε δὲ ἐν χάριτι καὶ γνώσει τοῦ κυρίου ἡμῶν καὶ σωτῆρος Ἰησοῦ Χριστοῦ. αὐτῷ ἡ δόξα καὶ νῦν καὶ εἰς ἡμέραν αἰῶνος.  ⸀ ἀμήν.","tokens":[{"text":"αὐξάνετε"},{"text":"δὲ"},{"text":"ἐν"},{"text":"χάριτι"},{"text":"καὶ"},{"text":"γνώσει"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"σωτῆρος"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"αὐτῷ"},{"text":"ἡ"},{"text":"δόξα"},{"text":"καὶ"},{"text":"νῦν"},{"text":"καὶ"},{"text":"εἰς"},{"text":"ἡμέραν"},{"text":"αἰῶνος"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"}]}}