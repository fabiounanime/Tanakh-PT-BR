{"book":{"id":"2Tim","name":"2 Timóteo","testament":"NT","source":"SBLGNT","chapters":4,"verses":83},"chapters":{"1":[{"n":1,"text":"Παῦλος ἀπόστολος ⸂ Χριστοῦ Ἰησοῦ⸃ διὰ θελήματος θεοῦ κατʼ ἐπαγγελίαν ζωῆς τῆς ἐν Χριστῷ Ἰησοῦ","tokens":[{"text":"Παῦλος"},{"text":"ἀπόστολος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"διὰ"},{"text":"θελήματος"},{"text":"θεοῦ"},{"text":"κατʼ"},{"text":"ἐπαγγελίαν"},{"text":"ζωῆς"},{"text":"τῆς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":2,"text":"Τιμοθέῳ ἀγαπητῷ τέκνῳ· χάρις, ἔλεος, εἰρήνη ἀπὸ θεοῦ πατρὸς καὶ Χριστοῦ Ἰησοῦ τοῦ κυρίου ἡμῶν.","tokens":[{"text":"Τιμοθέῳ"},{"text":"ἀγαπητῷ"},{"text":"τέκνῳ"},{"text":"χάρις"},{"text":"ἔλεος"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":3,"text":"Χάριν ἔχω τῷ θεῷ, ᾧ λατρεύω ἀπὸ προγόνων ἐν καθαρᾷ συνειδήσει, ὡς ἀδιάλειπτον ἔχω τὴν περὶ σοῦ μνείαν ἐν ταῖς δεήσεσίν μου, νυκτὸς καὶ ἡμέρας","tokens":[{"text":"Χάριν"},{"text":"ἔχω"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"ᾧ"},{"text":"λατρεύω"},{"text":"ἀπὸ"},{"text":"προγόνων"},{"text":"ἐν"},{"text":"καθαρᾷ"},{"text":"συνειδήσει"},{"text":"ὡς"},{"text":"ἀδιάλειπτον"},{"text":"ἔχω"},{"text":"τὴν"},{"text":"περὶ"},{"text":"σοῦ"},{"text":"μνείαν"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"δεήσεσίν"},{"text":"μου"},{"text":"νυκτὸς"},{"text":"καὶ"},{"text":"ἡμέρας"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἐπιποθῶν σε ἰδεῖν, μεμνημένος σου τῶν δακρύων, ἵνα χαρᾶς πληρωθῶ","tokens":[{"text":"ἐπιποθῶν"},{"text":"σε"},{"text":"ἰδεῖν"},{"text":"μεμνημένος"},{"text":"σου"},{"text":"τῶν"},{"text":"δακρύων"},{"text":"ἵνα"},{"text":"χαρᾶς"},{"text":"πληρωθῶ"}],"notes":[],"lang":"grc"},{"n":5,"text":"ὑπόμνησιν ⸀ λαβὼν τῆς ἐν σοὶ ἀνυποκρίτου πίστεως, ἥτις ἐνῴκησεν πρῶτον ἐν τῇ μάμμῃ σου Λωΐδι καὶ τῇ μητρί σου Εὐνίκῃ, πέπεισμαι δὲ ὅτι καὶ ἐν σοί.","tokens":[{"text":"ὑπόμνησιν"},{"text":"λαβὼν"},{"text":"τῆς"},{"text":"ἐν"},{"text":"σοὶ"},{"text":"ἀνυποκρίτου"},{"text":"πίστεως"},{"text":"ἥτις"},{"text":"ἐνῴκησεν"},{"text":"πρῶτον"},{"text":"ἐν"},{"text":"τῇ"},{"text":"μάμμῃ"},{"text":"σου"},{"text":"Λωΐδι"},{"text":"καὶ"},{"text":"τῇ"},{"text":"μητρί"},{"text":"σου"},{"text":"Εὐνίκῃ"},{"text":"πέπεισμαι"},{"text":"δὲ"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"ἐν"},{"text":"σοί"}],"notes":[],"lang":"grc"},{"n":6,"text":"διʼ ἣν αἰτίαν ἀναμιμνῄσκω σε ἀναζωπυρεῖν τὸ χάρισμα τοῦ θεοῦ, ὅ ἐστιν ἐν σοὶ διὰ τῆς ἐπιθέσεως τῶν χειρῶν μου·","tokens":[{"text":"διʼ"},{"text":"ἣν"},{"text":"αἰτίαν"},{"text":"ἀναμιμνῄσκω"},{"text":"σε"},{"text":"ἀναζωπυρεῖν"},{"text":"τὸ"},{"text":"χάρισμα"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"ἐν"},{"text":"σοὶ"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ἐπιθέσεως"},{"text":"τῶν"},{"text":"χειρῶν"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":7,"text":"οὐ γὰρ ἔδωκεν ἡμῖν ὁ θεὸς πνεῦμα δειλίας, ἀλλὰ δυνάμεως καὶ ἀγάπης καὶ σωφρονισμοῦ.","tokens":[{"text":"οὐ"},{"text":"γὰρ"},{"text":"ἔδωκεν"},{"text":"ἡμῖν"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"πνεῦμα"},{"text":"δειλίας"},{"text":"ἀλλὰ"},{"text":"δυνάμεως"},{"text":"καὶ"},{"text":"ἀγάπης"},{"text":"καὶ"},{"text":"σωφρονισμοῦ"}],"notes":[],"lang":"grc"},{"n":8,"text":"Μὴ οὖν ἐπαισχυνθῇς τὸ μαρτύριον τοῦ κυρίου ἡμῶν μηδὲ ἐμὲ τὸν δέσμιον αὐτοῦ, ἀλλὰ συγκακοπάθησον τῷ εὐαγγελίῳ κατὰ δύναμιν θεοῦ,","tokens":[{"text":"Μὴ"},{"text":"οὖν"},{"text":"ἐπαισχυνθῇς"},{"text":"τὸ"},{"text":"μαρτύριον"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"μηδὲ"},{"text":"ἐμὲ"},{"text":"τὸν"},{"text":"δέσμιον"},{"text":"αὐτοῦ"},{"text":"ἀλλὰ"},{"text":"συγκακοπάθησον"},{"text":"τῷ"},{"text":"εὐαγγελίῳ"},{"text":"κατὰ"},{"text":"δύναμιν"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"τοῦ σώσαντος ἡμᾶς καὶ καλέσαντος κλήσει ἁγίᾳ, οὐ κατὰ τὰ ἔργα ἡμῶν ἀλλὰ κατὰ ἰδίαν πρόθεσιν καὶ χάριν, τὴν δοθεῖσαν ἡμῖν ἐν Χριστῷ Ἰησοῦ πρὸ χρόνων αἰωνίων,","tokens":[{"text":"τοῦ"},{"text":"σώσαντος"},{"text":"ἡμᾶς"},{"text":"καὶ"},{"text":"καλέσαντος"},{"text":"κλήσει"},{"text":"ἁγίᾳ"},{"text":"οὐ"},{"text":"κατὰ"},{"text":"τὰ"},{"text":"ἔργα"},{"text":"ἡμῶν"},{"text":"ἀλλὰ"},{"text":"κατὰ"},{"text":"ἰδίαν"},{"text":"πρόθεσιν"},{"text":"καὶ"},{"text":"χάριν"},{"text":"τὴν"},{"text":"δοθεῖσαν"},{"text":"ἡμῖν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"πρὸ"},{"text":"χρόνων"},{"text":"αἰωνίων"}],"notes":[],"lang":"grc"},{"n":10,"text":"φανερωθεῖσαν δὲ νῦν διὰ τῆς ἐπιφανείας τοῦ σωτῆρος ἡμῶν ⸂ Ἰησοῦ Χριστοῦ⸃, καταργήσαντος μὲν τὸν θάνατον φωτίσαντος δὲ ζωὴν καὶ ἀφθαρσίαν διὰ τοῦ εὐαγγελίου,","tokens":[{"text":"φανερωθεῖσαν"},{"text":"δὲ"},{"text":"νῦν"},{"text":"διὰ"},{"text":"τῆς"},{"text":"ἐπιφανείας"},{"text":"τοῦ"},{"text":"σωτῆρος"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"καταργήσαντος"},{"text":"μὲν"},{"text":"τὸν"},{"text":"θάνατον"},{"text":"φωτίσαντος"},{"text":"δὲ"},{"text":"ζωὴν"},{"text":"καὶ"},{"text":"ἀφθαρσίαν"},{"text":"διὰ"},{"text":"τοῦ"},{"text":"εὐαγγελίου"}],"notes":[],"lang":"grc"},{"n":11,"text":"εἰς ὃ ἐτέθην ἐγὼ κῆρυξ καὶ ἀπόστολος καὶ ⸀ διδάσκαλος.","tokens":[{"text":"εἰς"},{"text":"ὃ"},{"text":"ἐτέθην"},{"text":"ἐγὼ"},{"text":"κῆρυξ"},{"text":"καὶ"},{"text":"ἀπόστολος"},{"text":"καὶ"},{"text":"διδάσκαλος"}],"notes":[],"lang":"grc"},{"n":12,"text":"διʼ ἣν αἰτίαν καὶ ταῦτα πάσχω, ἀλλʼ οὐκ ἐπαισχύνομαι, οἶδα γὰρ ᾧ πεπίστευκα, καὶ πέπεισμαι ὅτι δυνατός ἐστιν τὴν παραθήκην μου φυλάξαι εἰς ἐκείνην τὴν ἡμέραν.","tokens":[{"text":"διʼ"},{"text":"ἣν"},{"text":"αἰτίαν"},{"text":"καὶ"},{"text":"ταῦτα"},{"text":"πάσχω"},{"text":"ἀλλʼ"},{"text":"οὐκ"},{"text":"ἐπαισχύνομαι"},{"text":"οἶδα"},{"text":"γὰρ"},{"text":"ᾧ"},{"text":"πεπίστευκα"},{"text":"καὶ"},{"text":"πέπεισμαι"},{"text":"ὅτι"},{"text":"δυνατός"},{"text":"ἐστιν"},{"text":"τὴν"},{"text":"παραθήκην"},{"text":"μου"},{"text":"φυλάξαι"},{"text":"εἰς"},{"text":"ἐκείνην"},{"text":"τὴν"},{"text":"ἡμέραν"}],"notes":[],"lang":"grc"},{"n":13,"text":"ὑποτύπωσιν ἔχε ὑγιαινόντων λόγων ὧν παρʼ ἐμοῦ ἤκουσας ἐν πίστει καὶ ἀγάπῃ τῇ ἐν Χριστῷ Ἰησοῦ·","tokens":[{"text":"ὑποτύπωσιν"},{"text":"ἔχε"},{"text":"ὑγιαινόντων"},{"text":"λόγων"},{"text":"ὧν"},{"text":"παρʼ"},{"text":"ἐμοῦ"},{"text":"ἤκουσας"},{"text":"ἐν"},{"text":"πίστει"},{"text":"καὶ"},{"text":"ἀγάπῃ"},{"text":"τῇ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":14,"text":"τὴν καλὴν παραθήκην φύλαξον διὰ πνεύματος ἁγίου τοῦ ἐνοικοῦντος ἐν ἡμῖν.","tokens":[{"text":"τὴν"},{"text":"καλὴν"},{"text":"παραθήκην"},{"text":"φύλαξον"},{"text":"διὰ"},{"text":"πνεύματος"},{"text":"ἁγίου"},{"text":"τοῦ"},{"text":"ἐνοικοῦντος"},{"text":"ἐν"},{"text":"ἡμῖν"}],"notes":[],"lang":"grc"},{"n":15,"text":"Οἶδας τοῦτο ὅτι ἀπεστράφησάν με πάντες οἱ ἐν τῇ Ἀσίᾳ, ὧν ἐστιν Φύγελος καὶ Ἑρμογένης.","tokens":[{"text":"Οἶδας"},{"text":"τοῦτο"},{"text":"ὅτι"},{"text":"ἀπεστράφησάν"},{"text":"με"},{"text":"πάντες"},{"text":"οἱ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"Ἀσίᾳ"},{"text":"ὧν"},{"text":"ἐστιν"},{"text":"Φύγελος"},{"text":"καὶ"},{"text":"Ἑρμογένης"}],"notes":[],"lang":"grc"},{"n":16,"text":"δῴη ἔλεος ὁ κύριος τῷ Ὀνησιφόρου οἴκῳ, ὅτι πολλάκις με ἀνέψυξεν, καὶ τὴν ἅλυσίν μου οὐκ ἐπαισχύνθη·","tokens":[{"text":"δῴη"},{"text":"ἔλεος"},{"text":"ὁ"},{"text":"κύριος"},{"text":"τῷ"},{"text":"Ὀνησιφόρου"},{"text":"οἴκῳ"},{"text":"ὅτι"},{"text":"πολλάκις"},{"text":"με"},{"text":"ἀνέψυξεν"},{"text":"καὶ"},{"text":"τὴν"},{"text":"ἅλυσίν"},{"text":"μου"},{"text":"οὐκ"},{"text":"ἐπαισχύνθη"}],"notes":[],"lang":"grc"},{"n":17,"text":"ἀλλὰ γενόμενος ἐν Ῥώμῃ ⸀ σπουδαίως ἐζήτησέν με καὶ εὗρεν—","tokens":[{"text":"ἀλλὰ"},{"text":"γενόμενος"},{"text":"ἐν"},{"text":"Ῥώμῃ"},{"text":"σπουδαίως"},{"text":"ἐζήτησέν"},{"text":"με"},{"text":"καὶ"},{"text":"εὗρεν"}],"notes":[],"lang":"grc"},{"n":18,"text":"δῴη αὐτῷ ὁ κύριος εὑρεῖν ἔλεος παρὰ κυρίου ἐν ἐκείνῃ τῇ ἡμέρᾳ— καὶ ὅσα ἐν Ἐφέσῳ διηκόνησεν, βέλτιον σὺ γινώσκεις.","tokens":[{"text":"δῴη"},{"text":"αὐτῷ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"εὑρεῖν"},{"text":"ἔλεος"},{"text":"παρὰ"},{"text":"κυρίου"},{"text":"ἐν"},{"text":"ἐκείνῃ"},{"text":"τῇ"},{"text":"ἡμέρᾳ"},{"text":"καὶ"},{"text":"ὅσα"},{"text":"ἐν"},{"text":"Ἐφέσῳ"},{"text":"διηκόνησεν"},{"text":"βέλτιον"},{"text":"σὺ"},{"text":"γινώσκεις"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Σὺ οὖν, τέκνον μου, ἐνδυναμοῦ ἐν τῇ χάριτι τῇ ἐν Χριστῷ Ἰησοῦ,","tokens":[{"text":"Σὺ"},{"text":"οὖν"},{"text":"τέκνον"},{"text":"μου"},{"text":"ἐνδυναμοῦ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"χάριτι"},{"text":"τῇ"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":2,"text":"καὶ ἃ ἤκουσας παρʼ ἐμοῦ διὰ πολλῶν μαρτύρων, ταῦτα παράθου πιστοῖς ἀνθρώποις, οἵτινες ἱκανοὶ ἔσονται καὶ ἑτέρους διδάξαι.","tokens":[{"text":"καὶ"},{"text":"ἃ"},{"text":"ἤκουσας"},{"text":"παρʼ"},{"text":"ἐμοῦ"},{"text":"διὰ"},{"text":"πολλῶν"},{"text":"μαρτύρων"},{"text":"ταῦτα"},{"text":"παράθου"},{"text":"πιστοῖς"},{"text":"ἀνθρώποις"},{"text":"οἵτινες"},{"text":"ἱκανοὶ"},{"text":"ἔσονται"},{"text":"καὶ"},{"text":"ἑτέρους"},{"text":"διδάξαι"}],"notes":[],"lang":"grc"},{"n":3,"text":"⸀ συγκακοπάθησον ὡς καλὸς στρατιώτης ⸂ Χριστοῦ Ἰησοῦ⸃.","tokens":[{"text":"συγκακοπάθησον"},{"text":"ὡς"},{"text":"καλὸς"},{"text":"στρατιώτης"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":4,"text":"οὐδεὶς στρατευόμενος ἐμπλέκεται ταῖς τοῦ βίου πραγματείαις, ἵνα τῷ στρατολογήσαντι ἀρέσῃ·","tokens":[{"text":"οὐδεὶς"},{"text":"στρατευόμενος"},{"text":"ἐμπλέκεται"},{"text":"ταῖς"},{"text":"τοῦ"},{"text":"βίου"},{"text":"πραγματείαις"},{"text":"ἵνα"},{"text":"τῷ"},{"text":"στρατολογήσαντι"},{"text":"ἀρέσῃ"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἐὰν δὲ καὶ ἀθλῇ τις, οὐ στεφανοῦται ἐὰν μὴ νομίμως ἀθλήσῃ·","tokens":[{"text":"ἐὰν"},{"text":"δὲ"},{"text":"καὶ"},{"text":"ἀθλῇ"},{"text":"τις"},{"text":"οὐ"},{"text":"στεφανοῦται"},{"text":"ἐὰν"},{"text":"μὴ"},{"text":"νομίμως"},{"text":"ἀθλήσῃ"}],"notes":[],"lang":"grc"},{"n":6,"text":"τὸν κοπιῶντα γεωργὸν δεῖ πρῶτον τῶν καρπῶν μεταλαμβάνειν.","tokens":[{"text":"τὸν"},{"text":"κοπιῶντα"},{"text":"γεωργὸν"},{"text":"δεῖ"},{"text":"πρῶτον"},{"text":"τῶν"},{"text":"καρπῶν"},{"text":"μεταλαμβάνειν"}],"notes":[],"lang":"grc"},{"n":7,"text":"νόει ⸀ ὃ λέγω·  ⸀ δώσει γάρ σοι ὁ κύριος σύνεσιν ἐν πᾶσιν.","tokens":[{"text":"νόει"},{"text":"ὃ"},{"text":"λέγω"},{"text":"δώσει"},{"text":"γάρ"},{"text":"σοι"},{"text":"ὁ"},{"text":"κύριος"},{"text":"σύνεσιν"},{"text":"ἐν"},{"text":"πᾶσιν"}],"notes":[],"lang":"grc"},{"n":8,"text":"Μνημόνευε Ἰησοῦν Χριστὸν ἐγηγερμένον ἐκ νεκρῶν, ἐκ σπέρματος Δαυίδ, κατὰ τὸ εὐαγγέλιόν μου·","tokens":[{"text":"Μνημόνευε"},{"text":"Ἰησοῦν"},{"text":"Χριστὸν"},{"text":"ἐγηγερμένον"},{"text":"ἐκ"},{"text":"νεκρῶν"},{"text":"ἐκ"},{"text":"σπέρματος"},{"text":"Δαυίδ"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"εὐαγγέλιόν"},{"text":"μου"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἐν ᾧ κακοπαθῶ μέχρι δεσμῶν ὡς κακοῦργος. ἀλλὰ ὁ λόγος τοῦ θεοῦ οὐ δέδεται·","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"κακοπαθῶ"},{"text":"μέχρι"},{"text":"δεσμῶν"},{"text":"ὡς"},{"text":"κακοῦργος"},{"text":"ἀλλὰ"},{"text":"ὁ"},{"text":"λόγος"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"οὐ"},{"text":"δέδεται"}],"notes":[],"lang":"grc"},{"n":10,"text":"διὰ τοῦτο πάντα ὑπομένω διὰ τοὺς ἐκλεκτούς, ἵνα καὶ αὐτοὶ σωτηρίας τύχωσιν τῆς ἐν Χριστῷ Ἰησοῦ μετὰ δόξης αἰωνίου.","tokens":[{"text":"διὰ"},{"text":"τοῦτο"},{"text":"πάντα"},{"text":"ὑπομένω"},{"text":"διὰ"},{"text":"τοὺς"},{"text":"ἐκλεκτούς"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"αὐτοὶ"},{"text":"σωτηρίας"},{"text":"τύχωσιν"},{"text":"τῆς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"μετὰ"},{"text":"δόξης"},{"text":"αἰωνίου"}],"notes":[],"lang":"grc"},{"n":11,"text":"πιστὸς ὁ λόγος· εἰ γὰρ συναπεθάνομεν, καὶ συζήσομεν·","tokens":[{"text":"πιστὸς"},{"text":"ὁ"},{"text":"λόγος"},{"text":"εἰ"},{"text":"γὰρ"},{"text":"συναπεθάνομεν"},{"text":"καὶ"},{"text":"συζήσομεν"}],"notes":[],"lang":"grc"},{"n":12,"text":"εἰ ὑπομένομεν, καὶ συμβασιλεύσομεν· εἰ ⸀ ἀρνησόμεθα, κἀκεῖνος ἀρνήσεται ἡμᾶς·","tokens":[{"text":"εἰ"},{"text":"ὑπομένομεν"},{"text":"καὶ"},{"text":"συμβασιλεύσομεν"},{"text":"εἰ"},{"text":"ἀρνησόμεθα"},{"text":"κἀκεῖνος"},{"text":"ἀρνήσεται"},{"text":"ἡμᾶς"}],"notes":[],"lang":"grc"},{"n":13,"text":"εἰ ἀπιστοῦμεν, ἐκεῖνος πιστὸς μένει·  ⸀ ἀρνήσασθαι ἑαυτὸν οὐ δύναται.","tokens":[{"text":"εἰ"},{"text":"ἀπιστοῦμεν"},{"text":"ἐκεῖνος"},{"text":"πιστὸς"},{"text":"μένει"},{"text":"ἀρνήσασθαι"},{"text":"ἑαυτὸν"},{"text":"οὐ"},{"text":"δύναται"}],"notes":[],"lang":"grc"},{"n":14,"text":"Ταῦτα ὑπομίμνῃσκε, διαμαρτυρόμενος ἐνώπιον τοῦ ⸀ κυρίου, μὴ λογομαχεῖν,  ⸀ ἐπʼ οὐδὲν χρήσιμον, ἐπὶ καταστροφῇ τῶν ἀκουόντων.","tokens":[{"text":"Ταῦτα"},{"text":"ὑπομίμνῃσκε"},{"text":"διαμαρτυρόμενος"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"μὴ"},{"text":"λογομαχεῖν"},{"text":"ἐπʼ"},{"text":"οὐδὲν"},{"text":"χρήσιμον"},{"text":"ἐπὶ"},{"text":"καταστροφῇ"},{"text":"τῶν"},{"text":"ἀκουόντων"}],"notes":[],"lang":"grc"},{"n":15,"text":"σπούδασον σεαυτὸν δόκιμον παραστῆσαι τῷ θεῷ, ἐργάτην ἀνεπαίσχυντον, ὀρθοτομοῦντα τὸν λόγον τῆς ἀληθείας.","tokens":[{"text":"σπούδασον"},{"text":"σεαυτὸν"},{"text":"δόκιμον"},{"text":"παραστῆσαι"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"ἐργάτην"},{"text":"ἀνεπαίσχυντον"},{"text":"ὀρθοτομοῦντα"},{"text":"τὸν"},{"text":"λόγον"},{"text":"τῆς"},{"text":"ἀληθείας"}],"notes":[],"lang":"grc"},{"n":16,"text":"τὰς δὲ βεβήλους κενοφωνίας περιΐστασο· ἐπὶ πλεῖον γὰρ προκόψουσιν ἀσεβείας,","tokens":[{"text":"τὰς"},{"text":"δὲ"},{"text":"βεβήλους"},{"text":"κενοφωνίας"},{"text":"περιΐστασο"},{"text":"ἐπὶ"},{"text":"πλεῖον"},{"text":"γὰρ"},{"text":"προκόψουσιν"},{"text":"ἀσεβείας"}],"notes":[],"lang":"grc"},{"n":17,"text":"καὶ ὁ λόγος αὐτῶν ὡς γάγγραινα νομὴν ἕξει· ὧν ἐστιν Ὑμέναιος καὶ Φίλητος,","tokens":[{"text":"καὶ"},{"text":"ὁ"},{"text":"λόγος"},{"text":"αὐτῶν"},{"text":"ὡς"},{"text":"γάγγραινα"},{"text":"νομὴν"},{"text":"ἕξει"},{"text":"ὧν"},{"text":"ἐστιν"},{"text":"Ὑμέναιος"},{"text":"καὶ"},{"text":"Φίλητος"}],"notes":[],"lang":"grc"},{"n":18,"text":"οἵτινες περὶ τὴν ἀλήθειαν ἠστόχησαν,  ⸀ λέγοντες ἀνάστασιν ἤδη γεγονέναι, καὶ ἀνατρέπουσιν τήν τινων πίστιν.","tokens":[{"text":"οἵτινες"},{"text":"περὶ"},{"text":"τὴν"},{"text":"ἀλήθειαν"},{"text":"ἠστόχησαν"},{"text":"λέγοντες"},{"text":"ἀνάστασιν"},{"text":"ἤδη"},{"text":"γεγονέναι"},{"text":"καὶ"},{"text":"ἀνατρέπουσιν"},{"text":"τήν"},{"text":"τινων"},{"text":"πίστιν"}],"notes":[],"lang":"grc"},{"n":19,"text":"ὁ μέντοι στερεὸς θεμέλιος τοῦ θεοῦ ἕστηκεν, ἔχων τὴν σφραγῖδα ταύτην· Ἔγνω κύριος τοὺς ὄντας αὐτοῦ, καί· Ἀποστήτω ἀπὸ ἀδικίας πᾶς ὁ ὀνομάζων τὸ ὄνομα κυρίου.","tokens":[{"text":"ὁ"},{"text":"μέντοι"},{"text":"στερεὸς"},{"text":"θεμέλιος"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἕστηκεν"},{"text":"ἔχων"},{"text":"τὴν"},{"text":"σφραγῖδα"},{"text":"ταύτην"},{"text":"Ἔγνω"},{"text":"κύριος"},{"text":"τοὺς"},{"text":"ὄντας"},{"text":"αὐτοῦ"},{"text":"καί"},{"text":"Ἀποστήτω"},{"text":"ἀπὸ"},{"text":"ἀδικίας"},{"text":"πᾶς"},{"text":"ὁ"},{"text":"ὀνομάζων"},{"text":"τὸ"},{"text":"ὄνομα"},{"text":"κυρίου"}],"notes":[],"lang":"grc"},{"n":20,"text":"Ἐν μεγάλῃ δὲ οἰκίᾳ οὐκ ἔστιν μόνον σκεύη χρυσᾶ καὶ ἀργυρᾶ ἀλλὰ καὶ ξύλινα καὶ ὀστράκινα, καὶ ἃ μὲν εἰς τιμὴν ἃ δὲ εἰς ἀτιμίαν·","tokens":[{"text":"Ἐν"},{"text":"μεγάλῃ"},{"text":"δὲ"},{"text":"οἰκίᾳ"},{"text":"οὐκ"},{"text":"ἔστιν"},{"text":"μόνον"},{"text":"σκεύη"},{"text":"χρυσᾶ"},{"text":"καὶ"},{"text":"ἀργυρᾶ"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"ξύλινα"},{"text":"καὶ"},{"text":"ὀστράκινα"},{"text":"καὶ"},{"text":"ἃ"},{"text":"μὲν"},{"text":"εἰς"},{"text":"τιμὴν"},{"text":"ἃ"},{"text":"δὲ"},{"text":"εἰς"},{"text":"ἀτιμίαν"}],"notes":[],"lang":"grc"},{"n":21,"text":"ἐὰν οὖν τις ἐκκαθάρῃ ἑαυτὸν ἀπὸ τούτων, ἔσται σκεῦος εἰς τιμήν, ἡγιασμένον,  ⸀ εὔχρηστον τῷ δεσπότῃ, εἰς πᾶν ἔργον ἀγαθὸν ἡτοιμασμένον.","tokens":[{"text":"ἐὰν"},{"text":"οὖν"},{"text":"τις"},{"text":"ἐκκαθάρῃ"},{"text":"ἑαυτὸν"},{"text":"ἀπὸ"},{"text":"τούτων"},{"text":"ἔσται"},{"text":"σκεῦος"},{"text":"εἰς"},{"text":"τιμήν"},{"text":"ἡγιασμένον"},{"text":"εὔχρηστον"},{"text":"τῷ"},{"text":"δεσπότῃ"},{"text":"εἰς"},{"text":"πᾶν"},{"text":"ἔργον"},{"text":"ἀγαθὸν"},{"text":"ἡτοιμασμένον"}],"notes":[],"lang":"grc"},{"n":22,"text":"τὰς δὲ νεωτερικὰς ἐπιθυμίας φεῦγε, δίωκε δὲ δικαιοσύνην, πίστιν, ἀγάπην, εἰρήνην μετὰ τῶν ἐπικαλουμένων τὸν κύριον ἐκ καθαρᾶς καρδίας.","tokens":[{"text":"τὰς"},{"text":"δὲ"},{"text":"νεωτερικὰς"},{"text":"ἐπιθυμίας"},{"text":"φεῦγε"},{"text":"δίωκε"},{"text":"δὲ"},{"text":"δικαιοσύνην"},{"text":"πίστιν"},{"text":"ἀγάπην"},{"text":"εἰρήνην"},{"text":"μετὰ"},{"text":"τῶν"},{"text":"ἐπικαλουμένων"},{"text":"τὸν"},{"text":"κύριον"},{"text":"ἐκ"},{"text":"καθαρᾶς"},{"text":"καρδίας"}],"notes":[],"lang":"grc"},{"n":23,"text":"τὰς δὲ μωρὰς καὶ ἀπαιδεύτους ζητήσεις παραιτοῦ, εἰδὼς ὅτι γεννῶσι μάχας·","tokens":[{"text":"τὰς"},{"text":"δὲ"},{"text":"μωρὰς"},{"text":"καὶ"},{"text":"ἀπαιδεύτους"},{"text":"ζητήσεις"},{"text":"παραιτοῦ"},{"text":"εἰδὼς"},{"text":"ὅτι"},{"text":"γεννῶσι"},{"text":"μάχας"}],"notes":[],"lang":"grc"},{"n":24,"text":"δοῦλον δὲ κυρίου οὐ δεῖ μάχεσθαι, ἀλλὰ ἤπιον εἶναι πρὸς πάντας, διδακτικόν, ἀνεξίκακον,","tokens":[{"text":"δοῦλον"},{"text":"δὲ"},{"text":"κυρίου"},{"text":"οὐ"},{"text":"δεῖ"},{"text":"μάχεσθαι"},{"text":"ἀλλὰ"},{"text":"ἤπιον"},{"text":"εἶναι"},{"text":"πρὸς"},{"text":"πάντας"},{"text":"διδακτικόν"},{"text":"ἀνεξίκακον"}],"notes":[],"lang":"grc"},{"n":25,"text":"ἐν πραΰτητι παιδεύοντα τοὺς ἀντιδιατιθεμένους, μήποτε ⸀ δώῃ αὐτοῖς ὁ θεὸς μετάνοιαν εἰς ἐπίγνωσιν ἀληθείας,","tokens":[{"text":"ἐν"},{"text":"πραΰτητι"},{"text":"παιδεύοντα"},{"text":"τοὺς"},{"text":"ἀντιδιατιθεμένους"},{"text":"μήποτε"},{"text":"δώῃ"},{"text":"αὐτοῖς"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"μετάνοιαν"},{"text":"εἰς"},{"text":"ἐπίγνωσιν"},{"text":"ἀληθείας"}],"notes":[],"lang":"grc"},{"n":26,"text":"καὶ ἀνανήψωσιν ἐκ τῆς τοῦ διαβόλου παγίδος, ἐζωγρημένοι ὑπʼ αὐτοῦ εἰς τὸ ἐκείνου θέλημα.","tokens":[{"text":"καὶ"},{"text":"ἀνανήψωσιν"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"τοῦ"},{"text":"διαβόλου"},{"text":"παγίδος"},{"text":"ἐζωγρημένοι"},{"text":"ὑπʼ"},{"text":"αὐτοῦ"},{"text":"εἰς"},{"text":"τὸ"},{"text":"ἐκείνου"},{"text":"θέλημα"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Τοῦτο δὲ γίνωσκε ὅτι ἐν ἐσχάταις ἡμέραις ἐνστήσονται καιροὶ χαλεποί·","tokens":[{"text":"Τοῦτο"},{"text":"δὲ"},{"text":"γίνωσκε"},{"text":"ὅτι"},{"text":"ἐν"},{"text":"ἐσχάταις"},{"text":"ἡμέραις"},{"text":"ἐνστήσονται"},{"text":"καιροὶ"},{"text":"χαλεποί"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἔσονται γὰρ οἱ ἄνθρωποι φίλαυτοι, φιλάργυροι, ἀλαζόνες, ὑπερήφανοι, βλάσφημοι, γονεῦσιν ἀπειθεῖς, ἀχάριστοι, ἀνόσιοι,","tokens":[{"text":"ἔσονται"},{"text":"γὰρ"},{"text":"οἱ"},{"text":"ἄνθρωποι"},{"text":"φίλαυτοι"},{"text":"φιλάργυροι"},{"text":"ἀλαζόνες"},{"text":"ὑπερήφανοι"},{"text":"βλάσφημοι"},{"text":"γονεῦσιν"},{"text":"ἀπειθεῖς"},{"text":"ἀχάριστοι"},{"text":"ἀνόσιοι"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἄστοργοι, ἄσπονδοι, διάβολοι, ἀκρατεῖς, ἀνήμεροι, ἀφιλάγαθοι,","tokens":[{"text":"ἄστοργοι"},{"text":"ἄσπονδοι"},{"text":"διάβολοι"},{"text":"ἀκρατεῖς"},{"text":"ἀνήμεροι"},{"text":"ἀφιλάγαθοι"}],"notes":[],"lang":"grc"},{"n":4,"text":"προδόται, προπετεῖς, τετυφωμένοι, φιλήδονοι μᾶλλον ἢ φιλόθεοι,","tokens":[{"text":"προδόται"},{"text":"προπετεῖς"},{"text":"τετυφωμένοι"},{"text":"φιλήδονοι"},{"text":"μᾶλλον"},{"text":"ἢ"},{"text":"φιλόθεοι"}],"notes":[],"lang":"grc"},{"n":5,"text":"ἔχοντες μόρφωσιν εὐσεβείας τὴν δὲ δύναμιν αὐτῆς ἠρνημένοι· καὶ τούτους ἀποτρέπου.","tokens":[{"text":"ἔχοντες"},{"text":"μόρφωσιν"},{"text":"εὐσεβείας"},{"text":"τὴν"},{"text":"δὲ"},{"text":"δύναμιν"},{"text":"αὐτῆς"},{"text":"ἠρνημένοι"},{"text":"καὶ"},{"text":"τούτους"},{"text":"ἀποτρέπου"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἐκ τούτων γάρ εἰσιν οἱ ἐνδύνοντες εἰς τὰς οἰκίας καὶ ⸀ αἰχμαλωτίζοντες γυναικάρια σεσωρευμένα ἁμαρτίαις, ἀγόμενα ἐπιθυμίαις ποικίλαις,","tokens":[{"text":"ἐκ"},{"text":"τούτων"},{"text":"γάρ"},{"text":"εἰσιν"},{"text":"οἱ"},{"text":"ἐνδύνοντες"},{"text":"εἰς"},{"text":"τὰς"},{"text":"οἰκίας"},{"text":"καὶ"},{"text":"αἰχμαλωτίζοντες"},{"text":"γυναικάρια"},{"text":"σεσωρευμένα"},{"text":"ἁμαρτίαις"},{"text":"ἀγόμενα"},{"text":"ἐπιθυμίαις"},{"text":"ποικίλαις"}],"notes":[],"lang":"grc"},{"n":7,"text":"πάντοτε μανθάνοντα καὶ μηδέποτε εἰς ἐπίγνωσιν ἀληθείας ἐλθεῖν δυνάμενα.","tokens":[{"text":"πάντοτε"},{"text":"μανθάνοντα"},{"text":"καὶ"},{"text":"μηδέποτε"},{"text":"εἰς"},{"text":"ἐπίγνωσιν"},{"text":"ἀληθείας"},{"text":"ἐλθεῖν"},{"text":"δυνάμενα"}],"notes":[],"lang":"grc"},{"n":8,"text":"ὃν τρόπον δὲ Ἰάννης καὶ Ἰαμβρῆς ἀντέστησαν Μωϋσεῖ, οὕτως καὶ οὗτοι ἀνθίστανται τῇ ἀληθείᾳ, ἄνθρωποι κατεφθαρμένοι τὸν νοῦν, ἀδόκιμοι περὶ τὴν πίστιν.","tokens":[{"text":"ὃν"},{"text":"τρόπον"},{"text":"δὲ"},{"text":"Ἰάννης"},{"text":"καὶ"},{"text":"Ἰαμβρῆς"},{"text":"ἀντέστησαν"},{"text":"Μωϋσεῖ"},{"text":"οὕτως"},{"text":"καὶ"},{"text":"οὗτοι"},{"text":"ἀνθίστανται"},{"text":"τῇ"},{"text":"ἀληθείᾳ"},{"text":"ἄνθρωποι"},{"text":"κατεφθαρμένοι"},{"text":"τὸν"},{"text":"νοῦν"},{"text":"ἀδόκιμοι"},{"text":"περὶ"},{"text":"τὴν"},{"text":"πίστιν"}],"notes":[],"lang":"grc"},{"n":9,"text":"ἀλλʼ οὐ προκόψουσιν ἐπὶ πλεῖον, ἡ γὰρ ἄνοια αὐτῶν ἔκδηλος ἔσται πᾶσιν, ὡς καὶ ἡ ἐκείνων ἐγένετο.","tokens":[{"text":"ἀλλʼ"},{"text":"οὐ"},{"text":"προκόψουσιν"},{"text":"ἐπὶ"},{"text":"πλεῖον"},{"text":"ἡ"},{"text":"γὰρ"},{"text":"ἄνοια"},{"text":"αὐτῶν"},{"text":"ἔκδηλος"},{"text":"ἔσται"},{"text":"πᾶσιν"},{"text":"ὡς"},{"text":"καὶ"},{"text":"ἡ"},{"text":"ἐκείνων"},{"text":"ἐγένετο"}],"notes":[],"lang":"grc"},{"n":10,"text":"Σὺ δὲ ⸀ παρηκολούθησάς μου τῇ διδασκαλίᾳ, τῇ ἀγωγῇ, τῇ προθέσει, τῇ πίστει, τῇ μακροθυμίᾳ, τῇ ἀγάπῃ, τῇ ὑπομονῇ,","tokens":[{"text":"Σὺ"},{"text":"δὲ"},{"text":"παρηκολούθησάς"},{"text":"μου"},{"text":"τῇ"},{"text":"διδασκαλίᾳ"},{"text":"τῇ"},{"text":"ἀγωγῇ"},{"text":"τῇ"},{"text":"προθέσει"},{"text":"τῇ"},{"text":"πίστει"},{"text":"τῇ"},{"text":"μακροθυμίᾳ"},{"text":"τῇ"},{"text":"ἀγάπῃ"},{"text":"τῇ"},{"text":"ὑπομονῇ"}],"notes":[],"lang":"grc"},{"n":11,"text":"τοῖς διωγμοῖς, τοῖς παθήμασιν, οἷά μοι ἐγένετο ἐν Ἀντιοχείᾳ, ἐν Ἰκονίῳ, ἐν Λύστροις, οἵους διωγμοὺς ὑπήνεγκα· καὶ ἐκ πάντων με ἐρρύσατο ὁ κύριος.","tokens":[{"text":"τοῖς"},{"text":"διωγμοῖς"},{"text":"τοῖς"},{"text":"παθήμασιν"},{"text":"οἷά"},{"text":"μοι"},{"text":"ἐγένετο"},{"text":"ἐν"},{"text":"Ἀντιοχείᾳ"},{"text":"ἐν"},{"text":"Ἰκονίῳ"},{"text":"ἐν"},{"text":"Λύστροις"},{"text":"οἵους"},{"text":"διωγμοὺς"},{"text":"ὑπήνεγκα"},{"text":"καὶ"},{"text":"ἐκ"},{"text":"πάντων"},{"text":"με"},{"text":"ἐρρύσατο"},{"text":"ὁ"},{"text":"κύριος"}],"notes":[],"lang":"grc"},{"n":12,"text":"καὶ πάντες δὲ οἱ θέλοντες ⸂ ζῆν εὐσεβῶς⸃ ἐν Χριστῷ Ἰησοῦ διωχθήσονται·","tokens":[{"text":"καὶ"},{"text":"πάντες"},{"text":"δὲ"},{"text":"οἱ"},{"text":"θέλοντες"},{"text":"ζῆν"},{"text":"εὐσεβῶς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"διωχθήσονται"}],"notes":[],"lang":"grc"},{"n":13,"text":"πονηροὶ δὲ ἄνθρωποι καὶ γόητες προκόψουσιν ἐπὶ τὸ χεῖρον, πλανῶντες καὶ πλανώμενοι.","tokens":[{"text":"πονηροὶ"},{"text":"δὲ"},{"text":"ἄνθρωποι"},{"text":"καὶ"},{"text":"γόητες"},{"text":"προκόψουσιν"},{"text":"ἐπὶ"},{"text":"τὸ"},{"text":"χεῖρον"},{"text":"πλανῶντες"},{"text":"καὶ"},{"text":"πλανώμενοι"}],"notes":[],"lang":"grc"},{"n":14,"text":"σὺ δὲ μένε ἐν οἷς ἔμαθες καὶ ἐπιστώθης, εἰδὼς παρὰ ⸀ τίνων ἔμαθες,","tokens":[{"text":"σὺ"},{"text":"δὲ"},{"text":"μένε"},{"text":"ἐν"},{"text":"οἷς"},{"text":"ἔμαθες"},{"text":"καὶ"},{"text":"ἐπιστώθης"},{"text":"εἰδὼς"},{"text":"παρὰ"},{"text":"τίνων"},{"text":"ἔμαθες"}],"notes":[],"lang":"grc"},{"n":15,"text":"καὶ ὅτι ἀπὸ βρέφους ⸀ ἱερὰ γράμματα οἶδας, τὰ δυνάμενά σε σοφίσαι εἰς σωτηρίαν διὰ πίστεως τῆς ἐν Χριστῷ Ἰησοῦ·","tokens":[{"text":"καὶ"},{"text":"ὅτι"},{"text":"ἀπὸ"},{"text":"βρέφους"},{"text":"ἱερὰ"},{"text":"γράμματα"},{"text":"οἶδας"},{"text":"τὰ"},{"text":"δυνάμενά"},{"text":"σε"},{"text":"σοφίσαι"},{"text":"εἰς"},{"text":"σωτηρίαν"},{"text":"διὰ"},{"text":"πίστεως"},{"text":"τῆς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"}],"notes":[],"lang":"grc"},{"n":16,"text":"πᾶσα γραφὴ θεόπνευστος καὶ ὠφέλιμος πρὸς διδασκαλίαν, πρὸς ⸀ ἐλεγμόν, πρὸς ἐπανόρθωσιν, πρὸς παιδείαν τὴν ἐν δικαιοσύνῃ,","tokens":[{"text":"πᾶσα"},{"text":"γραφὴ"},{"text":"θεόπνευστος"},{"text":"καὶ"},{"text":"ὠφέλιμος"},{"text":"πρὸς"},{"text":"διδασκαλίαν"},{"text":"πρὸς"},{"text":"ἐλεγμόν"},{"text":"πρὸς"},{"text":"ἐπανόρθωσιν"},{"text":"πρὸς"},{"text":"παιδείαν"},{"text":"τὴν"},{"text":"ἐν"},{"text":"δικαιοσύνῃ"}],"notes":[],"lang":"grc"},{"n":17,"text":"ἵνα ἄρτιος ᾖ ὁ τοῦ θεοῦ ἄνθρωπος, πρὸς πᾶν ἔργον ἀγαθὸν ἐξηρτισμένος.","tokens":[{"text":"ἵνα"},{"text":"ἄρτιος"},{"text":"ᾖ"},{"text":"ὁ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἄνθρωπος"},{"text":"πρὸς"},{"text":"πᾶν"},{"text":"ἔργον"},{"text":"ἀγαθὸν"},{"text":"ἐξηρτισμένος"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"⸀ Διαμαρτύρομαι ἐνώπιον τοῦ θεοῦ καὶ ⸂ Χριστοῦ Ἰησοῦ⸃, τοῦ μέλλοντος κρίνειν ζῶντας καὶ νεκρούς,  ⸀ καὶ τὴν ἐπιφάνειαν αὐτοῦ καὶ τὴν βασιλείαν αὐτοῦ·","tokens":[{"text":"Διαμαρτύρομαι"},{"text":"ἐνώπιον"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"τοῦ"},{"text":"μέλλοντος"},{"text":"κρίνειν"},{"text":"ζῶντας"},{"text":"καὶ"},{"text":"νεκρούς"},{"text":"καὶ"},{"text":"τὴν"},{"text":"ἐπιφάνειαν"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"τὴν"},{"text":"βασιλείαν"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":2,"text":"κήρυξον τὸν λόγον, ἐπίστηθι εὐκαίρως ἀκαίρως, ἔλεγξον, ἐπιτίμησον, παρακάλεσον, ἐν πάσῃ μακροθυμίᾳ καὶ διδαχῇ.","tokens":[{"text":"κήρυξον"},{"text":"τὸν"},{"text":"λόγον"},{"text":"ἐπίστηθι"},{"text":"εὐκαίρως"},{"text":"ἀκαίρως"},{"text":"ἔλεγξον"},{"text":"ἐπιτίμησον"},{"text":"παρακάλεσον"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"μακροθυμίᾳ"},{"text":"καὶ"},{"text":"διδαχῇ"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἔσται γὰρ καιρὸς ὅτε τῆς ὑγιαινούσης διδασκαλίας οὐκ ἀνέξονται, ἀλλὰ κατὰ τὰς ⸂ ἰδίας ἐπιθυμίας⸃ ἑαυτοῖς ἐπισωρεύσουσιν διδασκάλους κνηθόμενοι τὴν ἀκοήν,","tokens":[{"text":"ἔσται"},{"text":"γὰρ"},{"text":"καιρὸς"},{"text":"ὅτε"},{"text":"τῆς"},{"text":"ὑγιαινούσης"},{"text":"διδασκαλίας"},{"text":"οὐκ"},{"text":"ἀνέξονται"},{"text":"ἀλλὰ"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"ἰδίας"},{"text":"ἐπιθυμίας"},{"text":"ἑαυτοῖς"},{"text":"ἐπισωρεύσουσιν"},{"text":"διδασκάλους"},{"text":"κνηθόμενοι"},{"text":"τὴν"},{"text":"ἀκοήν"}],"notes":[],"lang":"grc"},{"n":4,"text":"καὶ ἀπὸ μὲν τῆς ἀληθείας τὴν ἀκοὴν ἀποστρέψουσιν, ἐπὶ δὲ τοὺς μύθους ἐκτραπήσονται.","tokens":[{"text":"καὶ"},{"text":"ἀπὸ"},{"text":"μὲν"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"τὴν"},{"text":"ἀκοὴν"},{"text":"ἀποστρέψουσιν"},{"text":"ἐπὶ"},{"text":"δὲ"},{"text":"τοὺς"},{"text":"μύθους"},{"text":"ἐκτραπήσονται"}],"notes":[],"lang":"grc"},{"n":5,"text":"σὺ δὲ νῆφε ἐν πᾶσιν, κακοπάθησον, ἔργον ποίησον εὐαγγελιστοῦ, τὴν διακονίαν σου πληροφόρησον.","tokens":[{"text":"σὺ"},{"text":"δὲ"},{"text":"νῆφε"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"κακοπάθησον"},{"text":"ἔργον"},{"text":"ποίησον"},{"text":"εὐαγγελιστοῦ"},{"text":"τὴν"},{"text":"διακονίαν"},{"text":"σου"},{"text":"πληροφόρησον"}],"notes":[],"lang":"grc"},{"n":6,"text":"Ἐγὼ γὰρ ἤδη σπένδομαι, καὶ ὁ καιρὸς τῆς ⸂ ἀναλύσεώς μου⸃ ἐφέστηκεν.","tokens":[{"text":"Ἐγὼ"},{"text":"γὰρ"},{"text":"ἤδη"},{"text":"σπένδομαι"},{"text":"καὶ"},{"text":"ὁ"},{"text":"καιρὸς"},{"text":"τῆς"},{"text":"ἀναλύσεώς"},{"text":"μου"},{"text":"ἐφέστηκεν"}],"notes":[],"lang":"grc"},{"n":7,"text":"τὸν ⸂ καλὸν ἀγῶνα⸃ ἠγώνισμαι, τὸν δρόμον τετέλεκα, τὴν πίστιν τετήρηκα·","tokens":[{"text":"τὸν"},{"text":"καλὸν"},{"text":"ἀγῶνα"},{"text":"ἠγώνισμαι"},{"text":"τὸν"},{"text":"δρόμον"},{"text":"τετέλεκα"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"τετήρηκα"}],"notes":[],"lang":"grc"},{"n":8,"text":"λοιπὸν ἀπόκειταί μοι ὁ τῆς δικαιοσύνης στέφανος, ὃν ἀποδώσει μοι ὁ κύριος ἐν ἐκείνῃ τῇ ἡμέρᾳ, ὁ δίκαιος κριτής, οὐ μόνον δὲ ἐμοὶ ἀλλὰ καὶ πᾶσιν τοῖς ἠγαπηκόσι τὴν ἐπιφάνειαν αὐτοῦ.","tokens":[{"text":"λοιπὸν"},{"text":"ἀπόκειταί"},{"text":"μοι"},{"text":"ὁ"},{"text":"τῆς"},{"text":"δικαιοσύνης"},{"text":"στέφανος"},{"text":"ὃν"},{"text":"ἀποδώσει"},{"text":"μοι"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἐν"},{"text":"ἐκείνῃ"},{"text":"τῇ"},{"text":"ἡμέρᾳ"},{"text":"ὁ"},{"text":"δίκαιος"},{"text":"κριτής"},{"text":"οὐ"},{"text":"μόνον"},{"text":"δὲ"},{"text":"ἐμοὶ"},{"text":"ἀλλὰ"},{"text":"καὶ"},{"text":"πᾶσιν"},{"text":"τοῖς"},{"text":"ἠγαπηκόσι"},{"text":"τὴν"},{"text":"ἐπιφάνειαν"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":9,"text":"Σπούδασον ἐλθεῖν πρός με ταχέως·","tokens":[{"text":"Σπούδασον"},{"text":"ἐλθεῖν"},{"text":"πρός"},{"text":"με"},{"text":"ταχέως"}],"notes":[],"lang":"grc"},{"n":10,"text":"Δημᾶς γάρ με ⸀ ἐγκατέλιπεν ἀγαπήσας τὸν νῦν αἰῶνα, καὶ ἐπορεύθη εἰς Θεσσαλονίκην, Κρήσκης εἰς Γαλατίαν, Τίτος εἰς Δαλματίαν·","tokens":[{"text":"Δημᾶς"},{"text":"γάρ"},{"text":"με"},{"text":"ἐγκατέλιπεν"},{"text":"ἀγαπήσας"},{"text":"τὸν"},{"text":"νῦν"},{"text":"αἰῶνα"},{"text":"καὶ"},{"text":"ἐπορεύθη"},{"text":"εἰς"},{"text":"Θεσσαλονίκην"},{"text":"Κρήσκης"},{"text":"εἰς"},{"text":"Γαλατίαν"},{"text":"Τίτος"},{"text":"εἰς"},{"text":"Δαλματίαν"}],"notes":[],"lang":"grc"},{"n":11,"text":"Λουκᾶς ἐστιν μόνος μετʼ ἐμοῦ. Μᾶρκον ἀναλαβὼν ἄγε μετὰ σεαυτοῦ, ἔστιν γάρ μοι εὔχρηστος εἰς διακονίαν,","tokens":[{"text":"Λουκᾶς"},{"text":"ἐστιν"},{"text":"μόνος"},{"text":"μετʼ"},{"text":"ἐμοῦ"},{"text":"Μᾶρκον"},{"text":"ἀναλαβὼν"},{"text":"ἄγε"},{"text":"μετὰ"},{"text":"σεαυτοῦ"},{"text":"ἔστιν"},{"text":"γάρ"},{"text":"μοι"},{"text":"εὔχρηστος"},{"text":"εἰς"},{"text":"διακονίαν"}],"notes":[],"lang":"grc"},{"n":12,"text":"Τυχικὸν δὲ ἀπέστειλα εἰς Ἔφεσον.","tokens":[{"text":"Τυχικὸν"},{"text":"δὲ"},{"text":"ἀπέστειλα"},{"text":"εἰς"},{"text":"Ἔφεσον"}],"notes":[],"lang":"grc"},{"n":13,"text":"τὸν φαιλόνην, ὃν ⸀ ἀπέλιπον ἐν Τρῳάδι παρὰ Κάρπῳ, ἐρχόμενος φέρε, καὶ τὰ βιβλία, μάλιστα τὰς μεμβράνας.","tokens":[{"text":"τὸν"},{"text":"φαιλόνην"},{"text":"ὃν"},{"text":"ἀπέλιπον"},{"text":"ἐν"},{"text":"Τρῳάδι"},{"text":"παρὰ"},{"text":"Κάρπῳ"},{"text":"ἐρχόμενος"},{"text":"φέρε"},{"text":"καὶ"},{"text":"τὰ"},{"text":"βιβλία"},{"text":"μάλιστα"},{"text":"τὰς"},{"text":"μεμβράνας"}],"notes":[],"lang":"grc"},{"n":14,"text":"Ἀλέξανδρος ὁ χαλκεὺς πολλά μοι κακὰ ἐνεδείξατο— ⸀ ἀποδώσει αὐτῷ ὁ κύριος κατὰ τὰ ἔργα αὐτοῦ—","tokens":[{"text":"Ἀλέξανδρος"},{"text":"ὁ"},{"text":"χαλκεὺς"},{"text":"πολλά"},{"text":"μοι"},{"text":"κακὰ"},{"text":"ἐνεδείξατο"},{"text":"ἀποδώσει"},{"text":"αὐτῷ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"κατὰ"},{"text":"τὰ"},{"text":"ἔργα"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ὃν καὶ σὺ φυλάσσου, λίαν γὰρ ⸀ ἀντέστη τοῖς ἡμετέροις λόγοις.","tokens":[{"text":"ὃν"},{"text":"καὶ"},{"text":"σὺ"},{"text":"φυλάσσου"},{"text":"λίαν"},{"text":"γὰρ"},{"text":"ἀντέστη"},{"text":"τοῖς"},{"text":"ἡμετέροις"},{"text":"λόγοις"}],"notes":[],"lang":"grc"},{"n":16,"text":"Ἐν τῇ πρώτῃ μου ἀπολογίᾳ οὐδείς μοι ⸀ παρεγένετο, ἀλλὰ πάντες με ⸀ ἐγκατέλιπον— μὴ αὐτοῖς λογισθείη—","tokens":[{"text":"Ἐν"},{"text":"τῇ"},{"text":"πρώτῃ"},{"text":"μου"},{"text":"ἀπολογίᾳ"},{"text":"οὐδείς"},{"text":"μοι"},{"text":"παρεγένετο"},{"text":"ἀλλὰ"},{"text":"πάντες"},{"text":"με"},{"text":"ἐγκατέλιπον"},{"text":"μὴ"},{"text":"αὐτοῖς"},{"text":"λογισθείη"}],"notes":[],"lang":"grc"},{"n":17,"text":"ὁ δὲ κύριός μοι παρέστη καὶ ἐνεδυνάμωσέν με, ἵνα διʼ ἐμοῦ τὸ κήρυγμα πληροφορηθῇ καὶ ⸀ ἀκούσωσιν πάντα τὰ ἔθνη, καὶ ἐρρύσθην ἐκ στόματος λέοντος.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"κύριός"},{"text":"μοι"},{"text":"παρέστη"},{"text":"καὶ"},{"text":"ἐνεδυνάμωσέν"},{"text":"με"},{"text":"ἵνα"},{"text":"διʼ"},{"text":"ἐμοῦ"},{"text":"τὸ"},{"text":"κήρυγμα"},{"text":"πληροφορηθῇ"},{"text":"καὶ"},{"text":"ἀκούσωσιν"},{"text":"πάντα"},{"text":"τὰ"},{"text":"ἔθνη"},{"text":"καὶ"},{"text":"ἐρρύσθην"},{"text":"ἐκ"},{"text":"στόματος"},{"text":"λέοντος"}],"notes":[],"lang":"grc"},{"n":18,"text":"⸀ ῥύσεταί με ὁ κύριος ἀπὸ παντὸς ἔργου πονηροῦ καὶ σώσει εἰς τὴν βασιλείαν αὐτοῦ τὴν ἐπουράνιον· ᾧ ἡ δόξα εἰς τοὺς αἰῶνας τῶν αἰώνων, ἀμήν.","tokens":[{"text":"ῥύσεταί"},{"text":"με"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἀπὸ"},{"text":"παντὸς"},{"text":"ἔργου"},{"text":"πονηροῦ"},{"text":"καὶ"},{"text":"σώσει"},{"text":"εἰς"},{"text":"τὴν"},{"text":"βασιλείαν"},{"text":"αὐτοῦ"},{"text":"τὴν"},{"text":"ἐπουράνιον"},{"text":"ᾧ"},{"text":"ἡ"},{"text":"δόξα"},{"text":"εἰς"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"},{"n":19,"text":"Ἄσπασαι Πρίσκαν καὶ Ἀκύλαν καὶ τὸν Ὀνησιφόρου οἶκον.","tokens":[{"text":"Ἄσπασαι"},{"text":"Πρίσκαν"},{"text":"καὶ"},{"text":"Ἀκύλαν"},{"text":"καὶ"},{"text":"τὸν"},{"text":"Ὀνησιφόρου"},{"text":"οἶκον"}],"notes":[],"lang":"grc"},{"n":20,"text":"Ἔραστος ἔμεινεν ἐν Κορίνθῳ, Τρόφιμον δὲ ⸀ ἀπέλιπον ἐν Μιλήτῳ ἀσθενοῦντα.","tokens":[{"text":"Ἔραστος"},{"text":"ἔμεινεν"},{"text":"ἐν"},{"text":"Κορίνθῳ"},{"text":"Τρόφιμον"},{"text":"δὲ"},{"text":"ἀπέλιπον"},{"text":"ἐν"},{"text":"Μιλήτῳ"},{"text":"ἀσθενοῦντα"}],"notes":[],"lang":"grc"},{"n":21,"text":"Σπούδασον πρὸ χειμῶνος ἐλθεῖν. Ἀσπάζεταί σε Εὔβουλος καὶ Πούδης καὶ Λίνος καὶ Κλαυδία καὶ οἱ ἀδελφοὶ πάντες.","tokens":[{"text":"Σπούδασον"},{"text":"πρὸ"},{"text":"χειμῶνος"},{"text":"ἐλθεῖν"},{"text":"Ἀσπάζεταί"},{"text":"σε"},{"text":"Εὔβουλος"},{"text":"καὶ"},{"text":"Πούδης"},{"text":"καὶ"},{"text":"Λίνος"},{"text":"καὶ"},{"text":"Κλαυδία"},{"text":"καὶ"},{"text":"οἱ"},{"text":"ἀδελφοὶ"},{"text":"πάντες"}],"notes":[],"lang":"grc"},{"n":22,"text":"Ὁ ⸀ κύριος μετὰ τοῦ πνεύματός σου. ἡ χάρις μεθʼ ⸀ ὑμῶν.","tokens":[{"text":"Ὁ"},{"text":"κύριος"},{"text":"μετὰ"},{"text":"τοῦ"},{"text":"πνεύματός"},{"text":"σου"},{"text":"ἡ"},{"text":"χάρις"},{"text":"μεθʼ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}