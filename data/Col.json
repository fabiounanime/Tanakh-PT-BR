{"book":{"id":"Col","name":"Colossenses","testament":"NT","source":"SBLGNT","chapters":4,"verses":95},"chapters":{"1":[{"n":1,"text":"Παῦλος ἀπόστολος ⸂ Χριστοῦ Ἰησοῦ⸃ διὰ θελήματος θεοῦ καὶ Τιμόθεος ὁ ἀδελφὸς","tokens":[{"text":"Παῦλος"},{"text":"ἀπόστολος"},{"text":"Χριστοῦ"},{"text":"Ἰησοῦ"},{"text":"διὰ"},{"text":"θελήματος"},{"text":"θεοῦ"},{"text":"καὶ"},{"text":"Τιμόθεος"},{"text":"ὁ"},{"text":"ἀδελφὸς"}],"notes":[],"lang":"grc"},{"n":2,"text":"τοῖς ἐν ⸀ Κολοσσαῖς ἁγίοις καὶ πιστοῖς ἀδελφοῖς ἐν Χριστῷ· χάρις ὑμῖν καὶ εἰρήνη ἀπὸ θεοῦ πατρὸς ⸀ ἡμῶν.","tokens":[{"text":"τοῖς"},{"text":"ἐν"},{"text":"Κολοσσαῖς"},{"text":"ἁγίοις"},{"text":"καὶ"},{"text":"πιστοῖς"},{"text":"ἀδελφοῖς"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"χάρις"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"ἀπὸ"},{"text":"θεοῦ"},{"text":"πατρὸς"},{"text":"ἡμῶν"}],"notes":[],"lang":"grc"},{"n":3,"text":"Εὐχαριστοῦμεν τῷ ⸀ θεῷ πατρὶ τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ πάντοτε ⸀ περὶ ὑμῶν προσευχόμενοι,","tokens":[{"text":"Εὐχαριστοῦμεν"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"πατρὶ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"πάντοτε"},{"text":"περὶ"},{"text":"ὑμῶν"},{"text":"προσευχόμενοι"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἀκούσαντες τὴν πίστιν ὑμῶν ἐν Χριστῷ Ἰησοῦ καὶ τὴν ἀγάπην ⸂ ἣν ἔχετε⸃ εἰς πάντας τοὺς ἁγίους","tokens":[{"text":"ἀκούσαντες"},{"text":"τὴν"},{"text":"πίστιν"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"Χριστῷ"},{"text":"Ἰησοῦ"},{"text":"καὶ"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"ἣν"},{"text":"ἔχετε"},{"text":"εἰς"},{"text":"πάντας"},{"text":"τοὺς"},{"text":"ἁγίους"}],"notes":[],"lang":"grc"},{"n":5,"text":"διὰ τὴν ἐλπίδα τὴν ἀποκειμένην ὑμῖν ἐν τοῖς οὐρανοῖς, ἣν προηκούσατε ἐν τῷ λόγῳ τῆς ἀληθείας τοῦ εὐαγγελίου","tokens":[{"text":"διὰ"},{"text":"τὴν"},{"text":"ἐλπίδα"},{"text":"τὴν"},{"text":"ἀποκειμένην"},{"text":"ὑμῖν"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"οὐρανοῖς"},{"text":"ἣν"},{"text":"προηκούσατε"},{"text":"ἐν"},{"text":"τῷ"},{"text":"λόγῳ"},{"text":"τῆς"},{"text":"ἀληθείας"},{"text":"τοῦ"},{"text":"εὐαγγελίου"}],"notes":[],"lang":"grc"},{"n":6,"text":"τοῦ παρόντος εἰς ὑμᾶς, καθὼς καὶ ἐν παντὶ τῷ ⸀ κόσμῳ ἐστὶν καρποφορούμενον καὶ αὐξανόμενον καθὼς καὶ ἐν ὑμῖν, ἀφʼ ἧς ἡμέρας ἠκούσατε καὶ ἐπέγνωτε τὴν χάριν τοῦ θεοῦ ἐν ἀληθείᾳ·","tokens":[{"text":"τοῦ"},{"text":"παρόντος"},{"text":"εἰς"},{"text":"ὑμᾶς"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"τῷ"},{"text":"κόσμῳ"},{"text":"ἐστὶν"},{"text":"καρποφορούμενον"},{"text":"καὶ"},{"text":"αὐξανόμενον"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἀφʼ"},{"text":"ἧς"},{"text":"ἡμέρας"},{"text":"ἠκούσατε"},{"text":"καὶ"},{"text":"ἐπέγνωτε"},{"text":"τὴν"},{"text":"χάριν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐν"},{"text":"ἀληθείᾳ"}],"notes":[],"lang":"grc"},{"n":7,"text":"⸀ καθὼς ἐμάθετε ἀπὸ Ἐπαφρᾶ τοῦ ἀγαπητοῦ συνδούλου ἡμῶν, ὅς ἐστιν πιστὸς ὑπὲρ ⸀ ἡμῶν διάκονος τοῦ Χριστοῦ,","tokens":[{"text":"καθὼς"},{"text":"ἐμάθετε"},{"text":"ἀπὸ"},{"text":"Ἐπαφρᾶ"},{"text":"τοῦ"},{"text":"ἀγαπητοῦ"},{"text":"συνδούλου"},{"text":"ἡμῶν"},{"text":"ὅς"},{"text":"ἐστιν"},{"text":"πιστὸς"},{"text":"ὑπὲρ"},{"text":"ἡμῶν"},{"text":"διάκονος"},{"text":"τοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":8,"text":"ὁ καὶ δηλώσας ἡμῖν τὴν ὑμῶν ἀγάπην ἐν πνεύματι.","tokens":[{"text":"ὁ"},{"text":"καὶ"},{"text":"δηλώσας"},{"text":"ἡμῖν"},{"text":"τὴν"},{"text":"ὑμῶν"},{"text":"ἀγάπην"},{"text":"ἐν"},{"text":"πνεύματι"}],"notes":[],"lang":"grc"},{"n":9,"text":"Διὰ τοῦτο καὶ ἡμεῖς, ἀφʼ ἧς ἡμέρας ἠκούσαμεν, οὐ παυόμεθα ὑπὲρ ὑμῶν προσευχόμενοι καὶ αἰτούμενοι ἵνα πληρωθῆτε τὴν ἐπίγνωσιν τοῦ θελήματος αὐτοῦ ἐν πάσῃ σοφίᾳ καὶ συνέσει πνευματικῇ,","tokens":[{"text":"Διὰ"},{"text":"τοῦτο"},{"text":"καὶ"},{"text":"ἡμεῖς"},{"text":"ἀφʼ"},{"text":"ἧς"},{"text":"ἡμέρας"},{"text":"ἠκούσαμεν"},{"text":"οὐ"},{"text":"παυόμεθα"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"προσευχόμενοι"},{"text":"καὶ"},{"text":"αἰτούμενοι"},{"text":"ἵνα"},{"text":"πληρωθῆτε"},{"text":"τὴν"},{"text":"ἐπίγνωσιν"},{"text":"τοῦ"},{"text":"θελήματος"},{"text":"αὐτοῦ"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"σοφίᾳ"},{"text":"καὶ"},{"text":"συνέσει"},{"text":"πνευματικῇ"}],"notes":[],"lang":"grc"},{"n":10,"text":"⸀ περιπατῆσαι ἀξίως τοῦ κυρίου εἰς πᾶσαν ἀρεσκείαν ἐν παντὶ ἔργῳ ἀγαθῷ καρποφοροῦντες καὶ αὐξανόμενοι ⸂ τῇ ἐπιγνώσει⸃ τοῦ θεοῦ,","tokens":[{"text":"περιπατῆσαι"},{"text":"ἀξίως"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"εἰς"},{"text":"πᾶσαν"},{"text":"ἀρεσκείαν"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"ἔργῳ"},{"text":"ἀγαθῷ"},{"text":"καρποφοροῦντες"},{"text":"καὶ"},{"text":"αὐξανόμενοι"},{"text":"τῇ"},{"text":"ἐπιγνώσει"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἐν πάσῃ δυνάμει δυναμούμενοι κατὰ τὸ κράτος τῆς δόξης αὐτοῦ εἰς πᾶσαν ὑπομονὴν καὶ μακροθυμίαν μετὰ χαρᾶς,","tokens":[{"text":"ἐν"},{"text":"πάσῃ"},{"text":"δυνάμει"},{"text":"δυναμούμενοι"},{"text":"κατὰ"},{"text":"τὸ"},{"text":"κράτος"},{"text":"τῆς"},{"text":"δόξης"},{"text":"αὐτοῦ"},{"text":"εἰς"},{"text":"πᾶσαν"},{"text":"ὑπομονὴν"},{"text":"καὶ"},{"text":"μακροθυμίαν"},{"text":"μετὰ"},{"text":"χαρᾶς"}],"notes":[],"lang":"grc"},{"n":12,"text":"εὐχαριστοῦντες τῷ πατρὶ τῷ ἱκανώσαντι ⸀ ὑμᾶς εἰς τὴν μερίδα τοῦ κλήρου τῶν ἁγίων ἐν τῷ φωτί,","tokens":[{"text":"εὐχαριστοῦντες"},{"text":"τῷ"},{"text":"πατρὶ"},{"text":"τῷ"},{"text":"ἱκανώσαντι"},{"text":"ὑμᾶς"},{"text":"εἰς"},{"text":"τὴν"},{"text":"μερίδα"},{"text":"τοῦ"},{"text":"κλήρου"},{"text":"τῶν"},{"text":"ἁγίων"},{"text":"ἐν"},{"text":"τῷ"},{"text":"φωτί"}],"notes":[],"lang":"grc"},{"n":13,"text":"ὃς ἐρρύσατο ἡμᾶς ἐκ τῆς ἐξουσίας τοῦ σκότους καὶ μετέστησεν εἰς τὴν βασιλείαν τοῦ υἱοῦ τῆς ἀγάπης αὐτοῦ,","tokens":[{"text":"ὃς"},{"text":"ἐρρύσατο"},{"text":"ἡμᾶς"},{"text":"ἐκ"},{"text":"τῆς"},{"text":"ἐξουσίας"},{"text":"τοῦ"},{"text":"σκότους"},{"text":"καὶ"},{"text":"μετέστησεν"},{"text":"εἰς"},{"text":"τὴν"},{"text":"βασιλείαν"},{"text":"τοῦ"},{"text":"υἱοῦ"},{"text":"τῆς"},{"text":"ἀγάπης"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἐν ᾧ ἔχομεν τὴν ἀπολύτρωσιν, τὴν ἄφεσιν τῶν ἁμαρτιῶν·","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"ἔχομεν"},{"text":"τὴν"},{"text":"ἀπολύτρωσιν"},{"text":"τὴν"},{"text":"ἄφεσιν"},{"text":"τῶν"},{"text":"ἁμαρτιῶν"}],"notes":[],"lang":"grc"},{"n":15,"text":"ὅς ἐστιν εἰκὼν τοῦ θεοῦ τοῦ ἀοράτου, πρωτότοκος πάσης κτίσεως,","tokens":[{"text":"ὅς"},{"text":"ἐστιν"},{"text":"εἰκὼν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"τοῦ"},{"text":"ἀοράτου"},{"text":"πρωτότοκος"},{"text":"πάσης"},{"text":"κτίσεως"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὅτι ἐν αὐτῷ ἐκτίσθη τὰ ⸀ πάντα ἐν τοῖς οὐρανοῖς ⸀ καὶ ἐπὶ τῆς γῆς, τὰ ὁρατὰ καὶ τὰ ἀόρατα, εἴτε θρόνοι εἴτε κυριότητες εἴτε ἀρχαὶ εἴτε ἐξουσίαι· τὰ πάντα διʼ αὐτοῦ καὶ εἰς αὐτὸν ἔκτισται·","tokens":[{"text":"ὅτι"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"ἐκτίσθη"},{"text":"τὰ"},{"text":"πάντα"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"οὐρανοῖς"},{"text":"καὶ"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"},{"text":"τὰ"},{"text":"ὁρατὰ"},{"text":"καὶ"},{"text":"τὰ"},{"text":"ἀόρατα"},{"text":"εἴτε"},{"text":"θρόνοι"},{"text":"εἴτε"},{"text":"κυριότητες"},{"text":"εἴτε"},{"text":"ἀρχαὶ"},{"text":"εἴτε"},{"text":"ἐξουσίαι"},{"text":"τὰ"},{"text":"πάντα"},{"text":"διʼ"},{"text":"αὐτοῦ"},{"text":"καὶ"},{"text":"εἰς"},{"text":"αὐτὸν"},{"text":"ἔκτισται"}],"notes":[],"lang":"grc"},{"n":17,"text":"καὶ αὐτός ἐστιν πρὸ πάντων καὶ τὰ πάντα ἐν αὐτῷ συνέστηκεν,","tokens":[{"text":"καὶ"},{"text":"αὐτός"},{"text":"ἐστιν"},{"text":"πρὸ"},{"text":"πάντων"},{"text":"καὶ"},{"text":"τὰ"},{"text":"πάντα"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"συνέστηκεν"}],"notes":[],"lang":"grc"},{"n":18,"text":"καὶ αὐτός ἐστιν ἡ κεφαλὴ τοῦ σώματος τῆς ἐκκλησίας· ὅς ⸀ ἐστιν ἀρχή, πρωτότοκος ἐκ τῶν νεκρῶν, ἵνα γένηται ἐν πᾶσιν αὐτὸς πρωτεύων,","tokens":[{"text":"καὶ"},{"text":"αὐτός"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"κεφαλὴ"},{"text":"τοῦ"},{"text":"σώματος"},{"text":"τῆς"},{"text":"ἐκκλησίας"},{"text":"ὅς"},{"text":"ἐστιν"},{"text":"ἀρχή"},{"text":"πρωτότοκος"},{"text":"ἐκ"},{"text":"τῶν"},{"text":"νεκρῶν"},{"text":"ἵνα"},{"text":"γένηται"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"αὐτὸς"},{"text":"πρωτεύων"}],"notes":[],"lang":"grc"},{"n":19,"text":"ὅτι ἐν αὐτῷ εὐδόκησεν πᾶν τὸ πλήρωμα κατοικῆσαι","tokens":[{"text":"ὅτι"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"εὐδόκησεν"},{"text":"πᾶν"},{"text":"τὸ"},{"text":"πλήρωμα"},{"text":"κατοικῆσαι"}],"notes":[],"lang":"grc"},{"n":20,"text":"καὶ διʼ αὐτοῦ ἀποκαταλλάξαι τὰ πάντα εἰς αὐτόν, εἰρηνοποιήσας διὰ τοῦ αἵματος τοῦ σταυροῦ αὐτοῦ,  ⸂[ διʼ αὐτοῦ]⸃ εἴτε τὰ ἐπὶ τῆς γῆς εἴτε τὰ ⸀ ἐν τοῖς οὐρανοῖς·","tokens":[{"text":"καὶ"},{"text":"διʼ"},{"text":"αὐτοῦ"},{"text":"ἀποκαταλλάξαι"},{"text":"τὰ"},{"text":"πάντα"},{"text":"εἰς"},{"text":"αὐτόν"},{"text":"εἰρηνοποιήσας"},{"text":"διὰ"},{"text":"τοῦ"},{"text":"αἵματος"},{"text":"τοῦ"},{"text":"σταυροῦ"},{"text":"αὐτοῦ"},{"text":"διʼ"},{"text":"αὐτοῦ"},{"text":"εἴτε"},{"text":"τὰ"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"},{"text":"εἴτε"},{"text":"τὰ"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"οὐρανοῖς"}],"notes":[],"lang":"grc"},{"n":21,"text":"καὶ ὑμᾶς ποτε ὄντας ἀπηλλοτριωμένους καὶ ἐχθροὺς τῇ διανοίᾳ ἐν τοῖς ἔργοις τοῖς πονηροῖς—","tokens":[{"text":"καὶ"},{"text":"ὑμᾶς"},{"text":"ποτε"},{"text":"ὄντας"},{"text":"ἀπηλλοτριωμένους"},{"text":"καὶ"},{"text":"ἐχθροὺς"},{"text":"τῇ"},{"text":"διανοίᾳ"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"ἔργοις"},{"text":"τοῖς"},{"text":"πονηροῖς"}],"notes":[],"lang":"grc"},{"n":22,"text":"νυνὶ δὲ ⸀ ἀποκατηλλάγητε ἐν τῷ σώματι τῆς σαρκὸς αὐτοῦ διὰ τοῦ θανάτου— παραστῆσαι ὑμᾶς ἁγίους καὶ ἀμώμους καὶ ἀνεγκλήτους κατενώπιον αὐτοῦ,","tokens":[{"text":"νυνὶ"},{"text":"δὲ"},{"text":"ἀποκατηλλάγητε"},{"text":"ἐν"},{"text":"τῷ"},{"text":"σώματι"},{"text":"τῆς"},{"text":"σαρκὸς"},{"text":"αὐτοῦ"},{"text":"διὰ"},{"text":"τοῦ"},{"text":"θανάτου"},{"text":"παραστῆσαι"},{"text":"ὑμᾶς"},{"text":"ἁγίους"},{"text":"καὶ"},{"text":"ἀμώμους"},{"text":"καὶ"},{"text":"ἀνεγκλήτους"},{"text":"κατενώπιον"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":23,"text":"εἴ γε ἐπιμένετε τῇ πίστει τεθεμελιωμένοι καὶ ἑδραῖοι καὶ μὴ μετακινούμενοι ἀπὸ τῆς ἐλπίδος τοῦ εὐαγγελίου οὗ ἠκούσατε, τοῦ κηρυχθέντος ἐν ⸀ πάσῃ κτίσει τῇ ὑπὸ τὸν οὐρανόν, οὗ ἐγενόμην ἐγὼ Παῦλος διάκονος.","tokens":[{"text":"εἴ"},{"text":"γε"},{"text":"ἐπιμένετε"},{"text":"τῇ"},{"text":"πίστει"},{"text":"τεθεμελιωμένοι"},{"text":"καὶ"},{"text":"ἑδραῖοι"},{"text":"καὶ"},{"text":"μὴ"},{"text":"μετακινούμενοι"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"ἐλπίδος"},{"text":"τοῦ"},{"text":"εὐαγγελίου"},{"text":"οὗ"},{"text":"ἠκούσατε"},{"text":"τοῦ"},{"text":"κηρυχθέντος"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"κτίσει"},{"text":"τῇ"},{"text":"ὑπὸ"},{"text":"τὸν"},{"text":"οὐρανόν"},{"text":"οὗ"},{"text":"ἐγενόμην"},{"text":"ἐγὼ"},{"text":"Παῦλος"},{"text":"διάκονος"}],"notes":[],"lang":"grc"},{"n":24,"text":"Νῦν χαίρω ἐν τοῖς παθήμασιν ὑπὲρ ὑμῶν, καὶ ἀνταναπληρῶ τὰ ὑστερήματα τῶν θλίψεων τοῦ Χριστοῦ ἐν τῇ σαρκί μου ὑπὲρ τοῦ σώματος αὐτοῦ, ὅ ἐστιν ἡ ἐκκλησία,","tokens":[{"text":"Νῦν"},{"text":"χαίρω"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"παθήμασιν"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"ἀνταναπληρῶ"},{"text":"τὰ"},{"text":"ὑστερήματα"},{"text":"τῶν"},{"text":"θλίψεων"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"σαρκί"},{"text":"μου"},{"text":"ὑπὲρ"},{"text":"τοῦ"},{"text":"σώματος"},{"text":"αὐτοῦ"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"ἐκκλησία"}],"notes":[],"lang":"grc"},{"n":25,"text":"ἧς ἐγενόμην ἐγὼ διάκονος κατὰ τὴν οἰκονομίαν τοῦ θεοῦ τὴν δοθεῖσάν μοι εἰς ὑμᾶς πληρῶσαι τὸν λόγον τοῦ θεοῦ,","tokens":[{"text":"ἧς"},{"text":"ἐγενόμην"},{"text":"ἐγὼ"},{"text":"διάκονος"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"οἰκονομίαν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"τὴν"},{"text":"δοθεῖσάν"},{"text":"μοι"},{"text":"εἰς"},{"text":"ὑμᾶς"},{"text":"πληρῶσαι"},{"text":"τὸν"},{"text":"λόγον"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":26,"text":"τὸ μυστήριον τὸ ἀποκεκρυμμένον ἀπὸ τῶν αἰώνων καὶ ἀπὸ τῶν γενεῶν,— ⸀ νῦν δὲ ἐφανερώθη τοῖς ἁγίοις αὐτοῦ,","tokens":[{"text":"τὸ"},{"text":"μυστήριον"},{"text":"τὸ"},{"text":"ἀποκεκρυμμένον"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"αἰώνων"},{"text":"καὶ"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"γενεῶν"},{"text":"νῦν"},{"text":"δὲ"},{"text":"ἐφανερώθη"},{"text":"τοῖς"},{"text":"ἁγίοις"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":27,"text":"οἷς ἠθέλησεν ὁ θεὸς γνωρίσαι τί τὸ πλοῦτος τῆς δόξης τοῦ μυστηρίου τούτου ἐν τοῖς ἔθνεσιν,  ⸀ ὅ ἐστιν Χριστὸς ἐν ὑμῖν, ἡ ἐλπὶς τῆς δόξης·","tokens":[{"text":"οἷς"},{"text":"ἠθέλησεν"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"γνωρίσαι"},{"text":"τί"},{"text":"τὸ"},{"text":"πλοῦτος"},{"text":"τῆς"},{"text":"δόξης"},{"text":"τοῦ"},{"text":"μυστηρίου"},{"text":"τούτου"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"ἔθνεσιν"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"Χριστὸς"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"ἡ"},{"text":"ἐλπὶς"},{"text":"τῆς"},{"text":"δόξης"}],"notes":[],"lang":"grc"},{"n":28,"text":"ὃν ἡμεῖς καταγγέλλομεν νουθετοῦντες πάντα ἄνθρωπον καὶ διδάσκοντες πάντα ἄνθρωπον ἐν πάσῃ σοφίᾳ, ἵνα παραστήσωμεν πάντα ἄνθρωπον τέλειον ἐν ⸀ Χριστῷ·","tokens":[{"text":"ὃν"},{"text":"ἡμεῖς"},{"text":"καταγγέλλομεν"},{"text":"νουθετοῦντες"},{"text":"πάντα"},{"text":"ἄνθρωπον"},{"text":"καὶ"},{"text":"διδάσκοντες"},{"text":"πάντα"},{"text":"ἄνθρωπον"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"σοφίᾳ"},{"text":"ἵνα"},{"text":"παραστήσωμεν"},{"text":"πάντα"},{"text":"ἄνθρωπον"},{"text":"τέλειον"},{"text":"ἐν"},{"text":"Χριστῷ"}],"notes":[],"lang":"grc"},{"n":29,"text":"εἰς ὃ καὶ κοπιῶ ἀγωνιζόμενος κατὰ τὴν ἐνέργειαν αὐτοῦ τὴν ἐνεργουμένην ἐν ἐμοὶ ἐν δυνάμει.","tokens":[{"text":"εἰς"},{"text":"ὃ"},{"text":"καὶ"},{"text":"κοπιῶ"},{"text":"ἀγωνιζόμενος"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"ἐνέργειαν"},{"text":"αὐτοῦ"},{"text":"τὴν"},{"text":"ἐνεργουμένην"},{"text":"ἐν"},{"text":"ἐμοὶ"},{"text":"ἐν"},{"text":"δυνάμει"}],"notes":[],"lang":"grc"}],"2":[{"n":1,"text":"Θέλω γὰρ ὑμᾶς εἰδέναι ἡλίκον ἀγῶνα ἔχω ⸀ ὑπὲρ ὑμῶν καὶ τῶν ἐν Λαοδικείᾳ καὶ ὅσοι οὐχ ἑόρακαν τὸ πρόσωπόν μου ἐν σαρκί,","tokens":[{"text":"Θέλω"},{"text":"γὰρ"},{"text":"ὑμᾶς"},{"text":"εἰδέναι"},{"text":"ἡλίκον"},{"text":"ἀγῶνα"},{"text":"ἔχω"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"τῶν"},{"text":"ἐν"},{"text":"Λαοδικείᾳ"},{"text":"καὶ"},{"text":"ὅσοι"},{"text":"οὐχ"},{"text":"ἑόρακαν"},{"text":"τὸ"},{"text":"πρόσωπόν"},{"text":"μου"},{"text":"ἐν"},{"text":"σαρκί"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἵνα παρακληθῶσιν αἱ καρδίαι αὐτῶν,  ⸀ συμβιβασθέντες ἐν ἀγάπῃ καὶ εἰς ⸂ πᾶν πλοῦτος⸃ τῆς πληροφορίας τῆς συνέσεως, εἰς ἐπίγνωσιν τοῦ μυστηρίου τοῦ ⸀ θεοῦ, Χριστοῦ,","tokens":[{"text":"ἵνα"},{"text":"παρακληθῶσιν"},{"text":"αἱ"},{"text":"καρδίαι"},{"text":"αὐτῶν"},{"text":"συμβιβασθέντες"},{"text":"ἐν"},{"text":"ἀγάπῃ"},{"text":"καὶ"},{"text":"εἰς"},{"text":"πᾶν"},{"text":"πλοῦτος"},{"text":"τῆς"},{"text":"πληροφορίας"},{"text":"τῆς"},{"text":"συνέσεως"},{"text":"εἰς"},{"text":"ἐπίγνωσιν"},{"text":"τοῦ"},{"text":"μυστηρίου"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἐν ᾧ εἰσιν πάντες οἱ θησαυροὶ τῆς σοφίας ⸀ καὶ γνώσεως ἀπόκρυφοι.","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"εἰσιν"},{"text":"πάντες"},{"text":"οἱ"},{"text":"θησαυροὶ"},{"text":"τῆς"},{"text":"σοφίας"},{"text":"καὶ"},{"text":"γνώσεως"},{"text":"ἀπόκρυφοι"}],"notes":[],"lang":"grc"},{"n":4,"text":"⸀ τοῦτο λέγω ἵνα ⸀ μηδεὶς ὑμᾶς παραλογίζηται ἐν πιθανολογίᾳ.","tokens":[{"text":"τοῦτο"},{"text":"λέγω"},{"text":"ἵνα"},{"text":"μηδεὶς"},{"text":"ὑμᾶς"},{"text":"παραλογίζηται"},{"text":"ἐν"},{"text":"πιθανολογίᾳ"}],"notes":[],"lang":"grc"},{"n":5,"text":"εἰ γὰρ καὶ τῇ σαρκὶ ἄπειμι, ἀλλὰ τῷ πνεύματι σὺν ὑμῖν εἰμι, χαίρων καὶ βλέπων ὑμῶν τὴν τάξιν καὶ τὸ στερέωμα τῆς εἰς Χριστὸν πίστεως ὑμῶν.","tokens":[{"text":"εἰ"},{"text":"γὰρ"},{"text":"καὶ"},{"text":"τῇ"},{"text":"σαρκὶ"},{"text":"ἄπειμι"},{"text":"ἀλλὰ"},{"text":"τῷ"},{"text":"πνεύματι"},{"text":"σὺν"},{"text":"ὑμῖν"},{"text":"εἰμι"},{"text":"χαίρων"},{"text":"καὶ"},{"text":"βλέπων"},{"text":"ὑμῶν"},{"text":"τὴν"},{"text":"τάξιν"},{"text":"καὶ"},{"text":"τὸ"},{"text":"στερέωμα"},{"text":"τῆς"},{"text":"εἰς"},{"text":"Χριστὸν"},{"text":"πίστεως"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":6,"text":"Ὡς οὖν παρελάβετε τὸν Χριστὸν Ἰησοῦν τὸν κύριον, ἐν αὐτῷ περιπατεῖτε,","tokens":[{"text":"Ὡς"},{"text":"οὖν"},{"text":"παρελάβετε"},{"text":"τὸν"},{"text":"Χριστὸν"},{"text":"Ἰησοῦν"},{"text":"τὸν"},{"text":"κύριον"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"περιπατεῖτε"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἐρριζωμένοι καὶ ἐποικοδομούμενοι ἐν αὐτῷ καὶ ⸀ βεβαιούμενοι τῇ πίστει καθὼς ἐδιδάχθητε,  ⸀ περισσεύοντες ἐν εὐχαριστίᾳ.","tokens":[{"text":"ἐρριζωμένοι"},{"text":"καὶ"},{"text":"ἐποικοδομούμενοι"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"καὶ"},{"text":"βεβαιούμενοι"},{"text":"τῇ"},{"text":"πίστει"},{"text":"καθὼς"},{"text":"ἐδιδάχθητε"},{"text":"περισσεύοντες"},{"text":"ἐν"},{"text":"εὐχαριστίᾳ"}],"notes":[],"lang":"grc"},{"n":8,"text":"Βλέπετε μή τις ὑμᾶς ἔσται ὁ συλαγωγῶν διὰ τῆς φιλοσοφίας καὶ κενῆς ἀπάτης κατὰ τὴν παράδοσιν τῶν ἀνθρώπων, κατὰ τὰ στοιχεῖα τοῦ κόσμου καὶ οὐ κατὰ Χριστόν·","tokens":[{"text":"Βλέπετε"},{"text":"μή"},{"text":"τις"},{"text":"ὑμᾶς"},{"text":"ἔσται"},{"text":"ὁ"},{"text":"συλαγωγῶν"},{"text":"διὰ"},{"text":"τῆς"},{"text":"φιλοσοφίας"},{"text":"καὶ"},{"text":"κενῆς"},{"text":"ἀπάτης"},{"text":"κατὰ"},{"text":"τὴν"},{"text":"παράδοσιν"},{"text":"τῶν"},{"text":"ἀνθρώπων"},{"text":"κατὰ"},{"text":"τὰ"},{"text":"στοιχεῖα"},{"text":"τοῦ"},{"text":"κόσμου"},{"text":"καὶ"},{"text":"οὐ"},{"text":"κατὰ"},{"text":"Χριστόν"}],"notes":[],"lang":"grc"},{"n":9,"text":"ὅτι ἐν αὐτῷ κατοικεῖ πᾶν τὸ πλήρωμα τῆς θεότητος σωματικῶς,","tokens":[{"text":"ὅτι"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"κατοικεῖ"},{"text":"πᾶν"},{"text":"τὸ"},{"text":"πλήρωμα"},{"text":"τῆς"},{"text":"θεότητος"},{"text":"σωματικῶς"}],"notes":[],"lang":"grc"},{"n":10,"text":"καὶ ἐστὲ ἐν αὐτῷ πεπληρωμένοι, ὅς ἐστιν ἡ κεφαλὴ πάσης ἀρχῆς καὶ ἐξουσίας,","tokens":[{"text":"καὶ"},{"text":"ἐστὲ"},{"text":"ἐν"},{"text":"αὐτῷ"},{"text":"πεπληρωμένοι"},{"text":"ὅς"},{"text":"ἐστιν"},{"text":"ἡ"},{"text":"κεφαλὴ"},{"text":"πάσης"},{"text":"ἀρχῆς"},{"text":"καὶ"},{"text":"ἐξουσίας"}],"notes":[],"lang":"grc"},{"n":11,"text":"ἐν ᾧ καὶ περιετμήθητε περιτομῇ ἀχειροποιήτῳ ἐν τῇ ἀπεκδύσει τοῦ ⸀ σώματος τῆς σαρκός, ἐν τῇ περιτομῇ τοῦ Χριστοῦ,","tokens":[{"text":"ἐν"},{"text":"ᾧ"},{"text":"καὶ"},{"text":"περιετμήθητε"},{"text":"περιτομῇ"},{"text":"ἀχειροποιήτῳ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"ἀπεκδύσει"},{"text":"τοῦ"},{"text":"σώματος"},{"text":"τῆς"},{"text":"σαρκός"},{"text":"ἐν"},{"text":"τῇ"},{"text":"περιτομῇ"},{"text":"τοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":12,"text":"συνταφέντες αὐτῷ ἐν τῷ ⸀ βαπτισμῷ, ἐν ᾧ καὶ συνηγέρθητε διὰ τῆς πίστεως τῆς ἐνεργείας τοῦ θεοῦ τοῦ ἐγείραντος αὐτὸν ⸀ ἐκ νεκρῶν·","tokens":[{"text":"συνταφέντες"},{"text":"αὐτῷ"},{"text":"ἐν"},{"text":"τῷ"},{"text":"βαπτισμῷ"},{"text":"ἐν"},{"text":"ᾧ"},{"text":"καὶ"},{"text":"συνηγέρθητε"},{"text":"διὰ"},{"text":"τῆς"},{"text":"πίστεως"},{"text":"τῆς"},{"text":"ἐνεργείας"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"τοῦ"},{"text":"ἐγείραντος"},{"text":"αὐτὸν"},{"text":"ἐκ"},{"text":"νεκρῶν"}],"notes":[],"lang":"grc"},{"n":13,"text":"καὶ ὑμᾶς νεκροὺς ὄντας ⸀ ἐν τοῖς παραπτώμασιν καὶ τῇ ἀκροβυστίᾳ τῆς σαρκὸς ὑμῶν, συνεζωοποίησεν ὑμᾶς σὺν αὐτῷ· χαρισάμενος ἡμῖν πάντα τὰ παραπτώματα,","tokens":[{"text":"καὶ"},{"text":"ὑμᾶς"},{"text":"νεκροὺς"},{"text":"ὄντας"},{"text":"ἐν"},{"text":"τοῖς"},{"text":"παραπτώμασιν"},{"text":"καὶ"},{"text":"τῇ"},{"text":"ἀκροβυστίᾳ"},{"text":"τῆς"},{"text":"σαρκὸς"},{"text":"ὑμῶν"},{"text":"συνεζωοποίησεν"},{"text":"ὑμᾶς"},{"text":"σὺν"},{"text":"αὐτῷ"},{"text":"χαρισάμενος"},{"text":"ἡμῖν"},{"text":"πάντα"},{"text":"τὰ"},{"text":"παραπτώματα"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἐξαλείψας τὸ καθʼ ἡμῶν χειρόγραφον τοῖς δόγμασιν ὃ ἦν ὑπεναντίον ἡμῖν, καὶ αὐτὸ ἦρκεν ἐκ τοῦ μέσου προσηλώσας αὐτὸ τῷ σταυρῷ·","tokens":[{"text":"ἐξαλείψας"},{"text":"τὸ"},{"text":"καθʼ"},{"text":"ἡμῶν"},{"text":"χειρόγραφον"},{"text":"τοῖς"},{"text":"δόγμασιν"},{"text":"ὃ"},{"text":"ἦν"},{"text":"ὑπεναντίον"},{"text":"ἡμῖν"},{"text":"καὶ"},{"text":"αὐτὸ"},{"text":"ἦρκεν"},{"text":"ἐκ"},{"text":"τοῦ"},{"text":"μέσου"},{"text":"προσηλώσας"},{"text":"αὐτὸ"},{"text":"τῷ"},{"text":"σταυρῷ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἀπεκδυσάμενος τὰς ἀρχὰς καὶ τὰς ἐξουσίας ἐδειγμάτισεν ἐν παρρησίᾳ, θριαμβεύσας αὐτοὺς ἐν αὐτῷ.","tokens":[{"text":"ἀπεκδυσάμενος"},{"text":"τὰς"},{"text":"ἀρχὰς"},{"text":"καὶ"},{"text":"τὰς"},{"text":"ἐξουσίας"},{"text":"ἐδειγμάτισεν"},{"text":"ἐν"},{"text":"παρρησίᾳ"},{"text":"θριαμβεύσας"},{"text":"αὐτοὺς"},{"text":"ἐν"},{"text":"αὐτῷ"}],"notes":[],"lang":"grc"},{"n":16,"text":"Μὴ οὖν τις ὑμᾶς κρινέτω ἐν βρώσει ⸀ ἢ ἐν πόσει ἢ ἐν μέρει ἑορτῆς ἢ νουμηνίας ἢ σαββάτων,","tokens":[{"text":"Μὴ"},{"text":"οὖν"},{"text":"τις"},{"text":"ὑμᾶς"},{"text":"κρινέτω"},{"text":"ἐν"},{"text":"βρώσει"},{"text":"ἢ"},{"text":"ἐν"},{"text":"πόσει"},{"text":"ἢ"},{"text":"ἐν"},{"text":"μέρει"},{"text":"ἑορτῆς"},{"text":"ἢ"},{"text":"νουμηνίας"},{"text":"ἢ"},{"text":"σαββάτων"}],"notes":[],"lang":"grc"},{"n":17,"text":"ἅ ἐστιν σκιὰ τῶν μελλόντων, τὸ δὲ σῶμα ⸀ τοῦ Χριστοῦ.","tokens":[{"text":"ἅ"},{"text":"ἐστιν"},{"text":"σκιὰ"},{"text":"τῶν"},{"text":"μελλόντων"},{"text":"τὸ"},{"text":"δὲ"},{"text":"σῶμα"},{"text":"τοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":18,"text":"μηδεὶς ὑμᾶς καταβραβευέτω θέλων ἐν ταπεινοφροσύνῃ καὶ θρησκείᾳ τῶν ἀγγέλων,  ⸀ ἃ ἑόρακεν ἐμβατεύων, εἰκῇ φυσιούμενος ὑπὸ τοῦ νοὸς τῆς σαρκὸς αὐτοῦ,","tokens":[{"text":"μηδεὶς"},{"text":"ὑμᾶς"},{"text":"καταβραβευέτω"},{"text":"θέλων"},{"text":"ἐν"},{"text":"ταπεινοφροσύνῃ"},{"text":"καὶ"},{"text":"θρησκείᾳ"},{"text":"τῶν"},{"text":"ἀγγέλων"},{"text":"ἃ"},{"text":"ἑόρακεν"},{"text":"ἐμβατεύων"},{"text":"εἰκῇ"},{"text":"φυσιούμενος"},{"text":"ὑπὸ"},{"text":"τοῦ"},{"text":"νοὸς"},{"text":"τῆς"},{"text":"σαρκὸς"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":19,"text":"καὶ οὐ κρατῶν τὴν κεφαλήν, ἐξ οὗ πᾶν τὸ σῶμα διὰ τῶν ἁφῶν καὶ συνδέσμων ἐπιχορηγούμενον καὶ συμβιβαζόμενον αὔξει τὴν αὔξησιν τοῦ θεοῦ.","tokens":[{"text":"καὶ"},{"text":"οὐ"},{"text":"κρατῶν"},{"text":"τὴν"},{"text":"κεφαλήν"},{"text":"ἐξ"},{"text":"οὗ"},{"text":"πᾶν"},{"text":"τὸ"},{"text":"σῶμα"},{"text":"διὰ"},{"text":"τῶν"},{"text":"ἁφῶν"},{"text":"καὶ"},{"text":"συνδέσμων"},{"text":"ἐπιχορηγούμενον"},{"text":"καὶ"},{"text":"συμβιβαζόμενον"},{"text":"αὔξει"},{"text":"τὴν"},{"text":"αὔξησιν"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":20,"text":"Εἰ ἀπεθάνετε σὺν Χριστῷ ἀπὸ τῶν στοιχείων τοῦ κόσμου, τί ὡς ζῶντες ἐν κόσμῳ δογματίζεσθε·","tokens":[{"text":"Εἰ"},{"text":"ἀπεθάνετε"},{"text":"σὺν"},{"text":"Χριστῷ"},{"text":"ἀπὸ"},{"text":"τῶν"},{"text":"στοιχείων"},{"text":"τοῦ"},{"text":"κόσμου"},{"text":"τί"},{"text":"ὡς"},{"text":"ζῶντες"},{"text":"ἐν"},{"text":"κόσμῳ"},{"text":"δογματίζεσθε"}],"notes":[],"lang":"grc"},{"n":21,"text":"Μὴ ἅψῃ μηδὲ γεύσῃ μηδὲ θίγῃς,","tokens":[{"text":"Μὴ"},{"text":"ἅψῃ"},{"text":"μηδὲ"},{"text":"γεύσῃ"},{"text":"μηδὲ"},{"text":"θίγῃς"}],"notes":[],"lang":"grc"},{"n":22,"text":"ἅ ἐστιν πάντα εἰς φθορὰν τῇ ἀποχρήσει, κατὰ τὰ ἐντάλματα καὶ διδασκαλίας τῶν ἀνθρώπων;","tokens":[{"text":"ἅ"},{"text":"ἐστιν"},{"text":"πάντα"},{"text":"εἰς"},{"text":"φθορὰν"},{"text":"τῇ"},{"text":"ἀποχρήσει"},{"text":"κατὰ"},{"text":"τὰ"},{"text":"ἐντάλματα"},{"text":"καὶ"},{"text":"διδασκαλίας"},{"text":"τῶν"},{"text":"ἀνθρώπων"}],"notes":[],"lang":"grc"},{"n":23,"text":"ἅτινά ἐστιν λόγον μὲν ἔχοντα σοφίας ἐν ἐθελοθρησκίᾳ καὶ ταπεινοφροσύνῃ καὶ ἀφειδίᾳ σώματος, οὐκ ἐν τιμῇ τινι πρὸς πλησμονὴν τῆς σαρκός.","tokens":[{"text":"ἅτινά"},{"text":"ἐστιν"},{"text":"λόγον"},{"text":"μὲν"},{"text":"ἔχοντα"},{"text":"σοφίας"},{"text":"ἐν"},{"text":"ἐθελοθρησκίᾳ"},{"text":"καὶ"},{"text":"ταπεινοφροσύνῃ"},{"text":"καὶ"},{"text":"ἀφειδίᾳ"},{"text":"σώματος"},{"text":"οὐκ"},{"text":"ἐν"},{"text":"τιμῇ"},{"text":"τινι"},{"text":"πρὸς"},{"text":"πλησμονὴν"},{"text":"τῆς"},{"text":"σαρκός"}],"notes":[],"lang":"grc"}],"3":[{"n":1,"text":"Εἰ οὖν συνηγέρθητε τῷ Χριστῷ, τὰ ἄνω ζητεῖτε, οὗ ὁ Χριστός ἐστιν ἐν δεξιᾷ τοῦ θεοῦ καθήμενος·","tokens":[{"text":"Εἰ"},{"text":"οὖν"},{"text":"συνηγέρθητε"},{"text":"τῷ"},{"text":"Χριστῷ"},{"text":"τὰ"},{"text":"ἄνω"},{"text":"ζητεῖτε"},{"text":"οὗ"},{"text":"ὁ"},{"text":"Χριστός"},{"text":"ἐστιν"},{"text":"ἐν"},{"text":"δεξιᾷ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"καθήμενος"}],"notes":[],"lang":"grc"},{"n":2,"text":"τὰ ἄνω φρονεῖτε, μὴ τὰ ἐπὶ τῆς γῆς,","tokens":[{"text":"τὰ"},{"text":"ἄνω"},{"text":"φρονεῖτε"},{"text":"μὴ"},{"text":"τὰ"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"}],"notes":[],"lang":"grc"},{"n":3,"text":"ἀπεθάνετε γάρ, καὶ ἡ ζωὴ ὑμῶν κέκρυπται σὺν τῷ Χριστῷ ἐν τῷ θεῷ·","tokens":[{"text":"ἀπεθάνετε"},{"text":"γάρ"},{"text":"καὶ"},{"text":"ἡ"},{"text":"ζωὴ"},{"text":"ὑμῶν"},{"text":"κέκρυπται"},{"text":"σὺν"},{"text":"τῷ"},{"text":"Χριστῷ"},{"text":"ἐν"},{"text":"τῷ"},{"text":"θεῷ"}],"notes":[],"lang":"grc"},{"n":4,"text":"ὅταν ὁ Χριστὸς φανερωθῇ, ἡ ζωὴ ⸀ ὑμῶν, τότε καὶ ὑμεῖς σὺν αὐτῷ φανερωθήσεσθε ἐν δόξῃ.","tokens":[{"text":"ὅταν"},{"text":"ὁ"},{"text":"Χριστὸς"},{"text":"φανερωθῇ"},{"text":"ἡ"},{"text":"ζωὴ"},{"text":"ὑμῶν"},{"text":"τότε"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"σὺν"},{"text":"αὐτῷ"},{"text":"φανερωθήσεσθε"},{"text":"ἐν"},{"text":"δόξῃ"}],"notes":[],"lang":"grc"},{"n":5,"text":"Νεκρώσατε οὖν τὰ ⸀ μέλη τὰ ἐπὶ τῆς γῆς, πορνείαν, ἀκαθαρσίαν, πάθος, ἐπιθυμίαν κακήν, καὶ τὴν πλεονεξίαν ἥτις ἐστὶν εἰδωλολατρία,","tokens":[{"text":"Νεκρώσατε"},{"text":"οὖν"},{"text":"τὰ"},{"text":"μέλη"},{"text":"τὰ"},{"text":"ἐπὶ"},{"text":"τῆς"},{"text":"γῆς"},{"text":"πορνείαν"},{"text":"ἀκαθαρσίαν"},{"text":"πάθος"},{"text":"ἐπιθυμίαν"},{"text":"κακήν"},{"text":"καὶ"},{"text":"τὴν"},{"text":"πλεονεξίαν"},{"text":"ἥτις"},{"text":"ἐστὶν"},{"text":"εἰδωλολατρία"}],"notes":[],"lang":"grc"},{"n":6,"text":"διʼ ἃ ἔρχεται ἡ ὀργὴ τοῦ θεοῦ ⸂ ἐπὶ τοὺς υἱοὺς τῆς ἀπειθείας⸃·","tokens":[{"text":"διʼ"},{"text":"ἃ"},{"text":"ἔρχεται"},{"text":"ἡ"},{"text":"ὀργὴ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἐπὶ"},{"text":"τοὺς"},{"text":"υἱοὺς"},{"text":"τῆς"},{"text":"ἀπειθείας"}],"notes":[],"lang":"grc"},{"n":7,"text":"ἐν οἷς καὶ ὑμεῖς περιεπατήσατέ ποτε ὅτε ἐζῆτε ἐν ⸀ τούτοις·","tokens":[{"text":"ἐν"},{"text":"οἷς"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"περιεπατήσατέ"},{"text":"ποτε"},{"text":"ὅτε"},{"text":"ἐζῆτε"},{"text":"ἐν"},{"text":"τούτοις"}],"notes":[],"lang":"grc"},{"n":8,"text":"νυνὶ δὲ ἀπόθεσθε καὶ ὑμεῖς τὰ πάντα, ὀργήν, θυμόν, κακίαν, βλασφημίαν, αἰσχρολογίαν ἐκ τοῦ στόματος ὑμῶν·","tokens":[{"text":"νυνὶ"},{"text":"δὲ"},{"text":"ἀπόθεσθε"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"τὰ"},{"text":"πάντα"},{"text":"ὀργήν"},{"text":"θυμόν"},{"text":"κακίαν"},{"text":"βλασφημίαν"},{"text":"αἰσχρολογίαν"},{"text":"ἐκ"},{"text":"τοῦ"},{"text":"στόματος"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":9,"text":"μὴ ψεύδεσθε εἰς ἀλλήλους· ἀπεκδυσάμενοι τὸν παλαιὸν ἄνθρωπον σὺν ταῖς πράξεσιν αὐτοῦ,","tokens":[{"text":"μὴ"},{"text":"ψεύδεσθε"},{"text":"εἰς"},{"text":"ἀλλήλους"},{"text":"ἀπεκδυσάμενοι"},{"text":"τὸν"},{"text":"παλαιὸν"},{"text":"ἄνθρωπον"},{"text":"σὺν"},{"text":"ταῖς"},{"text":"πράξεσιν"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":10,"text":"καὶ ἐνδυσάμενοι τὸν νέον τὸν ἀνακαινούμενον εἰς ἐπίγνωσιν κατʼ εἰκόνα τοῦ κτίσαντος αὐτόν,","tokens":[{"text":"καὶ"},{"text":"ἐνδυσάμενοι"},{"text":"τὸν"},{"text":"νέον"},{"text":"τὸν"},{"text":"ἀνακαινούμενον"},{"text":"εἰς"},{"text":"ἐπίγνωσιν"},{"text":"κατʼ"},{"text":"εἰκόνα"},{"text":"τοῦ"},{"text":"κτίσαντος"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":11,"text":"ὅπου οὐκ ἔνι Ἕλλην καὶ Ἰουδαῖος, περιτομὴ καὶ ἀκροβυστία, βάρβαρος, Σκύθης, δοῦλος, ἐλεύθερος, ἀλλὰ ⸀ τὰ πάντα καὶ ἐν πᾶσιν Χριστός.","tokens":[{"text":"ὅπου"},{"text":"οὐκ"},{"text":"ἔνι"},{"text":"Ἕλλην"},{"text":"καὶ"},{"text":"Ἰουδαῖος"},{"text":"περιτομὴ"},{"text":"καὶ"},{"text":"ἀκροβυστία"},{"text":"βάρβαρος"},{"text":"Σκύθης"},{"text":"δοῦλος"},{"text":"ἐλεύθερος"},{"text":"ἀλλὰ"},{"text":"τὰ"},{"text":"πάντα"},{"text":"καὶ"},{"text":"ἐν"},{"text":"πᾶσιν"},{"text":"Χριστός"}],"notes":[],"lang":"grc"},{"n":12,"text":"Ἐνδύσασθε οὖν ὡς ἐκλεκτοὶ τοῦ θεοῦ, ἅγιοι καὶ ἠγαπημένοι, σπλάγχνα οἰκτιρμοῦ, χρηστότητα, ταπεινοφροσύνην, πραΰτητα, μακροθυμίαν,","tokens":[{"text":"Ἐνδύσασθε"},{"text":"οὖν"},{"text":"ὡς"},{"text":"ἐκλεκτοὶ"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἅγιοι"},{"text":"καὶ"},{"text":"ἠγαπημένοι"},{"text":"σπλάγχνα"},{"text":"οἰκτιρμοῦ"},{"text":"χρηστότητα"},{"text":"ταπεινοφροσύνην"},{"text":"πραΰτητα"},{"text":"μακροθυμίαν"}],"notes":[],"lang":"grc"},{"n":13,"text":"ἀνεχόμενοι ἀλλήλων καὶ χαριζόμενοι ἑαυτοῖς ἐάν τις πρός τινα ἔχῃ μομφήν· καθὼς καὶ ὁ ⸀ κύριος ἐχαρίσατο ὑμῖν οὕτως καὶ ὑμεῖς·","tokens":[{"text":"ἀνεχόμενοι"},{"text":"ἀλλήλων"},{"text":"καὶ"},{"text":"χαριζόμενοι"},{"text":"ἑαυτοῖς"},{"text":"ἐάν"},{"text":"τις"},{"text":"πρός"},{"text":"τινα"},{"text":"ἔχῃ"},{"text":"μομφήν"},{"text":"καθὼς"},{"text":"καὶ"},{"text":"ὁ"},{"text":"κύριος"},{"text":"ἐχαρίσατο"},{"text":"ὑμῖν"},{"text":"οὕτως"},{"text":"καὶ"},{"text":"ὑμεῖς"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἐπὶ πᾶσιν δὲ τούτοις τὴν ἀγάπην,  ⸀ ὅ ἐστιν σύνδεσμος τῆς τελειότητος.","tokens":[{"text":"ἐπὶ"},{"text":"πᾶσιν"},{"text":"δὲ"},{"text":"τούτοις"},{"text":"τὴν"},{"text":"ἀγάπην"},{"text":"ὅ"},{"text":"ἐστιν"},{"text":"σύνδεσμος"},{"text":"τῆς"},{"text":"τελειότητος"}],"notes":[],"lang":"grc"},{"n":15,"text":"καὶ ἡ εἰρήνη τοῦ ⸀ Χριστοῦ βραβευέτω ἐν ταῖς καρδίαις ὑμῶν, εἰς ἣν καὶ ἐκλήθητε ἐν ἑνὶ σώματι· καὶ εὐχάριστοι γίνεσθε.","tokens":[{"text":"καὶ"},{"text":"ἡ"},{"text":"εἰρήνη"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"βραβευέτω"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"καρδίαις"},{"text":"ὑμῶν"},{"text":"εἰς"},{"text":"ἣν"},{"text":"καὶ"},{"text":"ἐκλήθητε"},{"text":"ἐν"},{"text":"ἑνὶ"},{"text":"σώματι"},{"text":"καὶ"},{"text":"εὐχάριστοι"},{"text":"γίνεσθε"}],"notes":[],"lang":"grc"},{"n":16,"text":"ὁ λόγος τοῦ Χριστοῦ ἐνοικείτω ἐν ὑμῖν πλουσίως ἐν πάσῃ σοφίᾳ· διδάσκοντες καὶ νουθετοῦντες ἑαυτοὺς ⸀ ψαλμοῖς,  ⸀ ὕμνοις, ᾠδαῖς πνευματικαῖς ⸀ ἐν χάριτι, ᾄδοντες ἐν ⸂ ταῖς καρδίαις⸃ ὑμῶν τῷ ⸀ θεῷ·","tokens":[{"text":"ὁ"},{"text":"λόγος"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"ἐνοικείτω"},{"text":"ἐν"},{"text":"ὑμῖν"},{"text":"πλουσίως"},{"text":"ἐν"},{"text":"πάσῃ"},{"text":"σοφίᾳ"},{"text":"διδάσκοντες"},{"text":"καὶ"},{"text":"νουθετοῦντες"},{"text":"ἑαυτοὺς"},{"text":"ψαλμοῖς"},{"text":"ὕμνοις"},{"text":"ᾠδαῖς"},{"text":"πνευματικαῖς"},{"text":"ἐν"},{"text":"χάριτι"},{"text":"ᾄδοντες"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"καρδίαις"},{"text":"ὑμῶν"},{"text":"τῷ"},{"text":"θεῷ"}],"notes":[],"lang":"grc"},{"n":17,"text":"καὶ πᾶν ⸂ ὅ τι⸃  ⸀ ἐὰν ποιῆτε ἐν λόγῳ ἢ ἐν ἔργῳ, πάντα ἐν ὀνόματι κυρίου Ἰησοῦ, εὐχαριστοῦντες τῷ ⸀ θεῷ πατρὶ διʼ αὐτοῦ.","tokens":[{"text":"καὶ"},{"text":"πᾶν"},{"text":"ὅ"},{"text":"τι"},{"text":"ἐὰν"},{"text":"ποιῆτε"},{"text":"ἐν"},{"text":"λόγῳ"},{"text":"ἢ"},{"text":"ἐν"},{"text":"ἔργῳ"},{"text":"πάντα"},{"text":"ἐν"},{"text":"ὀνόματι"},{"text":"κυρίου"},{"text":"Ἰησοῦ"},{"text":"εὐχαριστοῦντες"},{"text":"τῷ"},{"text":"θεῷ"},{"text":"πατρὶ"},{"text":"διʼ"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":18,"text":"Αἱ γυναῖκες, ὑποτάσσεσθε ⸀ τοῖς ἀνδράσιν, ὡς ἀνῆκεν ἐν κυρίῳ.","tokens":[{"text":"Αἱ"},{"text":"γυναῖκες"},{"text":"ὑποτάσσεσθε"},{"text":"τοῖς"},{"text":"ἀνδράσιν"},{"text":"ὡς"},{"text":"ἀνῆκεν"},{"text":"ἐν"},{"text":"κυρίῳ"}],"notes":[],"lang":"grc"},{"n":19,"text":"οἱ ἄνδρες, ἀγαπᾶτε τὰς γυναῖκας καὶ μὴ πικραίνεσθε πρὸς αὐτάς.","tokens":[{"text":"οἱ"},{"text":"ἄνδρες"},{"text":"ἀγαπᾶτε"},{"text":"τὰς"},{"text":"γυναῖκας"},{"text":"καὶ"},{"text":"μὴ"},{"text":"πικραίνεσθε"},{"text":"πρὸς"},{"text":"αὐτάς"}],"notes":[],"lang":"grc"},{"n":20,"text":"Τὰ τέκνα, ὑπακούετε τοῖς γονεῦσιν κατὰ πάντα, τοῦτο γὰρ ⸂ εὐάρεστόν ἐστιν⸃ ἐν κυρίῳ.","tokens":[{"text":"Τὰ"},{"text":"τέκνα"},{"text":"ὑπακούετε"},{"text":"τοῖς"},{"text":"γονεῦσιν"},{"text":"κατὰ"},{"text":"πάντα"},{"text":"τοῦτο"},{"text":"γὰρ"},{"text":"εὐάρεστόν"},{"text":"ἐστιν"},{"text":"ἐν"},{"text":"κυρίῳ"}],"notes":[],"lang":"grc"},{"n":21,"text":"οἱ πατέρες, μὴ ἐρεθίζετε τὰ τέκνα ὑμῶν, ἵνα μὴ ἀθυμῶσιν.","tokens":[{"text":"οἱ"},{"text":"πατέρες"},{"text":"μὴ"},{"text":"ἐρεθίζετε"},{"text":"τὰ"},{"text":"τέκνα"},{"text":"ὑμῶν"},{"text":"ἵνα"},{"text":"μὴ"},{"text":"ἀθυμῶσιν"}],"notes":[],"lang":"grc"},{"n":22,"text":"οἱ δοῦλοι, ὑπακούετε κατὰ πάντα τοῖς κατὰ σάρκα κυρίοις, μὴ ἐν ⸀ ὀφθαλμοδουλίαις, ὡς ἀνθρωπάρεσκοι, ἀλλʼ ἐν ἁπλότητι καρδίας, φοβούμενοι τὸν ⸀ κύριον.","tokens":[{"text":"οἱ"},{"text":"δοῦλοι"},{"text":"ὑπακούετε"},{"text":"κατὰ"},{"text":"πάντα"},{"text":"τοῖς"},{"text":"κατὰ"},{"text":"σάρκα"},{"text":"κυρίοις"},{"text":"μὴ"},{"text":"ἐν"},{"text":"ὀφθαλμοδουλίαις"},{"text":"ὡς"},{"text":"ἀνθρωπάρεσκοι"},{"text":"ἀλλʼ"},{"text":"ἐν"},{"text":"ἁπλότητι"},{"text":"καρδίας"},{"text":"φοβούμενοι"},{"text":"τὸν"},{"text":"κύριον"}],"notes":[],"lang":"grc"},{"n":23,"text":"⸀ ὃ ἐὰν ποιῆτε, ἐκ ψυχῆς ἐργάζεσθε, ὡς τῷ κυρίῳ καὶ οὐκ ἀνθρώποις,","tokens":[{"text":"ὃ"},{"text":"ἐὰν"},{"text":"ποιῆτε"},{"text":"ἐκ"},{"text":"ψυχῆς"},{"text":"ἐργάζεσθε"},{"text":"ὡς"},{"text":"τῷ"},{"text":"κυρίῳ"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἀνθρώποις"}],"notes":[],"lang":"grc"},{"n":24,"text":"εἰδότες ὅτι ἀπὸ κυρίου ⸀ ἀπολήμψεσθε τὴν ἀνταπόδοσιν τῆς κληρονομίας·  ⸀ τῷ κυρίῳ Χριστῷ δουλεύετε·","tokens":[{"text":"εἰδότες"},{"text":"ὅτι"},{"text":"ἀπὸ"},{"text":"κυρίου"},{"text":"ἀπολήμψεσθε"},{"text":"τὴν"},{"text":"ἀνταπόδοσιν"},{"text":"τῆς"},{"text":"κληρονομίας"},{"text":"τῷ"},{"text":"κυρίῳ"},{"text":"Χριστῷ"},{"text":"δουλεύετε"}],"notes":[],"lang":"grc"},{"n":25,"text":"ὁ ⸀ γὰρ ἀδικῶν κομίσεται ὃ ἠδίκησεν, καὶ οὐκ ἔστιν προσωπολημψία.","tokens":[{"text":"ὁ"},{"text":"γὰρ"},{"text":"ἀδικῶν"},{"text":"κομίσεται"},{"text":"ὃ"},{"text":"ἠδίκησεν"},{"text":"καὶ"},{"text":"οὐκ"},{"text":"ἔστιν"},{"text":"προσωπολημψία"}],"notes":[],"lang":"grc"}],"4":[{"n":1,"text":"οἱ κύριοι, τὸ δίκαιον καὶ τὴν ἰσότητα τοῖς δούλοις παρέχεσθε, εἰδότες ὅτι καὶ ὑμεῖς ἔχετε κύριον ἐν ⸀ οὐρανῷ.","tokens":[{"text":"οἱ"},{"text":"κύριοι"},{"text":"τὸ"},{"text":"δίκαιον"},{"text":"καὶ"},{"text":"τὴν"},{"text":"ἰσότητα"},{"text":"τοῖς"},{"text":"δούλοις"},{"text":"παρέχεσθε"},{"text":"εἰδότες"},{"text":"ὅτι"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"ἔχετε"},{"text":"κύριον"},{"text":"ἐν"},{"text":"οὐρανῷ"}],"notes":[],"lang":"grc"},{"n":2,"text":"Τῇ προσευχῇ προσκαρτερεῖτε, γρηγοροῦντες ἐν αὐτῇ ἐν εὐχαριστίᾳ,","tokens":[{"text":"Τῇ"},{"text":"προσευχῇ"},{"text":"προσκαρτερεῖτε"},{"text":"γρηγοροῦντες"},{"text":"ἐν"},{"text":"αὐτῇ"},{"text":"ἐν"},{"text":"εὐχαριστίᾳ"}],"notes":[],"lang":"grc"},{"n":3,"text":"προσευχόμενοι ἅμα καὶ περὶ ἡμῶν, ἵνα ὁ θεὸς ἀνοίξῃ ἡμῖν θύραν τοῦ λόγου, λαλῆσαι τὸ μυστήριον τοῦ Χριστοῦ, διʼ ὃ καὶ δέδεμαι,","tokens":[{"text":"προσευχόμενοι"},{"text":"ἅμα"},{"text":"καὶ"},{"text":"περὶ"},{"text":"ἡμῶν"},{"text":"ἵνα"},{"text":"ὁ"},{"text":"θεὸς"},{"text":"ἀνοίξῃ"},{"text":"ἡμῖν"},{"text":"θύραν"},{"text":"τοῦ"},{"text":"λόγου"},{"text":"λαλῆσαι"},{"text":"τὸ"},{"text":"μυστήριον"},{"text":"τοῦ"},{"text":"Χριστοῦ"},{"text":"διʼ"},{"text":"ὃ"},{"text":"καὶ"},{"text":"δέδεμαι"}],"notes":[],"lang":"grc"},{"n":4,"text":"ἵνα φανερώσω αὐτὸ ὡς δεῖ με λαλῆσαι.","tokens":[{"text":"ἵνα"},{"text":"φανερώσω"},{"text":"αὐτὸ"},{"text":"ὡς"},{"text":"δεῖ"},{"text":"με"},{"text":"λαλῆσαι"}],"notes":[],"lang":"grc"},{"n":5,"text":"Ἐν σοφίᾳ περιπατεῖτε πρὸς τοὺς ἔξω, τὸν καιρὸν ἐξαγοραζόμενοι.","tokens":[{"text":"Ἐν"},{"text":"σοφίᾳ"},{"text":"περιπατεῖτε"},{"text":"πρὸς"},{"text":"τοὺς"},{"text":"ἔξω"},{"text":"τὸν"},{"text":"καιρὸν"},{"text":"ἐξαγοραζόμενοι"}],"notes":[],"lang":"grc"},{"n":6,"text":"ὁ λόγος ὑμῶν πάντοτε ἐν χάριτι, ἅλατι ἠρτυμένος, εἰδέναι πῶς δεῖ ὑμᾶς ἑνὶ ἑκάστῳ ἀποκρίνεσθαι.","tokens":[{"text":"ὁ"},{"text":"λόγος"},{"text":"ὑμῶν"},{"text":"πάντοτε"},{"text":"ἐν"},{"text":"χάριτι"},{"text":"ἅλατι"},{"text":"ἠρτυμένος"},{"text":"εἰδέναι"},{"text":"πῶς"},{"text":"δεῖ"},{"text":"ὑμᾶς"},{"text":"ἑνὶ"},{"text":"ἑκάστῳ"},{"text":"ἀποκρίνεσθαι"}],"notes":[],"lang":"grc"},{"n":7,"text":"Τὰ κατʼ ἐμὲ πάντα γνωρίσει ὑμῖν Τυχικὸς ὁ ἀγαπητὸς ἀδελφὸς καὶ πιστὸς διάκονος καὶ σύνδουλος ἐν κυρίῳ,","tokens":[{"text":"Τὰ"},{"text":"κατʼ"},{"text":"ἐμὲ"},{"text":"πάντα"},{"text":"γνωρίσει"},{"text":"ὑμῖν"},{"text":"Τυχικὸς"},{"text":"ὁ"},{"text":"ἀγαπητὸς"},{"text":"ἀδελφὸς"},{"text":"καὶ"},{"text":"πιστὸς"},{"text":"διάκονος"},{"text":"καὶ"},{"text":"σύνδουλος"},{"text":"ἐν"},{"text":"κυρίῳ"}],"notes":[],"lang":"grc"},{"n":8,"text":"ὃν ἔπεμψα πρὸς ὑμᾶς εἰς αὐτὸ τοῦτο ἵνα ⸀ γνῶτε τὰ περὶ ⸀ ἡμῶν καὶ παρακαλέσῃ τὰς καρδίας ὑμῶν,","tokens":[{"text":"ὃν"},{"text":"ἔπεμψα"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"εἰς"},{"text":"αὐτὸ"},{"text":"τοῦτο"},{"text":"ἵνα"},{"text":"γνῶτε"},{"text":"τὰ"},{"text":"περὶ"},{"text":"ἡμῶν"},{"text":"καὶ"},{"text":"παρακαλέσῃ"},{"text":"τὰς"},{"text":"καρδίας"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"},{"n":9,"text":"σὺν Ὀνησίμῳ τῷ πιστῷ καὶ ἀγαπητῷ ἀδελφῷ, ὅς ἐστιν ἐξ ὑμῶν· πάντα ὑμῖν γνωρίσουσιν τὰ ὧδε.","tokens":[{"text":"σὺν"},{"text":"Ὀνησίμῳ"},{"text":"τῷ"},{"text":"πιστῷ"},{"text":"καὶ"},{"text":"ἀγαπητῷ"},{"text":"ἀδελφῷ"},{"text":"ὅς"},{"text":"ἐστιν"},{"text":"ἐξ"},{"text":"ὑμῶν"},{"text":"πάντα"},{"text":"ὑμῖν"},{"text":"γνωρίσουσιν"},{"text":"τὰ"},{"text":"ὧδε"}],"notes":[],"lang":"grc"},{"n":10,"text":"Ἀσπάζεται ὑμᾶς Ἀρίσταρχος ὁ συναιχμάλωτός μου, καὶ Μᾶρκος ὁ ἀνεψιὸς Βαρναβᾶ ( περὶ οὗ ἐλάβετε ἐντολάς, ἐὰν ἔλθῃ πρὸς ὑμᾶς δέξασθε αὐτόν),","tokens":[{"text":"Ἀσπάζεται"},{"text":"ὑμᾶς"},{"text":"Ἀρίσταρχος"},{"text":"ὁ"},{"text":"συναιχμάλωτός"},{"text":"μου"},{"text":"καὶ"},{"text":"Μᾶρκος"},{"text":"ὁ"},{"text":"ἀνεψιὸς"},{"text":"Βαρναβᾶ"},{"text":"περὶ"},{"text":"οὗ"},{"text":"ἐλάβετε"},{"text":"ἐντολάς"},{"text":"ἐὰν"},{"text":"ἔλθῃ"},{"text":"πρὸς"},{"text":"ὑμᾶς"},{"text":"δέξασθε"},{"text":"αὐτόν"}],"notes":[],"lang":"grc"},{"n":11,"text":"καὶ Ἰησοῦς ὁ λεγόμενος Ἰοῦστος, οἱ ὄντες ἐκ περιτομῆς, οὗτοι μόνοι συνεργοὶ εἰς τὴν βασιλείαν τοῦ θεοῦ, οἵτινες ἐγενήθησάν μοι παρηγορία.","tokens":[{"text":"καὶ"},{"text":"Ἰησοῦς"},{"text":"ὁ"},{"text":"λεγόμενος"},{"text":"Ἰοῦστος"},{"text":"οἱ"},{"text":"ὄντες"},{"text":"ἐκ"},{"text":"περιτομῆς"},{"text":"οὗτοι"},{"text":"μόνοι"},{"text":"συνεργοὶ"},{"text":"εἰς"},{"text":"τὴν"},{"text":"βασιλείαν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"οἵτινες"},{"text":"ἐγενήθησάν"},{"text":"μοι"},{"text":"παρηγορία"}],"notes":[],"lang":"grc"},{"n":12,"text":"ἀσπάζεται ὑμᾶς Ἐπαφρᾶς ὁ ἐξ ὑμῶν, δοῦλος ⸀ Χριστοῦ, πάντοτε ἀγωνιζόμενος ὑπὲρ ὑμῶν ἐν ταῖς προσευχαῖς, ἵνα ⸀ σταθῆτε τέλειοι καὶ ⸀ πεπληροφορημένοι ἐν παντὶ θελήματι τοῦ θεοῦ.","tokens":[{"text":"ἀσπάζεται"},{"text":"ὑμᾶς"},{"text":"Ἐπαφρᾶς"},{"text":"ὁ"},{"text":"ἐξ"},{"text":"ὑμῶν"},{"text":"δοῦλος"},{"text":"Χριστοῦ"},{"text":"πάντοτε"},{"text":"ἀγωνιζόμενος"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"προσευχαῖς"},{"text":"ἵνα"},{"text":"σταθῆτε"},{"text":"τέλειοι"},{"text":"καὶ"},{"text":"πεπληροφορημένοι"},{"text":"ἐν"},{"text":"παντὶ"},{"text":"θελήματι"},{"text":"τοῦ"},{"text":"θεοῦ"}],"notes":[],"lang":"grc"},{"n":13,"text":"μαρτυρῶ γὰρ αὐτῷ ὅτι ἔχει ⸂ πολὺν πόνον⸃ ὑπὲρ ὑμῶν καὶ τῶν ἐν Λαοδικείᾳ καὶ τῶν ἐν Ἱεραπόλει.","tokens":[{"text":"μαρτυρῶ"},{"text":"γὰρ"},{"text":"αὐτῷ"},{"text":"ὅτι"},{"text":"ἔχει"},{"text":"πολὺν"},{"text":"πόνον"},{"text":"ὑπὲρ"},{"text":"ὑμῶν"},{"text":"καὶ"},{"text":"τῶν"},{"text":"ἐν"},{"text":"Λαοδικείᾳ"},{"text":"καὶ"},{"text":"τῶν"},{"text":"ἐν"},{"text":"Ἱεραπόλει"}],"notes":[],"lang":"grc"},{"n":14,"text":"ἀσπάζεται ὑμᾶς Λουκᾶς ὁ ἰατρὸς ὁ ἀγαπητὸς καὶ Δημᾶς.","tokens":[{"text":"ἀσπάζεται"},{"text":"ὑμᾶς"},{"text":"Λουκᾶς"},{"text":"ὁ"},{"text":"ἰατρὸς"},{"text":"ὁ"},{"text":"ἀγαπητὸς"},{"text":"καὶ"},{"text":"Δημᾶς"}],"notes":[],"lang":"grc"},{"n":15,"text":"ἀσπάσασθε τοὺς ἐν Λαοδικείᾳ ἀδελφοὺς καὶ ⸂ Νύμφαν καὶ τὴν κατʼ οἶκον αὐτῆς⸃ ἐκκλησίαν.","tokens":[{"text":"ἀσπάσασθε"},{"text":"τοὺς"},{"text":"ἐν"},{"text":"Λαοδικείᾳ"},{"text":"ἀδελφοὺς"},{"text":"καὶ"},{"text":"Νύμφαν"},{"text":"καὶ"},{"text":"τὴν"},{"text":"κατʼ"},{"text":"οἶκον"},{"text":"αὐτῆς"},{"text":"ἐκκλησίαν"}],"notes":[],"lang":"grc"},{"n":16,"text":"καὶ ὅταν ἀναγνωσθῇ παρʼ ὑμῖν ἡ ἐπιστολή, ποιήσατε ἵνα καὶ ἐν τῇ ⸀ Λαοδικέων ἐκκλησίᾳ ἀναγνωσθῇ, καὶ τὴν ἐκ Λαοδικείας ἵνα καὶ ὑμεῖς ἀναγνῶτε.","tokens":[{"text":"καὶ"},{"text":"ὅταν"},{"text":"ἀναγνωσθῇ"},{"text":"παρʼ"},{"text":"ὑμῖν"},{"text":"ἡ"},{"text":"ἐπιστολή"},{"text":"ποιήσατε"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"ἐν"},{"text":"τῇ"},{"text":"Λαοδικέων"},{"text":"ἐκκλησίᾳ"},{"text":"ἀναγνωσθῇ"},{"text":"καὶ"},{"text":"τὴν"},{"text":"ἐκ"},{"text":"Λαοδικείας"},{"text":"ἵνα"},{"text":"καὶ"},{"text":"ὑμεῖς"},{"text":"ἀναγνῶτε"}],"notes":[],"lang":"grc"},{"n":17,"text":"καὶ εἴπατε Ἀρχίππῳ· Βλέπε τὴν διακονίαν ἣν παρέλαβες ἐν κυρίῳ, ἵνα αὐτὴν πληροῖς.","tokens":[{"text":"καὶ"},{"text":"εἴπατε"},{"text":"Ἀρχίππῳ"},{"text":"Βλέπε"},{"text":"τὴν"},{"text":"διακονίαν"},{"text":"ἣν"},{"text":"παρέλαβες"},{"text":"ἐν"},{"text":"κυρίῳ"},{"text":"ἵνα"},{"text":"αὐτὴν"},{"text":"πληροῖς"}],"notes":[],"lang":"grc"},{"n":18,"text":"Ὁ ἀσπασμὸς τῇ ἐμῇ χειρὶ Παύλου. μνημονεύετέ μου τῶν δεσμῶν. ἡ χάρις μεθʼ ⸀ ὑμῶν.","tokens":[{"text":"Ὁ"},{"text":"ἀσπασμὸς"},{"text":"τῇ"},{"text":"ἐμῇ"},{"text":"χειρὶ"},{"text":"Παύλου"},{"text":"μνημονεύετέ"},{"text":"μου"},{"text":"τῶν"},{"text":"δεσμῶν"},{"text":"ἡ"},{"text":"χάρις"},{"text":"μεθʼ"},{"text":"ὑμῶν"}],"notes":[],"lang":"grc"}]}}