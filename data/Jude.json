{"book":{"id":"Jude","name":"Judas","testament":"NT","source":"SBLGNT","chapters":1,"verses":25},"chapters":{"1":[{"n":1,"text":"Ἰούδας Ἰησοῦ Χριστοῦ δοῦλος, ἀδελφὸς δὲ Ἰακώβου, τοῖς ἐν θεῷ πατρὶ ⸀ ἠγαπημένοις καὶ Ἰησοῦ Χριστῷ τετηρημένοις κλητοῖς·","tokens":[{"text":"Ἰούδας"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"δοῦλος"},{"text":"ἀδελφὸς"},{"text":"δὲ"},{"text":"Ἰακώβου"},{"text":"τοῖς"},{"text":"ἐν"},{"text":"θεῷ"},{"text":"πατρὶ"},{"text":"ἠγαπημένοις"},{"text":"καὶ"},{"text":"Ἰησοῦ"},{"text":"Χριστῷ"},{"text":"τετηρημένοις"},{"text":"κλητοῖς"}],"notes":[],"lang":"grc"},{"n":2,"text":"ἔλεος ὑμῖν καὶ εἰρήνη καὶ ἀγάπη πληθυνθείη.","tokens":[{"text":"ἔλεος"},{"text":"ὑμῖν"},{"text":"καὶ"},{"text":"εἰρήνη"},{"text":"καὶ"},{"text":"ἀγάπη"},{"text":"πληθυνθείη"}],"notes":[],"lang":"grc"},{"n":3,"text":"Ἀγαπητοί, πᾶσαν σπουδὴν ποιούμενος γράφειν ὑμῖν περὶ τῆς κοινῆς ⸀ ἡμῶν σωτηρίας ἀνάγκην ἔσχον γράψαι ὑμῖν παρακαλῶν ἐπαγωνίζεσθαι τῇ ἅπαξ παραδοθείσῃ τοῖς ἁγίοις πίστει.","tokens":[{"text":"Ἀγαπητοί"},{"text":"πᾶσαν"},{"text":"σπουδὴν"},{"text":"ποιούμενος"},{"text":"γράφειν"},{"text":"ὑμῖν"},{"text":"περὶ"},{"text":"τῆς"},{"text":"κοινῆς"},{"text":"ἡμῶν"},{"text":"σωτηρίας"},{"text":"ἀνάγκην"},{"text":"ἔσχον"},{"text":"γράψαι"},{"text":"ὑμῖν"},{"text":"παρακαλῶν"},{"text":"ἐπαγωνίζεσθαι"},{"text":"τῇ"},{"text":"ἅπαξ"},{"text":"παραδοθείσῃ"},{"text":"τοῖς"},{"text":"ἁγίοις"},{"text":"πίστει"}],"notes":[],"lang":"grc"},{"n":4,"text":"παρεισέδυσαν γάρ τινες ἄνθρωποι, οἱ πάλαι προγεγραμμένοι εἰς τοῦτο τὸ κρίμα, ἀσεβεῖς, τὴν τοῦ θεοῦ ἡμῶν χάριτα μετατιθέντες εἰς ἀσέλγειαν καὶ τὸν μόνον ⸀ δεσπότην καὶ κύριον ἡμῶν Ἰησοῦν Χριστὸν ἀρνούμενοι.","tokens":[{"text":"παρεισέδυσαν"},{"text":"γάρ"},{"text":"τινες"},{"text":"ἄνθρωποι"},{"text":"οἱ"},{"text":"πάλαι"},{"text":"προγεγραμμένοι"},{"text":"εἰς"},{"text":"τοῦτο"},{"text":"τὸ"},{"text":"κρίμα"},{"text":"ἀσεβεῖς"},{"text":"τὴν"},{"text":"τοῦ"},{"text":"θεοῦ"},{"text":"ἡμῶν"},{"text":"χάριτα"},{"text":"μετατιθέντες"},{"text":"εἰς"},{"text":"ἀσέλγειαν"},{"text":"καὶ"},{"text":"τὸν"},{"text":"μόνον"},{"text":"δεσπότην"},{"text":"καὶ"},{"text":"κύριον"},{"text":"ἡμῶν"},{"text":"Ἰησοῦν"},{"text":"Χριστὸν"},{"text":"ἀρνούμενοι"}],"notes":[],"lang":"grc"},{"n":5,"text":"Ὑπομνῆσαι δὲ ὑμᾶς βούλομαι, εἰδότας ⸂ ὑμᾶς ἅπαξ⸃  ⸀ πάντα, ὅτι ⸀ Ἰησοῦς λαὸν ἐκ γῆς Αἰγύπτου σώσας τὸ δεύτερον τοὺς μὴ πιστεύσαντας ἀπώλεσεν,","tokens":[{"text":"Ὑπομνῆσαι"},{"text":"δὲ"},{"text":"ὑμᾶς"},{"text":"βούλομαι"},{"text":"εἰδότας"},{"text":"ὑμᾶς"},{"text":"ἅπαξ"},{"text":"πάντα"},{"text":"ὅτι"},{"text":"Ἰησοῦς"},{"text":"λαὸν"},{"text":"ἐκ"},{"text":"γῆς"},{"text":"Αἰγύπτου"},{"text":"σώσας"},{"text":"τὸ"},{"text":"δεύτερον"},{"text":"τοὺς"},{"text":"μὴ"},{"text":"πιστεύσαντας"},{"text":"ἀπώλεσεν"}],"notes":[],"lang":"grc"},{"n":6,"text":"ἀγγέλους τε τοὺς μὴ τηρήσαντας τὴν ἑαυτῶν ἀρχὴν ἀλλὰ ἀπολιπόντας τὸ ἴδιον οἰκητήριον εἰς κρίσιν μεγάλης ἡμέρας δεσμοῖς ἀϊδίοις ὑπὸ ζόφον τετήρηκεν·","tokens":[{"text":"ἀγγέλους"},{"text":"τε"},{"text":"τοὺς"},{"text":"μὴ"},{"text":"τηρήσαντας"},{"text":"τὴν"},{"text":"ἑαυτῶν"},{"text":"ἀρχὴν"},{"text":"ἀλλὰ"},{"text":"ἀπολιπόντας"},{"text":"τὸ"},{"text":"ἴδιον"},{"text":"οἰκητήριον"},{"text":"εἰς"},{"text":"κρίσιν"},{"text":"μεγάλης"},{"text":"ἡμέρας"},{"text":"δεσμοῖς"},{"text":"ἀϊδίοις"},{"text":"ὑπὸ"},{"text":"ζόφον"},{"text":"τετήρηκεν"}],"notes":[],"lang":"grc"},{"n":7,"text":"ὡς Σόδομα καὶ Γόμορρα καὶ αἱ περὶ αὐτὰς πόλεις, τὸν ὅμοιον ⸂ τρόπον τούτοις⸃ ἐκπορνεύσασαι καὶ ἀπελθοῦσαι ὀπίσω σαρκὸς ἑτέρας, πρόκεινται δεῖγμα πυρὸς αἰωνίου δίκην ὑπέχουσαι.","tokens":[{"text":"ὡς"},{"text":"Σόδομα"},{"text":"καὶ"},{"text":"Γόμορρα"},{"text":"καὶ"},{"text":"αἱ"},{"text":"περὶ"},{"text":"αὐτὰς"},{"text":"πόλεις"},{"text":"τὸν"},{"text":"ὅμοιον"},{"text":"τρόπον"},{"text":"τούτοις"},{"text":"ἐκπορνεύσασαι"},{"text":"καὶ"},{"text":"ἀπελθοῦσαι"},{"text":"ὀπίσω"},{"text":"σαρκὸς"},{"text":"ἑτέρας"},{"text":"πρόκεινται"},{"text":"δεῖγμα"},{"text":"πυρὸς"},{"text":"αἰωνίου"},{"text":"δίκην"},{"text":"ὑπέχουσαι"}],"notes":[],"lang":"grc"},{"n":8,"text":"Ὁμοίως μέντοι καὶ οὗτοι ἐνυπνιαζόμενοι σάρκα μὲν μιαίνουσιν, κυριότητα δὲ ἀθετοῦσιν, δόξας δὲ βλασφημοῦσιν.","tokens":[{"text":"Ὁμοίως"},{"text":"μέντοι"},{"text":"καὶ"},{"text":"οὗτοι"},{"text":"ἐνυπνιαζόμενοι"},{"text":"σάρκα"},{"text":"μὲν"},{"text":"μιαίνουσιν"},{"text":"κυριότητα"},{"text":"δὲ"},{"text":"ἀθετοῦσιν"},{"text":"δόξας"},{"text":"δὲ"},{"text":"βλασφημοῦσιν"}],"notes":[],"lang":"grc"},{"n":9,"text":"ὁ δὲ Μιχαὴλ ὁ ἀρχάγγελος, ὅτε τῷ διαβόλῳ διακρινόμενος διελέγετο περὶ τοῦ Μωϋσέως σώματος, οὐκ ἐτόλμησεν κρίσιν ἐπενεγκεῖν βλασφημίας, ἀλλὰ εἶπεν· Ἐπιτιμήσαι σοι κύριος.","tokens":[{"text":"ὁ"},{"text":"δὲ"},{"text":"Μιχαὴλ"},{"text":"ὁ"},{"text":"ἀρχάγγελος"},{"text":"ὅτε"},{"text":"τῷ"},{"text":"διαβόλῳ"},{"text":"διακρινόμενος"},{"text":"διελέγετο"},{"text":"περὶ"},{"text":"τοῦ"},{"text":"Μωϋσέως"},{"text":"σώματος"},{"text":"οὐκ"},{"text":"ἐτόλμησεν"},{"text":"κρίσιν"},{"text":"ἐπενεγκεῖν"},{"text":"βλασφημίας"},{"text":"ἀλλὰ"},{"text":"εἶπεν"},{"text":"Ἐπιτιμήσαι"},{"text":"σοι"},{"text":"κύριος"}],"notes":[],"lang":"grc"},{"n":10,"text":"οὗτοι δὲ ὅσα μὲν οὐκ οἴδασιν βλασφημοῦσιν, ὅσα δὲ φυσικῶς ὡς τὰ ἄλογα ζῷα ἐπίστανται, ἐν τούτοις φθείρονται.","tokens":[{"text":"οὗτοι"},{"text":"δὲ"},{"text":"ὅσα"},{"text":"μὲν"},{"text":"οὐκ"},{"text":"οἴδασιν"},{"text":"βλασφημοῦσιν"},{"text":"ὅσα"},{"text":"δὲ"},{"text":"φυσικῶς"},{"text":"ὡς"},{"text":"τὰ"},{"text":"ἄλογα"},{"text":"ζῷα"},{"text":"ἐπίστανται"},{"text":"ἐν"},{"text":"τούτοις"},{"text":"φθείρονται"}],"notes":[],"lang":"grc"},{"n":11,"text":"οὐαὶ αὐτοῖς, ὅτι τῇ ὁδῷ τοῦ Κάϊν ἐπορεύθησαν, καὶ τῇ πλάνῃ τοῦ Βαλαὰμ μισθοῦ ἐξεχύθησαν, καὶ τῇ ἀντιλογίᾳ τοῦ Κόρε ἀπώλοντο.","tokens":[{"text":"οὐαὶ"},{"text":"αὐτοῖς"},{"text":"ὅτι"},{"text":"τῇ"},{"text":"ὁδῷ"},{"text":"τοῦ"},{"text":"Κάϊν"},{"text":"ἐπορεύθησαν"},{"text":"καὶ"},{"text":"τῇ"},{"text":"πλάνῃ"},{"text":"τοῦ"},{"text":"Βαλαὰμ"},{"text":"μισθοῦ"},{"text":"ἐξεχύθησαν"},{"text":"καὶ"},{"text":"τῇ"},{"text":"ἀντιλογίᾳ"},{"text":"τοῦ"},{"text":"Κόρε"},{"text":"ἀπώλοντο"}],"notes":[],"lang":"grc"},{"n":12,"text":"οὗτοί εἰσιν ⸀ οἱ ἐν ταῖς ἀγάπαις ὑμῶν σπιλάδες συνευωχούμενοι, ἀφόβως ἑαυτοὺς ποιμαίνοντες, νεφέλαι ἄνυδροι ὑπὸ ἀνέμων παραφερόμεναι, δένδρα φθινοπωρινὰ ἄκαρπα δὶς ἀποθανόντα ἐκριζωθέντα,","tokens":[{"text":"οὗτοί"},{"text":"εἰσιν"},{"text":"οἱ"},{"text":"ἐν"},{"text":"ταῖς"},{"text":"ἀγάπαις"},{"text":"ὑμῶν"},{"text":"σπιλάδες"},{"text":"συνευωχούμενοι"},{"text":"ἀφόβως"},{"text":"ἑαυτοὺς"},{"text":"ποιμαίνοντες"},{"text":"νεφέλαι"},{"text":"ἄνυδροι"},{"text":"ὑπὸ"},{"text":"ἀνέμων"},{"text":"παραφερόμεναι"},{"text":"δένδρα"},{"text":"φθινοπωρινὰ"},{"text":"ἄκαρπα"},{"text":"δὶς"},{"text":"ἀποθανόντα"},{"text":"ἐκριζωθέντα"}],"notes":[],"lang":"grc"},{"n":13,"text":"κύματα ἄγρια θαλάσσης ἐπαφρίζοντα τὰς ἑαυτῶν αἰσχύνας, ἀστέρες πλανῆται οἷς ὁ ζόφος τοῦ σκότους εἰς αἰῶνα τετήρηται.","tokens":[{"text":"κύματα"},{"text":"ἄγρια"},{"text":"θαλάσσης"},{"text":"ἐπαφρίζοντα"},{"text":"τὰς"},{"text":"ἑαυτῶν"},{"text":"αἰσχύνας"},{"text":"ἀστέρες"},{"text":"πλανῆται"},{"text":"οἷς"},{"text":"ὁ"},{"text":"ζόφος"},{"text":"τοῦ"},{"text":"σκότους"},{"text":"εἰς"},{"text":"αἰῶνα"},{"text":"τετήρηται"}],"notes":[],"lang":"grc"},{"n":14,"text":"Προεφήτευσεν δὲ καὶ τούτοις ἕβδομος ἀπὸ Ἀδὰμ Ἑνὼχ λέγων· Ἰδοὺ ἦλθεν κύριος ἐν ἁγίαις μυριάσιν αὐτοῦ,","tokens":[{"text":"Προεφήτευσεν"},{"text":"δὲ"},{"text":"καὶ"},{"text":"τούτοις"},{"text":"ἕβδομος"},{"text":"ἀπὸ"},{"text":"Ἀδὰμ"},{"text":"Ἑνὼχ"},{"text":"λέγων"},{"text":"Ἰδοὺ"},{"text":"ἦλθεν"},{"text":"κύριος"},{"text":"ἐν"},{"text":"ἁγίαις"},{"text":"μυριάσιν"},{"text":"αὐτοῦ"}],"notes":[],"lang":"grc"},{"n":15,"text":"ποιῆσαι κρίσιν κατὰ πάντων καὶ ἐλέγξαι ⸂ πάντας τοὺς ἀσεβεῖς⸃ περὶ πάντων τῶν ἔργων ἀσεβείας αὐτῶν ὧν ἠσέβησαν καὶ περὶ πάντων τῶν σκληρῶν ὧν ἐλάλησαν κατʼ αὐτοῦ ἁμαρτωλοὶ ἀσεβεῖς.","tokens":[{"text":"ποιῆσαι"},{"text":"κρίσιν"},{"text":"κατὰ"},{"text":"πάντων"},{"text":"καὶ"},{"text":"ἐλέγξαι"},{"text":"πάντας"},{"text":"τοὺς"},{"text":"ἀσεβεῖς"},{"text":"περὶ"},{"text":"πάντων"},{"text":"τῶν"},{"text":"ἔργων"},{"text":"ἀσεβείας"},{"text":"αὐτῶν"},{"text":"ὧν"},{"text":"ἠσέβησαν"},{"text":"καὶ"},{"text":"περὶ"},{"text":"πάντων"},{"text":"τῶν"},{"text":"σκληρῶν"},{"text":"ὧν"},{"text":"ἐλάλησαν"},{"text":"κατʼ"},{"text":"αὐτοῦ"},{"text":"ἁμαρτωλοὶ"},{"text":"ἀσεβεῖς"}],"notes":[],"lang":"grc"},{"n":16,"text":"οὗτοί εἰσιν γογγυσταί, μεμψίμοιροι, κατὰ τὰς ἐπιθυμίας ⸀ αὐτῶν πορευόμενοι, καὶ τὸ στόμα αὐτῶν λαλεῖ ὑπέρογκα, θαυμάζοντες πρόσωπα ὠφελείας χάριν.","tokens":[{"text":"οὗτοί"},{"text":"εἰσιν"},{"text":"γογγυσταί"},{"text":"μεμψίμοιροι"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"ἐπιθυμίας"},{"text":"αὐτῶν"},{"text":"πορευόμενοι"},{"text":"καὶ"},{"text":"τὸ"},{"text":"στόμα"},{"text":"αὐτῶν"},{"text":"λαλεῖ"},{"text":"ὑπέρογκα"},{"text":"θαυμάζοντες"},{"text":"πρόσωπα"},{"text":"ὠφελείας"},{"text":"χάριν"}],"notes":[],"lang":"grc"},{"n":17,"text":"Ὑμεῖς δέ, ἀγαπητοί, μνήσθητε τῶν ῥημάτων τῶν προειρημένων ὑπὸ τῶν ἀποστόλων τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ·","tokens":[{"text":"Ὑμεῖς"},{"text":"δέ"},{"text":"ἀγαπητοί"},{"text":"μνήσθητε"},{"text":"τῶν"},{"text":"ῥημάτων"},{"text":"τῶν"},{"text":"προειρημένων"},{"text":"ὑπὸ"},{"text":"τῶν"},{"text":"ἀποστόλων"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"}],"notes":[],"lang":"grc"},{"n":18,"text":"ὅτι ἔλεγον ⸀ ὑμῖν·  ⸂ Ἐπʼ ἐσχάτου χρόνου⸃ ἔσονται ἐμπαῖκται κατὰ τὰς ἑαυτῶν ἐπιθυμίας πορευόμενοι τῶν ἀσεβειῶν.","tokens":[{"text":"ὅτι"},{"text":"ἔλεγον"},{"text":"ὑμῖν"},{"text":"Ἐπʼ"},{"text":"ἐσχάτου"},{"text":"χρόνου"},{"text":"ἔσονται"},{"text":"ἐμπαῖκται"},{"text":"κατὰ"},{"text":"τὰς"},{"text":"ἑαυτῶν"},{"text":"ἐπιθυμίας"},{"text":"πορευόμενοι"},{"text":"τῶν"},{"text":"ἀσεβειῶν"}],"notes":[],"lang":"grc"},{"n":19,"text":"οὗτοί εἰσιν οἱ ἀποδιορίζοντες, ψυχικοί, πνεῦμα μὴ ἔχοντες.","tokens":[{"text":"οὗτοί"},{"text":"εἰσιν"},{"text":"οἱ"},{"text":"ἀποδιορίζοντες"},{"text":"ψυχικοί"},{"text":"πνεῦμα"},{"text":"μὴ"},{"text":"ἔχοντες"}],"notes":[],"lang":"grc"},{"n":20,"text":"ὑμεῖς δέ, ἀγαπητοί,  ⸂ ἐποικοδομοῦντες ἑαυτοὺς τῇ ἁγιωτάτῃ ὑμῶν πίστει⸃, ἐν πνεύματι ἁγίῳ προσευχόμενοι,","tokens":[{"text":"ὑμεῖς"},{"text":"δέ"},{"text":"ἀγαπητοί"},{"text":"ἐποικοδομοῦντες"},{"text":"ἑαυτοὺς"},{"text":"τῇ"},{"text":"ἁγιωτάτῃ"},{"text":"ὑμῶν"},{"text":"πίστει"},{"text":"ἐν"},{"text":"πνεύματι"},{"text":"ἁγίῳ"},{"text":"προσευχόμενοι"}],"notes":[],"lang":"grc"},{"n":21,"text":"ἑαυτοὺς ἐν ἀγάπῃ θεοῦ τηρήσατε προσδεχόμενοι τὸ ἔλεος τοῦ κυρίου ἡμῶν Ἰησοῦ Χριστοῦ εἰς ζωὴν αἰώνιον.","tokens":[{"text":"ἑαυτοὺς"},{"text":"ἐν"},{"text":"ἀγάπῃ"},{"text":"θεοῦ"},{"text":"τηρήσατε"},{"text":"προσδεχόμενοι"},{"text":"τὸ"},{"text":"ἔλεος"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"εἰς"},{"text":"ζωὴν"},{"text":"αἰώνιον"}],"notes":[],"lang":"grc"},{"n":22,"text":"καὶ οὓς μὲν ⸀ ἐλεᾶτε ⸂ διακρινομένους,","tokens":[{"text":"καὶ"},{"text":"οὓς"},{"text":"μὲν"},{"text":"ἐλεᾶτε"},{"text":"διακρινομένους"}],"notes":[],"lang":"grc"},{"n":23,"text":"οὓς δὲ σῴζετε ἐκ πυρὸς ἁρπάζοντες, οὓς δὲ ἐλεᾶτε ἐν φόβῳ⸃, μισοῦντες καὶ τὸν ἀπὸ τῆς σαρκὸς ἐσπιλωμένον χιτῶνα.","tokens":[{"text":"οὓς"},{"text":"δὲ"},{"text":"σῴζετε"},{"text":"ἐκ"},{"text":"πυρὸς"},{"text":"ἁρπάζοντες"},{"text":"οὓς"},{"text":"δὲ"},{"text":"ἐλεᾶτε"},{"text":"ἐν"},{"text":"φόβῳ"},{"text":"μισοῦντες"},{"text":"καὶ"},{"text":"τὸν"},{"text":"ἀπὸ"},{"text":"τῆς"},{"text":"σαρκὸς"},{"text":"ἐσπιλωμένον"},{"text":"χιτῶνα"}],"notes":[],"lang":"grc"},{"n":24,"text":"Τῷ δὲ δυναμένῳ φυλάξαι ⸀ ὑμᾶς ἀπταίστους καὶ στῆσαι κατενώπιον τῆς δόξης αὐτοῦ ἀμώμους ἐν ἀγαλλιάσει","tokens":[{"text":"Τῷ"},{"text":"δὲ"},{"text":"δυναμένῳ"},{"text":"φυλάξαι"},{"text":"ὑμᾶς"},{"text":"ἀπταίστους"},{"text":"καὶ"},{"text":"στῆσαι"},{"text":"κατενώπιον"},{"text":"τῆς"},{"text":"δόξης"},{"text":"αὐτοῦ"},{"text":"ἀμώμους"},{"text":"ἐν"},{"text":"ἀγαλλιάσει"}],"notes":[],"lang":"grc"},{"n":25,"text":"⸀ μόνῳ θεῷ σωτῆρι ἡμῶν ⸂ διὰ Ἰησοῦ Χριστοῦ τοῦ κυρίου ἡμῶν⸃  ⸀ δόξα μεγαλωσύνη κράτος καὶ ἐξουσία ⸂ πρὸ παντὸς τοῦ αἰῶνος⸃ καὶ νῦν καὶ εἰς πάντας τοὺς αἰῶνας· ἀμήν.","tokens":[{"text":"μόνῳ"},{"text":"θεῷ"},{"text":"σωτῆρι"},{"text":"ἡμῶν"},{"text":"διὰ"},{"text":"Ἰησοῦ"},{"text":"Χριστοῦ"},{"text":"τοῦ"},{"text":"κυρίου"},{"text":"ἡμῶν"},{"text":"δόξα"},{"text":"μεγαλωσύνη"},{"text":"κράτος"},{"text":"καὶ"},{"text":"ἐξουσία"},{"text":"πρὸ"},{"text":"παντὸς"},{"text":"τοῦ"},{"text":"αἰῶνος"},{"text":"καὶ"},{"text":"νῦν"},{"text":"καὶ"},{"text":"εἰς"},{"text":"πάντας"},{"text":"τοὺς"},{"text":"αἰῶνας"},{"text":"ἀμήν"}],"notes":[],"lang":"grc"}]}}